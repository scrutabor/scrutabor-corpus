  "segments": {
    "s01": { "translation": "Drop down dew, ye heavens, from above, and let the clouds rain down the Just One: let the earth be opened and bud forth a Savior.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Isaiah 45:8" }] },
    "s02": { "translation": "The heavens declare the glory of God: and the firmament proclaims the work of His hands.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Psalm 18:2" }] },
    "s03": { "translation": "Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen." },
