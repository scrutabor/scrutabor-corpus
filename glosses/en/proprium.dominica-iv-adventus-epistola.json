  "about": "The epistle of the Fourth Sunday of Advent. Paul takes the verdict away from the Corinthians and from himself alike — it belongs to the Lord, and it is not given until He comes.",
  "analysis_defaults": { "confidence": "high", "sources": ["editorial"], "review": "pending" },
  "segments": {
    "s01": { "translation": "Brethren: Let a man so account of us as of the ministers of Christ, and the stewards of the mysteries of God.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "1 Corinthians 4:1" }] },
    "s02": { "translation": "Here now it is required among the stewards that a man be found faithful.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "1 Corinthians 4:2" }] },
    "s03": { "translation": "But to me it is a very small thing to be judged by you, or by man's day: but neither do I judge my own self.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "1 Corinthians 4:3" }] },
    "s04": { "translation": "For I am not conscious to myself of anything: yet am I not hereby justified, but He that judges me is the Lord.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "1 Corinthians 4:4" }] },
    "s05": { "translation": "Therefore judge not before the time, until the Lord comes: who both will bring to light the hidden things of darkness, and will make manifest the counsels of the hearts: and then shall every man have praise from God.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "1 Corinthians 4:5" }] }
  },
