  "about": "The gospel of the Third Sunday of Advent. The delegation from Jerusalem asks three times, and John's answers grow shorter each time: I am not the Christ, I am not, no. Only after that does he say who he is, and he says it in Isaiah's words. The Bethania of the last sentence lies beyond the Jordan and is not the one near Jerusalem where Martha and Mary lived.",
  "about_citations": [
    {
      "title": "Biblia Sacra Vulgata",
      "locator": "John 1:28"
    },
    {
      "title": "Biblia Sacra Vulgata",
      "locator": "John 11:1, 11:18"
    }
  ],
  "analysis_defaults": { "confidence": "high", "sources": ["editorial"], "review": "pending" },
  "segments": {
    "s01": { "translation": "At that time: The Jews sent priests and Levites from Jerusalem to John, to ask him:", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:19" }] },
    "s02": { "translation": "Who are you?", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:19" }] },
    "s03": { "translation": "And he confessed and did not deny, and he confessed: I am not the Christ.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:20" }] },
    "s04": { "translation": "And they asked him: What then? Are you Elijah?", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:21" }] },
    "s05": { "translation": "And he said: I am not. Are you the prophet? And he answered: No.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:21" }] },
    "s06": { "translation": "They said therefore to him: Who are you, that we may give an answer to those who sent us? What do you say of yourself?", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:22" }] },
    "s07": { "translation": "He said: I am the voice of one crying in the wilderness: Make straight the way of the Lord, as the prophet Isaiah said.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:23" }] },
    "s08": { "translation": "And those who had been sent were of the Pharisees.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:24" }] },
    "s09": { "translation": "And they asked him and said to him: Why then do you baptize, if you are not the Christ, nor Elijah, nor the prophet?", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:25" }] },
    "s10": { "translation": "John answered them, saying: I baptize with water, but there has stood in your midst one whom you do not know.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:26" }] },
    "s11": { "translation": "He it is who is to come after me, who was made before me, and I am not worthy to loosen the strap of his shoe.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:27" }] },
    "s12": { "translation": "These things were done in Bethania beyond the Jordan, where John was baptizing.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:28" }] }
  },
