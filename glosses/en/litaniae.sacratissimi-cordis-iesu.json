    "s087": { "translation": "Make our hearts like unto Thine.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Sacratissimi Cordis Iesu", "url": "https://www.preces-latinae.org/thesaurus/Filius/LitSCI.html" }] },
    "s088": { "translation": "Let us pray.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Sacratissimi Cordis Iesu", "url": "https://www.preces-latinae.org/thesaurus/Filius/LitSCI.html" }] },
    "s089": { "translation": "Almighty and eternal God, look upon the Heart of Thy most beloved Son and upon the praises and satisfaction which He offers Thee in the name of sinners; and to those who implore Thy mercy, in Thy great goodness grant forgiveness in the name of the same Jesus Christ, Thy Son, who lives and reigns with Thee for ever and ever. Amen.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Sacratissimi Cordis Iesu", "url": "https://www.preces-latinae.org/thesaurus/Filius/LitSCI.html" }] }
  },
