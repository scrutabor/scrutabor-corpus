  "about": "The epistle of the Third Sunday of Advent, from which the day takes its name of Gaudete. The call to rejoice stands beside a call to modesty and to freedom from anxiety — three things Paul binds together because “the Lord is nigh”.",
  "analysis_defaults": { "confidence": "high", "sources": ["editorial"], "review": "pending" },
  "segments": {
    "s01": { "translation": "Brethren: Rejoice in the Lord always: again I say, rejoice.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Philippians 4:4-7" }] },
    "s02": { "translation": "Let your modesty be known to all men: the Lord is nigh.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Philippians 4:4-7" }] },
    "s03": { "translation": "Be nothing solicitous: but in everything by prayer and supplication, with thanksgiving, let your petitions be made known to God.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Philippians 4:4-7" }] },
    "s04": { "translation": "And the peace of God, which surpasseth all understanding, keep your hearts and minds in Christ Jesus our Lord.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Philippians 4:4-7" }] }
