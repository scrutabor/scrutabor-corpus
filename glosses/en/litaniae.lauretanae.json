    "s124": { "translation": "Lamb of God, who takest away the sins of the world.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Lauretanae", "url": "https://www.preces-latinae.org/thesaurus/BVM/Laurentanae.html" }] },
    "s125": { "translation": "Spare us, O Lord.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Lauretanae", "url": "https://www.preces-latinae.org/thesaurus/BVM/Laurentanae.html" }] },
    "s126": { "translation": "Lamb of God, who takest away the sins of the world.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Lauretanae", "url": "https://www.preces-latinae.org/thesaurus/BVM/Laurentanae.html" }] },
    "s127": { "translation": "Graciously hear us, O Lord.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Lauretanae", "url": "https://www.preces-latinae.org/thesaurus/BVM/Laurentanae.html" }] },
    "s128": { "translation": "Lamb of God, who takest away the sins of the world.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Lauretanae", "url": "https://www.preces-latinae.org/thesaurus/BVM/Laurentanae.html" }] },
    "s129": { "translation": "Have mercy on us.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Lauretanae", "url": "https://www.preces-latinae.org/thesaurus/BVM/Laurentanae.html" }] },
    "s130": { "translation": "Pray for us, O holy Mother of God.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Lauretanae", "url": "https://www.preces-latinae.org/thesaurus/BVM/Laurentanae.html" }] },
    "s131": { "translation": "That we may be made worthy of the promises of Christ.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Lauretanae", "url": "https://www.preces-latinae.org/thesaurus/BVM/Laurentanae.html" }] },
    "s132": { "translation": "Let us pray.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Lauretanae", "url": "https://www.preces-latinae.org/thesaurus/BVM/Laurentanae.html" }] },
    "s133": { "translation": "Grant, we beseech Thee, O Lord God, that we Thy servants may enjoy lasting health of mind and body; and by the glorious intercession of Blessed Mary, ever Virgin, be delivered from present sorrow and enjoy eternal gladness. Through Christ our Lord. Amen.", "translation_citations": [{ "title": "Thesaurus Precum Latinarum", "locator": "Litaniae Lauretanae", "url": "https://www.preces-latinae.org/thesaurus/BVM/Laurentanae.html" }] }
