  "status": "working-edition",
  "about": "The epistle of the Second Sunday of Advent, from Romans. Paul reads the Scriptures as written for us — so that patience and comfort should breed hope — and ends with a chain of quotations in which the nations praise God together with Israel.",
  "analysis_defaults": { "confidence": "high", "sources": ["editorial"], "review": "pending" },
  "segments": {
    "s01": { "translation": "Brethren: Whatsoever things were written, were written for our learning: that through patience and the comfort of the Scriptures we might have hope.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s02": { "translation": "Now the God of patience and of comfort grant you to be of one mind toward one another according to Jesus Christ: that with one mind and with one mouth you may glorify God and the Father of our Lord Jesus Christ.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s03": { "translation": "Wherefore receive one another, as Christ also hath received you unto the honor of God.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s04": { "translation": "For I say that Christ Jesus was minister of the circumcision for the truth of God, to confirm the promises made unto the fathers: but that the Gentiles are to glorify God for His mercy, as it is written: Therefore will I confess to Thee among the Gentiles, O Lord, and will sing to Thy name.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s05": { "translation": "And again he saith: Rejoice, ye Gentiles, with His people.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s06": { "translation": "And again: Praise the Lord, all ye Gentiles, and magnify Him, all ye peoples.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s07": { "translation": "And again Isaias saith: There shall be a root of Jesse, and He that shall rise up to rule the Gentiles, in Him the Gentiles shall hope.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s08": { "translation": "Now the God of hope fill you with all joy and peace in believing: that you may abound in hope and in the power of the Holy Ghost.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] }
  },
