  "segments": {
    "s01": { "narrative": "Bowed, the priest continues." },
    "s02": { "translation": "O God, Thou wilt turn and give us life.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 84:7" }] },
    "s03": { "translation": "And Thy people will rejoice in Thee.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 84:7" }] },
    "s04": { "translation": "Show us, O Lord, Thy mercy.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 84:8" }] },
    "s05": { "translation": "And grant us Thy salvation.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 84:8" }] },
    "s06": { "translation": "O Lord, hear my prayer.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 101:2" }] },
    "s07": { "translation": "And let my cry come unto Thee.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 101:2" }] },
    "s08": { "translation": "The Lord be with you." },
    "s09": { "translation": "And with your spirit." }
  },
