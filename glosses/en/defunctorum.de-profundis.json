  "segments": {
    "s001": { "translation": "Out of the depths I have cried to Thee, O Lord.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 129" }] },
    "s002": { "translation": "Lord, hear my voice.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 129" }] },
    "s003": { "translation": "Let Thy ears be attentive to the voice of my supplication.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 129" }] },
    "s004": { "translation": "If Thou, O Lord, wilt mark iniquities, Lord, who shall stand it?", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 129" }] },
    "s005": { "translation": "For with Thee there is merciful forgiveness; and by reason of Thy law I have waited for Thee, O Lord.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 129" }] },
    "s006": { "translation": "My soul hath relied on His word; my soul hath hoped in the Lord.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 129" }] },
    "s007": { "translation": "From the morning watch even until night, let Israel hope in the Lord.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 129" }] },
    "s008": { "translation": "Because with the Lord there is mercy, and with Him plentiful redemption.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 129" }] },
    "s009": { "translation": "And He shall redeem Israel from all his iniquities.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Psalm 129" }] }
  },
