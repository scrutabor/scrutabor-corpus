  "segments": {
    "s01": { "narrative": "Kapłan, pochylony, mówi dalej." },
    "s02": { "translation": "Boże, Ty, zwróciwszy się ku nam, ożywisz nas.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Ps 84, 7" }] },
    "s03": { "translation": "A lud Twój rozraduje się w Tobie.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Ps 84, 7" }] },
    "s04": { "translation": "Okaż nam, Panie, miłosierdzie Twoje.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Ps 84, 8" }] },
    "s05": { "translation": "I daj nam zbawienie Twoje.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Ps 84, 8" }] },
    "s06": { "translation": "Panie, wysłuchaj modlitwy mojej.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Ps 101, 2" }] },
    "s07": { "translation": "A wołanie moje niech do Ciebie przyjdzie.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Ps 101, 2" }] },
    "s08": { "translation": "Pan z wami." },
    "s09": { "translation": "I z duchem twoim." }
  },
