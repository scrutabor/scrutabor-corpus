  "about": "Ewangelia III Niedzieli Adwentu. Poselstwo z Jerozolimy pyta trzy razy, a odpowiedzi Jana są coraz krótsze: nie jestem ja Chrystusem, nie jestem, nie. Dopiero potem mówi, kim jest, i mówi to słowami Izajasza. Betania z ostatniego zdania leży za Jordanem i nie jest tą pod Jerozolimą, w której mieszkały Marta i Maria.",
  "about_citations": [
    {
      "title": "Biblia Sacra Vulgata",
      "locator": "John 1:28"
    },
    {
      "title": "Biblia Sacra Vulgata",
      "locator": "John 11:1, 11:18"
    }
  ],
  "analysis_defaults": { "confidence": "high", "sources": ["editorial"], "review": "pending" },
  "segments": {
    "s01": { "translation": "W owym czasie: Posłali Żydzi z Jerozolimy kapłanów i lewitów do Jana, aby go zapytali:", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:19" }] },
    "s02": { "translation": "Kim ty jesteś?", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:19" }] },
    "s03": { "translation": "I wyznał, a nie zaprzeczył, i wyznał: Nie jestem ja Chrystusem.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:20" }] },
    "s04": { "translation": "I zapytali go: Co więc? Czy ty jesteś Eliaszem?", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:21" }] },
    "s05": { "translation": "I rzekł: Nie jestem. Czy ty jesteś prorokiem? I odpowiedział: Nie.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:21" }] },
    "s06": { "translation": "Rzekli mu więc: Kim jesteś, abyśmy dali odpowiedź tym, którzy nas posłali? Co mówisz sam o sobie?", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:22" }] },
    "s07": { "translation": "Rzekł: Jam głos wołającego na pustyni: Prostujcie drogę Pańską, jak powiedział prorok Izajasz.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:23" }] },
    "s08": { "translation": "A ci, którzy byli posłani, byli z faryzeuszów.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:24" }] },
    "s09": { "translation": "I zapytali go, i rzekli mu: Czemu więc chrzcisz, jeśli ty nie jesteś Chrystusem ani Eliaszem, ani prorokiem?", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:25" }] },
    "s10": { "translation": "Odpowiedział im Jan, mówiąc: Ja chrzczę wodą, a pośród was stanął Ten, którego wy nie znacie.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:26" }] },
    "s11": { "translation": "On jest tym, który po mnie przyjdzie, który przede mną się stał, a ja nie jestem godzien rozwiązać rzemyka u sandała jego.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:27" }] },
    "s12": { "translation": "To działo się w Betanii za Jordanem, gdzie Jan chrzcił.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:28" }] }
  },
