  "about": "Introit II Niedzieli Adwentu, z Izajasza, z wersetem Psalmu 79. Antyfona zwraca się do ludu Syjonu i mówi, po co Pan przychodzi — zbawić narody, i dać usłyszeć swój głos.",
  "analysis_defaults": { "confidence": "high", "sources": ["editorial"], "review": "pending" },
  "segments": {
    "s01": { "translation": "Ludu Syjonu, oto Pan przyjdzie, aby zbawić narody: i da usłyszeć Pan chwałę głosu swego w radości serca waszego.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Isaiah 30:30" }] },
    "s02": { "translation": "Który rządzisz Izraelem, nakłoń ucha: który prowadzisz Józefa jak owcę.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Psalm 79:2" }] },
    "s03": { "translation": "Chwała Ojcu i Synowi, i Duchowi Świętemu. Jak była na początku, teraz i zawsze, i na wieki wieków. Amen." },
    "s05": { "translation": "Ludu Syjonu, oto Pan przyjdzie, aby zbawić narody: i da usłyszeć Pan chwałę głosu swego w radości serca waszego.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Isaiah 30:30" }] }
