  "text": "orationes.angelus-domini",
  "lang": "pl",
  "status": "working-edition",
  "about": "Poza okresem wielkanocnym modlitwę Anioł Pański odmawia się ze wskazanymi wersetami i modlitwą. W okresie wielkanocnym jej miejsce zajmuje Regina caeli.",
  "about_citations": [
    {
      "title": "Enchiridion Indulgentiarum, fourth edition",
      "locator": "Concessio 17 § 2, Angelus Domini and Regina caeli",
      "url": "https://www.vatican.va/roman_curia/tribunals/apost_penit/documents/rc_trib_appen_doc_20020826_enchiridion-indulgentiarum_lt.html"
    }
  ],
  "analysis_defaults": { "confidence": "high", "sources": ["editorial"], "review": "pending" },
  "segments": {
    "s01": { "translation": "Anioł Pański zwiastował Pannie Maryi." },
    "s02": { "translation": "I poczęła z Ducha Świętego." },
    "ave1": { "translation": "Zdrowaś Maryjo, łaski pełna, Pan z Tobą, błogosławionaś Ty między niewiastami i błogosławiony owoc żywota Twojego, Jezus. Święta Maryjo, Matko Boża, módl się za nami grzesznymi teraz i w godzinę śmierci naszej. Amen." },
    "s04": { "translation": "Oto ja Służebnica Pańska." },
    "s05": { "translation": "Niech mi się stanie według słowa Twego." },
    "ave2": { "translation": "Zdrowaś Maryjo, łaski pełna, Pan z Tobą, błogosławionaś Ty między niewiastami i błogosławiony owoc żywota Twojego, Jezus. Święta Maryjo, Matko Boża, módl się za nami grzesznymi teraz i w godzinę śmierci naszej. Amen." },
    "s07": { "translation": "A Słowo stało się Ciałem." },
    "s08": { "translation": "I zamieszkało między nami." },
    "ave3": { "translation": "Zdrowaś Maryjo, łaski pełna, Pan z Tobą, błogosławionaś Ty między niewiastami i błogosławiony owoc żywota Twojego, Jezus. Święta Maryjo, Matko Boża, módl się za nami grzesznymi teraz i w godzinę śmierci naszej. Amen." },
    "s10": { "translation": "Módl się za nami, święta Boża Rodzicielko." },
    "s11": { "translation": "Abyśmy się stali godnymi obietnic Chrystusowych." },
    "s12": { "translation": "Módlmy się." },
    "s13": { "translation": "Wszechmogący Boże, przez zwiastowanie anielskie poznaliśmy wcielenie Chrystusa, Twojego Syna, prosimy Cię, wlej w serca nasze swoją łaskę, abyśmy przez Jego mękę i krzyż zostali doprowadzeni do chwały zmartwychwstania. Przez Chrystusa, Pana naszego. Amen." }
  },
