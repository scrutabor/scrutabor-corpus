  "about": "Introit IV Niedzieli Adwentu, od którego cały adwentowy zwyczaj Rorat bierze nazwę. Antyfona wraca po psalmie i po Chwała Ojcu, tak jak każe rubryka pod nią.",
  "analysis_defaults": { "confidence": "high", "sources": ["editorial"], "review": "pending" },
  "segments": {
    "s01": { "translation": "Spuszczajcie rosę, niebiosa, z góry, a obłoki niech spuszczą deszczem Sprawiedliwego: niech się otworzy ziemia i zrodzi Zbawiciela.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Isaiah 45:8" }] },
    "s02": { "translation": "Niebiosa opowiadają chwałę Boga, a dzieła rąk Jego oznajmia firmament.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Psalm 18:2" }] },
    "s03": { "translation": "Chwała Ojcu i Synowi, i Duchowi Świętemu. Jak była na początku, teraz i zawsze, i na wieki wieków. Amen." },
    "s05": { "translation": "Spuszczajcie rosę, niebiosa, z góry, a obłoki niech spuszczą deszczem Sprawiedliwego: niech się otworzy ziemia i zrodzi Zbawiciela.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Isaiah 45:8" }] }
  },
