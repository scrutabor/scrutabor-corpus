  "about": "Lekcja III Niedzieli Adwentu, od której niedziela bierze nazwę Gaudete. Wezwanie do radości stoi obok wezwania do skromności i do wolności od troski — trzy rzeczy, które Paweł wiąże ze sobą, bo „Pan jest blisko”.",
  "analysis_defaults": { "confidence": "high", "sources": ["editorial"], "review": "pending" },
  "segments": {
    "s01": { "translation": "Bracia: Radujcie się zawsze w Panu: powtórnie mówię, radujcie się.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Philippians 4:4-7" }] },
    "s02": { "translation": "Skromność wasza niech będzie znana wszystkim ludziom: Pan jest blisko.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Philippians 4:4-7" }] },
    "s03": { "translation": "O nic się nie troszczcie, ale w każdej modlitwie i błaganiu, z dziękczynieniem, niech prośby wasze będą znane u Boga.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Philippians 4:4-7" }] },
    "s04": { "translation": "A pokój Boży, który przewyższa wszelki rozum, niech strzeże serc waszych i myśli waszych w Chrystusie Jezusie, Panu naszym.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Philippians 4:4-7" }] }
  },
