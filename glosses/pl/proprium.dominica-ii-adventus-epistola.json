  "text": "proprium.dominica-ii-adventus-epistola",
  "lang": "pl",
  "status": "working-edition",
  "about": "Lekcja II Niedzieli Adwentu, z Listu do Rzymian. Paweł czyta Pisma jako napisane dla nas — po to, by z cierpliwości i pociechy rodziła się nadzieja — i kończy szeregiem cytatów, w których narody chwalą Boga razem z Izraelem.",
  "analysis_defaults": { "confidence": "high", "sources": ["editorial"], "review": "pending" },
  "segments": {
    "s01": { "translation": "Bracia: Cokolwiek napisano, ku naszemu pouczeniu napisano: abyśmy przez cierpliwość i pociechę Pism nadzieję mieli.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s02": { "translation": "A Bóg cierpliwości i pokrzepienia niech wam da to samo rozumieć między sobą według Jezusa Chrystusa: abyście jednomyślni jednymi usty wysławiali Boga i Ojca Pana naszego Jezusa Chrystusa.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s03": { "translation": "Dlatego przyjmujcie jeden drugiego, jak i Chrystus przyjął was ku czci Boga.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s04": { "translation": "Mówię bowiem, że Chrystus Jezus był sługą obrzezania dla prawdy Bożej, aby utwierdzić obietnice ojców: narody zaś za miłosierdzie mają czcić Boga, jak napisano: Dlatego będę Cię wysławiał wśród narodów, Panie, i imieniu Twemu będę śpiewał.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s05": { "translation": "I znowu mówi: Weselcie się, narody, z ludem Jego.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s06": { "translation": "I znowu: Chwalcie Pana, wszystkie narody, i wielbijcie Go, wszystkie ludy.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s07": { "translation": "I na powrót Izajasz mówi: Będzie korzeń Jessego, i który powstanie, aby rządzić narodami, w Nim narody nadzieję położą.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] },
    "s08": { "translation": "A Bóg nadziei niech was napełni wszelką radością i pokojem w wierzeniu: abyście obfitowali w nadziei i mocy Ducha Świętego.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Romans 15:4-13" }] }
  },
