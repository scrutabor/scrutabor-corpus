  "segments": {
    "s01": { "translation": "Chwała Ojcu i Synowi, i Duchowi Świętemu." },
    "s02": { "translation": "Jak była na początku, teraz i zawsze, i na wieki wieków. Amen." }
  },
  "words": {
    "w001": { "gloss": "chwała", "function": "Mianownik z domyślnym „sit”: „chwała [niech będzie]”." },
    "w002": { "gloss": "Ojcu", "function": "Celownik: chwała komu? Pierwszy z trzech celowników Trójcy." },
    "w003": { "gloss": "i", "function": "Spójnik łączny." },
    "w004": { "gloss": "Synowi", "function": "Celownik II deklinacji (fílius, fílii)." },
    "w005": { "gloss": "i", "function": "Spójnik łączny." },
    "w006": { "gloss": "Duchowi", "function": "Celownik IV deklinacji (spíritus, -us) — końcówka -ui, jak „fructus → frúctui”." },
    "w007": { "gloss": "Świętemu", "function": "Celownik — zgodny ze „Spirítui”." },
    "w008": { "gloss": "jak", "function": "Spójnik porównawczy: „tak jak”." },
    "w009": { "gloss": "była", "function": "Imperfectum od „sum”: trwanie w przeszłości; podmiot domyślny — chwała." },
    "w010": { "gloss": "na", "function": "Przyimek z ablativem — czas-miejsce: „na początku”." },
    "w011": { "gloss": "początku", "function": "Ablativus II deklinacji (princípium)." },
    "w012": { "gloss": "i", "function": "Spójnik łączny." },
    "w013": { "gloss": "teraz", "function": "Przysłówek czasu." },
    "w014": { "gloss": "i", "function": "Spójnik łączny." },
    "w015": { "gloss": "zawsze", "function": "Przysłówek — jak w tytule „semper Virgo”." },
    "w016": { "gloss": "i", "function": "Spójnik łączny." },
    "w017": { "gloss": "na", "function": "„in” z BIERNIKIEM — rozciągłość w czasie: „na wieki”. Por. „in” (w010), gdzie ablativus wskazuje punkt w czasie." },
    "w018": { "gloss": "wieki", "function": "Biernik l. mn. — cel po „in”." },
    "w019": { "gloss": "wieków", "function": "Dopełniacz l. mn. — hebraizm wzmacniający przez powtórzenie: „wieki wieków”, jak „Święte Świętych”." },
    "w020": { "gloss": "amen", "function": "Hebrajskie „niech się stanie” — nieodmienne." }
  }
}
