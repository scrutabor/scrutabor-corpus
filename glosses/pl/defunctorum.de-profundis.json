  "segments": {
    "s001": { "translation": "Z głębokości wołałem ku Tobie, Panie.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Psalm 129" }] },
    "s002": { "translation": "Panie, wysłuchaj głosu mego.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Psalm 129" }] },
    "s003": { "translation": "Niech będą uszy Twoje nakłonione na głos modlitwy mojej.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Psalm 129" }] },
    "s004": { "translation": "Jeżeli będziesz baczył na nieprawości, Panie, Panie, któż się ostoi?", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Psalm 129" }] },
    "s005": { "translation": "Albowiem u Ciebie jest ubłaganie i dla zakonu Twego czekałem Cię, Panie.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Psalm 129" }] },
    "s006": { "translation": "Czekała dusza moja na słowo Jego; nadzieję miała dusza moja w Panu.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Psalm 129" }] },
    "s007": { "translation": "Od straży porannej aż do nocy niechaj Izrael nadzieję ma w Panu.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Psalm 129" }] },
    "s008": { "translation": "Bo u Pana miłosierdzie i obfite u Niego odkupienie.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Psalm 129" }] },
    "s009": { "translation": "A On odkupi Izraela ze wszystkich nieprawości jego.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Psalm 129" }] }
  },
