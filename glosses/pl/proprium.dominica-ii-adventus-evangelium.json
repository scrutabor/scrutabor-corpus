  "text": "proprium.dominica-ii-adventus-evangelium",
  "lang": "pl",
  "status": "working-edition",
  "about": "Ewangelia II Niedzieli Adwentu. Jan Chrzciciel, już w więzieniu, posyła zapytać, czy to Ten. Odpowiedź nie jest twierdzeniem, lecz listą tego, co widać, i kończy się słowem o samym Janie.",
  "analysis_defaults": { "confidence": "high", "sources": ["editorial"], "review": "pending" },
  "segments": {
    "s01": { "translation": "W owym czasie: Gdy Jan usłyszał w więzieniu o dziełach Chrystusa, posławszy dwóch spośród uczniów swoich, rzekł Mu:", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Matthew 11:2-10" }] },
    "s02": { "translation": "Tyś jest, który ma przyjść, czy innego oczekujemy?", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Matthew 11:2-10" }] },
    "s03": { "translation": "A Jezus odpowiadając rzekł im: Idźcie i donieście Janowi, coście usłyszeli i widzieli.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Matthew 11:2-10" }] },
    "s04": { "translation": "Ślepi widzą, chromi chodzą, trędowaci bywają oczyszczeni, głusi słyszą, umarli powstają, ubogim głosi się dobrą nowinę: a błogosławiony jest, kto się we mnie nie zgorszy.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Matthew 11:2-10" }] },
    "s05": { "translation": "A gdy oni odchodzili, począł Jezus mówić do rzesz o Janie: Coście wyszli na pustynię oglądać? Trzcinę wiatrem kołysaną?", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Matthew 11:2-10" }] },
    "s06": { "translation": "Ale coście wyszli oglądać? Człowieka w miękkie szaty odzianego?", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Matthew 11:2-10" }] },
    "s07": { "translation": "Oto ci, którzy w miękkie szaty się odziewają, w domach królewskich są.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Matthew 11:2-10" }] },
    "s08": { "translation": "Ale coście wyszli oglądać? Proroka? Zaiste mówię wam, i więcej niż proroka.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Matthew 11:2-10" }] },
    "s09": { "translation": "Ten bowiem jest, o którym napisano: Oto ja posyłam Anioła mego przed obliczem Twoim, który przygotuje drogę Twoją przed Tobą.", "translation_citations": [{ "title": "Biblia Sacra Vulgata", "locator": "Matthew 11:2-10" }] }
  },
