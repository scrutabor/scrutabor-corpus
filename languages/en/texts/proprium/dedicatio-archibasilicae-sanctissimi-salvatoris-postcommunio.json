  "text": "proprium.dedicatio-archibasilicae-sanctissimi-salvatoris-postcommunio",
  "about": "The postcommunio of the formulary “Dedication of the Archbasilica of the Most Holy Savior” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who from living and chosen stones prepare an eternal dwelling for Your majesty, help Your people as they pray to You, that what Your Church gains in material space may be enlarged by spiritual growth. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w008", "w009", "w010", "w011", "w012"], "anchor": "w011", "gloss": "prepare an eternal dwelling for Your majesty" }, { "words": ["w014", "w015"], "anchor": "w014", "gloss": "Your people" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "Your Church" }, { "words": ["w021", "w022", "w023"], "anchor": "w022", "gloss": "gains in physical space" }, { "words": ["w024", "w025", "w026"], "anchor": "w025", "gloss": "may be enlarged by spiritual growth" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "our Lord" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "Your Son" }, { "words": ["w041", "w042"], "anchor": "w041", "gloss": "of the Holy Spirit" }, { "words": ["w044", "w045", "w046", "w047"], "anchor": "w046", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
