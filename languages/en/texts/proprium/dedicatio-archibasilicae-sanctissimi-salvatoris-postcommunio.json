  "text": "proprium.dedicatio-archibasilicae-sanctissimi-salvatoris-postcommunio",
  "about": "The postcommunio of the formulary “Dedication of the Archbasilica of the Most Holy Savior” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who from living and chosen stones prepare an eternal dwelling for Your majesty, help Your people as they pray to You, that what Your Church gains in material space may be enlarged by spiritual growth. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God, world without end.", "alignments": [{ "words": ["w009", "w010"], "anchor": "w009", "gloss": "to Thy Majesty" }] },
    "s02": { "translation": "Amen." }
  },
