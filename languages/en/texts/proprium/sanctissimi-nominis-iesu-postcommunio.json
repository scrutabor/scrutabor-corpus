  "text": "proprium.sanctissimi-nominis-iesu-postcommunio",
  "about": "The postcommunio of the formulary “Most Holy Name of Jesus” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Almighty, everlasting God, who created and redeemed us, look graciously upon our desires and be pleased to receive with a serene and kindly countenance the sacrifice of the saving Victim which we have offered to Your majesty in honor of the name of Your Son, our Lord Jesus Christ, so that, with Your grace poured into us, under the glorious name of Jesus, the sign of eternal predestination, we may rejoice that our names are written in heaven. Through this same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w009", "w010"], "anchor": "w009", "gloss": "look graciously upon" }, { "words": ["w011", "w012"], "anchor": "w011", "gloss": "our desires" }, { "words": ["w017", "w018", "w019", "w020", "w021", "w022", "w023", "w024", "w025", "w026", "w027", "w028", "w029"], "anchor": "w029", "gloss": "which we have offered to Your majesty in honor of the name of Your Son, our Lord Jesus Christ" }, { "words": ["w030", "w031", "w032", "w033", "w034", "w035"], "anchor": "w035", "gloss": "be pleased to receive with a serene and kindly countenance" }, { "words": ["w037", "w038", "w039", "w040"], "anchor": "w040", "gloss": "with Your grace poured into us" }, { "words": ["w045", "w046", "w047"], "anchor": "w047", "gloss": "the sign of eternal predestination" }, { "words": ["w049", "w050"], "anchor": "w049", "gloss": "our names" }, { "words": ["w051", "w052"], "anchor": "w051", "gloss": "are written" }, { "words": ["w056", "w057", "w058", "w059", "w060"], "anchor": "w057", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "Your Son" }, { "words": ["w070", "w071"], "anchor": "w070", "gloss": "of the Holy Spirit" }, { "words": ["w073", "w074", "w075", "w076"], "anchor": "w075", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
