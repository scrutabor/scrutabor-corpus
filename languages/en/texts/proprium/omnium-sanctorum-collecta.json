  "text": "proprium.omnium-sanctorum-collecta",
  "about": "The collecta of the formulary “All Saints” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Almighty, eternal God, Who granted us to honor the merits of all Your Saints in a single solemn festival, bestow on us, we beseech You, through their manifold intercession, that abundance of Your mercy for which we yearn. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w039", "w040"], "anchor": "w039", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
