  "about": "The epistola of the formulary “Dedication of the Archbasilica of the Most Holy Savior” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "In those days, I saw the holy city, the new Jerusalem, descending from heaven, from God, prepared as a bride adorned for her husband. And I heard a loud voice from the throne, saying: Behold the tabernacle of God with people, and He will dwell with them. And they themselves will be His people, and God Himself will be with them as their God; and God will wipe away every tear from their eyes, and death will be no more, nor will there be mourning, crying or pain any longer, because the former things have passed away. And He who was seated on the throne said: Behold, I make all things new.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "those days" }, { "words": ["w005", "w006"], "anchor": "w006", "gloss": "the holy city" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "the new Jerusalem" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "for her husband" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "a loud voice" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "His people" }, { "words": ["w042", "w043"], "anchor": "w043", "gloss": "God Himself" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "God will wipe away" }, { "words": ["w055", "w056"], "anchor": "w055", "gloss": "their eyes" }, { "words": ["w060", "w061"], "anchor": "w061", "gloss": "will not be" }, { "words": ["w080", "w081", "w082"], "anchor": "w081", "gloss": "I make all things new" }] }
  },
