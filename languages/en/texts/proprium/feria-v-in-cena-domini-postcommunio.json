  "text": "proprium.feria-v-in-cena-domini-postcommunio",
  "about": "The postcommunio of the formulary “Holy Thursday — Mass of the Lord’s Supper” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Refreshed by life-giving nourishment, we beseech You, O Lord our God, that what we perform in the time of our mortality we may attain by the gift of Your immortality. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "our God" }, { "words": ["w014", "w015", "w016"], "anchor": "w016", "gloss": "by the gift of Your immortality" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "our Lord" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "Jesus Christ" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Your Son" }, { "words": ["w025", "w026", "w027", "w028", "w029"], "anchor": "w027", "gloss": "who lives and reigns with You" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "of the Holy Spirit" }, { "words": ["w035", "w036", "w037", "w038"], "anchor": "w037", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
