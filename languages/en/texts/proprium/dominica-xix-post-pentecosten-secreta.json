  "text": "proprium.dominica-xix-post-pentecosten-secreta",
  "about": "The secreta of the formulary “19th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, we beseech You, O Lord, that these gifts which we offer in the sight of Your majesty may be the means of our salvation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God," },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
