  "text": "proprium.dominica-ii-post-pascha-postcommunio",
  "about": "The postcommunio of the formulary “Second Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Almighty God, we ask You to grant that, receiving the grace of Your life-giving work, we may always glory in Your gift. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002", "w003"], "anchor": "w001", "gloss": "Grant us, we ask" }, { "words": ["w007", "w008", "w009", "w010"], "anchor": "w010", "gloss": "receiving the grace of Your life-giving work" }, { "words": ["w011", "w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "we may always glory in Your gift" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "our Lord" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "Your Son" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "of the Holy Spirit" }, { "words": ["w033", "w034", "w035", "w036"], "anchor": "w035", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
