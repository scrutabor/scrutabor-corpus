  "about": "The collecta of the formulary “Second Sunday after Epiphany” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Almighty, everlasting God, who govern heavenly and earthly things alike, mercifully hear the supplications of Your people and grant Your peace in our times. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006", "w007", "w008", "w009"], "anchor": "w009", "gloss": "govern heavenly and earthly things alike" }, { "words": ["w011", "w012"], "anchor": "w011", "gloss": "of Your people" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "Your peace" }, { "words": ["w018", "w019", "w020"], "anchor": "w019", "gloss": "grant to our times" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "our Lord" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Your Son" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }, { "words": ["w038", "w039", "w040", "w041"], "anchor": "w040", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
