  "text": "proprium.dominica-i-in-quadragesima-collecta",
  "about": "The collecta of the formulary “First Sunday of Lent” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who purify Your Church by the yearly observance of Lent, grant to Your household that what it strives to obtain from You by abstinence it may accomplish by good works. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w003", "w004"], "anchor": "w003", "gloss": "Your Church" }, { "words": ["w005", "w006", "w007"], "anchor": "w007", "gloss": "by the yearly Lenten observance" }, { "words": ["w010", "w011"], "anchor": "w010", "gloss": "to Your household" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "our Lord" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Jesus Christ" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "Your Son" }, { "words": ["w030", "w031", "w032", "w033", "w034"], "anchor": "w032", "gloss": "who lives and reigns with You" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "of the Holy Spirit" }, { "words": ["w040", "w041", "w042", "w043"], "anchor": "w042", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
