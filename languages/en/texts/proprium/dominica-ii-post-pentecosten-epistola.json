  "segments": {
    "s01": { "translation": "Dearly beloved: Do not be astonished if the world hates you. We ourselves know that we have been brought over from death to life, since we love the brethren. Whoever does not love remains in death. Anyone who hates his brother is a murderer. You know, too, that no murderer has eternal life remaining in himself. By this we know the love of God: He laid down His life for us, and we must lay down our lives for the brethren. Whoever has this world's goods, and sees that his brother is in need, and shuts off his compassion from him, how does the love of God remain in him? My little children, let us not love with words, nor with our tongues, but in action and in truth.", "alignments": [{ "words": ["w011", "w012"], "anchor": "w011", "gloss": "have passed" }, { "words": ["w038", "w039"], "anchor": "w039", "gloss": "has no" }] }
  },
