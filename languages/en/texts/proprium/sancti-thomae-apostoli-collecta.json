  "text": "proprium.sancti-thomae-apostoli-collecta",
  "about": "The collecta of the formulary “Saint Thomas the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord, grant us, we beseech You, to glory in the feast-day of blessed Thomas, Your Apostle, that we may always be helped by his patronage and follow the faith with fitting devotion. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006", "w007", "w008", "w009"], "anchor": "w009", "gloss": "in the solemnities of blessed Thomas, Your Apostle" }, { "words": ["w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "both by his patronage always" }, { "words": ["w019", "w020"], "anchor": "w020", "gloss": "with fitting devotion" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Jesus Christ" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your Son" }, { "words": ["w029", "w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "who lives and reigns with You" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }, { "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
