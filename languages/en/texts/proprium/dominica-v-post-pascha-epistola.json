  "about": "The epistola of the formulary “Fifth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Dearly beloved: Be doers of the word and not hearers only, deceiving yourselves. For if anyone is a hearer of the word and not a doer, he will be likened to a man beholding his natural face in a mirror: for he beheld himself and went away, and immediately forgot what he was like. But he who has looked into the perfect law of liberty and has continued in it, becoming not a forgetful hearer but a doer of the work, this man will be blessed in his deed. And if anyone thinks himself religious, not bridling his tongue but deceiving his own heart, this man’s religion is vain. Religion pure and undefiled before God and the Father is this: to visit orphans and widows in their tribulation, and to keep oneself unspotted from this world.", "alignments": [{ "words": ["w014", "w015"], "anchor": "w015", "gloss": "is a hearer" }, { "words": ["w024", "w025", "w026"], "anchor": "w024", "gloss": "his natural face" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "for he beheld" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "forgot" }, { "words": ["w038", "w039"], "anchor": "w039", "gloss": "what he was like" }, { "words": ["w044", "w045", "w046"], "anchor": "w044", "gloss": "the perfect law of liberty" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "his deed" }, { "words": ["w068", "w069", "w070"], "anchor": "w070", "gloss": "himself to be religious" }, { "words": ["w073", "w074"], "anchor": "w073", "gloss": "his tongue" }, { "words": ["w077", "w078"], "anchor": "w077", "gloss": "his own heart" }, { "words": ["w079", "w080", "w081", "w082"], "anchor": "w081", "gloss": "this man’s religion is vain" }, { "words": ["w091", "w092"], "anchor": "w092", "gloss": "is this" }, { "words": ["w098", "w099"], "anchor": "w098", "gloss": "their tribulation" }, { "words": ["w101", "w102", "w103"], "anchor": "w103", "gloss": "to keep oneself unspotted" }] }
  },
