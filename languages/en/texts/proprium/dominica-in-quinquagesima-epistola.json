  "about": "The epistola of the formulary “Quinquagesima Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Brothers: If I speak in the tongues of men and angels but have no love, I have become like sounding brass or a tinkling cymbal. And even if I have prophecy and know all mysteries and all knowledge, and even if I have all faith so that I can move mountains, but have no love, I am nothing. And even if I distribute all my possessions to feed the poor, and even if I hand over my body so that I may burn, but have no love, it profits me nothing. Love is patient and kind; love does not envy, does not act wrongly, is not puffed up, does not seek prestige, does not seek its own interests, is not provoked, does not harbor evil thoughts, does not rejoice in iniquity, but rejoices with the truth. It bears all things, believes all things, hopes all things, endures all things. Love never falls away: if there are prophecies, they will be made void; if there are tongues, they will cease; if there is knowledge, it will be destroyed. For we know in part and we prophesy in part. But when what is perfect comes, what is partial will be done away. When I was a child, I spoke as a child, I understood as a child, I thought as a child. But when I became a man, I put away what belonged to childhood. Now we see through a mirror, in an obscure manner, but then face to face. Now I know in part, but then I will know even as I have been known. But now faith, hope and love remain, these three; but the greatest of these is love.", "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w005", "gloss": "I speak with the tongues of men" }, { "words": ["w008", "w009", "w010", "w011"], "anchor": "w008", "gloss": "but have no love" }, { "words": ["w012", "w013"], "anchor": "w012", "gloss": "I have become" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "sounding brass" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "a tinkling cymbal" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "all mysteries" }, { "words": ["w036", "w037", "w038", "w039"], "anchor": "w036", "gloss": "so that I can move mountains" }, { "words": ["w040", "w041", "w042", "w043"], "anchor": "w040", "gloss": "but have no love" }, { "words": ["w044", "w045"], "anchor": "w045", "gloss": "I am nothing" }, { "words": ["w052", "w053", "w054"], "anchor": "w052", "gloss": "all my possessions" }, { "words": ["w058", "w059"], "anchor": "w058", "gloss": "my body" }, { "words": ["w063", "w064", "w065", "w066"], "anchor": "w063", "gloss": "but have no love" }, { "words": ["w067", "w068", "w069"], "anchor": "w067", "gloss": "it profits me nothing" }, { "words": ["w071", "w072"], "anchor": "w071", "gloss": "is patient" }, { "words": ["w073", "w074"], "anchor": "w073", "gloss": "and is kind" }, { "words": ["w076", "w077"], "anchor": "w076", "gloss": "does not envy" }, { "words": ["w078", "w079"], "anchor": "w078", "gloss": "does not act" }, { "words": ["w081", "w082"], "anchor": "w081", "gloss": "is not puffed up" }, { "words": ["w083", "w084", "w085"], "anchor": "w083", "gloss": "does not seek prestige" }, { "words": ["w086", "w087", "w088", "w089", "w090"], "anchor": "w086", "gloss": "does not seek its own interests" }, { "words": ["w091", "w092"], "anchor": "w091", "gloss": "is not provoked" }, { "words": ["w093", "w094", "w095"], "anchor": "w093", "gloss": "does not harbor evil thoughts" }, { "words": ["w096", "w097"], "anchor": "w096", "gloss": "does not rejoice" }, { "words": ["w100", "w101", "w102"], "anchor": "w100", "gloss": "but rejoices with the truth" }, { "words": ["w103", "w104"], "anchor": "w103", "gloss": "bears all things" }, { "words": ["w105", "w106"], "anchor": "w105", "gloss": "believes all things" }, { "words": ["w107", "w108"], "anchor": "w107", "gloss": "hopes all things" }, { "words": ["w109", "w110"], "anchor": "w109", "gloss": "endures all things" }, { "words": ["w114", "w115", "w116"], "anchor": "w114", "gloss": "if there are prophecies, they will be made void" }, { "words": ["w117", "w118", "w119"], "anchor": "w117", "gloss": "if there are tongues, they will cease" }, { "words": ["w120", "w121", "w122"], "anchor": "w120", "gloss": "if there is knowledge, it will be destroyed" }, { "words": ["w123", "w124", "w125"], "anchor": "w123", "gloss": "For in part" }, { "words": ["w131", "w132", "w133", "w134", "w135", "w136"], "anchor": "w131", "gloss": "But when what is perfect comes" }, { "words": ["w137", "w138", "w139", "w140", "w141"], "anchor": "w137", "gloss": "what is partial will be done away" }, { "words": ["w154", "w155"], "anchor": "w154", "gloss": "But when" }, { "words": ["w156", "w157", "w158"], "anchor": "w156", "gloss": "I became a man" }, { "words": ["w167", "w168"], "anchor": "w167", "gloss": "in an obscure manner" }, { "words": ["w169", "w170"], "anchor": "w169", "gloss": "but then" }, { "words": ["w171", "w172", "w173"], "anchor": "w171", "gloss": "face to face" }, { "words": ["w178", "w179"], "anchor": "w178", "gloss": "but then" }, { "words": ["w181", "w182", "w183", "w184"], "anchor": "w181", "gloss": "even as I have been known" }, { "words": ["w185", "w186"], "anchor": "w185", "gloss": "But now" }, { "words": ["w187", "w188", "w189", "w190"], "anchor": "w187", "gloss": "faith, hope and love remain" }, { "words": ["w191", "w192"], "anchor": "w191", "gloss": "these three" }, { "words": ["w193", "w194", "w195", "w196", "w197"], "anchor": "w193", "gloss": "but the greatest of these is love" }] }
