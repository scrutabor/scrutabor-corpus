  "text": "proprium.dominica-iv-adventus-introitus",
  "about": "The introit of the Fourth Sunday of Advent, the antiphon the Roráte Masses of Advent are named from. It returns after the psalm verse and the Glória Patri, as the missal directs.",
  "segments": {
    "s01": { "translation": "Drop down dew, O heavens, from above, and let the clouds rain down the Just One; let the earth open and bring forth the Savior.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 105", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w005", "w006"], "anchor": "w006", "gloss": "let the clouds rain down" }, { "words": ["w008", "w009"], "anchor": "w008", "gloss": "let the earth be opened" }] },
    "s02": { "translation": "The heavens recount God’s glory, and the firmament announces the works of His hands.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "parallel Ordinary and Advent propers, examined edition", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w019", "w020"], "anchor": "w019", "gloss": "of His hands" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "the firmament announces" }] },
    "s03": { "translation": "Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 37", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w028", "w029"], "anchor": "w028", "gloss": "to the Holy Spirit" }] },
    "s04": { "narrative": "After the doxology the Introit antiphon is repeated from Roráte to the psalm verse — by the choir at a sung Mass, by the priest himself at a low Mass." },
    "s05": { "translation": "Drop down dew, O heavens, from above, and let the clouds rain down the Just One; let the earth open and bring forth the Savior.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 105", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w047", "w048"], "anchor": "w048", "gloss": "let the clouds rain down" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "let the earth be opened" }] }
  },
