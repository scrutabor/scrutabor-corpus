  "text": "proprium.corporis-christi-secreta",
  "about": "The Secret of the feast of the Most Holy Body of Christ. It asks for the gifts of unity and peace for the Church, mystically signified under the offered gifts.",
  "segments": {
    "s01": { "translation": "Graciously grant, we beseech Thee, O Lord, to Thy Church the gifts of unity and peace which are mystically signified beneath the offerings presented. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God,", "alignments": [{ "words": ["w018", "w019"], "anchor": "w018", "gloss": "our Lord" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "Jesus Christ" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Thy Son" }, { "words": ["w024", "w025", "w026", "w027", "w028"], "anchor": "w026", "gloss": "who liveth and reigneth with Thee" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "of the Holy Ghost" }] },
    "s02": { "translation": "world without end.", "alignments": [{ "words": ["w034", "w035", "w036", "w037"], "anchor": "w036", "gloss": "world without end" }] },
    "s03": { "translation": "Amen." }
  },
