  "text": "proprium.corporis-christi-secreta",
  "about": "The Secret of the feast of the Most Holy Body of Christ. It asks for the gifts of unity and peace for the Church, mystically signified under the offered gifts.",
  "segments": {
    "s01": { "translation": "Graciously grant, we pray, Lord, to Your Church the gifts of unity and peace which are mystically signified under the offered gifts. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "To Your Church" }, { "words": ["w005", "w006", "w007"], "anchor": "w005", "gloss": "of unity and peace" }, { "words": ["w012", "w013", "w014"], "anchor": "w014", "gloss": "under the offered gifts" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "our Lord" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "Jesus Christ" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Your Son" }, { "words": ["w024", "w025", "w026", "w027", "w028"], "anchor": "w026", "gloss": "who lives and reigns with You" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w034", "w035", "w036", "w037"], "anchor": "w036", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
