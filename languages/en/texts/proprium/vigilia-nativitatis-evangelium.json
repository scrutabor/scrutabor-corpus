  "text": "proprium.vigilia-nativitatis-evangelium",
  "about": "The evangelium of the formulary “Vigil of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "When Mary, the mother of Jesus, was betrothed to Joseph, before they came together she was found with child by the Holy Spirit. But Joseph her husband, being a just man and not willing to expose her, was minded to put her away privately. While he was thinking on these things, behold, an Angel of the Lord appeared to him in his sleep, saying: Joseph, son of David, do not fear to take Mary your wife, for that which is conceived in her is of the Holy Spirit. And she will bring forth a Son, and you will call His name Jesus, for He will save His people from their sins.", "alignments": [{ "words": ["w010", "w011"], "anchor": "w010", "gloss": "she was found" }, { "words": ["w012", "w013", "w014"], "anchor": "w014", "gloss": "with child" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "the Holy Spirit" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "her husband" }, { "words": ["w026", "w027", "w028"], "anchor": "w026", "gloss": "not willing to expose her" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "to put her away" }, { "words": ["w033", "w034", "w035", "w036"], "anchor": "w036", "gloss": "But while he was thinking on these things" }, { "words": ["w052", "w053"], "anchor": "w052", "gloss": "your wife" }, { "words": ["w054", "w055"], "anchor": "w054", "gloss": "for that which" }, { "words": ["w058", "w059"], "anchor": "w058", "gloss": "has been begotten" }, { "words": ["w060", "w061", "w062", "w063"], "anchor": "w063", "gloss": "is of the Holy Spirit" }, { "words": ["w064", "w065", "w066"], "anchor": "w064", "gloss": "and she will bring forth a Son" }, { "words": ["w069", "w070"], "anchor": "w069", "gloss": "His name" }, { "words": ["w072", "w073", "w074", "w075"], "anchor": "w075", "gloss": "for He Himself will save" }, { "words": ["w076", "w077"], "anchor": "w076", "gloss": "His people" }, { "words": ["w079", "w080"], "anchor": "w079", "gloss": "their sins" }] }
  },
