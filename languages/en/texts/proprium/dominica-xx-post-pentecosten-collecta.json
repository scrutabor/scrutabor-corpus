  "segments": {
    "s01": { "translation": "O Lord, we beseech You, graciously grant Your faithful forgiveness and peace, that they may be cleansed of all sin and serve You with minds free from care. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w012", "w013", "w014", "w015"], "anchor": "w014", "gloss": "may be cleansed of all offenses" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "our Lord" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Your Son" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
