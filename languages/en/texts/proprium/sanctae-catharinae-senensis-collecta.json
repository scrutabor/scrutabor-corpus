  "text": "proprium.sanctae-catharinae-senensis-collecta",
  "about": "On Catherine of Siena’s feast, we ask to rejoice in its yearly celebration and to grow through the example of her great virtue.",
  "segments": {
    "s01": { "translation": "Almighty God, grant, we pray, that we who celebrate the feast of blessed Catherine, Your virgin, may both rejoice in its annual celebration and grow by her example of such great virtue. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w003", "w004"], "anchor": "w004", "gloss": "almighty God" }, { "words": ["w007", "w008", "w009", "w010", "w011"], "anchor": "w011", "gloss": "the feast of blessed Catherine, Your virgin" }, { "words": ["w014", "w015"], "anchor": "w015", "gloss": "in the annual celebration" }, { "words": ["w018", "w019", "w020", "w021"], "anchor": "w020", "gloss": "grow by the example of such great virtue" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Jesus Christ" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your Son" }, { "words": ["w029", "w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "who lives and reigns with You" }, { "words": ["w034", "w035"], "anchor": "w035", "gloss": "in the unity" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }, { "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
