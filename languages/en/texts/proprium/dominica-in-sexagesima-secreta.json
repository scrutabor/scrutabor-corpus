  "text": "proprium.dominica-in-sexagesima-secreta",
  "about": "The secreta of the formulary “Sexagesima Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May the sacrifice offered to You, O Lord, always give us life and strengthen us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002", "w003", "w004"], "anchor": "w004", "gloss": "May the sacrifice offered to You, Lord," }, { "words": ["w005", "w006", "w007"], "anchor": "w005", "gloss": "always give us life" }, { "words": ["w011", "w012"], "anchor": "w011", "gloss": "our Lord" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "Your Son" }, { "words": ["w018", "w019", "w020", "w021"], "anchor": "w019", "gloss": "lives and reigns with You" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w027", "w028", "w029", "w030"], "anchor": "w027", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
