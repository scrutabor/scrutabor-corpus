  "text": "proprium.sancta-familia-secreta",
  "about": "The secreta of the formulary “Holy Family of Jesus, Mary, and Joseph” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We offer You, O Lord, a sacrifice of propitiation, humbly beseeching that through the intercession of the Virgin Mother of God together with blessed Joseph You may firmly establish our families in Your peace and grace. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002"], "anchor": "w002", "gloss": "A sacrifice of propitiation" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "our families" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "Your grace" }, { "words": ["w025", "w026", "w027", "w028", "w029"], "anchor": "w026", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "Your Son" }, { "words": ["w032", "w033", "w034", "w035", "w036"], "anchor": "w034", "gloss": "who lives and reigns with You" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w042", "w043", "w044", "w045"], "anchor": "w044", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
