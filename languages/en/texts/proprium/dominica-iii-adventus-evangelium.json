  "text": "proprium.dominica-iii-adventus-evangelium",
  "about": "The gospel of the Third Sunday of Advent. The delegation from Jerusalem asks three times, and John’s answers grow shorter each time: I am not the Christ, I am not, no. Only after that does he say who he is, and he says it in Isaiah’s words. The Bethania of the last sentence lies beyond the Jordan and is not the one near Jerusalem where Martha and Mary lived.",
  "segments": {
    "s01": { "translation": "At that time the Jews sent priests and Levites from Jerusalem to John to ask him:", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 93–94", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "the Jews sent" }] },
    "s02": { "translation": "Who are you?", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 93–94", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s03": { "translation": "He confessed and did not deny, but confessed: I am not the Christ.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 93–94", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w020", "w021"], "anchor": "w020", "gloss": "he confessed" }, { "words": ["w023", "w024"], "anchor": "w024", "gloss": "did not deny" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "confessed" }, { "words": ["w028"], "reason": "punctuation" }, { "words": ["w029", "w030", "w031"], "anchor": "w030", "gloss": "I am not" }] },
    "s04": { "translation": "They asked him: What then? Are you Elijah?", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 93–94", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w038", "w039", "w040"], "anchor": "w039", "gloss": "Are you Elijah" }] },
    "s05": { "translation": "He said: I am not. Are you the prophet? He answered: No.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 93–94", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w043", "w044"], "anchor": "w044", "gloss": "I am not" }, { "words": ["w045", "w046", "w047"], "anchor": "w046", "gloss": "Are you the prophet" }] },
    "s06": { "translation": "They said therefore to him: Who are you, that we may give an answer to those who sent us? What do you say of yourself?", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 93–94", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w066", "w067"], "anchor": "w066", "gloss": "yourself" }] },
    "s07": { "translation": "He said: I am the voice of one crying in the wilderness: Make straight the way of the Lord, as the prophet Isaiah said.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 93–94", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s08": { "translation": "Those who had been sent were from among the Pharisees.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 93–94", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w083", "w084"], "anchor": "w084", "gloss": "had been sent" }] },
    "s09": { "translation": "They asked him: Why then do you baptize, if you are not the Christ, nor Elijah, nor the prophet?", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 93–94", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w099", "w100"], "anchor": "w100", "gloss": "are not" }] },
    "s10": { "translation": "John answered them, saying: I baptize in water; yet in your midst there has stood One you do not know.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "parallel Ordinary and Advent propers, examined edition", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w106", "w107", "w108"], "anchor": "w106", "gloss": "John answered them" }, { "words": ["w114", "w115", "w116"], "anchor": "w114", "gloss": "but among you" }] },
    "s11": { "translation": "It is He who will come after me, who was set before me, and I am not worthy to unfasten the strap of His shoe.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "parallel Ordinary and Advent propers, examined edition", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w126", "w127"], "anchor": "w126", "gloss": "is to come" }, { "words": ["w131", "w132"], "anchor": "w131", "gloss": "was set" }, { "words": ["w135", "w136"], "anchor": "w136", "gloss": "am not" }] },
    "s12": { "translation": "These things were done in Bethania beyond the Jordan, where John was baptizing.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 93–94", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w146", "w147"], "anchor": "w146", "gloss": "were done" }, { "words": ["w151", "w152"], "anchor": "w151", "gloss": "John was" }] }
  },
