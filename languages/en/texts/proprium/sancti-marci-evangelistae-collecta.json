  "about": "The collecta of the formulary “Saint Mark the Evangelist” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who exalted blessed Mark, Your Evangelist, by the grace of preaching the Gospel: grant, we beseech You, that we may always profit by his teaching and be defended by his prayer. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006"], "anchor": "w005", "gloss": "Your Evangelist" }, { "words": ["w007", "w008", "w009"], "anchor": "w009", "gloss": "by the grace of Gospel preaching" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your Son" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }, { "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
