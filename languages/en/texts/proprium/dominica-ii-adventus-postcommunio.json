  "text": "proprium.dominica-ii-adventus-postcommunio",
  "about": "The postcommunion of the Second Sunday of Advent. It asks for nothing new, but that the food just received should change the judgment of things — what to despise and what to love.",
  "segments": {
    "s01": { "translation": "Filled with spiritual food, we humbly ask You, Lord: through our sharing in this mystery, teach us to despise what is earthly and to love what is heavenly. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w021", "w022"], "anchor": "w021", "gloss": "our Lord" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Jesus Christ" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Thy Son" }, { "words": ["w027", "w028", "w029", "w030", "w031"], "anchor": "w029", "gloss": "who liveth and reigneth with Thee" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Ghost" }, { "words": ["w037", "w038", "w039", "w040"], "anchor": "w039", "gloss": "world without end" }] },
    "s02": { "translation": "Amen." }
  },
