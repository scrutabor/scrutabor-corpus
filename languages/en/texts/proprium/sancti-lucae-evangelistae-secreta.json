  "text": "proprium.sancti-lucae-evangelistae-secreta",
  "about": "The secreta of the formulary “Saint Luke the Evangelist” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "By Your heavenly gifts, grant us, O Lord, we pray, to serve You with a free mind, so that the offerings we present may, through the intercession of blessed Luke, Your Evangelist, bring us both healing and glory. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God," },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
