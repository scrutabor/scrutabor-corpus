  "text": "proprium.in-octava-nativitatis-collecta",
  "about": "The collecta of the formulary “Octave Day of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who through the fruitful virginity of blessed Mary have bestowed upon mankind the rewards of eternal salvation, grant, we beseech You, that we may feel her intercession for us, through whom we merited to receive the Author of life, our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w003", "w004", "w005", "w006", "w007", "w008", "w009", "w010", "w011"], "anchor": "w011", "gloss": "the rewards of eternal salvation, through the fruitful virginity of blessed Mary, to the human race" }, { "words": ["w016", "w017", "w018", "w019", "w020"], "anchor": "w020", "gloss": "may feel that she herself intercedes for us" }, { "words": ["w024", "w025", "w026"], "anchor": "w026", "gloss": "to receive the Author of life" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "our Lord" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "Jesus Christ" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "Your Son" }, { "words": ["w033", "w034", "w035", "w036", "w037"], "anchor": "w035", "gloss": "who lives and reigns with You" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "of the Holy Spirit" }, { "words": ["w043", "w044", "w045", "w046"], "anchor": "w045", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
