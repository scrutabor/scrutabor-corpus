  "about": "The introitus of the formulary “Third Sunday after Epiphany” in the 1962 Roman Missal. Page 45 prints the proper text and short cues. The full doxology comes from page 1 and the antiphon repetition follows the cue and RG427.",
  "segments": {
    "s01": { "translation": "Adore God, all His Angels. Sion heard and was glad, and the daughters of Juda rejoiced. The Lord reigns; let the earth rejoice, let the many islands be glad. Glory be to the Father, and to the Son, and to the Holy Ghost. As it was in the beginning, is now, and ever shall be, world without end. Amen. Adore God, all His Angels. Sion heard and was glad, and the daughters of Juda rejoiced.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "His Angels" }, { "words": ["w006", "w007", "w008", "w009", "w010"], "anchor": "w006", "gloss": "Sion heard and was glad" }, { "words": ["w012", "w013", "w014"], "anchor": "w012", "gloss": "the daughters of Juda rejoiced" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "let the earth rejoice" }, { "words": ["w019", "w020", "w021"], "anchor": "w019", "gloss": "let the many islands be glad" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "to the Holy Spirit" }, { "words": ["w045", "w046"], "anchor": "w045", "gloss": "His Angels" }, { "words": ["w047", "w048", "w049", "w050", "w051"], "anchor": "w047", "gloss": "Sion heard and was glad" }, { "words": ["w053", "w054", "w055"], "anchor": "w053", "gloss": "the daughters of Juda rejoiced" }] }
