  "text": "proprium.ascensio-domini-secreta",
  "about": "The secreta of the formulary “Ascension of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Receive, O Lord, the gifts which we offer for the glorious Ascension of Your Son, and graciously grant that we may be delivered from present dangers and attain to everlasting life. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "of Your Son" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w042", "w043", "w044", "w045"], "anchor": "w044", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
