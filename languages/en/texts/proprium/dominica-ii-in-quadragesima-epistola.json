  "about": "The epistola of the formulary “Second Sunday of Lent” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Brethren: We ask and beseech you in the Lord Jesus that, as you have received from us how you ought to walk and to please God, so also you would walk, that you may abound the more. For you know what precepts I have given you by the Lord Jesus. For this is the will of God, your sanctification: that you should abstain from fornication; that every one of you should know how to possess his vessel in sanctification and honor, not in the passion of lust like the Gentiles who do not know God; and that no man overreach or defraud his brother in business, because the Lord is the avenger of all these things, as we have told you before and have testified. For God has not called us to uncleanness, but to sanctification, in Christ Jesus our Lord.", "alignments": [{ "words": ["w015", "w016"], "anchor": "w015", "gloss": "you ought" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "For you know" }, { "words": ["w036", "w037", "w038"], "anchor": "w037", "gloss": "For this is" }, { "words": ["w041", "w042"], "anchor": "w041", "gloss": "your sanctification" }, { "words": ["w049", "w050", "w051"], "anchor": "w049", "gloss": "each one of you should know" }, { "words": ["w052", "w053", "w054"], "anchor": "w054", "gloss": "how to possess his own vessel" }, { "words": ["w070", "w071"], "anchor": "w071", "gloss": "that no one" }, { "words": ["w077", "w078"], "anchor": "w077", "gloss": "his own brother" }, { "words": ["w083", "w084", "w085"], "anchor": "w083", "gloss": "of all these things" }, { "words": ["w090", "w091"], "anchor": "w090", "gloss": "have testified" }, { "words": ["w092", "w093", "w094", "w095", "w096"], "anchor": "w094", "gloss": "For God has not called us" }, { "words": ["w105", "w106"], "anchor": "w105", "gloss": "our Lord" }] }
  },
