  "about": "The secreta of the formulary “Mass of the Easter Vigil” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Accept, we beseech Thee, O Lord, the prayers of Thy people together with the offerings of sacrifice, that what hath begun with the paschal mysteries may, by Thy working, become for us a remedy unto eternity. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God,", "alignments": [{ "words": ["w005", "w006"], "anchor": "w005", "gloss": "of Thy people" }, { "words": ["w014"], "reason": "inflection" }] },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
