  "text": "proprium.dominica-ii-post-pascha-collecta",
  "about": "The collecta of the formulary “Second Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "God, who through the humility of Your Son raised up the fallen world, grant Your faithful unending joy, so that You may grant those whom You rescued from the perils of everlasting death the enjoyment of everlasting joys. Through the same Jesus Christ, our Lord, Your Son, who, as God, lives and reigns with You in the unity of the Holy Spirit forever and ever.", "alignments": [{ "words": ["w004", "w005", "w006"], "anchor": "w006", "gloss": "the humility of Your Son" }, { "words": ["w007", "w008", "w009"], "anchor": "w009", "gloss": "raised up the fallen world" }, { "words": ["w010", "w011", "w012", "w013", "w014"], "anchor": "w013", "gloss": "grant Your faithful unending joy" }, { "words": ["w017", "w018", "w019", "w020"], "anchor": "w019", "gloss": "You rescued from the perils of everlasting death" }, { "words": ["w021", "w022", "w023", "w024"], "anchor": "w022", "gloss": "may be granted by You the enjoyment of everlasting joys" }, { "words": ["w026", "w027", "w028", "w029", "w030", "w031", "w032"], "anchor": "w027", "gloss": "the same Jesus Christ, our Lord, Your Son" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "of the Holy Spirit" }, { "words": ["w043", "w044", "w045", "w046"], "anchor": "w045", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
