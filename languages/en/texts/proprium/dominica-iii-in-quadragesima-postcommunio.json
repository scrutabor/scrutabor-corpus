  "text": "proprium.dominica-iii-in-quadragesima-postcommunio",
  "about": "The postcommunio of the formulary “Third Sunday of Lent” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We beseech You, O Lord, graciously absolve us from all guilt and danger, whom You grant to partake of so great a mystery. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005", "w006", "w007", "w008", "w009", "w010"], "anchor": "w010", "gloss": "Appeased, we beseech You, Lord, absolve us from all guilt and dangers" }, { "words": ["w012", "w013", "w014", "w015", "w016"], "anchor": "w014", "gloss": "You grant to be partakers of so great a mystery" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "our Lord" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "Jesus Christ" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Your Son" }, { "words": ["w024", "w025", "w026", "w027", "w028"], "anchor": "w026", "gloss": "who lives and reigns with You" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "of the Holy Spirit" }, { "words": ["w034", "w035", "w036", "w037"], "anchor": "w036", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
