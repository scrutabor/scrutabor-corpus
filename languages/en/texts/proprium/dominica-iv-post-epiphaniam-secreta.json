    "s01": { "translation": "Grant, we beseech You, almighty God, that the offered gift of this sacrifice may always cleanse and protect our frailty from all evil. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w006", "w007", "w008", "w009"], "anchor": "w008", "gloss": "the offered gift of this sacrifice" }, { "words": ["w010", "w011", "w012", "w013", "w014", "w015", "w016"], "anchor": "w015", "gloss": "may always cleanse our frailty from all evil" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "our Lord" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "Your Son" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w036", "w037", "w038", "w039"], "anchor": "w038", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
