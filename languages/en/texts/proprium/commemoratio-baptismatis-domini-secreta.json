  "text": "proprium.commemoratio-baptismatis-domini-secreta",
  "about": "The secreta of the formulary “Commemoration of the Baptism of Our Lord Jesus Christ” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We bring offerings to You, O Lord, for the manifestation of Your newborn Son, humbly beseeching that, as He is the author of our gifts, so He may also be merciful and receive them, Jesus Christ our Lord, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w005", "w006", "w007", "w008"], "anchor": "w008", "gloss": "the manifestation of Your newborn Son" }, { "words": ["w015", "w016", "w017", "w018"], "anchor": "w016", "gloss": "is the author of our gifts" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "may He be" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "our Lord" }, { "words": ["w029", "w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "who lives and reigns with You" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
