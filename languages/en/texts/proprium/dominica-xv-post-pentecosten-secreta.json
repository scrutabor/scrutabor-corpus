  "text": "proprium.dominica-xv-post-pentecosten-secreta",
  "about": "The secreta of the formulary “15th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May Your sacrament, O Lord, always keep us and guard us from the assaults of the devil. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God," },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
