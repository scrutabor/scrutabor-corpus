  "text": "proprium.litaniae-maiores-collecta",
  "about": "The collect for the commemoration of the Greater Litanies in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, we pray, almighty God, that we who in our affliction trust in Your compassion may always be shielded by Your protection against all adversity. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w008", "w009"], "anchor": "w008", "gloss": "our affliction" }, { "words": ["w010", "w011", "w012", "w013"], "anchor": "w013", "gloss": "trust in Your compassion" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "all adversity" }, { "words": ["w017", "w018", "w019", "w020"], "anchor": "w020", "gloss": "may always be shielded by Your protection" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "our Lord" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Your Son" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }, { "words": ["w038", "w039", "w040", "w041"], "anchor": "w040", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
