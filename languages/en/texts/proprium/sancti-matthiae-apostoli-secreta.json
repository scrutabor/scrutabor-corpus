  "text": "proprium.sancti-matthiae-apostoli-secreta",
  "about": "The secreta of the formulary “Saint Matthias the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May the prayer of Your holy Apostle Matthias, O Lord, accompany the sacrificial gifts which we offer to be hallowed in Your name, so that we may obtain pardon and protection. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
