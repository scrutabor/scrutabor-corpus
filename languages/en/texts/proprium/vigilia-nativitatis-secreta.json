  "about": "The secreta of the formulary “Vigil of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant us, we beseech You, almighty God, that as we anticipate the adorable birth of Your Son, so we may joyfully receive His everlasting gifts. Who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w008", "w009", "w010", "w011"], "anchor": "w011", "gloss": "the adorable birth feast of Your Son" }, { "words": ["w014", "w015", "w016", "w017"], "anchor": "w016", "gloss": "we may receive His everlasting gifts" }, { "words": ["w019", "w020", "w021", "w022", "w023"], "anchor": "w021", "gloss": "Who lives and reigns with You" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w029", "w030", "w031", "w032"], "anchor": "w031", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
