  "text": "proprium.sanctissimae-trinitatis-collecta",
  "about": "The collect of the feast of the Most Holy Trinity. It joins confession of true faith in the Trinity to adoration of the unity of the divine majesty and asks that steadfast faith protect the faithful.",
  "segments": {
    "s01": { "translation": "Almighty, everlasting God, who have granted Your servants, in the confession of the true faith, to acknowledge the glory of the eternal Trinity and in the power of majesty to adore the Unity: we ask that, by the steadfastness of that same faith, we may always be defended from all adversities. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "Your servants" }, { "words": ["w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "to acknowledge the glory of the eternal Trinity" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "we ask that" }, { "words": ["w024", "w025", "w026"], "anchor": "w026", "gloss": "by the steadfastness of that same faith" }, { "words": ["w027", "w028", "w029", "w030", "w031"], "anchor": "w030", "gloss": "we may always be defended from all adversities" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "our Lord" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "Your Son" }, { "words": ["w039", "w040", "w041", "w042", "w043"], "anchor": "w041", "gloss": "who lives and reigns with You" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "of the Holy Spirit" }, { "words": ["w049", "w050", "w051", "w052"], "anchor": "w051", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
