  "text": "proprium.sanctissimae-trinitatis-collecta",
  "about": "The collect of the feast of the Most Holy Trinity. It joins confession of true faith in the Trinity to adoration of the unity of the divine majesty and asks that steadfast faith protect the faithful.",
  "segments": {
    "s01": { "translation": "Almighty, everlasting God, who have given Your servants, in the confession of the true faith, to acknowledge the glory of the eternal Trinity and in the power of majesty to adore the Unity: we beseech You that, by the steadfastness of that same faith, we may ever be defended from all adversities. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w046", "w047"], "anchor": "w046", "gloss": "of the Holy Spirit" }, { "words": ["w049", "w050", "w051", "w052"], "anchor": "w051", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
