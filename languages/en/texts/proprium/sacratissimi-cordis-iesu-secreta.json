  "text": "proprium.sacratissimi-cordis-iesu-secreta",
  "about": "The Secret of the feast of the Most Sacred Heart of Jesus. It asks that the ineffable charity of the beloved Son's Heart make the offering acceptable to God and an expiation for sins.",
  "segments": {
    "s01": { "translation": "Look, we beseech Thee, O Lord, upon the ineffable charity of the Heart of Thy beloved Son, that what we offer may be an acceptable gift to Thee and an expiation for our sins. Through the same our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God,", "alignments": [{ "words": ["w023", "w024", "w025", "w026", "w027"], "anchor": "w024", "gloss": "the same our Lord Jesus Christ" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "Thy Son" }, { "words": ["w030", "w031", "w032", "w033", "w034"], "anchor": "w032", "gloss": "who liveth and reigneth with Thee" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "of the Holy Ghost" }] },
    "s02": { "translation": "world without end.", "alignments": [{ "words": ["w040", "w041", "w042", "w043"], "anchor": "w042", "gloss": "world without end" }] },
    "s03": { "translation": "Amen." }
  },
