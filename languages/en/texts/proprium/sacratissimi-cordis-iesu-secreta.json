  "text": "proprium.sacratissimi-cordis-iesu-secreta",
  "about": "The Secret of the feast of the Most Sacred Heart of Jesus. It asks that the ineffable charity of the beloved Son’s Heart make the offering acceptable to God and an expiation for sins.",
  "segments": {
    "s01": { "translation": "Look, we pray, Lord, upon the ineffable charity of the Heart of Your beloved Son, that what we offer may be an acceptable gift to You and an expiation for our sins. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w007", "w008", "w009"], "anchor": "w008", "gloss": "of Your beloved Son" }, { "words": ["w019", "w020", "w021"], "anchor": "w020", "gloss": "expiation for our sins" }, { "words": ["w023", "w024", "w025", "w026", "w027"], "anchor": "w024", "gloss": "the same Jesus Christ, our Lord" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "Your Son" }, { "words": ["w030", "w031", "w032", "w033", "w034"], "anchor": "w032", "gloss": "who lives and reigns with You" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w040", "w041", "w042", "w043"], "anchor": "w042", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
