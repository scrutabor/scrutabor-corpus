  "text": "proprium.sanctae-petronillae-postcommunio",
  "about": "Postcommunion for the commemoration of Saint Petronilla.",
  "segments": {
    "s01": { "translation": "You have filled Your household, O Lord, with sacred gifts; always refresh us, we beseech You, through the intercession of her whose solemnity we celebrate.", "alignments": [{ "words": ["w003", "w004"], "anchor": "w003", "gloss": "Your household" }, { "words": ["w005", "w006"], "anchor": "w005", "gloss": "with sacred gifts" }, { "words": ["w007", "w008", "w009", "w010"], "anchor": "w010", "gloss": "always, we beseech You, by her intercession" }] },
    "s02": { "translation": "Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w017", "w018"], "anchor": "w017", "gloss": "our Lord" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "Jesus Christ" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "Your Son" }, { "words": ["w023", "w024", "w025", "w026", "w027"], "anchor": "w025", "gloss": "who lives and reigns with You" }, { "words": ["w028", "w029"], "anchor": "w029", "gloss": "in the unity" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "of the Holy Spirit" }] },
    "s03": { "translation": "forever and ever.", "alignments": [{ "words": ["w033", "w034", "w035", "w036"], "anchor": "w035", "gloss": "forever and ever" }] },
    "s04": { "translation": "Amen." }
  },
