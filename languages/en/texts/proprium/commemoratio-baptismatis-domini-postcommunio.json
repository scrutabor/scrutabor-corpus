  "text": "proprium.commemoratio-baptismatis-domini-postcommunio",
  "about": "The postcommunio of the formulary “Commemoration of the Baptism of Our Lord Jesus Christ” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "With heavenly light, we beseech You, O Lord, always and everywhere go before us, that we may behold with a pure gaze and receive with a worthy disposition the mystery in which You have willed us to share. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w018", "w019", "w020"], "anchor": "w019", "gloss": "we may behold with a pure gaze" }, { "words": ["w022", "w023", "w024"], "anchor": "w023", "gloss": "may receive with a worthy disposition" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "our Lord" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "Jesus Christ" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "Your Son" }, { "words": ["w032", "w033", "w034", "w035", "w036"], "anchor": "w034", "gloss": "who lives and reigns with You" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "of the Holy Spirit" }, { "words": ["w042", "w043", "w044", "w045"], "anchor": "w044", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
