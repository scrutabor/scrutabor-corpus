  "text": "proprium.sancti-ioannis-apostoli-et-evangelistae-collecta",
  "about": "The collecta of the formulary “Saint John, Apostle and Evangelist” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord, graciously shed light upon Your Church, so that, enlightened by the teachings of blessed John, Your Apostle and Evangelist, she may attain to everlasting gifts. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "Your Church" }, { "words": ["w007", "w008", "w009", "w010", "w011", "w012", "w013", "w014"], "anchor": "w013", "gloss": "enlightened by the teachings of blessed John, Your Apostle and Evangelist" }, { "words": ["w015", "w016", "w017", "w018"], "anchor": "w017", "gloss": "she may attain to everlasting gifts" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "our Lord" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Jesus Christ" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "Your Son" }, { "words": ["w026", "w027", "w028", "w029", "w030"], "anchor": "w028", "gloss": "who lives and reigns with You" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "of the Holy Spirit" }, { "words": ["w036", "w037", "w038", "w039"], "anchor": "w038", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
