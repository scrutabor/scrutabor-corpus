  "about": "The introitus of the formulary “Fourth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Sing to the Lord a new song, alleluia, for the Lord has done wonders, alleluia; in the sight of the nations He has revealed His justice, alleluia, alleluia, alleluia. His right hand and His holy arm have worked salvation for Him. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. Sing to the Lord a new song, alleluia, for the Lord has done wonders, alleluia; in the sight of the nations He has revealed His justice, alleluia, alleluia, alleluia.", "alignments": [{ "words": ["w003", "w004"], "anchor": "w003", "gloss": "a new song" }, { "words": ["w008", "w009"], "anchor": "w008", "gloss": "the Lord has done" }, { "words": ["w011", "w012"], "anchor": "w012", "gloss": "in the sight" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "His justice" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "His right hand" }, { "words": ["w025", "w026", "w027"], "anchor": "w025", "gloss": "His holy arm" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "to the Holy Spirit" }, { "words": ["w035", "w036"], "anchor": "w036", "gloss": "As it was" }, { "words": ["w037", "w038"], "anchor": "w038", "gloss": "in the beginning" }, { "words": ["w044", "w045", "w046"], "anchor": "w045", "gloss": "forever and ever" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "a new song" }, { "words": ["w055", "w056"], "anchor": "w055", "gloss": "the Lord has done" }, { "words": ["w058", "w059"], "anchor": "w058", "gloss": "in the sight" }, { "words": ["w062", "w063"], "anchor": "w062", "gloss": "His justice" }] }
