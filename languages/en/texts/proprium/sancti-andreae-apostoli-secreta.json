  "about": "The secreta of the formulary “Saint Andrew the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord, we beseech You, that the holy prayer of blessed Andrew the Apostle may make our sacrifice pleasing to You, so that it may become acceptable through the merits of him in whose honor it is solemnly offered. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "our sacrifice" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Jesus Christ" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your Son" }, { "words": ["w029", "w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "who lives and reigns with You" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
