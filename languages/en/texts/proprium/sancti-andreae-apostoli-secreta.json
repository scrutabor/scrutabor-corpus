  "text": "proprium.sancti-andreae-apostoli-secreta",
  "about": "The secreta of the formulary “Saint Andrew the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord, we beseech You, that the holy prayer of blessed Andrew the Apostle may make our sacrifice pleasing to You, so that it may become acceptable through the merits of him in whose honor it is solemnly offered. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
