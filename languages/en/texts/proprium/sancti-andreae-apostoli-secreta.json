  "text": "proprium.sancti-andreae-apostoli-secreta",
  "about": "The secreta of the formulary “Saint Andrew the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord, we beseech You, that the holy prayer of blessed Andrew the Apostle may make our sacrifice pleasing to You, so that it may become acceptable through the merits of him in whose honor it is solemnly offered. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God," },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
