  "about": "The tractus of the formulary “First Sunday of Lent” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "He who dwells in the help of the Most High will abide in the protection of the God of heaven. He will say to the Lord: You are my upholder and my refuge; my God, I will hope in Him. For He Himself has delivered me from the hunters’ snare, and from the harsh word. He will overshadow you with His shoulders, and under His wings you will hope. His truth will surround you with a shield; you will not be afraid of the dread of night, of the arrow that flies by day, of the trouble that roams in the darkness, of ruin and the noonday demon. At your side a thousand will fall, and ten thousand at your right hand; but it will not come near you. For He has commanded His angels concerning you, that they guard you in all your ways. They will carry you in their hands, so that you never strike your foot against a stone. You will walk on the asp and the basilisk, and you will tread the lion and the dragon underfoot. I will deliver him, because he has hoped in Me; I will shield him, for he has known My name. He will call on Me, and I will answer him; I am with him in affliction. I will rescue him and glorify him; I will fill him with length of days, and I will show him My salvation.", "alignments": [{ "words": ["w036", "w037"], "anchor": "w036", "gloss": "With His shoulders" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "His wings" }, { "words": ["w046", "w047", "w048", "w049"], "anchor": "w046", "gloss": "His truth shall compass you" }, { "words": ["w050", "w051"], "anchor": "w051", "gloss": "you shall not fear" }, { "words": ["w079", "w080"], "anchor": "w079", "gloss": "your right hand" }, { "words": ["w081", "w082"], "anchor": "w081", "gloss": "but to you" }, { "words": ["w083", "w084"], "anchor": "w084", "gloss": "it shall not draw near" }] }
  },
