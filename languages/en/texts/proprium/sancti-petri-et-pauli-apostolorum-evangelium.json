  "about": "The Gospel reading of the formulary “Saints Peter and Paul, Apostles” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At that time, Jesus came to the district of Caesarea Philippi and asked His disciples, “Who do people say the Son of Man is?” They replied, “Some say John the Baptist, others Elijah, and others Jeremiah or one of the prophets.” Jesus said to them, “But who do you say I am?” Simon Peter answered, “You are the Christ, the Son of the living God.” Jesus answered him, “Blessed are you, Simon son of Jonah, for flesh and blood has not revealed this to you, but My Father who is in heaven. And I tell you: you are Peter, and on this rock I will build My Church, and the gates of hell will not prevail against it. And I will give you the keys of the kingdom of heaven. And whatever you bind on earth will also be bound in heaven, and whatever you loose on earth will also be loosed in heaven.”", "alignments": [{ "words": ["w012", "w013"], "anchor": "w012", "gloss": "His disciples" }, { "words": ["w042", "w043", "w044", "w045"], "anchor": "w045", "gloss": "who do you say I am" }, { "words": ["w054", "w055"], "anchor": "w054", "gloss": "of the living God" }, { "words": ["w056", "w057"], "anchor": "w056", "gloss": "And answering" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "Blessed are you" }, { "words": ["w070", "w071"], "anchor": "w071", "gloss": "has not revealed" }, { "words": ["w074", "w075"], "anchor": "w074", "gloss": "My Father" }, { "words": ["w093", "w094"], "anchor": "w093", "gloss": "My Church" }, { "words": ["w098", "w099"], "anchor": "w099", "gloss": "will not prevail" }, { "words": ["w113", "w114"], "anchor": "w113", "gloss": "will be bound" }, { "words": ["w123", "w124"], "anchor": "w123", "gloss": "will be loosed" }] }
