{
  "schema_version": "0.21.0",
  "language": "en",
  "text": "proprium.corporis-christi-sequentia",
  "about": "The Lauda Sion sequence of Saint Thomas Aquinas. It praises Christ present in the Eucharist, expounds transubstantiation, and ends by asking for a share in the banquet of the saints.",
  "segments": {
    "s01": { "translation": "Praise, O Zion, your Savior; praise your Leader and Shepherd in hymns and canticles." },
    "s02": { "translation": "Dare as much as you can, for He is greater than all praise, and you cannot praise Him enough.", "alignments": [{ "words": ["w018", "w019"], "anchor": "w019", "gloss": "than all praise" }, { "words": ["w020", "w021", "w022"], "anchor": "w022", "gloss": "nor can you praise enough" }] },
    "s03": { "translation": "The theme of special praise, the living and life-giving Bread, is set forth today.", "alignments": [{ "words": ["w023", "w024", "w025"], "anchor": "w024", "gloss": "The theme of special praise" }] },
    "s04": { "translation": "At the table of the holy supper He was given to the company of the twelve brethren; this is not doubted.", "alignments": [{ "words": ["w034", "w035", "w036"], "anchor": "w035", "gloss": "the table of the holy supper" }, { "words": ["w037", "w038", "w039"], "anchor": "w037", "gloss": "to the company of twelve brethren" }, { "words": ["w041", "w042"], "anchor": "w042", "gloss": "it is not doubted" }] },
    "s05": { "translation": "Let praise be full and sounding; let the rejoicing of the mind be glad and fitting." },
    "s06": { "translation": "For a solemn day is kept, on which the first institution of this table is recalled.", "alignments": [{ "words": ["w054", "w055", "w056"], "anchor": "w054", "gloss": "For a solemn day" }] },
    "s07": { "translation": "At this table of the new King, the new Pasch of the new law brings the ancient Passover to an end.", "alignments": [{ "words": ["w068", "w069"], "anchor": "w069", "gloss": "of the new King" }, { "words": ["w072", "w073"], "anchor": "w073", "gloss": "of the new law" }] },
    "s08": { "translation": "Newness drives away the old, truth drives away the shadow, and light banishes night." },
    "s09": { "translation": "What Christ did at the supper He commanded to be done in remembrance of Himself.", "alignments": [{ "words": ["w093", "w094", "w095"], "anchor": "w095", "gloss": "in remembrance of Him" }] },
    "s10": { "translation": "Taught by sacred precepts, we consecrate bread and wine into the victim of salvation.", "alignments": [{ "words": ["w097", "w098"], "anchor": "w098", "gloss": "by sacred precepts" }] },
    "s11": { "translation": "A dogma is given to Christians: bread is changed into Flesh, and wine into Blood." },
    "s12": { "translation": "What you do not comprehend or see, a courageous faith confirms beyond the ordinary course of nature.", "alignments": [{ "words": ["w118", "w119"], "anchor": "w119", "gloss": "you do not comprehend" }, { "words": ["w121", "w122"], "anchor": "w122", "gloss": "you do not see" }, { "words": ["w127", "w128"], "anchor": "w128", "gloss": "the order of things" }] },
    "s13": { "translation": "Beneath different appearances—different only as signs, not in reality—extraordinary realities lie hidden." },
    "s14": { "translation": "The Flesh is food and the Blood is drink; yet Christ remains whole beneath either species." },
    "s15": { "translation": "He is not cut, broken, or divided by the receiver; He is received whole." },
    "s16": { "translation": "One receives, a thousand receive; they receive as much as he, and the One received is not consumed." },
    "s17": { "translation": "The good receive and the wicked receive, yet with unequal lot: of life or of destruction." },
    "s18": { "translation": "It is death to the wicked and life to the good; see how unlike is the outcome of an equal reception.", "alignments": [{ "words": ["w188", "w189"], "anchor": "w189", "gloss": "of equal reception" }] },
    "s19": { "translation": "When at last the Sacrament is broken, do not waver, but remember: as much lies beneath the fragment as is covered by the whole." },
    "s20": { "translation": "No division is made in the reality; only the sign is broken, whereby neither the state nor the stature of what is signified is diminished." },
    "s21": { "translation": "Behold the Bread of Angels, made the food of wayfarers; truly the Bread of the children, not to be cast to dogs.", "alignments": [{ "words": ["w232", "w233"], "anchor": "w233", "gloss": "not to be cast" }] },
    "s22": { "translation": "He is foreshadowed in figures: when Isaac is offered, when the paschal lamb is appointed, and when manna is given to the fathers." },
    "s23": { "translation": "Good Shepherd, true Bread, Jesus, have mercy on us. Feed us and guard us; make us behold good things in the land of the living." },
    "s24": { "translation": "You who know and can do all things, who feed us mortals here: make us there Your table companions, fellow heirs, and comrades of the holy citizens. Amen. Alleluia.", "alignments": [{ "words": ["w285", "w286"], "anchor": "w286", "gloss": "of the holy citizens" }] }
  },
