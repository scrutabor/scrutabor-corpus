{
  "schema_version": "0.21.0",
  "language": "en",
  "text": "proprium.corporis-christi-sequentia",
  "about": "The Lauda Sion sequence of Saint Thomas Aquinas. It praises Christ present in the Eucharist, expounds transubstantiation, and ends by asking for a share in the banquet of the saints.",
  "segments": {
    "s01": { "translation": "Praise, O Zion, your Savior; praise your Leader and Shepherd in hymns and canticles." },
    "s02": { "translation": "Dare as much as you can, for He is greater than all praise, and you cannot praise Him enough.", "alignments": [{ "words": ["w018", "w019"], "anchor": "w019", "gloss": "than all praise" }, { "words": ["w020", "w021", "w022"], "anchor": "w022", "gloss": "nor can you praise enough" }] },
    "s03": { "translation": "The theme of special praise, the living and life-giving Bread, is set forth today.", "alignments": [{ "words": ["w023", "w024", "w025"], "anchor": "w024", "gloss": "The theme of special praise" }] },
    "s04": { "translation": "At the table of the holy supper He was given to the company of the twelve brethren; this is not doubted.", "alignments": [{ "words": ["w034", "w035", "w036"], "anchor": "w035", "gloss": "the table of the holy supper" }, { "words": ["w037", "w038", "w039"], "anchor": "w037", "gloss": "to the company of twelve brethren" }, { "words": ["w041", "w042"], "anchor": "w042", "gloss": "it is not doubted" }] },
    "s05": { "translation": "Let praise be full and resounding; let the rejoicing of the mind be glad and fitting.", "alignments": [{ "words": ["w043", "w044", "w045"], "anchor": "w043", "gloss": "Let praise be full" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "let it ring out;" }, { "words": ["w048", "w049"], "anchor": "w048", "gloss": "let it be glad" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "let it be fitting—" }, { "words": ["w052", "w053"], "anchor": "w053", "gloss": "the rejoicing of the mind" }] },
    "s06": { "translation": "For a solemn day is kept, on which the first institution of this table is recalled.", "alignments": [{ "words": ["w054", "w055", "w056"], "anchor": "w054", "gloss": "For a solemn day" }, { "words": ["w060", "w061", "w062", "w063", "w064"], "anchor": "w062", "gloss": "the first institution of this table is recalled" }] },
    "s07": { "translation": "At this table of the new King, the new Pasch of the new law brings the ancient Passover to an end.", "alignments": [{ "words": ["w068", "w069"], "anchor": "w069", "gloss": "of the new King" }, { "words": ["w070", "w071"], "anchor": "w071", "gloss": "the new Pasch" }, { "words": ["w072", "w073"], "anchor": "w073", "gloss": "of the new law" }, { "words": ["w074", "w075", "w076"], "anchor": "w076", "gloss": "brings the old Passover to an end" }] },
    "s08": { "translation": "Newness drives away the old, truth drives away the shadow, and light banishes night.", "alignments": [{ "words": ["w077", "w078"], "anchor": "w078", "gloss": "Newness drives away the old" }, { "words": ["w079", "w080", "w081"], "anchor": "w080", "gloss": "truth drives away the shadow" }, { "words": ["w082", "w083", "w084"], "anchor": "w084", "gloss": "light banishes night" }] },
    "s09": { "translation": "What Christ did at the supper He commanded to be done in remembrance of Himself.", "alignments": [{ "words": ["w090", "w091", "w092"], "anchor": "w092", "gloss": "He commanded this to be done" }, { "words": ["w093", "w094", "w095"], "anchor": "w095", "gloss": "in remembrance of Him" }] },
    "s10": { "translation": "Taught by sacred precepts, we consecrate bread and wine into the victim of salvation.", "alignments": [{ "words": ["w097", "w098"], "anchor": "w098", "gloss": "by sacred precepts" }, { "words": ["w101", "w102", "w103", "w104"], "anchor": "w103", "gloss": "we consecrate into the victim of salvation" }] },
    "s11": { "translation": "A dogma is given to Christians: bread is changed into Flesh, and wine into Blood.", "alignments": [{ "words": ["w109", "w110", "w111", "w112"], "anchor": "w111", "gloss": "bread is changed into Flesh" }] },
    "s12": { "translation": "What you do not comprehend or see, a courageous faith confirms beyond the ordinary course of nature.", "alignments": [{ "words": ["w118", "w119"], "anchor": "w119", "gloss": "you do not comprehend" }, { "words": ["w121", "w122"], "anchor": "w122", "gloss": "you do not see" }, { "words": ["w123", "w124", "w125"], "anchor": "w124", "gloss": "a courageous faith confirms" }, { "words": ["w127", "w128"], "anchor": "w128", "gloss": "the order of things" }] },
    "s13": { "translation": "Beneath different appearances—different only as signs, not in reality—extraordinary realities lie hidden." },
    "s14": { "translation": "The Flesh is food and the Blood is drink; yet Christ remains whole beneath either species.", "alignments": [{ "words": ["w140", "w141"], "anchor": "w141", "gloss": "Flesh is food" }, { "words": ["w142", "w143"], "anchor": "w143", "gloss": "Blood is drink" }, { "words": ["w144", "w145", "w146", "w147"], "anchor": "w144", "gloss": "yet Christ remains whole" }] },
    "s15": { "translation": "He is not cut, broken, or divided by the receiver; He is received whole." },
    "s16": { "translation": "One receives, a thousand receive; they receive as much as he, and the One received is not consumed.", "alignments": [{ "words": ["w161", "w162"], "anchor": "w161", "gloss": "One receives" }, { "words": ["w163", "w164"], "anchor": "w163", "gloss": "a thousand receive" }, { "words": ["w165", "w166"], "anchor": "w165", "gloss": "as much as they receive" }, { "words": ["w167", "w168"], "anchor": "w167", "gloss": "so much does he" }, { "words": ["w169", "w170", "w171"], "anchor": "w171", "gloss": "and the One received is not consumed" }] },
    "s17": { "translation": "The good receive and the wicked receive, yet with unequal lot: of life or of destruction.", "alignments": [{ "words": ["w172", "w173"], "anchor": "w172", "gloss": "The good receive" }, { "words": ["w174", "w175"], "anchor": "w174", "gloss": "the wicked receive" }, { "words": ["w176", "w177", "w178"], "anchor": "w176", "gloss": "yet with unequal lot" }] },
    "s18": { "translation": "It is death to the wicked and life to the good; see how unlike is the outcome of an equal reception.", "alignments": [{ "words": ["w182", "w183"], "anchor": "w183", "gloss": "It is death" }, { "words": ["w188", "w189"], "anchor": "w189", "gloss": "of equal reception" }, { "words": ["w190", "w191", "w192", "w193"], "anchor": "w191", "gloss": "how unlike the outcome is" }] },
    "s19": { "translation": "When at last the Sacrament is broken, do not waver, but remember: as much lies beneath the fragment as is covered by the whole.", "alignments": [{ "words": ["w194", "w195", "w196"], "anchor": "w194", "gloss": "When at last the Sacrament is broken" }, { "words": ["w205", "w206", "w207"], "anchor": "w207", "gloss": "as is covered by the whole" }] },
    "s20": { "translation": "No division is made in the reality; only the sign is broken, whereby neither the state nor the stature of what is signified is diminished.", "alignments": [{ "words": ["w208", "w209", "w210", "w211"], "anchor": "w210", "gloss": "No division of the reality is made" }, { "words": ["w212", "w213", "w214", "w215"], "anchor": "w214", "gloss": "only the sign is broken" }] },
    "s21": { "translation": "Behold the Bread of Angels, made the food of wayfarers; truly the Bread of the children, not to be cast to dogs.", "alignments": [{ "words": ["w232", "w233"], "anchor": "w233", "gloss": "not to be cast" }] },
    "s22": { "translation": "He is foreshadowed in figures: when Isaac is offered, when the paschal lamb is appointed, and when manna is given to the fathers.", "alignments": [{ "words": ["w244", "w245"], "anchor": "w244", "gloss": "manna is given" }] },
    "s23": { "translation": "Good Shepherd, true Bread, Jesus, have mercy on us. Feed us and guard us; make us behold good things in the land of the living.", "alignments": [{ "words": ["w249", "w250"], "anchor": "w249", "gloss": "true Bread" }, { "words": ["w252", "w253"], "anchor": "w253", "gloss": "have mercy on us" }, { "words": ["w254", "w255", "w256"], "anchor": "w256", "gloss": "You, feed us" }, { "words": ["w257", "w258"], "anchor": "w258", "gloss": "guard us" }, { "words": ["w260", "w261", "w262", "w263"], "anchor": "w262", "gloss": "make us behold good things" }] },
    "s24": { "translation": "You who know and can do all things, who feed us mortals here: make us there Your table companions, fellow heirs, and comrades of the holy citizens. Amen. Alleluia.", "alignments": [{ "words": ["w269", "w270", "w271", "w272"], "anchor": "w270", "gloss": "know and can do all things" }, { "words": ["w274", "w275", "w276", "w277"], "anchor": "w275", "gloss": "feed us mortals here" }, { "words": ["w278", "w279", "w280"], "anchor": "w280", "gloss": "Your table companions there" }, { "words": ["w285", "w286"], "anchor": "w286", "gloss": "of the holy citizens" }] }
  },
