  "about": "The epistola of the formulary “Nativity of the Lord — Mass at Dawn” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Dearly beloved: The goodness and loving-kindness of God our Savior has appeared: not by works of justice which we have done, but according to His mercy He saved us, by the washing of regeneration and renewal of the Holy Spirit, whom He poured forth upon us abundantly through Jesus Christ our Savior, that, justified by His grace, we may be heirs according to the hope of eternal life, in Christ Jesus our Lord.", "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "of our Savior" }, { "words": ["w020", "w021", "w022"], "anchor": "w022", "gloss": "He saved us" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "of the Holy Spirit" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "our Savior" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "by His grace" }, { "words": ["w044", "w045"], "anchor": "w045", "gloss": "may be heirs" }, { "words": ["w053", "w054"], "anchor": "w053", "gloss": "our Lord" }] }
  },
