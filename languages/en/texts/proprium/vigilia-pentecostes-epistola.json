  "about": "The Epistle of the formulary “Vigil of Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "In those days, while Apollos was at Corinth, Paul, having passed through the upper regions, came to Ephesus and found certain disciples. And he said to them: Did you receive the Holy Spirit when you came to believe? But they said to him: We have not even heard whether there is a Holy Spirit. And he said: In what then were you baptized? They said: In John’s baptism. Then Paul said: John baptized the people with the baptism of penance, saying that they should believe in Him who was to come after him, that is, in Jesus. Having heard these things, they were baptized in the name of the Lord Jesus. And when Paul had laid his hands on them, the Holy Spirit came upon them, and they spoke with tongues and prophesied. And there were about twelve men in all. And entering into the synagogue, he spoke boldly for three months, disputing and persuading concerning the kingdom of God.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "those days" }, { "words": ["w004", "w005"], "anchor": "w004", "gloss": "It came to pass" }, { "words": ["w024", "w025", "w026", "w027"], "anchor": "w027", "gloss": "Did you receive the Holy Spirit" }, { "words": ["w035", "w036", "w037", "w038", "w039", "w040"], "anchor": "w040", "gloss": "we have not even heard whether there is a Holy Spirit" }, { "words": ["w047", "w048"], "anchor": "w047", "gloss": "were you baptized" }, { "words": ["w054", "w055", "w056"], "anchor": "w054", "gloss": "Then Paul said" }, { "words": ["w066", "w067"], "anchor": "w066", "gloss": "was to come" }, { "words": ["w070", "w071"], "anchor": "w071", "gloss": "they should believe" }, { "words": ["w076", "w077"], "anchor": "w077", "gloss": "Having heard these things" }, { "words": ["w078", "w079"], "anchor": "w078", "gloss": "they were baptized" }, { "words": ["w086", "w087", "w088", "w089"], "anchor": "w086", "gloss": "Paul had laid hands on them" }, { "words": ["w090", "w091", "w092"], "anchor": "w090", "gloss": "the Holy Spirit came" }, { "words": ["w100", "w101"], "anchor": "w100", "gloss": "And there were" }, { "words": ["w103", "w104", "w105"], "anchor": "w103", "gloss": "about twelve men" }, { "words": ["w106", "w107"], "anchor": "w106", "gloss": "And having entered" }] }
  },
