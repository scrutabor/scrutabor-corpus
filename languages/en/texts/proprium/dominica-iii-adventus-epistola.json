  "text": "proprium.dominica-iii-adventus-epistola",
  "about": "The epistle of the Third Sunday of Advent, from which the day takes its name of Gaudéte. The call to rejoice stands beside a call to modesty and to freedom from anxiety — three things Paul binds together because “the Lord is near”.",
  "segments": {
    "s01": { "translation": "Brethren: Rejoice in the Lord always; again I say, rejoice.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 93", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s02": { "translation": "Let your modesty be known to all people; the Lord is near.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 93", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w009", "w010"], "anchor": "w009", "gloss": "your modesty" }] },
    "s03": { "translation": "Be anxious about nothing, but in every prayer and supplication, with thanksgiving, make your petitions known to God.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 93", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w028", "w029"], "anchor": "w029", "gloss": "thanksgiving" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "your petitions" }] },
    "s04": { "translation": "And may the peace of God, which surpasses all understanding, guard your hearts and minds in Christ Jesus our Lord.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 93", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w043", "w044"], "anchor": "w043", "gloss": "your hearts" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "your minds" }, { "words": ["w051", "w052"], "anchor": "w051", "gloss": "our Lord" }] }
  },
