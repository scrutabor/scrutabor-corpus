  "about": "The postcommunio of the formulary “Fourth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Be present with us, O Lord our God, that by these things which we have faithfully received we may be cleansed from our faults and delivered from all dangers. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "our God" }, { "words": ["w007", "w008", "w009", "w010", "w011"], "anchor": "w011", "gloss": "by these things which we have faithfully received" }, { "words": ["w012", "w013"], "anchor": "w013", "gloss": "we may both be cleansed" }, { "words": ["w017", "w018", "w019", "w020"], "anchor": "w020", "gloss": "delivered from all dangers" }, { "words": ["w021", "w022", "w023"], "anchor": "w022", "gloss": "Through our Lord" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Your Son" }, { "words": ["w028", "w029", "w030"], "anchor": "w030", "gloss": "who lives with You" }, { "words": ["w033", "w034", "w035", "w036"], "anchor": "w034", "gloss": "in the unity of the Holy Spirit" }, { "words": ["w038", "w039", "w040", "w041"], "anchor": "w040", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
