  "text": "proprium.in-octava-nativitatis-postcommunio",
  "about": "The postcommunio of the formulary “Octave Day of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May this Communion cleanse us from sin, O Lord, and through the intercession of the Blessed Virgin Mary, Mother of God, make us partakers of the heavenly remedy. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005"], "anchor": "w005", "gloss": "May this Communion, O Lord, cleanse us" }, { "words": ["w012", "w013"], "anchor": "w013", "gloss": "Mother of God" }, { "words": ["w015", "w016", "w017", "w018", "w019"], "anchor": "w017", "gloss": "may make us sharers of the heavenly remedy" }, { "words": ["w021", "w022", "w023", "w024", "w025"], "anchor": "w022", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Your Son" }, { "words": ["w028", "w029", "w030", "w031", "w032"], "anchor": "w030", "gloss": "who lives and reigns with You" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }, { "words": ["w038", "w039", "w040", "w041"], "anchor": "w040", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
