    "s01": { "translation": "May this Communion cleanse us from sin, O Lord, and through the intercession of the blessed Virgin Mary, Mother of God, make us partakers of the heavenly remedy. Through the same our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God, world without end.", "alignments": [{ "words": ["w017", "w018"], "anchor": "w017", "gloss": "may make" }] },
    "s02": { "translation": "Amen." }
  },
