  "about": "The postcommunio of the formulary “Ascension of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant us, we beseech You, almighty and merciful God, that we may obtain the unseen fruit of what we have received to partake of in visible mysteries. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w012", "w013"], "anchor": "w013", "gloss": "we have received to partake of" }, { "words": ["w014", "w015", "w016"], "anchor": "w015", "gloss": "we may obtain through unseen efficacy" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "our Lord" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Your Son" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "of the Holy Spirit" }, { "words": ["w034", "w035", "w036", "w037"], "anchor": "w036", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
