  "text": "proprium.dominica-ii-adventus-collecta",
  "about": "The collect of the Second Sunday of Advent. It asks God to stir the heart toward preparing the ways of His Son, and ties that preparing to a mind made clean. The image of the ways comes from the cry of John the Baptist, whom this Sunday's Gospel recalls.",
  "segments": {
    "s01": { "translation": "Stir up our hearts, O Lord, to prepare the ways of Your Only-begotten Son, so that through His coming we may be found worthy to serve You with purified minds. Who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w019", "w020", "w021", "w022", "w023"], "anchor": "w021", "gloss": "Who liveth and reigneth with Thee" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "of the Holy Ghost" }, { "words": ["w029", "w030", "w031", "w032"], "anchor": "w031", "gloss": "world without end" }] },
    "s02": { "translation": "Amen." }
  },
