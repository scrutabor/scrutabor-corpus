  "text": "proprium.sanctorum-philippi-et-iacobi-apostolorum-evangelium",
  "about": "Jesus speaks of the many dwellings in His Father's house, identifies Himself as the way to the Father, and promises to act when His disciples ask in His name.",
  "segments": {
    "s01": { "translation": "At that time Jesus said to His disciples: Let your heart not be troubled. You believe in God; believe in Me as well. In the house of My Father there are many dwellings. If it were otherwise, I would have told you, for I am going to prepare you a place. And if I have gone away and have prepared you a place, I come again, and I will receive you to Myself, so that where I am, you too may be. And you know where I am going, and you know the way. Thomas says to Him: Lord, we do not know where You go, and how can we know the way? Jesus says to him: I am the way, and the truth, and the life. No one comes to the Father other than through Me. If you had known Me, you would certainly have known My Father as well; and from now on you will know Him, and you have seen Him. Philip says to Him: Lord, show us the Father, and it is enough for us. Jesus says to him: I have been with you so long, and you have not come to know Me? Philip, whoever sees Me sees the Father as well. How is it that you say, ‘Show us the Father’? Do you not believe that I am in the Father, and the Father in Me? The words that I speak to you, I do not speak from Myself. But the Father who remains in Me, He Himself does the works. Do you not believe that I am in the Father, and the Father in Me? Otherwise, believe on account of the works themselves. Amen, amen, I say to you: whoever believes in Me, he too will do the works I do, and he will do greater things than these, for I go to the Father. And whatever you ask of the Father in My name, this I will do.", "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "to His disciples" }, { "words": ["w010", "w011"], "anchor": "w010", "gloss": "your heart" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "of My Father" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "many dwellings" }, { "words": ["w026", "w027", "w028"], "anchor": "w026", "gloss": "if it were otherwise" }, { "words": ["w052", "w053"], "anchor": "w052", "gloss": "I am" }, { "words": ["w098", "w099"], "anchor": "w098", "gloss": "My Father" }, { "words": ["w122", "w123"], "anchor": "w122", "gloss": "for so long" }, { "words": ["w127", "w128"], "anchor": "w127", "gloss": "have you not known" }, { "words": ["w138", "w139"], "anchor": "w138", "gloss": "do you say" }, { "words": ["w143", "w144"], "anchor": "w143", "gloss": "Do you not believe" }, { "words": ["w171", "w172"], "anchor": "w171", "gloss": "Do you not believe" }, { "words": ["w216", "w217"], "anchor": "w216", "gloss": "My name" }] }
