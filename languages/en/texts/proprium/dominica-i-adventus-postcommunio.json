  "text": "proprium.dominica-i-adventus-postcommunio",
  "about": "The postcommunion of the First Sunday of Advent. It asks that we receive God's mercy within His temple and approach the coming celebrations of our renewal with fitting reverence. Its opening words adapt Psalm 47:10 in the Vulgate numbering (Psalm 48 in Hebrew), and its conclusion is printed as the two words Per Dóminum.",
  "segments": {
    "s01": { "translation": "Lord, let us receive Your mercy in the heart of Your temple, so that we may anticipate the coming celebrations of our renewal with fitting reverence. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w018", "w019"], "anchor": "w018", "gloss": "our Lord" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "Jesus Christ" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Thy Son" }, { "words": ["w024", "w025", "w026", "w027", "w028"], "anchor": "w026", "gloss": "who liveth and reigneth with Thee" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "of the Holy Ghost" }, { "words": ["w034", "w035", "w036", "w037"], "anchor": "w036", "gloss": "world without end" }] },
    "s02": { "translation": "Amen." }
  },
