    "s01": { "translation": "The father of the Just One rejoices with gladness; let Your Father and Your Mother be glad, and let her who bore You rejoice. How lovely are Your tabernacles, O Lord of hosts! My soul longs and faints for the courts of the Lord. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. The father of the Just One rejoices with gladness; let Your Father and Your Mother be glad, and let her who bore You rejoice.", "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "Your Father" }, { "words": ["w009", "w010"], "anchor": "w009", "gloss": "Your Mother" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "Your dwelling places" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "my soul" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "to the Holy Spirit" }, { "words": ["w055", "w056"], "anchor": "w055", "gloss": "Your Father" }, { "words": ["w058", "w059"], "anchor": "w058", "gloss": "Your Mother" }] }
