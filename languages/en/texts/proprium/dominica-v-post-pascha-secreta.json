  "text": "proprium.dominica-v-post-pascha-secreta",
  "about": "The secreta of the formulary “Fifth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Receive, O Lord, the prayers of the faithful along with the oblations of sacrificial gifts, that through these services of pious devotion we may pass over to heavenly glory. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w003", "w004"], "anchor": "w004", "gloss": "the prayers of the faithful" }, { "words": ["w010", "w011", "w012", "w013"], "anchor": "w013", "gloss": "these duties of pious devotion" }, { "words": ["w014", "w015", "w016", "w017"], "anchor": "w017", "gloss": "we may pass to heavenly glory" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "our Lord" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Your Son" }, { "words": ["w025", "w026", "w027"], "anchor": "w025", "gloss": "who lives with You" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w035", "w036", "w037", "w038"], "anchor": "w037", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
