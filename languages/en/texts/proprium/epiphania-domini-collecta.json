  "text": "proprium.epiphania-domini-collecta",
  "about": "The collecta of the formulary “Epiphany of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who today made known Your Only-begotten to the Gentiles, a star leading the way, graciously grant that we, who have already come to know You by faith, be led onward until we contemplate the beauty of Your sublime majesty. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006", "w007", "w008", "w009", "w010"], "anchor": "w010", "gloss": "revealed Your Only-begotten to the nations, a star leading them" }, { "words": ["w016", "w017", "w018", "w019"], "anchor": "w019", "gloss": "have known You by faith" }, { "words": ["w020", "w021"], "anchor": "w021", "gloss": "to" }, { "words": ["w024", "w025"], "anchor": "w025", "gloss": "of Your majesty" }, { "words": ["w028", "w029", "w030", "w031", "w032"], "anchor": "w029", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "Your Son" }, { "words": ["w035", "w036", "w037", "w038", "w039"], "anchor": "w037", "gloss": "who lives and reigns with You" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "of the Holy Spirit" }, { "words": ["w045", "w046", "w047", "w048"], "anchor": "w047", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
