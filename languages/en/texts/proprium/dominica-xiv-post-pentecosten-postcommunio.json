  "text": "proprium.dominica-xiv-post-pentecosten-postcommunio",
  "about": "The postcommunio of the formulary “14th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May Your sacrament, O God, ever cleanse and strengthen us, and bring us to everlasting salvation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever." },
    "s02": { "translation": "Amen." }
  },
