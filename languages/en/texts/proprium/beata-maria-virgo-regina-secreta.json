  "text": "proprium.beata-maria-virgo-regina-secreta",
  "about": "The secreta of the formulary “Queenship of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Accept, we beseech You, O Lord, the gifts of the rejoicing Church and grant by the pleading merits of the Blessed Virgin Mary, the Queen, that they may be helpful for our salvation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
