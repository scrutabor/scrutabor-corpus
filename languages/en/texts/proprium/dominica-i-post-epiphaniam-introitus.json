  "text": "proprium.dominica-i-post-epiphaniam-introitus",
  "about": "The introitus of the formulary “Mass of the First Sunday after Epiphany” in the 1962 Roman Missal. This formulary serves the weekdays of that week. On the Sunday itself the feast of the Holy Family takes its place.",
  "segments": {
    "s01": { "translation": "I saw a Man seated upon a lofty throne, whom a multitude of Angels adore, singing together: behold Him, the name of whose dominion endures forever. Sing joyfully to God, all the earth; serve the Lord with gladness. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. I saw a Man seated upon a lofty throne, whom a multitude of Angels adore, singing together: behold Him, the name of whose dominion endures forever.", "alignments": [{ "words": ["w008", "w009", "w010"], "anchor": "w008", "gloss": "a multitude of Angels adore" }, { "words": ["w013"], "reason": "idiom" }, { "words": ["w015", "w016", "w017"], "anchor": "w017", "gloss": "Him the name of whose dominion" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "to the Holy Spirit" }, { "words": ["w056", "w057", "w058"], "anchor": "w056", "gloss": "a multitude of Angels adore" }, { "words": ["w061"], "reason": "idiom" }, { "words": ["w063", "w064", "w065"], "anchor": "w065", "gloss": "Him the name of whose dominion" }] }
