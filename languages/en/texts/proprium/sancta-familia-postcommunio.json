  "text": "proprium.sancta-familia-postcommunio",
  "about": "The postcommunio of the formulary “Holy Family of Jesus, Mary, and Joseph” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord Jesus, who refresh us with heavenly sacraments, grant that we may continually imitate the examples of Your Holy Family, and that at the hour of our death, when the glorious Virgin, Your Mother, and blessed Joseph come to meet us, we may through You merit to be received into the everlasting tabernacles. You live and reign with God the Father in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w002", "w003", "w004"], "anchor": "w003", "gloss": "You refresh with heavenly sacraments" }, { "words": ["w008", "w009", "w010", "w011", "w012", "w013"], "anchor": "w013", "gloss": "may continually imitate the examples of Your Holy Family" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "of our death" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Your Mother" }, { "words": ["w034", "w035", "w036", "w037"], "anchor": "w035", "gloss": "You live and reign" }, { "words": ["w043", "w044"], "anchor": "w043", "gloss": "of the Holy Spirit" }, { "words": ["w046", "w047", "w048", "w049"], "anchor": "w048", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
