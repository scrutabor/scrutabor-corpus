  "about": "The Epistle of the formulary “9th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Brethren: Let us not covet evil things, as they also coveted. Nor must you become idolaters, like some of them, just as it is written: The people sat down to eat and to drink, and they rose up to play. Let us not commit fornication, as some of them did, and in one day twenty-three thousand fell. Let us not put Christ to the test, as some of them did, and they perished by serpents. Nor must you murmur, as some of them murmured, and perished by the destroyer. Now all these things befell them as a figure, and they were written to correct us, upon whom the ends of the ages have come. Therefore, let whoever thinks he stands see to it that he does not fall. Let no temptation seize you except a human one; but God is faithful, who will not let you be tempted beyond what you are able, but with the temptation He will also bring about a favorable outcome, so that you may be able to endure.", "alignments": [{ "words": ["w002", "w003", "w004"], "anchor": "w004", "gloss": "Let us not lust after" }, { "words": ["w011", "w012"], "anchor": "w012", "gloss": "become idolaters" }, { "words": ["w018", "w019"], "anchor": "w019", "gloss": "it is written" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "The people sat down" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "committed fornication" }, { "words": ["w071", "w072"], "anchor": "w071", "gloss": "they were written" }, { "words": ["w075", "w076"], "anchor": "w075", "gloss": "our correction" }, { "words": ["w084", "w085", "w086"], "anchor": "w085", "gloss": "thinks he stands" }, { "words": ["w090", "w091", "w092", "w093"], "anchor": "w093", "gloss": "Let no temptation take hold of you" }, { "words": ["w096", "w097", "w098", "w099"], "anchor": "w099", "gloss": "but God is faithful" }, { "words": ["w101", "w102"], "anchor": "w102", "gloss": "will not permit" }, { "words": ["w110", "w111"], "anchor": "w110", "gloss": "will also bring about" }] }
  },
