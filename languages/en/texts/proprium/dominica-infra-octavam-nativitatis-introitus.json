  "about": "The introitus of the formulary “Sunday within the Octave of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "While all things kept deep silence, and the night in her course had reached the midst of her journey, Your almighty Word, O Lord, came down from heaven, from the royal thrones. The Lord has reigned, He is clothed with beauty; the Lord is clothed with strength and has girded Himself. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. While all things kept deep silence, and the night in her course had reached the midst of her journey, Your almighty Word, O Lord, came down from heaven, from the royal thrones.", "alignments": [{ "words": ["w002", "w003", "w004", "w005"], "anchor": "w004", "gloss": "all things kept deep silence" }, { "words": ["w011", "w012", "w013"], "anchor": "w013", "gloss": "had reached the midst of her journey" }, { "words": ["w014", "w015", "w016"], "anchor": "w015", "gloss": "Your almighty Word" }, { "words": ["w026", "w027", "w028"], "anchor": "w027", "gloss": "He is clothed with beauty" }, { "words": ["w041", "w042"], "anchor": "w041", "gloss": "to the Holy Spirit" }, { "words": ["w057", "w058", "w059", "w060"], "anchor": "w059", "gloss": "all things kept deep silence" }, { "words": ["w066", "w067", "w068"], "anchor": "w068", "gloss": "had reached the midst of her journey" }, { "words": ["w069", "w070", "w071"], "anchor": "w070", "gloss": "Your almighty Word" }] }
