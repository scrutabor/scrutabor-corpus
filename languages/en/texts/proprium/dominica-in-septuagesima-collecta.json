  "text": "proprium.dominica-in-septuagesima-collecta",
  "about": "The collecta of the formulary “Septuagesima Sunday” in the 1962 Roman Missal.\n\nThe proper page prints the prayer body with the short cue Per Dominum. The complete ending and Amen follow the common formula. They are not printed in full beside this prayer.",
  "segments": {
    "s01": { "translation": "We beseech You, O Lord, graciously hear the prayers of Your people, that we, who are justly afflicted for our sins, may be mercifully delivered for the glory of Your name. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005", "w006", "w007"], "anchor": "w007", "gloss": "We beseech You, O Lord, graciously hear the prayers of Your people" }, { "words": ["w009", "w010", "w011", "w012", "w013", "w014"], "anchor": "w014", "gloss": "we, who are justly afflicted for our sins," }, { "words": ["w015", "w016", "w017", "w018", "w019", "w020"], "anchor": "w020", "gloss": "may be mercifully delivered for the glory of Your name" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "our Lord" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Your Son" }, { "words": ["w029", "w030"], "anchor": "w030", "gloss": "lives with You" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }, { "words": ["w038", "w039", "w040", "w041"], "anchor": "w040", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
