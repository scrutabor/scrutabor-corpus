  "text": "proprium.feria-v-in-cena-domini-secreta",
  "about": "The secreta of the formulary “Holy Thursday — Mass of the Lord’s Supper” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May He Himself, we beseech You, O Lord, holy Father, almighty eternal God, render our sacrifice acceptable to You, He who by today’s institution showed His disciples that this was to be done in commemoration of Him, Jesus Christ, Your Son, our Lord, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005", "w006", "w007", "w008", "w009", "w010", "w011", "w012", "w013"], "anchor": "w012", "gloss": "We pray, Lord, holy Father, almighty eternal God, that He Himself may make our sacrifice acceptable to You" }, { "words": ["w015", "w016", "w017", "w018", "w019", "w020", "w021", "w022", "w023", "w024"], "anchor": "w024", "gloss": "showed His disciples by today’s institution that this was to be done in commemoration of Him" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your Son" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "our Lord" }, { "words": ["w031", "w032", "w033", "w034", "w035"], "anchor": "w033", "gloss": "who lives and reigns with You" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w041", "w042", "w043", "w044"], "anchor": "w043", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
