  "text": "proprium.commemoratio-omnium-fidelium-defunctorum-missa-iii-secreta",
  "about": "The secreta of the formulary “Commemoration of All the Faithful Departed — Mass III” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, whose mercy is boundless, graciously accept our humble prayers, and, through these sacraments of our salvation, grant to the souls of all the faithful departed, to whom You gave the grace to profess Your name, the remission of all their sins. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w002", "w003", "w004", "w005", "w006"], "anchor": "w006", "gloss": "whose mercy is without number" }, { "words": ["w009", "w010", "w011"], "anchor": "w009", "gloss": "our humble prayers" }, { "words": ["w055", "w056", "w057"], "anchor": "w057", "gloss": "of all the faithful departed" }, { "words": ["w020", "w021", "w022", "w023"], "anchor": "w022", "gloss": "Thou gavest the profession of Thy name" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "of our salvation" }, { "words": ["w029", "w030", "w031", "w032"], "anchor": "w031", "gloss": "grant remission of all sins" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "our Lord" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "Thy Son" }, { "words": ["w047", "w048"], "anchor": "w047", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w050", "w051", "w052", "w053"], "anchor": "w052", "gloss": "world without end" }] },
    "s03": { "translation": "Amen." }
  },
