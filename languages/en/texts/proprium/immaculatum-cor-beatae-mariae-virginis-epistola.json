  "segments": {
    "s01": { "translation": "I, like a vine, have yielded a sweet fragrance, and my blossoms are the fruit of honor and of riches. I am the mother of beautiful love, and of fear, and of knowledge, and of holy hope. Within me is every grace of the way and the truth; within me, every hope of life and virtue. Come over to me, all you who desire me, and take your fill of what I bring forth. For my spirit is sweet beyond honey, and my inheritance beyond honey and the honeycomb. The remembrance of me is for the generations of the ages. Those who eat me will still hunger, and those who drink me will still thirst. Whoever listens to me will not be brought to shame, and those who work in me will not sin. Those who make me known will have eternal life.", "alignments": [{ "words": ["w051", "w052", "w053"], "anchor": "w051", "gloss": "For my spirit" }, { "words": ["w083", "w084"], "anchor": "w084", "gloss": "will not be put to shame" }, { "words": ["w090", "w091"], "anchor": "w091", "gloss": "shall not sin" }] }
  },
