  "text": "proprium.vigilia-nativitatis-collecta",
  "about": "The collecta of the formulary “Vigil of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who gladden us each year with the expectation of our redemption, grant that we who joyfully receive Your Only-begotten as Redeemer may also look on Him without fear when He comes as Judge, our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w004", "w005", "w006", "w007"], "anchor": "w007", "gloss": "with the annual expectation of our redemption" }, { "words": ["w011", "w012"], "anchor": "w011", "gloss": "Your Only-begotten" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "our Lord" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "Jesus Christ" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Your Son" }, { "words": ["w028", "w029", "w030", "w031", "w032"], "anchor": "w030", "gloss": "who lives and reigns with You" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }, { "words": ["w038", "w039", "w040", "w041"], "anchor": "w040", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
