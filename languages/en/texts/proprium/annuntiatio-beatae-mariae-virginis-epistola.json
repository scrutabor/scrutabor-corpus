  "about": "The Epistle of the formulary “Annunciation of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "In those days, the Lord spoke to Achaz, saying: Ask of the Lord your God a sign for yourself, whether to the depth of hell or to the height above. And Achaz said: I will not ask, and I will not put the Lord to the test. And he said: Hear, then, O house of David: Is it a small thing for you to be troublesome to men, that you are troublesome also to my God? Therefore the Lord Himself will give you a sign. Behold, a virgin will conceive and bear a son, and His name will be called Emmanuel. He will eat butter and honey, that He may know how to refuse evil and to choose good.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "those days" }, { "words": ["w004", "w005", "w006"], "anchor": "w004", "gloss": "the Lord spoke" }, { "words": ["w010", "w011", "w012"], "anchor": "w010", "gloss": "ask for a sign for yourself" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "your God" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Achaz said" }, { "words": ["w027", "w028"], "anchor": "w028", "gloss": "I will not ask" }, { "words": ["w030", "w031"], "anchor": "w031", "gloss": "I will not test" }, { "words": ["w039", "w040", "w041", "w042"], "anchor": "w042", "gloss": "is it too little for you" }, { "words": ["w043", "w044"], "anchor": "w043", "gloss": "to be troublesome" }, { "words": ["w047", "w048"], "anchor": "w047", "gloss": "you are troublesome" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "to my God" }, { "words": ["w054", "w055", "w056"], "anchor": "w054", "gloss": "the Lord Himself will give" }, { "words": ["w066", "w067", "w068"], "anchor": "w066", "gloss": "His name will be called" }] }
