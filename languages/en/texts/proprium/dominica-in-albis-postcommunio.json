    "s01": { "translation": "We ask You, Lord our God, to make the most holy mysteries, which You have bestowed to safeguard our restoration, a remedy for us both now and in the future. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, for ever and ever.", "alignments": [{ "words": ["w003", "w004"], "anchor": "w003", "gloss": "our God" }, { "words": ["w010", "w011"], "anchor": "w010", "gloss": "our restoration’s" }, { "words": ["w015", "w016", "w017"], "anchor": "w017", "gloss": "a present remedy for us" }, { "words": ["w018", "w019"], "anchor": "w019", "gloss": "You may make" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your Son" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
