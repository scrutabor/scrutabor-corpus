  "text": "proprium.dominica-i-post-epiphaniam-collecta",
  "about": "The collecta of the formulary “Mass of the First Sunday after Epiphany” in the 1962 Roman Missal. This formulary serves the weekdays of that week. On the Sunday itself the feast of the Holy Family takes its place.",
  "segments": {
    "s01": { "translation": "We beseech You, O Lord, pursue with heavenly loving-kindness the desires of the suppliant people, that they may both see what ought to be done and gain strength to fulfill what they have seen. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w012", "w013"], "anchor": "w012", "gloss": "ought to be done" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "our Lord" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "Jesus Christ" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Your Son" }, { "words": ["w028", "w029", "w030", "w031", "w032"], "anchor": "w030", "gloss": "who lives and reigns with You" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }, { "words": ["w038", "w039", "w040", "w041"], "anchor": "w040", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
