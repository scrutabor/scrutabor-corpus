  "about": "The evangelium of the formulary “Mass of the Easter Vigil” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Now at the end of the Sabbath, as it was dawning toward the first day of the week, Mary Magdalene and the other Mary came to see the tomb. And behold, a great earthquake took place. For an angel of the Lord descended from heaven and, approaching, rolled back the stone and sat on it. His appearance was like lightning, and his garment like snow. For fear of him, the guards were terrified and became like dead men. The angel answered the women: “You, do not be afraid, for I know that you seek Jesus, who was crucified. He is not here, for He has risen, as He said. Come and see the place where the Lord had been laid. Go quickly and tell His disciples that He has risen; and behold, He goes before you into Galilee. There you will see Him. Behold, I have told you beforehand.”", "alignments": [{ "words": ["w001", "w002", "w003"], "gloss": "Now at the end of the Sabbath", "anchor": "w001" }, { "words": ["w004", "w005", "w006", "w007", "w008"], "gloss": "as it was dawning toward the first day of the week", "anchor": "w005" }, { "words": ["w019", "w020", "w021", "w022"], "gloss": "a great earthquake took place", "anchor": "w020" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "For an angel" }, { "words": ["w037", "w038", "w039", "w040"], "gloss": "and his appearance was", "anchor": "w037" }, { "words": ["w044", "w045"], "gloss": "his garment", "anchor": "w044" }, { "words": ["w048", "w049", "w050", "w051"], "gloss": "and for fear of him", "anchor": "w049" }, { "words": ["w052", "w053", "w054"], "gloss": "the guards were terrified", "anchor": "w052" }, { "words": ["w056", "w057"], "anchor": "w056", "gloss": "became" }, { "words": ["w060", "w061", "w062"], "gloss": "and the angel, answering,", "anchor": "w060" }, { "words": ["w065", "w066", "w067"], "gloss": "You, do not fear", "anchor": "w065" }, { "words": ["w068", "w069"], "anchor": "w068", "gloss": "for I know" }, { "words": ["w071", "w072", "w073", "w074", "w075"], "gloss": "you seek Jesus, who was crucified", "anchor": "w075" }, { "words": ["w076", "w077"], "gloss": "He is not", "anchor": "w077" }, { "words": ["w079", "w080"], "gloss": "for He has risen", "anchor": "w079" }, { "words": ["w088", "w089", "w090"], "anchor": "w088", "gloss": "the Lord had been laid" }, { "words": ["w095", "w096"], "gloss": "His disciples", "anchor": "w095" }, { "words": ["w109", "w110"], "gloss": "I have told you beforehand", "anchor": "w109" }] }
