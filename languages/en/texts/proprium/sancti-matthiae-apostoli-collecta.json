  "text": "proprium.sancti-matthiae-apostoli-collecta",
  "about": "The collecta of the formulary “Saint Matthias the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who joined blessed Matthias to the company of Your Apostles, grant, we pray, that through his intercession we may always experience the tenderness of Your mercy toward us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006"], "anchor": "w005", "gloss": "of Your Apostles" }, { "words": ["w012", "w013"], "anchor": "w013", "gloss": "through his intercession" }, { "words": ["w014", "w015", "w016", "w017"], "anchor": "w017", "gloss": "of Your mercy toward us" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "our Lord" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Your Son" }, { "words": ["w028", "w029", "w030", "w031", "w032"], "anchor": "w030", "gloss": "who lives and reigns with You" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }, { "words": ["w038", "w039", "w040", "w041"], "anchor": "w040", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
