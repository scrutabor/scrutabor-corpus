  "text": "proprium.commemoratio-omnium-fidelium-defunctorum-missa-ii-secreta",
  "about": "The secreta of the formulary “Commemoration of All the Faithful Departed — Mass II” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord, be pleased to accept our humble prayers for the souls of Your servants and handmaids, in whose behalf we offer You the sacrifice of praise that You may mercifully admit them into the fellowship of Your Saints. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God," },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
