  "text": "proprium.dominica-iv-adventus-secreta",
  "about": "The secret of the Fourth Sunday of Advent. It asks that the offering serve two things at once, our devotion and our salvation.",
  "segments": {
    "s01": { "translation": "Lord, we pray, look favorably upon these sacrifices, so that they may serve both our devotion and salvation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w015", "w016"], "anchor": "w015", "gloss": "our Lord" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "Jesus Christ" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "Your Son" }, { "words": ["w021", "w022", "w023", "w024", "w025"], "anchor": "w023", "gloss": "who lives and reigns with You" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w031", "w032", "w033", "w034"], "anchor": "w033", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
