  "text": "proprium.sanctissimi-nominis-iesu-collecta",
  "about": "The collecta of the formulary “Most Holy Name of Jesus” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who appointed Your only-begotten Son as Savior of the human race and commanded Him to be called Jesus, mercifully grant that we who venerate His holy name on earth may also enjoy the sight of Him in heaven. Through this same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w003", "w004", "w005", "w006"], "anchor": "w006", "gloss": "appointed Your only-begotten Son" }, { "words": ["w007", "w008", "w009"], "anchor": "w009", "gloss": "as Savior of the human race" }, { "words": ["w011", "w012", "w013"], "anchor": "w013", "gloss": "commanded that He be called Jesus" }, { "words": ["w017", "w018", "w019", "w020", "w021", "w022"], "anchor": "w020", "gloss": "we who venerate His holy name on earth" }, { "words": ["w023", "w024", "w025", "w026"], "anchor": "w026", "gloss": "may also enjoy the sight of Him" }, { "words": ["w030", "w031", "w032", "w033", "w034"], "anchor": "w031", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "Your Son" }, { "words": ["w044", "w045"], "anchor": "w044", "gloss": "of the Holy Spirit" }, { "words": ["w047", "w048", "w049", "w050"], "anchor": "w049", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
