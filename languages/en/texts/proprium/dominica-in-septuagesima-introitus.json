  "text": "proprium.dominica-in-septuagesima-introitus",
  "about": "The introitus of the formulary “Septuagesima Sunday” in the 1962 Roman Missal.\n\nThe proper page prints the antiphon and psalm verse, followed by short cues for Gloria Patri and the repeated antiphon. The complete doxology and repetition follow the common formula and rubrics.",
  "segments": {
    "s01": { "translation": "The groans of death surrounded me, and the sorrows of hell encompassed me; in my tribulation I called upon the Lord, and He heard my voice from His holy temple. I will love You, O Lord, my strength; the Lord is my support, my refuge, and my deliverer. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever will be, forever and ever. Amen. The groans of death surrounded me, and the sorrows of hell encompassed me; in my tribulation I called upon the Lord, and He heard my voice from His holy temple.", "alignments": [{ "words": ["w001", "w002", "w003", "w004"], "anchor": "w001", "gloss": "The groans of death surrounded me" }, { "words": ["w011", "w012"], "anchor": "w011", "gloss": "my tribulation" }, { "words": ["w018", "w019", "w020"], "anchor": "w018", "gloss": "His holy temple" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "my voice" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "my strength" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "my support" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "my refuge" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "my deliverer" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "to the Holy Spirit" }, { "words": ["w053", "w054", "w055"], "anchor": "w054", "gloss": "forever and ever" }, { "words": ["w057", "w058", "w059", "w060"], "anchor": "w057", "gloss": "The groans of death surrounded me" }, { "words": ["w067", "w068"], "anchor": "w067", "gloss": "my tribulation" }, { "words": ["w074", "w075", "w076"], "anchor": "w074", "gloss": "His holy temple" }, { "words": ["w077", "w078"], "anchor": "w077", "gloss": "my voice" }] }
