  "text": "proprium.dominica-in-quinquagesima-introitus",
  "about": "The introitus of the formulary “Quinquagesima Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Be for me a protecting God and a place of refuge, that You may save me; for You are my support and my refuge, and for Your name’s sake You will be my guide and nourish me. In You, O Lord, I have hoped; may I never be put to shame. In Your justice deliver me and rescue me. Glory to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and always, and forever and ever. Amen. Be for me a protecting God and a place of refuge, that You may save me; for You are my support and my refuge, and for Your name’s sake You will be my guide and nourish me.", "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w003", "gloss": "a protecting God" }, { "words": ["w007", "w008", "w009"], "anchor": "w007", "gloss": "a place of refuge" }, { "words": ["w011", "w012", "w013"], "anchor": "w011", "gloss": "You may save me" }, { "words": ["w015", "w016", "w017", "w018", "w019", "w020", "w021"], "anchor": "w015", "gloss": "You are my support and my refuge" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "Your name" }, { "words": ["w026", "w027", "w028"], "anchor": "w026", "gloss": "You will be my guide" }, { "words": ["w036", "w037", "w038", "w039"], "anchor": "w036", "gloss": "may I never be put to shame" }, { "words": ["w041", "w042"], "anchor": "w041", "gloss": "Your justice" }, { "words": ["w053", "w054"], "anchor": "w053", "gloss": "to the Holy Spirit" }, { "words": ["w063", "w064", "w065", "w066"], "anchor": "w063", "gloss": "and forever and ever" }, { "words": ["w070", "w071", "w072"], "anchor": "w070", "gloss": "a protecting God" }, { "words": ["w074", "w075", "w076"], "anchor": "w074", "gloss": "a place of refuge" }, { "words": ["w078", "w079", "w080"], "anchor": "w078", "gloss": "You may save me" }, { "words": ["w082", "w083", "w084", "w085", "w086", "w087", "w088"], "anchor": "w082", "gloss": "You are my support and my refuge" }, { "words": ["w091", "w092"], "anchor": "w091", "gloss": "Your name" }, { "words": ["w093", "w094", "w095"], "anchor": "w093", "gloss": "You will be my guide" }] }
