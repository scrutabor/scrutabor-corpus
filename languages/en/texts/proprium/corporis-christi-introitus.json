  "text": "proprium.corporis-christi-introitus",
  "about": "The Introit of the feast of the Most Holy Body of Christ. It presents God feeding His people with the finest wheat and honey from the rock, while the psalm verse summons them to joyful praise.",
  "segments": {
    "s01": { "translation": "He fed them with the finest wheat, alleluia, and filled them with honey from the rock, alleluia, alleluia, alleluia." },
    "s02": { "translation": "Rejoice in God our helper; sing aloud unto the God of Jacob." },
    "s03": { "translation": "Glory be to the Father, and to the Son, and to the Holy Ghost. As it was in the beginning, is now, and ever shall be, world without end. Amen." },
    "s04": { "narrative": "When it is finished, the antiphon Cibávit eos is repeated as far as the psalm." },
    "s05": { "translation": "He fed them with the finest wheat, alleluia, and filled them with honey from the rock, alleluia, alleluia, alleluia." }
