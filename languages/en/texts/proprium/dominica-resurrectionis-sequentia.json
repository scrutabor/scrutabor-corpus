  "text": "proprium.dominica-resurrectionis-sequentia",
  "about": "The sequentia of the formulary “Easter Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Let Christians offer their praises as a sacrifice to the paschal Victim. The Lamb redeemed the sheep. The innocent Christ reconciled sinners to the Father. Death and life clashed in wondrous combat. The leader of life, who died, reigns alive. Tell us, Mary: What did you see on the way? I saw the tomb of the living Christ and the glory of the risen One. Angelic witnesses, the facecloth, and the garments. Christ, my hope, has risen. He will go ahead of you into Galilee. We know that Christ truly rose from the dead. You, victorious King, have mercy on us. Amen. Alleluia.", "alignments": [{ "words": ["w001", "w002"], "gloss": "To the paschal Victim", "anchor": "w001" }, { "words": ["w003", "w004", "w005"], "gloss": "let Christians offer praises", "anchor": "w004" }, { "words": ["w017", "w018", "w019"], "gloss": "contended in a wondrous battle", "anchor": "w018" }, { "words": ["w036", "w037", "w038"], "gloss": "I saw the glory of the risen One", "anchor": "w037" }, { "words": ["w044", "w045", "w046", "w047"], "gloss": "Christ, my hope, has risen", "anchor": "w044" }] }
