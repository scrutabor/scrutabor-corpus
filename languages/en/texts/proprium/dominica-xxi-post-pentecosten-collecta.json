    "s01": { "translation": "Guard Your household, we beseech You, O Lord, with unceasing care, that under Your protection it may be free from all harm and be devoted to Your name in good deeds. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "Your household" }, { "words": ["w012", "w013"], "anchor": "w013", "gloss": "with You protecting" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "our Lord" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "Your Son" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
