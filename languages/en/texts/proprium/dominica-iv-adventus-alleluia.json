  "text": "proprium.dominica-iv-adventus-alleluia",
  "about": "The alleluia verse of the Fourth Sunday of Advent. The last Sunday before Christmas asks one thing, that He not delay. On the ferias of Advent, when this Sunday Mass is used through the week, the Alleluia and its verse are omitted and only the gradual is said.",
  "segments": {
    "s01": { "translation": "Alleluia, alleluia.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 106", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s02": { "translation": "Come, O Lord, and do not delay; forgive the offenses of Your people Israel.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 106", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w010", "w011"], "anchor": "w010", "gloss": "of Your people" }] },
