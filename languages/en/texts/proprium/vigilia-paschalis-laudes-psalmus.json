  "text": "proprium.vigilia-paschalis-laudes-psalmus",
  "about": "After Communion and the ablutions, Psalm 150 is sung for Lauds of Easter Sunday. A triple Alleluia precedes the psalm and is repeated after its doxology.",
  "segments": {
    "s01": { "translation": "Alleluia, alleluia, alleluia." },
    "s02": { "translation": "Praise the Lord in His sanctuary; praise Him in His majestic firmament.", "alignments": [{ "words": ["w007", "w008"], "anchor": "w007", "gloss": "His sanctuary" }, { "words": ["w012", "w013", "w014"], "anchor": "w013", "gloss": "His majestic firmament" }] },
    "s03": { "translation": "Praise Him for His great works; praise Him for His supreme majesty.", "alignments": [{ "words": ["w018", "w019", "w020"], "anchor": "w019", "gloss": "His great works" }, { "words": ["w024", "w025", "w026"], "anchor": "w025", "gloss": "His supreme majesty" }] },
    "s04": { "translation": "Praise Him with the blast of a trumpet; praise Him with psaltery and cithara." },
    "s05": { "translation": "Praise Him with drum and dance; praise Him with strings and pipe." },
    "s06": { "translation": "Praise Him with resounding cymbals; praise Him with clashing cymbals. Let everything that breathes praise the Lord!", "alignments": [{ "words": ["w048", "w049"], "anchor": "w048", "gloss": "with resounding cymbals" }, { "words": ["w052", "w053"], "anchor": "w052", "gloss": "with clashing cymbals" }] },
    "s07": { "translation": "Glory to the Father, and to the Son, and to the Holy Spirit,", "alignments": [{ "words": ["w064", "w065"], "anchor": "w064", "gloss": "to the Holy Spirit" }] },
    "s08": { "translation": "as it was in the beginning, so it is now and always, forever and ever. Amen.", "alignments": [{ "words": ["w075", "w076", "w077"], "anchor": "w076", "gloss": "forever and ever" }] },
    "s09": { "translation": "Alleluia, alleluia, alleluia." }
  },
