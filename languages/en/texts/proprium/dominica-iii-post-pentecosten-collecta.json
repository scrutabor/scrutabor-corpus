  "about": "The collecta of the formulary “3rd Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, protector of all who hope in You, without Whom nothing is strong, nothing is holy, increase Your mercy toward us, that, with Your guidance and direction we may so pass through the things of this temporal life as not to lose those of life eternal. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w029", "w030"], "anchor": "w030", "gloss": "we may not lose" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
