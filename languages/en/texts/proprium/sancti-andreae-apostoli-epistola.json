  "about": "The epistola of the formulary “Saint Andrew the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Brothers: For belief in the heart leads to justice, and profession of faith with the mouth leads to salvation. For Scripture says: “Everyone who believes in Him will not be put to shame.” For there is no distinction between Jew and Greek: all have the same Lord, who is generous to all who call upon Him. For everyone who calls upon the name of the Lord will be saved. How then will they call upon Him in whom they have not believed? Or how will they believe Him whom they have not heard? And how will they hear without a preacher? And how will they preach unless they are sent? As it is written: “How beautiful are the feet of those who bring good news of peace, of those who bring good news of good things!” But not all obey the Gospel. For Isaiah says: “Lord, who has believed our report?” Therefore faith comes from hearing, and hearing through the word of Christ. But I say: “Have they not heard?” Yes, indeed: “Their voice has gone out into all the earth, and their words to the ends of the world.”", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "For with the heart" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "and with the mouth" }, { "words": ["w009", "w010"], "anchor": "w009", "gloss": "confession is made" }, { "words": ["w013", "w014", "w015"], "anchor": "w013", "gloss": "For Scripture says" }, { "words": ["w021", "w022"], "anchor": "w022", "gloss": "will not be put to shame" }, { "words": ["w023", "w024", "w025"], "anchor": "w025", "gloss": "For there is no" }, { "words": ["w027", "w028", "w029"], "anchor": "w027", "gloss": "between Jew and Greek" }, { "words": ["w031", "w032"], "anchor": "w032", "gloss": "the same Lord" }, { "words": ["w040", "w041", "w042"], "anchor": "w040", "gloss": "For everyone who" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "will be saved" }, { "words": ["w051", "w052"], "anchor": "w052", "gloss": "Him in whom" }, { "words": ["w053", "w054"], "anchor": "w054", "gloss": "they have not believed" }, { "words": ["w060", "w061"], "anchor": "w061", "gloss": "they have not heard" }, { "words": ["w062", "w063"], "anchor": "w062", "gloss": "And how" }, { "words": ["w073", "w074"], "anchor": "w073", "gloss": "it is written" }, { "words": ["w075", "w076", "w077"], "anchor": "w076", "gloss": "How beautiful are the feet" }, { "words": ["w087", "w088", "w089"], "anchor": "w089", "gloss": "For Isaiah says" }, { "words": ["w093", "w094"], "anchor": "w093", "gloss": "our report" }, { "words": ["w099", "w100"], "anchor": "w099", "gloss": "and hearing" }, { "words": ["w106", "w107", "w108"], "anchor": "w108", "gloss": "Have they not heard" }, { "words": ["w109", "w110"], "anchor": "w110", "gloss": "Yes indeed" }, { "words": ["w115", "w116"], "anchor": "w115", "gloss": "their voice" }, { "words": ["w120", "w121"], "anchor": "w120", "gloss": "of the world" }, { "words": ["w122", "w123"], "anchor": "w122", "gloss": "their words" }] }
  },
