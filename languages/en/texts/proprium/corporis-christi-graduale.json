  "text": "proprium.corporis-christi-graduale",
  "about": "The Gradual of the feast of the Most Holy Body of Christ. It praises God, in whom all place their hope and who feeds every creature in due season.",
  "segments": {
    "s01": { "translation": "The eyes of all hope in Thee, O Lord, and Thou givest them food in due season." },
    "s02": { "translation": "Thou openest Thy hand and fillest every living creature with blessing." }
  },
