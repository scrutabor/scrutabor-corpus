  "text": "proprium.dominica-xi-post-pentecosten-secreta",
  "about": "The secreta of the formulary “11th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Look with mercy, we beseech You, O Lord, upon our act of worship that the gift we offer may be acceptable to You and may support us in our frailty. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
