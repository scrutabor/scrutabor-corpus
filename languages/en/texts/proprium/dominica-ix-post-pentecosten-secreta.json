  "text": "proprium.dominica-ix-post-pentecosten-secreta",
  "about": "The secreta of the formulary “9th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant us, we beseech You, O Lord, to take part worthily and frequently in these mysteries: for as often as the commemoration of this sacrifice is celebrated, the work of our redemption is carried out. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God," },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
