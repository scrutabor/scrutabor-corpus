  "text": "proprium.dominica-ii-in-quadragesima-secreta",
  "about": "The secreta of the formulary “Second Sunday of Lent” in the 1962 Roman Missal. The same prayer is used in the formulary of the Fourth Sunday of Lent.",
  "segments": {
    "s01": { "translation": "Look graciously, we beseech You, O Lord, upon the present sacrifices, that they may profit both our devotion and our salvation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "The present sacrifices" }, { "words": ["w008", "w009", "w010"], "anchor": "w009", "gloss": "both our devotion" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "our Lord" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "Jesus Christ" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "Your Son" }, { "words": ["w021", "w022", "w023", "w024", "w025"], "anchor": "w023", "gloss": "who lives and reigns with You" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w031", "w032", "w033", "w034"], "anchor": "w033", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
