  "about": "The Gospel of the Sixth Sunday after Epiphany in the 1962 Roman Missal, also used when this formulary is resumed after Pentecost.",
  "segments": {
    "s01": { "translation": "At that time, Jesus told the crowds this parable: The kingdom of heaven is like a grain of mustard, which a man took and sowed in his field. It is indeed the least of all seeds, but when it has grown, it is greater than all garden plants and becomes a tree, so that the birds of the sky come and live in its branches. He spoke another parable to them: The kingdom of heaven is like leaven, which a woman took and hid in three measures of meal, until the whole was leavened. Jesus spoke all these things in parables to the crowds, and He did not speak to them without parables, so that there might be fulfilled what had been spoken through the prophet, who said: I will open My mouth in parables; I will pour forth things hidden from the founding of the world.", "alignments": [{ "words": ["w004", "w005", "w006", "w007", "w008"], "anchor": "w004", "gloss": "Jesus told the crowds this parable:" }, { "words": ["w009", "w010", "w011", "w012"], "anchor": "w010", "gloss": "The kingdom of heaven is like" }, { "words": ["w015", "w016", "w017", "w018"], "anchor": "w018", "gloss": "which a man took and sowed" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "his field" }, { "words": ["w022", "w023", "w024", "w025"], "anchor": "w025", "gloss": "which is indeed the smallest" }, { "words": ["w031", "w032"], "anchor": "w032", "gloss": "it is greater" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "its branches" }, { "words": ["w048", "w049", "w050", "w051", "w052"], "anchor": "w050", "gloss": "He told them another parable:" }, { "words": ["w053", "w054", "w055", "w056"], "anchor": "w054", "gloss": "The kingdom of heaven is like" }, { "words": ["w058", "w059", "w060", "w061"], "anchor": "w061", "gloss": "which a woman took and hid" }, { "words": ["w063", "w064", "w065"], "anchor": "w064", "gloss": "three measures of flour" }, { "words": ["w067", "w068", "w069"], "anchor": "w067", "gloss": "the whole was leavened" }, { "words": ["w070", "w071