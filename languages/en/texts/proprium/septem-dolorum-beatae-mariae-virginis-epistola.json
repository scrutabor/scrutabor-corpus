  "text": "proprium.septem-dolorum-beatae-mariae-virginis-epistola",
  "about": "The epistola of the formulary “Seven Sorrows of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "The Lord has blessed you by His power, because by you He has brought our enemies to naught. Blessed are you, O daughter, by the Lord the Most High God, above all women upon the earth. Blessed be the Lord Who made heaven and earth, because He has so magnified your name this day, that your praise will not depart out of the mouth of men, who will be mindful of the power of the Lord forever; for whose sake you have not spared your life, by reason of the distress and tribulation of your people, but have prevented our ruin in the presence of our God.", "alignments": [{ "words": ["w005", "w006"], "anchor": "w005", "gloss": "His power" }, { "words": ["w013", "w014"], "anchor": "w013", "gloss": "our enemies" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "your name" }, { "words": ["w044", "w045"], "anchor": "w044", "gloss": "your praise" }, { "words": ["w058", "w059"], "anchor": "w059", "gloss": "you did not spare" }, { "words": ["w060", "w061"], "anchor": "w060", "gloss": "your life" }, { "words": ["w066", "w067"], "anchor": "w066", "gloss": "of your people" }, { "words": ["w073", "w074"], "anchor": "w073", "gloss": "of our God" }] }
  },
