  "about": "The epistola of the formulary “Fourth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Dearly beloved: Every excellent gift and every perfect gift is from above, coming down from the Father of lights, with whom there is no change nor shadow of alteration. For of His own will He begot us by the word of truth, that we might be a kind of first fruits of His creation. You know this, my dearest brothers. And let every man be swift to hear, but slow to speak and slow to anger. For the anger of man does not work the justice of God. Therefore, casting away all uncleanness and abundance of malice, receive with meekness the implanted word, which is able to save your souls.", "alignments": [{ "words": ["w002", "w003", "w004"], "anchor": "w003", "gloss": "Every excellent gift" }, { "words": ["w006", "w007", "w008"], "anchor": "w007", "gloss": "every perfect gift" }, { "words": ["w009", "w010"], "anchor": "w010", "gloss": "is from above" }, { "words": ["w017", "w018"], "anchor": "w018", "gloss": "there is no" }, { "words": ["w021", "w022"], "anchor": "w022", "gloss": "shadow of alteration" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "For of His own will" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "a kind of beginning" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "of His creation" }, { "words": ["w036", "w037", "w038"], "anchor": "w036", "gloss": "my dearest brothers" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "And let" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "but slow" }, { "words": ["w054", "w055"], "anchor": "w054", "gloss": "For the anger" }, { "words": ["w059", "w060"], "anchor": "w060", "gloss": "does not work" }, { "words": ["w062"], "reason": "idiom" }, { "words": ["w072", "w073"], "anchor": "w073", "gloss": "the implanted word" }, { "words": ["w077", "w078"], "anchor": "w077", "gloss": "your souls" }] }
  },
