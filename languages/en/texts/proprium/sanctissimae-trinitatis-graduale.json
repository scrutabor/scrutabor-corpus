  "text": "proprium.sanctissimae-trinitatis-graduale",
  "about": "The Gradual of the feast of the Most Holy Trinity. It blesses God, who beholds the depths, sits above the Cherubim, and reigns in the firmament of heaven.",
  "segments": {
    "s01": { "translation": "Blessed are You, O Lord, who look upon the depths and sit above the Cherubim," },
    "s02": { "translation": "Blessed are You, O Lord, in the firmament of heaven, and worthy of praise forever." }
