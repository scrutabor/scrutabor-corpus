  "text": "proprium.visitatio-beatae-mariae-virginis-collecta",
  "about": "The collecta of the formulary “Visitation of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Bestow upon Your servants, we beseech You, O Lord, the gift of heavenly grace, that as the child-bearing of the Blessed Virgin marked the beginning of our salvation, so may the solemn feast of her Visitation bring us an increase of peace. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w038", "w039"], "anchor": "w038", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
