  "about": "The introitus of the formulary “Second Sunday of Lent” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Remember Your compassions, O Lord, and Your mercy, which are from everlasting; let our enemies never have dominion over us; O God of Israel, deliver us from all our distresses. To You, O Lord, I have lifted up my soul. My God, I trust in You: let me not be ashamed. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. Remember Your compassions, O Lord, and Your mercy, which are from everlasting; let our enemies never have dominion over us; O God of Israel, deliver us from all our distresses.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "Your tender mercies" }, { "words": ["w006", "w007"], "anchor": "w006", "gloss": "Your mercy" }, { "words": ["w009", "w010"], "anchor": "w010", "gloss": "of old" }, { "words": ["w012", "w013", "w014", "w015", "w016", "w017"], "anchor": "w014", "gloss": "let our enemies never rule over us" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "our tribulations" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "my soul" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "my God" }, { "words": ["w037", "w038"], "anchor": "w038", "gloss": "let me not be ashamed" }, { "words": ["w044", "w045"], "anchor": "w044", "gloss": "to the Holy Spirit" }, { "words": ["w060", "w061"], "anchor": "w060", "gloss": "Your tender mercies" }, { "words": ["w064", "w065"], "anchor": "w064", "gloss": "Your mercy" }, { "words": ["w067", "w068"], "anchor": "w068", "gloss": "of old" }, { "words": ["w070", "w071", "w072", "w073", "w074", "w075"], "anchor": "w072", "gloss": "let our enemies never rule over us" }, { "words": ["w082", "w083"], "anchor": "w082", "gloss": "our tribulations" }] }
