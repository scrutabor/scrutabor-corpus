  "text": "proprium.sanctissimae-trinitatis-introitus",
  "about": "The Introit of the feast of the Most Holy Trinity. It blesses the Triune God for His mercy and, in the psalm verse, praises His name throughout the earth.",
  "segments": {
    "s01": { "translation": "Blessed be the Holy Trinity and undivided Unity; we will praise Him, for He has shown us His mercy.", "alignments": [{ "words": ["w013", "w014"], "anchor": "w013", "gloss": "His mercy" }] },
    "s02": { "translation": "O Lord, our Lord, how wonderful is Your name in all the earth!", "alignments": [{ "words": ["w016", "w017"], "anchor": "w016", "gloss": "our Lord" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "Your name" }] },
    "s03": { "translation": "Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen.", "alignments": [{ "words": ["w031", "w032"], "anchor": "w031", "gloss": "to the Holy Spirit" }, { "words": ["w042", "w043", "w044"], "anchor": "w043", "gloss": "forever and ever" }] },
    "s04": { "narrative": "When it is finished, the antiphon “Benedícta sit sancta Trínitas” is repeated up to the psalm." },
    "s05": { "translation": "Blessed be the Holy Trinity and undivided Unity; we will praise Him, for He has shown us His mercy.", "alignments": [{ "words": ["w058", "w059"], "anchor": "w058", "gloss": "His mercy" }] }
  },
