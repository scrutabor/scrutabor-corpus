  "about": "The introitus of the formulary “9th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Behold, God helps me, and the Lord is the upholder of my soul. Turn back the evils upon my enemies, and in Your truth destroy them, O Lord, my protector. O God, save me in Your name, and set me free in Your strength. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. Behold, God helps me, and the Lord is the upholder of my soul. Turn back the evils upon my enemies, and in Your truth destroy them, O Lord, my protector.", "alignments": [{ "words": ["w009", "w010"], "anchor": "w009", "gloss": "of my soul" }, { "words": ["w013", "w014"], "anchor": "w013", "gloss": "upon my enemies" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "Your truth" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "my protector" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Your name" }, { "words": ["w030"], "reason": "idiom" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "Your might" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "to the Holy Spirit" }, { "words": ["w065", "w066"], "anchor": "w065", "gloss": "of my soul" }, { "words": ["w069", "w070"], "anchor": "w069", "gloss": "upon my enemies" }, { "words": ["w073", "w074"], "anchor": "w073", "gloss": "Your truth" }, { "words": ["w077", "w078"], "anchor": "w077", "gloss": "my protector" }] }
