  "text": "proprium.sancti-thomae-apostoli-postcommunio",
  "about": "The postcommunio of the formulary “Saint Thomas the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Merciful God, abide with us, and through the intercession of Your blessed Apostle Thomas, mercifully safeguard the gifts You have given us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w009", "w010", "w011"], "anchor": "w010", "gloss": "of blessed Thomas the Apostle" }, { "words": ["w012", "w013", "w014", "w015", "w016"], "anchor": "w016", "gloss": "appeased, Your gifts toward us" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "our Lord" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "Jesus Christ" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Your Son" }, { "words": ["w025", "w026", "w027", "w028", "w029"], "anchor": "w027", "gloss": "who lives and reigns with You" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "of the Holy Spirit" }, { "words": ["w035", "w036", "w037", "w038"], "anchor": "w037", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
