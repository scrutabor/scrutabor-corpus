  "text": "proprium.ascensio-domini-evangelium",
  "about": "The evangelium of the formulary “Ascension of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At that time, as the eleven disciples were at table, Jesus appeared to them and upbraided them for their unbelief and hardness of heart, because they did not believe those who had seen Him risen. And He said to them: Go into the whole world and preach the Gospel to every creature. He who believes and is baptized will be saved; but he who does not believe will be condemned. And these signs will follow those who believe: in My name they will cast out demons; they will speak with new tongues; they will take up serpents; and if they drink anything deadly, it will not hurt them; they will lay their hands upon the sick, and they will recover. And the Lord Jesus, after He had spoken to them, was taken up into heaven and sits at the right hand of God. And they, going forth, preached everywhere, the Lord working with them and confirming the word by the signs that followed.", "alignments": [{ "words": ["w012", "w013"], "anchor": "w012", "gloss": "their unbelief" }, { "words": ["w023", "w024"], "anchor": "w024", "gloss": "they did not believe" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "is baptized" }, { "words": ["w045", "w046"], "anchor": "w046", "gloss": "does not believe" }, { "words": ["w056", "w057"], "anchor": "w056", "gloss": "My name" }, { "words": ["w078", "w079"], "anchor": "w079", "gloss": "will be well" }, { "words": ["w085", "w086"], "anchor": "w085", "gloss": "He had spoken" }, { "words": ["w088", "w089"], "anchor": "w088", "gloss": "was taken up" }, { "words": ["w097", "w098"], "anchor": "w097", "gloss": "And they" }] },
    "s02": { "narrative": "After the Gospel has been read, the Paschal candle is extinguished." }
  },
