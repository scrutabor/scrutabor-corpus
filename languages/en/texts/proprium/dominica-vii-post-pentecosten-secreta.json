  "text": "proprium.dominica-vii-post-pentecosten-secreta",
  "about": "The secreta of the formulary “7th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who through the perfection of one sacrifice have confirmed the varied sacrifices of the Law, receive the sacrifice from servants devoted to You and sanctify it with the same blessing You bestowed on the gifts of Abel, so that what each has offered in honor of Your majesty may contribute to the salvation of all. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w003", "w004", "w005", "w006", "w007", "w008", "w009"], "anchor": "w009", "gloss": "through the perfection of one sacrifice have confirmed the varied sacrifices of the Law" }, { "words": ["w013", "w014", "w015"], "anchor": "w015", "gloss": "servants devoted to You" }, { "words": ["w017", "w018", "w019", "w020", "w021", "w022"], "anchor": "w022", "gloss": "sanctify it with the same blessing You bestowed on the gifts of Abel" }, { "words": ["w028", "w029", "w030"], "anchor": "w030", "gloss": "the honor of Your majesty" }, { "words": ["w031", "w032", "w033", "w034"], "anchor": "w032", "gloss": "may contribute to the salvation of all" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "our Lord" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "Your Son" }, { "words": ["w049", "w050"], "anchor": "w049", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w052", "w053", "w054", "w055"], "anchor": "w054", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
