  "text": "proprium.nativitas-domini-in-aurora-collecta",
  "about": "The collecta of the formulary “Nativity of the Lord — Mass at Dawn” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant us, we beseech You, almighty God, that, since we are flooded with the new light of Your incarnate Word, what shines in our minds through faith may shine forth in our deeds. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w008", "w009", "w010", "w011", "w012"], "anchor": "w012", "gloss": "with the new light of Your incarnate Word" }, { "words": ["w015", "w016", "w017", "w018"], "anchor": "w017", "gloss": "may shine forth in our deed" }, { "words": ["w026", "w027", "w028", "w029", "w030"], "anchor": "w027", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "Your Son" }, { "words": ["w033", "w034", "w035", "w036", "w037"], "anchor": "w035", "gloss": "who lives and reigns with You" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "of the Holy Spirit" }, { "words": ["w043", "w044", "w045", "w046"], "anchor": "w045", "gloss": "forever and ever" }] },
    "s04": { "translation": "Amen." },
    "s02": { "narrative": "Then commemoration is made of Saint Anastasia, Martyr, even in sung Masses." },
    "s03": { "translation": "Grant, we beseech You, almighty God, that we who keep the solemnity of blessed Anastasia, Your Martyr, may experience her patronage before You. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w054", "w055", "w056", "w057", "w058", "w059"], "anchor": "w059", "gloss": "honor the solemnity of blessed Anastasia, Your Martyr" }, { "words": ["w060", "w061", "w062", "w063", "w064"], "anchor": "w064", "gloss": "may experience her patronage before You" }, { "words": ["w066", "w067"], "anchor": "w066", "gloss": "our Lord" }, { "words": ["w068", "w069"], "anchor": "w068", "gloss": "Jesus Christ" }, { "words": ["w070", "w071"], "anchor": "w070", "gloss": "Your Son" }, { "words": ["w072", "w073", "w074", "w075", "w076"], "anchor": "w074", "gloss": "who lives and reigns with You" }, { "words": ["w079", "w080"], "anchor": "w079", "gloss": "of the Holy Spirit" }, { "words": ["w082", "w083", "w084", "w085"], "anchor": "w084", "gloss": "forever and ever" }] },
    "s05": { "translation": "Amen." }
  },
