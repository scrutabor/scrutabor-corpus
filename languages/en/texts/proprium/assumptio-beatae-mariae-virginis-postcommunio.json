  "text": "proprium.assumptio-beatae-mariae-virginis-postcommunio",
  "about": "The postcommunio of the formulary “Assumption of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Having received, O Lord, the sacraments of salvation, grant, we beseech You, that through the merits and intercession of the Blessed Virgin Mary, who was taken up into heaven, we may be brought to the glory of the resurrection. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
