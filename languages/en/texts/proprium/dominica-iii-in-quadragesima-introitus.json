  "about": "The introitus of the formulary “Third Sunday of Lent” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "My eyes are ever toward the Lord, for He will pluck my feet out of the snare: look upon me, and have mercy on me, for I am alone and poor. To You, O Lord, I have lifted up my soul. My God, I trust in You: let me not be ashamed. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. My eyes are ever toward the Lord, for He will pluck my feet out of the snare: look upon me, and have mercy on me, for I am alone and poor.", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "My eyes" }, { "words": ["w011", "w012"], "anchor": "w011", "gloss": "my feet" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "my soul" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "my God" }, { "words": ["w036", "w037"], "anchor": "w037", "gloss": "let me not be ashamed" }, { "words": ["w043", "w044"], "anchor": "w043", "gloss": "to the Holy Spirit" }, { "words": ["w058", "w059"], "anchor": "w058", "gloss": "My eyes" }, { "words": ["w068", "w069"], "anchor": "w068", "gloss": "my feet" }] }
