  "about": "The introitus of the formulary “4th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "The Lord is my light and my salvation; whom shall I fear? The Lord is the defender of my life; before whom shall I tremble? My enemies who trouble me have themselves grown weak and have fallen. Should armies take their stand against me, my heart will not fear. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. The Lord is my light and my salvation; whom shall I fear? The Lord is the defender of my life; before whom shall I tremble? My enemies who trouble me have themselves grown weak and have fallen.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "my light" }, { "words": ["w005", "w006"], "anchor": "w005", "gloss": "my salvation" }, { "words": ["w011", "w012"], "anchor": "w011", "gloss": "of my life" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "my enemies" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "have grown weak" }, { "words": ["w031", "w032", "w033", "w034"], "anchor": "w032", "gloss": "my heart will not fear" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "to the Holy Spirit" }, { "words": ["w056", "w057"], "anchor": "w056", "gloss": "my light" }, { "words": ["w059", "w060"], "anchor": "w059", "gloss": "my salvation" }, { "words": ["w065", "w066"], "anchor": "w065", "gloss": "of my life" }, { "words": ["w073", "w074"], "anchor": "w073", "gloss": "my enemies" }, { "words": ["w076", "w077"], "anchor": "w076", "gloss": "have grown weak" }] }
