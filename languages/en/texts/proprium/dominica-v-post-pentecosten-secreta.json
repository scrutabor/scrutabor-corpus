  "text": "proprium.dominica-v-post-pentecosten-secreta",
  "about": "The secreta of the formulary “5th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Be propitious to our supplications, O Lord, and graciously receive these oblations of Your servants and handmaids, that what each one offered to the honor of Your name may profit all to salvation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w003", "w004"], "anchor": "w003", "gloss": "to our supplications" }, { "words": ["w008", "w009", "w010"], "anchor": "w008", "gloss": "of Your servants and handmaids" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "of Your name" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "our Lord" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "Your Son" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
