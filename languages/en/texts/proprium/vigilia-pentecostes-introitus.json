  "about": "The introitus of the formulary “Vigil of Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "When My holiness has been made manifest among you, I will gather you from all countries, and I will pour upon you clean water, and you will be cleansed from all your filthiness; and I will give you a new spirit, alleluia, alleluia. I will bless the Lord at all times; His praise will always be in my mouth. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. When My holiness has been made manifest among you, I will gather you from all countries, and I will pour upon you clean water, and you will be cleansed from all your filthiness; and I will give you a new spirit, alleluia, alleluia.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "My holiness has been made manifest" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "clean water" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "your filthiness" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "a new spirit" }, { "words": ["w035", "w036", "w037"], "anchor": "w036", "gloss": "His praise is always" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "my mouth" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "to the Holy Spirit" }, { "words": ["w057", "w058", "w059"], "anchor": "w058", "gloss": "forever and ever" }, { "words": ["w062", "w063"], "anchor": "w062", "gloss": "My holiness has been made manifest" }, { "words": ["w075", "w076"], "anchor": "w075", "gloss": "clean water" }, { "words": ["w081", "w082"], "anchor": "w081", "gloss": "your filthiness" }, { "words": ["w086", "w087"], "anchor": "w086", "gloss": "a new spirit" }] }
