  "text": "proprium.dominica-iii-adventus-secreta",
  "about": "The secret of the Third Sunday of Advent. The offering is to do two things: complete the rite, and work in those who make it.",
  "segments": {
    "s01": { "translation": "Lord, we pray, may the sacrifice of our devotion be offered to You unceasingly; may it fulfill the rites appointed for the sacred mystery, and may it wondrously bring about Your salvation in us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Jesus Christ" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Thy Son" }, { "words": ["w029", "w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "who liveth and reigneth with Thee" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Ghost" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "world without end" }] },
    "s03": { "translation": "Amen." }
  },
