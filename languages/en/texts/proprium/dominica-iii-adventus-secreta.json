  "text": "proprium.dominica-iii-adventus-secreta",
  "about": "The secret of the Third Sunday of Advent. The offering is to do two things: complete the rite, and work in those who make it.",
  "segments": {
    "s01": { "translation": "May the offering of our devotion, we pray, O Lord, be sacrificed to You without ceasing, that it may both carry out the ordinances of the sacred mystery and wondrously work Your salvation in us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "of our devotion" }, { "words": ["w011", "w012", "w013", "w014"], "anchor": "w012", "gloss": "may fulfill the rites of the sacred mystery" }, { "words": ["w016", "w017", "w018", "w019", "w020", "w021"], "anchor": "w021", "gloss": "may wondrously work Your salvation in us" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Jesus Christ" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your Son" }, { "words": ["w029", "w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "who lives and reigns with You" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
