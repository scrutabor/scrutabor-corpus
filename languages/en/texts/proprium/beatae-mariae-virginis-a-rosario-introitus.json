  "text": "proprium.beatae-mariae-virginis-a-rosario-introitus",
  "about": "The introitus of the formulary “Blessed Virgin Mary of the Rosary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Let us all rejoice in the Lord as we celebrate a feast day in honor of the blessed Virgin Mary. The angels rejoice at her feast and extol the Son of God. My heart has poured out a noble word. I myself recite my compositions to the King. Glory be to the Father, and to the Son, and to the Holy Ghost. As it was in the beginning, is now, and ever shall be, world without end. Amen. Let us all rejoice in the Lord as we celebrate a feast day in honor of the blessed Virgin Mary. The angels rejoice at her feast and extol the Son of God.", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "Let us all rejoice" }, { "words": ["w005", "w006", "w007"], "anchor": "w007", "gloss": "celebrating a feast day" }, { "words": ["w008", "w009"], "anchor": "w009", "gloss": "in honor" }, { "words": ["w010", "w011", "w012"], "anchor": "w011", "gloss": "of the blessed Virgin Mary" }, { "words": ["w013", "w014", "w015"], "anchor": "w015", "gloss": "at whose feast" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "the angels rejoice" }, { "words": ["w022", "w023", "w024"], "anchor": "w022", "gloss": "My heart has poured out" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "a noble word" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "I myself recite" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "my compositions" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "to the Holy Spirit" }, { "words": ["w048", "w049", "w050"], "anchor": "w049", "gloss": "forever and ever" }, { "words": ["w052", "w053"], "anchor": "w052", "gloss": "Let us all rejoice" }, { "words": ["w056", "w057", "w058"], "anchor": "w058", "gloss": "celebrating a feast day" }, { "words": ["w059", "w060"], "anchor": "w060", "gloss": "in honor" }, { "words": ["w061", "w062", "w063"], "anchor": "w062", "gloss": "of the blessed Virgin Mary" }, { "words": ["w064", "w065", "w066"], "anchor": "w066", "gloss": "at whose feast" }, { "word