  "text": "proprium.dominica-i-adventus-secreta",
  "about": "The secret of the First Sunday of Advent, said over the offerings in a voice nobody hears. It asks that these holy things cleanse us by their power and bring us purer to Him who is their beginning. The missal prints its conclusion in the two words Per Dóminum, and this edition keeps the abbreviation.",
  "segments": {
    "s01": { "translation": "Lord, may the mighty power of these sacred gifts cleanse us and bring us, purer still, to their source. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w015", "w016"], "anchor": "w015", "gloss": "our Lord" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "Jesus Christ" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "Your Son" }, { "words": ["w021", "w022", "w023", "w024", "w025"], "anchor": "w023", "gloss": "who lives and reigns with You" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w031", "w032", "w033", "w034"], "anchor": "w033", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
