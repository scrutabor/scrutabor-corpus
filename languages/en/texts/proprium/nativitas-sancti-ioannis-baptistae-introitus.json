  "about": "The introitus of the formulary “Nativity of Saint John the Baptist” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "From the womb of my mother the Lord has called me by my name, and He has set my mouth as a sharp sword; beneath the cover of His hand He has protected me, and He has set me as a chosen arrow. It is good to give praise to the Lord, and to sing psalms to Your name, O Most High. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. From the womb of my mother the Lord has called me by my name, and He has set my mouth as a sharp sword; beneath the cover of His hand He has protected me, and He has set me as a chosen arrow.", "alignments": [{ "words": ["w003", "w004"], "anchor": "w003", "gloss": "of my mother" }, { "words": ["w009", "w010"], "anchor": "w009", "gloss": "my name" }, { "words": ["w013", "w014"], "anchor": "w013", "gloss": "my mouth" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "of His hand" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "to Your name" }, { "words": ["w044", "w045"], "anchor": "w044", "gloss": "to the Holy Spirit" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "of my mother" }, { "words": ["w067", "w068"], "anchor": "w067", "gloss": "my name" }, { "words": ["w071", "w072"], "anchor": "w071", "gloss": "my mouth" }, { "words": ["w078", "w079"], "anchor": "w078", "gloss": "of His hand" }] }
