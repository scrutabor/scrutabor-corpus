  "text": "proprium.sancti-stephani-protomartyris-secreta",
  "about": "The secreta of the formulary “Saint Stephen, the First Martyr” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Receive our offerings, O Lord, in memory of Your saints, that, as their passion made them glorious, so may our devotion make us innocent. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w005", "w006", "w007"], "anchor": "w006", "gloss": "memory of Your Saints" }, { "words": ["w010", "w011", "w012", "w013"], "anchor": "w011", "gloss": "the passion made them glorious" }, { "words": ["w015", "w016", "w017", "w018"], "anchor": "w017", "gloss": "devotion may render us innocent" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "our Lord" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Jesus Christ" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "Your Son" }, { "words": ["w026", "w027", "w028", "w029", "w030"], "anchor": "w028", "gloss": "who lives and reigns with You" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w036", "w037", "w038", "w039"], "anchor": "w038", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
