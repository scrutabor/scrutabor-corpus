  "about": "The secreta of the formulary “Fourth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, through the venerable exchange of this sacrifice You have made us partakers of the one supreme Godhead. Grant, we beseech You, that as we know Your truth, so we may attain it by worthy conduct. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w027", "w028"], "anchor": "w027", "gloss": "our Lord" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "Your Son" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w043", "w044", "w045", "w046"], "anchor": "w045", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
