  "text": "proprium.dominica-iv-post-pascha-secreta",
  "about": "The secreta of the formulary “Fourth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, through the venerable exchange of this sacrifice You have made us partakers of the one supreme Godhead. Grant, we beseech You, that as we know Your truth, so we may attain it by worthy conduct. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "by whom we" }, { "words": ["w005", "w006", "w007", "w008"], "anchor": "w008", "gloss": "the venerable exchange of this sacrifice" }, { "words": ["w009", "w010", "w011", "w012", "w013"], "anchor": "w013", "gloss": "have been made partakers of the one supreme Godhead" }, { "words": ["w018", "w019", "w020"], "anchor": "w019", "gloss": "we know Your truth" }, { "words": ["w021", "w022", "w023", "w024", "w025"], "anchor": "w025", "gloss": "so we may attain it by worthy conduct" }, { "words": ["w026", "w027", "w028"], "anchor": "w027", "gloss": "Through our Lord" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "Your Son" }, { "words": ["w033", "w034", "w035"], "anchor": "w035", "gloss": "who lives with You" }, { "words": ["w038", "w039", "w040", "w041"], "anchor": "w039", "gloss": "in the unity of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w043", "w044", "w045", "w046"], "anchor": "w045", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
