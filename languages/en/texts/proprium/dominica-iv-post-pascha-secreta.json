  "text": "proprium.dominica-iv-post-pascha-secreta",
  "about": "The secreta of the formulary “Fourth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, Who through the venerable exchange of this sacrifice hast made us partakers of the one supreme Godhead, grant, we beseech Thee, that as we know Thy truth, so we may attain it by worthy conduct. Through our Lord Jesus Christ, Thy Son, Who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
