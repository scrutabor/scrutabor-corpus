  "about": "The Secret of the formulary “Purification of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord, heed our prayer, and give us the help of Your loving-kindness so that the gifts we offer before the eyes of Your majesty may be worthy of You. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w003", "w004"], "anchor": "w003", "gloss": "our prayers" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "our Lord" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Jesus Christ" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Your Son" }, { "words": ["w027", "w028", "w029", "w030", "w031"], "anchor": "w029", "gloss": "who lives and reigns with You" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w037", "w038", "w039", "w040"], "anchor": "w039", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
