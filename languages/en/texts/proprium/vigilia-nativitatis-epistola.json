  "about": "The epistola of the formulary “Vigil of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Paul, a servant of Jesus Christ, called to be an Apostle, set apart unto the Gospel of God, which He had promised beforehand through His Prophets in the holy Scriptures concerning His Son, Who was made unto Him of the seed of David according to the flesh; Who was appointed the Son of God in power, according to the Spirit of sanctification, by the resurrection from the dead, Jesus Christ our Lord. Through Him we received grace and apostleship, to bring all nations to the obedience of faith for His name, among whom are ye also called by Jesus Christ our Lord.", "alignments": [{ "words": ["w024", "w025"], "anchor": "w024", "gloss": "was made" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "appointed" }] }
  },
