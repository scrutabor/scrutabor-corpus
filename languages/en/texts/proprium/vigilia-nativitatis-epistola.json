  "about": "The epistola of the formulary “Vigil of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Paul, servant of Jesus Christ, an apostle by calling, set apart for the gospel of God that He had previously promised by His prophets in the sacred Scriptures about His Son, who was made to Him from David’s seed according to the flesh, who was predestined Son of God with power according to the spirit of sanctification, through the resurrection of Jesus Christ our Lord from the dead; through whom we have received grace and apostleship for obedience to the faith among all nations for the sake of His name, among whom you too are the called of Jesus Christ our Lord.", "alignments": [{ "words": ["w015", "w016"], "anchor": "w015", "gloss": "His prophets" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "the holy Scriptures" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "His Son" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "was made" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "was predestined" }, { "words": ["w047", "w048"], "anchor": "w047", "gloss": "our Lord" }, { "words": ["w062", "w063"], "anchor": "w062", "gloss": "His name" }, { "words": ["w072", "w073"], "anchor": "w072", "gloss": "our Lord" }] }
