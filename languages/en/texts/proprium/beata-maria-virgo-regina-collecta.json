  "text": "proprium.beata-maria-virgo-regina-collecta",
  "about": "The collecta of the formulary “Queenship of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant we beseech You, O Lord, that we who keep the feast of the Blessed Virgin Mary, Our Queen, safe under her protection, may be worthy to have peace now and glory in the future. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w011", "w012"], "anchor": "w011", "gloss": "our Queen" }, { "words": ["w014", "w015", "w016"], "anchor": "w015", "gloss": "fortified by her protection" }, { "words": ["w024", "w025"], "anchor": "w025", "gloss": "we may be worthy to attain" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "our Lord" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "Your Son" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
