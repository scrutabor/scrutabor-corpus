  "text": "proprium.dominica-i-in-quadragesima-secreta",
  "about": "The secreta of the formulary “First Sunday of Lent” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We solemnly offer the sacrifice that opens Lent, beseeching You, O Lord, that together with the restraint of bodily food we may also refrain from harmful pleasures. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w002", "w003"], "anchor": "w003", "gloss": "of the beginning of Lent" }, { "words": ["w006", "w007", "w008"], "anchor": "w008", "gloss": "beseeching You, Lord" }, { "words": ["w011", "w012", "w013"], "anchor": "w012", "gloss": "the restraint of bodily foods" }, { "words": ["w015", "w016", "w017"], "anchor": "w017", "gloss": "harmful pleasures too" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "our Lord" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Jesus Christ" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "Your Son" }, { "words": ["w026", "w027", "w028", "w029", "w030"], "anchor": "w028", "gloss": "who lives and reigns with You" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w036", "w037", "w038", "w039"], "anchor": "w038", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
