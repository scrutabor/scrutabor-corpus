  "text": "proprium.sancti-matthiae-apostoli-postcommunio",
  "about": "The postcommunio of the formulary “Saint Matthias the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, almighty God, we pray You, that through the intercession of blessed Matthias, Your Apostle, we may obtain pardon and peace through the holy things of which we have partaken. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
