  "about": "The introitus of the formulary “23rd Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "The Lord says: I think thoughts of peace, and not of affliction. You will call upon Me, and I will hear you, and I will bring back your captive people from every place. You have blessed Your land, O Lord; You have turned away the captivity of Jacob. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. The Lord says: I think thoughts of peace, and not of affliction. You will call upon Me, and I will hear you, and I will bring back your captive people from every place.", "alignments": [{ "words": ["w017", "w018", "w019"], "anchor": "w017", "gloss": "I will bring back your captive people" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Your land" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "to the Holy Spirit" }, { "words": ["w066", "w067", "w068"], "anchor": "w066", "gloss": "I will bring back your captive people" }] }
  },
