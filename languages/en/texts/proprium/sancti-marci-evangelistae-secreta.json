  "text": "proprium.sancti-marci-evangelistae-secreta",
  "about": "The secreta of the formulary “Saint Mark the Evangelist” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Bringing gifts to You on the feast of blessed Mark, Your Evangelist, we beseech You, O Lord: that, as the preaching of the Gospel made him glorious, so his intercession may make us acceptable to You in word and in deed. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w043", "w044"], "anchor": "w043", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w046", "w047", "w048", "w049"], "anchor": "w048", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
