  "text": "proprium.dominica-v-post-epiphaniam-secreta",
  "about": "The secreta of the formulary “Transferred Fifth Sunday after Epiphany” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We offer You, O Lord, this sacrifice of atonement, that You would mercifully absolve our sins and direct our faltering hearts. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
