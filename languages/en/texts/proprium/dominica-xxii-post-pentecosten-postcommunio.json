  "segments": {
    "s01": { "translation": "Lord, we have received the gifts of the sacred mystery, and we humbly pray that what You commanded us to do in remembrance of You may help us in our weakness. You live and reign with God the Father in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w004", "gloss": "the gifts of the sacred mystery" }, { "words": ["w010", "w011", "w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "You commanded us to do in remembrance of You" }, { "words": ["w016", "w017", "w018", "w019", "w020"], "anchor": "w018", "gloss": "may help us in our weakness" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "of the Holy Spirit" }, { "words": ["w033", "w034", "w035", "w036"], "anchor": "w035", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
