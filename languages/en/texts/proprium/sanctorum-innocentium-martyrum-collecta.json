  "text": "proprium.sanctorum-innocentium-martyrum-collecta",
  "about": "The collecta of the formulary “The Holy Innocents, Martyrs” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, whose praise the Innocents, Your martyrs, this day proclaimed, not by speaking, but by dying, put to death in us all the wickedness of sin, so that our life may also profess by its conduct Your faith, which our tongue speaks. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w005", "gloss": "praise this day" }, { "words": ["w012", "w013"], "anchor": "w012", "gloss": "proclaimed" }, { "words": ["w014", "w015", "w016", "w017", "w018"], "anchor": "w018", "gloss": "all the evils of vices in us" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "Your faith" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "our tongue" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "our Lord" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "Jesus Christ" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "Your Son" }, { "words": ["w038", "w039", "w040", "w041", "w042"], "anchor": "w040", "gloss": "who lives and reigns with You" }, { "words": ["w045", "w046"], "anchor": "w045", "gloss": "of the Holy Spirit" }, { "words": ["w048", "w049", "w050", "w051"], "anchor": "w050", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
