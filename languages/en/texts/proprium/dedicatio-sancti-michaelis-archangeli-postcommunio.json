  "text": "proprium.dedicatio-sancti-michaelis-archangeli-postcommunio",
  "about": "The postcommunio of the formulary “Dedication of Saint Michael the Archangel” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Relying upon the intercession of blessed Michael, Your Archangel, we humbly pray You, O Lord, that what we utter with our lips we may also lay hold of with our mind. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w032", "w033"], "anchor": "w032", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
