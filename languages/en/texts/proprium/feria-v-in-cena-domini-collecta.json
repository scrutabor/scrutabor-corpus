  "text": "proprium.feria-v-in-cena-domini-collecta",
  "about": "The collecta of the formulary “Holy Thursday — Mass of the Lord’s Supper” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, from whom Judas received the punishment of his guilt and the thief the reward of his confession, grant us the fruit of Your mercy, that, as Jesus Christ our Lord in His Passion rendered to each a different recompense according to his deserts, so, taking away the error of our former life, He may bestow on us the grace of His resurrection. Who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w004", "w005", "w006", "w007", "w008", "w009", "w010", "w011", "w012", "w013", "w014"], "anchor": "w014", "gloss": "both Judas received the punishment of his guilt and the thief the reward of his confession" }, { "words": ["w017", "w018", "w019"], "anchor": "w019", "gloss": "the fruit of Your mercy" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "His Passion" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "our Lord" }, { "words": ["w029", "w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "rendered to each a different recompense according to his deserts" }, { "words": ["w036", "w037", "w038"], "anchor": "w036", "gloss": "the error of the former life being removed" }, { "words": ["w039", "w040", "w041", "w042"], "anchor": "w042", "gloss": "may He bestow the grace of His resurrection" }, { "words": ["w043", "w044", "w045", "w046", "w047"], "anchor": "w045", "gloss": "Who lives and reigns with You" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "of the Holy Spirit" }, { "words": ["w053", "w054", "w055", "w056"], "anchor": "w055", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
