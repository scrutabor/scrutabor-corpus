  "text": "proprium.dominica-xxii-post-pentecosten-collecta",
  "about": "The collecta of the formulary “22nd Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, our refuge and our strength, the very source of holiness, heed the devout prayers of Your Church, and grant that what we seek in faith we may obtain in fact. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever." },
    "s02": { "translation": "Amen." }
  },
