  "text": "proprium.dominica-iii-adventus-introitus",
  "about": "The introit of the Third Sunday of Advent, from which the day takes its name of Gaudéte. The antiphon is the opening of the same Mass’s epistle, and the psalm verse the opening of its offertory: the Mass says each of them twice, the second time more fully.",
  "segments": {
    "s01": { "translation": "Rejoice in the Lord always; again I say, rejoice. Let your modesty be known to all people, for the Lord is near. Be anxious about nothing, but in every prayer let your petitions be made known to God.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "parallel Ordinary and Advent propers, examined edition", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w008", "w009"], "anchor": "w008", "gloss": "your modesty" }, { "words": ["w014", "w015", "w016", "w017"], "anchor": "w017", "gloss": "for the Lord is near" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "your petitions" }] },
    "s02": { "translation": "You have blessed Your land, O Lord; You have turned away the captivity of Jacob.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 92–93", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w032", "w033"], "anchor": "w032", "gloss": "Your land" }] },
    "s03": { "translation": "Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 37", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s04": { "narrative": "After the doxology the Introit antiphon is repeated from Gaudéte to the psalm verse — by the choir at a sung Mass, by the priest himself at a low Mass." },
    "s05": { "translation": "Rejoice in the Lord always; again I say, rejoice. Let your modesty be known to all people, for the Lord is near. Be anxious about nothing, but in every prayer let your petitions be made known to God.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "parallel Ordinary and Advent propers, examined edition", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w064", "w065"], "anchor": "w064", "gloss": "your modesty" }, { "words": ["w070", "w071", "w072", "w073"], "anchor": "w073", "gloss": "for the Lord is near" }, { "words": ["w081", "w082"], "anchor": "w081", "gloss": "your petitions" }] }
  },
