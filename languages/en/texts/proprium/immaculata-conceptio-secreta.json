  "text": "proprium.immaculata-conceptio-secreta",
  "about": "The secreta of the formulary “Immaculate Conception of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Accept, O Lord, the sacrifice of salvation which we offer You on the solemnity of the Immaculate Conception of the Blessed Virgin Mary; and grant that, as we profess that by Your prevenient grace she was kept free from every stain, so through her intercession we may be freed from all sin. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w020", "w021", "w022"], "anchor": "w021", "gloss": "by Your prevenient grace" }, { "words": ["w029", "w030"], "anchor": "w030", "gloss": "by her intercession" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "all faults" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "our Lord" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "Jesus Christ" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "Your Son" }, { "words": ["w042", "w043", "w044", "w045", "w046"], "anchor": "w044", "gloss": "who lives and reigns with You" }, { "words": ["w049", "w050"], "anchor": "w049", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w052", "w053", "w054", "w055"], "anchor": "w054", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
