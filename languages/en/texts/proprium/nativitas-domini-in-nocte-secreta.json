  "text": "proprium.nativitas-domini-in-nocte-secreta",
  "about": "The secreta of the formulary “Nativity of the Lord — Mass during the Night” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May the offering of this day’s solemnity be acceptable to You, O Lord, we beseech You, that by the bounty of Your grace, through this most sacred exchange, we may be found in the likeness of Him in whom our nature is with You. Who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w006", "w007", "w008"], "anchor": "w008", "gloss": "the offering of this day’s solemnity" }, { "words": ["w010", "w011", "w012"], "anchor": "w012", "gloss": "by the bounty of Your grace" }, { "words": ["w017", "w018", "w019", "w020"], "anchor": "w019", "gloss": "we may be found in His likeness" }, { "words": ["w023", "w024", "w025", "w026"], "anchor": "w024", "gloss": "our nature is with You" }, { "words": ["w027", "w028", "w029", "w030", "w031"], "anchor": "w029", "gloss": "Who lives and reigns with You" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w037", "w038", "w039", "w040"], "anchor": "w039", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
