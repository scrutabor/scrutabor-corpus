  "text": "proprium.nativitas-domini-in-nocte-secreta",
  "about": "The secreta of the formulary “Nativity of the Lord — Mass during the Night” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May the offering of this day’s solemnity be acceptable unto Thee, O Lord, we beseech Thee, that by Thy bountiful grace, through this most sacred exchange, we may be found conformed to Him in Whom our nature is with Thee, who liveth and reigneth with Thee in the unity of the Holy Ghost, God,", "alignments": [{ "words": ["w006", "w007", "w008"], "anchor": "w008", "gloss": "the offering of this day’s solemnity" }, { "words": ["w010", "w011", "w012"], "anchor": "w012", "gloss": "by the bounty of Thy grace" }, { "words": ["w017", "w018", "w019", "w020"], "anchor": "w019", "gloss": "we may be found in His likeness" }, { "words": ["w023", "w024", "w025", "w026"], "anchor": "w024", "gloss": "our nature is with Thee" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Ghost" }] },
    "s02": { "translation": "world without end.", "alignments": [{ "words": ["w037", "w038", "w039", "w040"], "anchor": "w039", "gloss": "world without end" }] },
    "s03": { "translation": "Amen." }
  },
