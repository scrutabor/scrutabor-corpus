  "text": "proprium.nativitas-domini-in-nocte-postcommunio",
  "about": "The postcommunio of the formulary “Nativity of the Lord — Mass during the Night” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant us, we beseech You, O Lord our God, that we who rejoice to celebrate in these mysteries the Nativity of our Lord Jesus Christ may by worthy lives deserve to attain to fellowship with Him. Who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006"], "anchor": "w005", "gloss": "our God" }, { "words": ["w009", "w010", "w011", "w012", "w013", "w014", "w015", "w016", "w017"], "anchor": "w017", "gloss": "rejoice to celebrate in these mysteries the Nativity of our Lord Jesus Christ" }, { "words": ["w020", "w021", "w022", "w023", "w024"], "anchor": "w022", "gloss": "may deserve to attain to His fellowship" }, { "words": ["w025", "w026", "w027", "w028", "w029"], "anchor": "w027", "gloss": "Who lives and reigns with You" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "of the Holy Spirit" }, { "words": ["w035", "w036", "w037", "w038"], "anchor": "w037", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
