  "about": "The Epistle of the formulary “Fourth Sunday after Epiphany” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Brethren: Owe no one anything except to love one another, for he who loves his neighbor has fulfilled the law. For: You shall not commit adultery, you shall not kill, you shall not steal, you shall not bear false witness, you shall not covet—and if there is any other commandment—it is summed up in this word: You shall love your neighbor as yourself. Love does no evil to a neighbor. Love therefore is the fulfillment of the law.", "alignments": [{ "words": ["w002", "w003", "w004"], "anchor": "w004", "gloss": "owe no one anything" }, { "words": ["w007", "w008"], "anchor": "w008", "gloss": "love one another" }, { "words": ["w009", "w010"], "anchor": "w009", "gloss": "for he who" }, { "words": ["w013", "w014"], "anchor": "w014", "gloss": "has fulfilled the Law" }, { "words": ["w016", "w017"], "anchor": "w017", "gloss": "You shall not commit adultery" }, { "words": ["w018", "w019"], "anchor": "w019", "gloss": "you shall not kill" }, { "words": ["w020", "w021"], "anchor": "w021", "gloss": "you shall not steal" }, { "words": ["w022", "w023", "w024", "w025"], "anchor": "w025", "gloss": "you shall not bear false witness" }, { "words": ["w026", "w027"], "anchor": "w027", "gloss": "you shall not covet" }, { "words": ["w030", "w031"], "anchor": "w031", "gloss": "there is any" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "your neighbor" }, { "words": ["w045", "w046", "w047"], "anchor": "w047", "gloss": "does no evil" }] }
