  "text": "proprium.sanctorum-innocentium-martyrum-secreta",
  "about": "The secreta of the formulary “The Holy Innocents, Martyrs” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Let not the gracious prayer of Your saints fail us, O Lord, but may it make our offerings acceptable to You and always obtain for us Your mercy. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005", "w006", "w007", "w008"], "anchor": "w007", "gloss": "May the gracious prayer of Your saints not fail us, O Lord" }, { "words": ["w011", "w012"], "anchor": "w011", "gloss": "our offerings" }, { "words": ["w015", "w016", "w017"], "anchor": "w017", "gloss": "Your pardon for us" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "our Lord" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Jesus Christ" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Your Son" }, { "words": ["w027", "w028", "w029", "w030", "w031"], "anchor": "w029", "gloss": "who lives and reigns with You" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w037", "w038", "w039", "w040"], "anchor": "w039", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
