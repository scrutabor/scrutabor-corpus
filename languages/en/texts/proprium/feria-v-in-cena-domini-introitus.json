  "about": "The introitus of the formulary “Holy Thursday — Mass of the Lord’s Supper” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "As for us, we must glory in the cross of our Lord Jesus Christ, in whom lies our salvation, our life, and our resurrection, through whom we were saved and set free. May God have mercy on us and bless us, make His face shine over us, and have mercy on us. As for us, we must glory in the cross of our Lord Jesus Christ, in whom lies our salvation, our life, and our resurrection, through whom we were saved and set free.", "alignments": [{ "words": ["w003", "w004"], "anchor": "w004", "gloss": "ought to glory" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "of our Lord" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "our resurrection" }, { "words": ["w021", "w022", "w023", "w024"], "anchor": "w024", "gloss": "we were saved and delivered" }, { "words": ["w025", "w026"], "anchor": "w026", "gloss": "May God have mercy" }, { "words": ["w031", "w032", "w033"], "anchor": "w031", "gloss": "may He make His countenance shine" }, { "words": ["w041", "w042"], "anchor": "w042", "gloss": "ought to glory" }, { "words": ["w045", "w046"], "anchor": "w045", "gloss": "of our Lord" }, { "words": ["w055", "w056"], "anchor": "w055", "gloss": "our resurrection" }, { "words": ["w059", "w060", "w061", "w062"], "anchor": "w062", "gloss": "we were saved and delivered" }] }
