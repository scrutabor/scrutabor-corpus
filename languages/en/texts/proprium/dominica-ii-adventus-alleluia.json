  "text": "proprium.dominica-ii-adventus-alleluia",
  "about": "The alleluia verse of the Second Sunday of Advent, from Psalm 121 — a song of pilgrims going up to Jerusalem. The joy comes not from arriving but from the word that they will go. On the ferias of Advent, when this Sunday Mass is used through the week, the Alleluia and its verse are omitted and only the gradual is said.",
  "segments": {
    "s01": { "translation": "Alleluia, alleluia.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 91", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s02": { "translation": "I rejoiced at the things that were said to me: we will go into the house of the Lord.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 91", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w003", "w004"], "anchor": "w003", "gloss": "I rejoiced" }] },
