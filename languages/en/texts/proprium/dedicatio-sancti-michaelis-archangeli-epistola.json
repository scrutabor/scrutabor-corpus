  "text": "proprium.dedicatio-sancti-michaelis-archangeli-epistola",
  "about": "The epistola of the formulary “Dedication of Saint Michael the Archangel” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "In those days, God made known the things that must soon take place, sending by His angel to His servant John, who gave testimony to the word of God and gave the testimony of Jesus Christ, all that he saw. Blessed is the one who reads and hears the words of this prophecy, and observes what is written in it, since the time is near. John, to the seven churches which are in Asia. Grace and peace to you from Him who is, and who was, and who is to come, and from the seven spirits who are in the presence of His throne, and from Jesus Christ, who is the faithful witness, firstborn of the dead, and prince of the kings of the earth, who loved us, and in His blood washed us from our sins.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "those days" }, { "words": ["w004", "w005"], "anchor": "w004", "gloss": "God made known" }, { "words": ["w012", "w013"], "anchor": "w012", "gloss": "His angel" }, { "words": ["w014", "w015"], "anchor": "w014", "gloss": "to His servant" }, { "words": ["w018", "w019"], "anchor": "w019", "gloss": "bore witness" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "Blessed is the one who" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "of this prophecy" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "are written" }, { "words": ["w044", "w045", "w046", "w047"], "anchor": "w047", "gloss": "for the time is near" }, { "words": ["w049", "w050"], "anchor": "w050", "gloss": "to the seven churches" }, { "words": ["w068", "w069"], "anchor": "w068", "gloss": "is coming" }, { "words": ["w075", "w076"], "anchor": "w076", "gloss": "in the presence" }, { "words": ["w077", "w078"], "anchor": "w077", "gloss": "of His throne" }, { "words": ["w086", "w087"], "anchor": "w086", "gloss": "the faithful witness" }, { "words": ["w101", "w102"], "anchor": "w101", "gloss": "our sins" }, { "words": ["w104", "w105"], "anchor": "w104", "gloss": "His own blood" }] }
  },
