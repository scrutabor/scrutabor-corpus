  "about": "The epistola of the formulary “Saint Joachim, Confessor” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Happy the man found without fault, who turns not aside after gain, nor puts his trust in money nor in treasures! Who is he, that we may praise him? For he has done wonders in his life. He has been tested by gold and come off safe, and this remains his glory forever; he could have sinned but did not, could have done evil but would not, so that his possessions are secure in the Lord, and the assembly of the Saints shall recount his alms.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "has been found" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "has been tested" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "came off perfect" }, { "words": ["w049", "w050"], "anchor": "w050", "gloss": "transgress" }] }
  },
