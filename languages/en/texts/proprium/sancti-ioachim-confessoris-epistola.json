  "about": "The epistola of the formulary “Saint Joachim, Confessor” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Blessed is the man who has been found without stain, and who has not gone after gold, nor put his hope in money and treasures. Who is he? And we will praise him, for he has done wonderful things in his life. Whoever has been tried by gold and made perfect will have eternal glory: he who was able to transgress and did not transgress, to do evil things and did not do them; therefore his goods are established in the Lord, and the whole assembly of the saints will declare his alms.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "has been found" }, { "words": ["w012", "w013"], "anchor": "w013", "gloss": "did not go" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "for he has done" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "has been tested" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "was made perfect" }, { "words": ["w048", "w049", "w050"], "anchor": "w050", "gloss": "did not transgress" }, { "words": ["w054", "w055"], "anchor": "w055", "gloss": "did not" }] }
  },
