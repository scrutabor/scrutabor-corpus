  "text": "proprium.vigilia-nativitatis-postcommunio",
  "about": "The postcommunio of the formulary “Vigil of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant us, we beseech You, O Lord, to draw new breath from the celebration of the birth of Your Only-begotten Son, by whose heavenly mystery we are fed and given drink. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006", "w007", "w008", "w009"], "anchor": "w009", "gloss": "by the celebrated Nativity of Your Only-begotten Son" }, { "words": ["w018", "w019", "w020", "w021", "w022"], "anchor": "w019", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Your Son" }, { "words": ["w025", "w026", "w027", "w028", "w029"], "anchor": "w027", "gloss": "who lives and reigns with You" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "of the Holy Spirit" }, { "words": ["w035", "w036", "w037", "w038"], "anchor": "w037", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
