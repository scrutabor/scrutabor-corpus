  "text": "proprium.assumptio-beatae-mariae-virginis-collecta",
  "about": "The collecta of the formulary “Assumption of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Almighty, everlasting God, Who took up, body and soul, the Immaculate Virgin Mary, Mother of Your Son, into heavenly glory, grant, we beseech You, that, always devoting ourselves to heavenly things, we may be found worthy to share in her glory. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w008", "w009"], "anchor": "w008", "gloss": "of Your Son" }, { "words": ["w025", "w026"], "anchor": "w026", "gloss": "of her glory" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "our Lord" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "Your Son" }, { "words": ["w045", "w046"], "anchor": "w045", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
