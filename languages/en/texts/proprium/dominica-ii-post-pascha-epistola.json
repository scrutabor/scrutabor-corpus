  "about": "The epistola of the formulary “Second Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Beloved: Christ suffered for us, leaving you an example so that you may follow in His footsteps. He committed no sin, and no deceit was found in His mouth. When He was reviled, He did not revile; when He suffered, He did not threaten, but handed Himself over to the one who judged Him unjustly. He Himself bore our sins in His own body on the tree, so that, dead to sins, we may live for righteousness; by His wound you have been healed. For you were like wandering sheep, but now you have returned to the Shepherd and Bishop of your souls.", "alignments": [{ "words": ["w003", "w004"], "anchor": "w003", "gloss": "suffered" }, { "words": ["w007", "w008", "w009"], "anchor": "w008", "gloss": "leaving you an example" }, { "words": ["w010", "w011"], "anchor": "w011", "gloss": "so that you may follow" }, { "words": ["w012", "w013"], "anchor": "w012", "gloss": "in His footsteps" }, { "words": ["w015", "w016", "w017"], "anchor": "w017", "gloss": "committed no sin" }, { "words": ["w018", "w019", "w020", "w021"], "anchor": "w019", "gloss": "and no deceit was found" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "His mouth" }, { "words": ["w025", "w026", "w027"], "anchor": "w027", "gloss": "when He was reviled" }, { "words": ["w028", "w029"], "anchor": "w029", "gloss": "He did not revile" }, { "words": ["w032", "w033"], "anchor": "w033", "gloss": "He did not threaten" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "but handed Himself over" }, { "words": ["w036", "w037", "w038"], "anchor": "w036", "gloss": "to the one who judged Him unjustly" }, { "words": ["w039", "w040", "w041", "w042", "w043"], "anchor": "w043", "gloss": "He Himself bore our sins" }, { "words": ["w045", "w046"], "anchor": "w045", "gloss": "His own body" }, { "words": ["w050", "w051"], "anchor": "w051", "gloss": "dead to sins" }, { "words": ["w054", "w055"], "anchor": "w055", "gloss": "by His wound" }, { "words": ["w056", "w057"], "anchor": "w056", "gloss": "you have been healed" }, { "words": ["w058", "w059"], "anchor": "w058", "gloss": "For you were" }, { "words": ["w064", "w065"], "anchor": "w064", "gloss": "you have returned" }, { "words": ["w071", "w072"], "anchor": "w071", "gloss": "of your souls" }] }
