  "about": "The collecta of the formulary “Vigil of Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, we beseech You, almighty God, that the splendor of Your glory may shine upon us, and that the light of Your light may, by the illumination of the Holy Spirit, strengthen the hearts of those who have been born again by Your grace. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the same Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "of Your glory" }, { "words": ["w014", "w015"], "anchor": "w015", "gloss": "of Your light" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "Your grace" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "have been born again" }, { "words": ["w024", "w025", "w026"], "anchor": "w026", "gloss": "by the illumination of the Holy Spirit" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "our Lord" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "Your Son" }, { "words": ["w043", "w044"], "anchor": "w043", "gloss": "Holy Spirit" }, { "words": ["w046", "w047", "w048", "w049"], "anchor": "w048", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
