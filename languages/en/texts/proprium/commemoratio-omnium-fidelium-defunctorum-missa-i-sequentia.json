  "text": "proprium.commemoratio-omnium-fidelium-defunctorum-missa-i-sequentia",
  "about": "The sequentia of the formulary “Commemoration of All the Faithful Departed — Mass I” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Dreaded day, that day of ire, When the world shall melt in fire, Told by Sibyl and David’s lyre." },
    "s02": { "translation": "Fright men’s hearts shall rudely shift, As the Judge through gleaming rift Comes each soul to closely sift.", "alignments": [{ "words": ["w015", "w016"], "anchor": "w016", "gloss": "shall be" }, { "words": ["w019", "w020"], "anchor": "w020", "gloss": "shall come" }] },
    "s03": { "translation": "Then, the trumpet’s shrill refrain, Piercing tombs by hill and plain, Souls to judgment shall arraign." },
    "s04": { "translation": "Death and nature stand aghast, As the bodies rising fast, Hie to hear the sentence passed." },
    "s05": { "translation": "Then, before Him shall be placed, That whereon the verdict’s based, Book wherein each deed is traced." },
    "s06": { "translation": "When the Judge His seat shall gain, All that’s hidden shall be plain, Nothing shall unjudged remain." },
    "s07": { "translation": "Wretched man, what can I plead? Whom to ask to intercede, When the just much mercy need?" },
    "s08": { "translation": "You, O awe-inspiring Lord, Saving e’en when unimplored, Save me, mercy’s fount adored." },
    "s09": { "translation": "O sweet Jesus, mindful be, That You came on earth for me: Cast me not from You this day." },
    "s10": { "translation": "Seeking me Your strength was spent Ransoming Your limbs were rent: Is this toil to no intent?" },
    "s11": { "translation": "You, awarding pains condign, Mercy’s ear to me incline, Ere the reckoning You assign." },
    "s12": { "translation": "I, felon-like, my lot bewail, Suffused cheeks my shame unveil: God! O let my prayer prevail." },
    "s13": { "translation": "Mary’s soul You fashioned white, And did to heaven the thief invite; Hope in me these now excite." },
    "s14": { "translation": "Prayers of mine in vain ascend: You are good and will forefend, In quenchless fire my life to end." },
    "s15": { "translation": "When the cursed by shame oppressed, Enter flames at Your behest, Call me then to join the blessed." },
    "s16": { "translation": "Place amid Your sheep accord, Keep me from the tainted horde, Set me in Your sight, O Lord." },
    "s17": { "translation": "Prostrate, suppliant, now no more Unrepenting, as of yore, Save me dying, I implore." },
    "s18": { "translation": "Mournful day that day of sighs, When from dust shall man arise, Stained with guilt his doom to know," },
    "s19": { "translation": "Mercy, Lord, on him bestow. Jesus, kind! Your souls release, Led them thence to realms of peace. Amen." }
  },
