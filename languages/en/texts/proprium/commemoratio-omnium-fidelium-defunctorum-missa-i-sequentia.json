  "text": "proprium.commemoratio-omnium-fidelium-defunctorum-missa-i-sequentia",
  "about": "The sequence Dies irae belongs to all three formularies for the Commemoration of All the Faithful Departed. When a priest celebrates the three Masses without interruption, he must say it only at the principal Mass, or at the first Mass if none is principal. He may omit it at the other Masses unless they are sung (1962 Roman Missal, p. 722).",
  "segments": {
    "s01": { "translation": "The day of wrath, that day, shall dissolve the world in ashes, as David bears witness with the Sibyl." },
    "s02": { "translation": "How great a trembling there shall be when the Judge is to come. He shall examine all things strictly!", "alignments": [{ "words": ["w015", "w016"], "anchor": "w016", "gloss": "shall be" }, { "words": ["w019", "w020"], "anchor": "w020", "gloss": "shall come" }] },
    "s03": { "translation": "The trumpet, spreading its wondrous sound through the tombs of every land, shall gather all before the throne." },
    "s04": { "translation": "Death and nature shall stand aghast when creation rises again to answer to the Judge." },
    "s05": { "translation": "A written book shall be brought forth, in which everything is contained, from which the world shall be judged." },
    "s06": { "translation": "When therefore the Judge is seated, whatever lies hidden shall appear: nothing shall remain unpunished." },
    "s07": { "translation": "What then shall I say, wretched as I am? Whom shall I ask to be my patron, when even the just man is scarcely safe?" },
    "s08": { "translation": "King of awe-inspiring majesty, who freely save those who are to be saved, save me, fount of mercy." },
    "s09": { "translation": "Remember, kind Jesus, that I am the cause of Your journey: do not destroy me on that day." },
    "s10": { "translation": "Seeking me, You sat down weary. You redeemed me by suffering the Cross. Let not so great a toil be in vain." },
    "s11": { "translation": "Just Judge of vengeance, grant the gift of forgiveness before the day of reckoning." },
    "s12": { "translation": "I groan as one who is guilty, and my face blushes with guilt: spare the suppliant, O God." },
    "s13": { "translation": "You who absolved Mary and heard the thief have given hope to me as well." },
    "s14": { "translation": "My prayers are not worthy: but You, being good, kindly grant that I may not burn in everlasting fire." },
    "s15": { "translation": "Grant me a place among the sheep, and separate me from the goats, placing me on the right side." },
    "s16": { "translation": "When the accursed are confounded and consigned to fierce flames, call me with the blessed." },
    "s17": { "translation": "I pray, suppliant and prostrate, with a heart contrite as ashes: take care of my end." },
    "s18": { "translation": "Tearful shall be that day on which guilty man shall rise from the ashes to be judged." },
    "s19": { "translation": "Spare him therefore, O God. Kind Lord Jesus, grant them rest. Amen." }
  },
