  "text": "proprium.corporis-christi-evangelium",
  "about": "The Gospel of the feast of the Most Holy Body of Christ, John 6:56–59. Christ promises abiding in Him and eternal life to those who eat His Flesh and drink His Blood.",
  "segments": {
    "s01": { "translation": "At that time Jesus said to the multitudes of the Jews: My Flesh is meat indeed, and My Blood is drink indeed." },
    "s02": { "translation": "He that eateth My Flesh and drinketh My Blood abideth in Me, and I in him." },
    "s03": { "translation": "As the living Father hath sent Me, and I live by the Father, so he that eateth Me shall live by Me." },
    "s04": { "translation": "This is the Bread which came down from heaven." },
    "s05": { "translation": "Not as your fathers ate manna and died." },
    "s06": { "translation": "He that eateth this Bread shall live for ever." }
  },
