  "text": "proprium.corporis-christi-evangelium",
  "about": "The Gospel of the feast of the Most Holy Body of Christ, John 6:56–59. Christ promises abiding in Him and eternal life to those who eat His Flesh and drink His Blood.",
  "segments": {
    "s01": { "translation": "At that time, Jesus said to the multitudes of the Jews: My Flesh is meat indeed, and My Blood is drink indeed.", "alignments": [{ "words": ["w008", "w009"], "anchor": "w008", "gloss": "My Flesh" }, { "words": ["w014", "w015"], "anchor": "w014", "gloss": "My Blood" }] },
    "s02": { "translation": "He who eats My Flesh and drinks My Blood abides in Me, and I in him." },
    "s03": { "translation": "As the living Father has sent Me, and I live by the Father, so he who eats Me will live by Me." },
    "s04": { "translation": "This is the Bread which came down from heaven." },
    "s05": { "translation": "Not as your fathers ate manna and died.", "alignments": [{ "words": ["w063", "w064"], "anchor": "w063", "gloss": "your fathers" }, { "words": ["w067", "w068"], "anchor": "w067", "gloss": "died" }] },
    "s06": { "translation": "He who eats this Bread will live forever." }
  },
