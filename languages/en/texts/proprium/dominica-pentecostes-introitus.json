  "about": "The introitus of the formulary “Pentecost Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "The Spirit of the Lord has filled the whole world, alleluia; and that which holds all things together understands what is said, alleluia, alleluia, alleluia. Let God arise, and let His enemies be scattered, and let those who hate Him flee from before His face. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. The Spirit of the Lord has filled the whole world, alleluia; and that which holds all things together understands what is said, alleluia, alleluia, alleluia.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "the world" }, { "words": ["w012", "w013"], "anchor": "w013", "gloss": "has knowledge" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "Let God arise" }, { "words": ["w021", "w022", "w023"], "anchor": "w021", "gloss": "let His enemies be scattered" }, { "words": ["w025", "w026", "w027", "w028"], "anchor": "w025", "gloss": "let those who hate Him flee" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "His face" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "to the Holy Spirit" }, { "words": ["w048", "w049", "w050"], "anchor": "w049", "gloss": "forever and ever" }, { "words": ["w055", "w056"], "anchor": "w055", "gloss": "the world" }, { "words": ["w063", "w064"], "anchor": "w064", "gloss": "has knowledge" }] }
