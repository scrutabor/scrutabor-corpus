  "text": "proprium.sanctorum-innocentium-martyrum-postcommunio",
  "about": "The postcommunio of the formulary “The Holy Innocents, Martyrs” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We have partaken, O Lord, of the dedicated gifts: may they, we beseech You, help us through the intercession of Your saints both for this life and life eternal. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w006", "w007", "w008"], "anchor": "w008", "gloss": "to us through the prayers of the Saints" }, { "words": ["w009", "w010", "w011", "w012", "w013", "w014", "w015"], "anchor": "w012", "gloss": "both for the present life, we beseech You, and for the eternal" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "our Lord" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Jesus Christ" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "Your Son" }, { "words": ["w026", "w027", "w028", "w029", "w030"], "anchor": "w028", "gloss": "who lives and reigns with You" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "of the Holy Spirit" }, { "words": ["w036", "w037", "w038", "w039"], "anchor": "w038", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
