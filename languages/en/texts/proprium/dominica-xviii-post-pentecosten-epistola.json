  "segments": {
    "s01": { "translation": "Brethren: I thank my God for you always, on account of God’s grace bestowed on you in Christ Jesus, because in everything you have been enriched in Him, in every kind of utterance and in all knowledge, just as among you the testimony of Christ was confirmed, so that nothing is lacking to you in any grace, while you wait for the revelation of our Lord Jesus Christ. He will also strengthen you until the end, free of reproach, on the day when our Lord Jesus Christ comes.", "alignments": [{ "words": ["w013", "w014"], "anchor": "w013", "gloss": "was given" }, { "words": ["w059", "w060"], "anchor": "w060", "gloss": "until" }] }
