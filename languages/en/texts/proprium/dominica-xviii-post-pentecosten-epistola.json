  "about": "The epistola of the formulary “18th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Brethren: I thank my God for you always, on account of God’s grace bestowed on you in Christ Jesus, because in everything you have been enriched in Him, in every kind of utterance and in all knowledge, just as among you the testimony of Christ was confirmed, so that nothing is lacking to you in any grace, while you wait for the revelation of our Lord Jesus Christ. He will also strengthen you until the end, free of reproach, on the day when our Lord Jesus Christ comes.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w003", "gloss": "I give thanks" }, { "words": ["w004", "w005"], "anchor": "w004", "gloss": "to my God" }, { "words": ["w013", "w014"], "anchor": "w013", "gloss": "was given" }, { "words": ["w022", "w023", "w024"], "anchor": "w023", "gloss": "you have been made rich" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "was confirmed" }, { "words": ["w043", "w044", "w045"], "anchor": "w045", "gloss": "you lack nothing" }, { "words": ["w051", "w052"], "anchor": "w051", "gloss": "of our Lord" }, { "words": ["w059", "w060"], "anchor": "w060", "gloss": "until" }, { "words": ["w067", "w068"], "anchor": "w067", "gloss": "of our Lord" }] }
  },
