  "text": "proprium.dominica-xvi-post-pentecosten-secreta",
  "about": "The secreta of the formulary “16th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Cleanse us, we beseech You, O Lord, by the effect of the present sacrifice, and in Your mercy complete this in us, that we may deserve to be partakers of it. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God," },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
