  "text": "proprium.dominica-xvi-post-pentecosten-secreta",
  "about": "The secreta of the formulary “16th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Cleanse us by this sacrifice, we beseech You, O Lord, and by the workings of Your mercy, make us worthy to receive it. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
