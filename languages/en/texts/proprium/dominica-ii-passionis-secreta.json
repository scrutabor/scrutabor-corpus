  "text": "proprium.dominica-ii-passionis-secreta",
  "about": "The secreta of the formulary “Palm Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, we beseech You, O Lord, that the gift offered before the eyes of Your majesty may obtain for us the grace of devotion and gain the fruit of blessed eternity. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w005", "w006", "w007"], "anchor": "w005", "gloss": "before the eyes of Your majesty" }, { "words": ["w011", "w012", "w013", "w014"], "anchor": "w014", "gloss": "may obtain for us the grace of devotion" }, { "words": ["w016", "w017", "w018", "w019"], "anchor": "w019", "gloss": "may gain the fruit of blessed eternity" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "our Lord" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Jesus Christ" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Your Son" }, { "words": ["w027", "w028", "w029", "w030", "w031"], "anchor": "w029", "gloss": "who lives and reigns with You" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w037", "w038", "w039", "w040"], "anchor": "w039", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
