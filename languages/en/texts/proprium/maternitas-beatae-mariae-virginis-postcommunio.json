    "s01": { "translation": "May this Communion cleanse us from sin, O Lord, and through the intercession of the Blessed Virgin Mary, Mother of God, make us partakers of the heavenly remedy. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
