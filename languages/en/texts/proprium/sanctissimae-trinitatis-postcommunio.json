  "text": "proprium.sanctissimae-trinitatis-postcommunio",
  "about": "The Postcommunion of the feast of the Most Holy Trinity. It asks that reception of the sacrament and confession of the eternal Trinity and that same undivided Unity advance the salvation of body and soul.",
  "segments": {
    "s01": { "translation": "May the reception of this sacrament, O Lord our God, and the confession of the eternal Holy Trinity and of that same undivided Unity profit us unto the salvation of body and soul. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Jesus Christ" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Thy Son" }, { "words": ["w029", "w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "who liveth and reigneth with Thee" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }, { "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
