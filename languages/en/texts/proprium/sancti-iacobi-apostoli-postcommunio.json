  "about": "The postcommunio of the formulary “Saint James the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Help us, O Lord, we beseech You, by the intercession of blessed James, Your Apostle, for whose festival we have joyfully received Your holy gifts. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002", "w003"], "anchor": "w002", "gloss": "Of Your blessed Apostle" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "our Lord" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Your Son" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
