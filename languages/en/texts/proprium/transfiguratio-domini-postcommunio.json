  "text": "proprium.transfiguratio-domini-postcommunio",
  "about": "The postcommunio of the formulary “Transfiguration of Our Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, we beseech You, almighty God, that by the understanding of our minds made pure, we may grasp the mystery of the Transfiguration of Your only-begotten Son, which we celebrate by these solemn rites. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w015", "w016", "w017"], "anchor": "w017", "gloss": "with purified understanding of the mind" }] },
    "s02": { "translation": "Amen." }
  },
