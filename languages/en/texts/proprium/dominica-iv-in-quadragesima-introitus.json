  "about": "The introitus of the formulary “Fourth Sunday of Lent” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Rejoice, Jerusalem! And gather together, all of you who love her. Rejoice with gladness, you who have been in sorrow, so that you may exult and be filled at the breasts that bring you consolation. I rejoiced at the things that were said to me: we will go into the house of the Lord. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. Rejoice, Jerusalem! And gather together, all of you who love her. Rejoice with gladness, you who have been in sorrow, so that you may exult and be filled at the breasts that bring you consolation.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w005", "gloss": "gather together" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "of your consolation" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "I rejoiced" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "were said" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "to the Holy Spirit" }, { "words": ["w060", "w061"], "anchor": "w061", "gloss": "gather together" }, { "words": ["w079", "w080"], "anchor": "w079", "gloss": "of your consolation" }] }
