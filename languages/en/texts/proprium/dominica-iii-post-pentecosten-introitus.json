  "about": "The introitus of the formulary “3rd Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Look upon me and have mercy on me, O Lord, for I am alone and poor. See my lowliness and my toil, and forgive all my sins, O my God. To You, O Lord, I have lifted up my soul. My God, I trust in You: let me not be ashamed. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. Look upon me and have mercy on me, O Lord, for I am alone and poor. See my lowliness and my toil, and forgive all my sins, O my God.", "alignments": [{ "words": ["w015", "w016"], "anchor": "w015", "gloss": "my lowliness" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "my labor" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "my sins" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "my God" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "my soul" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "my God" }, { "words": ["w038", "w039"], "anchor": "w039", "gloss": "let me not be ashamed" }, { "words": ["w045", "w046"], "anchor": "w045", "gloss": "to the Holy Spirit" }, { "words": ["w074", "w075"], "anchor": "w074", "gloss": "my lowliness" }, { "words": ["w077", "w078"], "anchor": "w077", "gloss": "my labor" }, { "words": ["w082", "w083"], "anchor": "w082", "gloss": "my sins" }, { "words": ["w084", "w085"], "anchor": "w084", "gloss": "my God" }] }
