  "text": "proprium.sanctissimi-nominis-iesu-secreta",
  "about": "The Secret of the formulary “Most Holy Name of Jesus” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May Your blessing, most merciful God, by which every creature lives, sanctify, we beseech You, this sacrifice of ours which we offer to You for the glory of the name of Your Son, our Lord Jesus Christ, that it may be pleasing to Your majesty for Your praise and profit us for salvation. Through this same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "Your blessing" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "creature lives" }, { "words": ["w012", "w013"], "anchor": "w012", "gloss": "sacrifice of ours" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "of Your Son" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "our Lord" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your majesty" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "it may please" }, { "words": ["w034", "w035"], "anchor": "w035", "gloss": "profit us" }, { "words": ["w039", "w040", "w041", "w042", "w043"], "anchor": "w040", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w044", "w045"], "anchor": "w044", "gloss": "Your Son" }, { "words": ["w053", "w054"], "anchor": "w053", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w056", "w057", "w058", "w059"], "anchor": "w058", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
