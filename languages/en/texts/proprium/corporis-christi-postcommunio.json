  "text": "proprium.corporis-christi-postcommunio",
  "about": "The Postcommunion of the feast of the Most Holy Body of Christ. It asks that we be filled with the eternal enjoyment of Christ’s divinity, an enjoyment foreshadowed by our temporal reception of His precious Body and Blood.",
  "segments": {
    "s01": { "translation": "Grant, we pray, Lord, that we may be filled with the eternal enjoyment of Your divinity, an enjoyment foreshadowed by our reception in time of Your precious Body and Blood. You live and reign with God the Father in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006"], "anchor": "w005", "gloss": "of Your divinity" }, { "words": ["w011", "w012", "w013", "w014", "w015"], "anchor": "w012", "gloss": "of Your precious Body and Blood" }, { "words": ["w019", "w020", "w021", "w022"], "anchor": "w020", "gloss": "You live and reign" }, { "words": ["w023", "w024", "w025"], "anchor": "w024", "gloss": "with God the Father" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "of the Holy Spirit" }, { "words": ["w031", "w032", "w033", "w034"], "anchor": "w033", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
