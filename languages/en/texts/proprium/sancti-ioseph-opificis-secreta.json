  "about": "The secreta of the formulary “Saint Joseph the Worker” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord, through the intercession of Saint Joseph, make the offerings we present to You from the work of our hands a pledge of unity and peace for us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "of our hands" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "our Lord" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Your Son" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w037", "w038", "w039", "w040"], "anchor": "w039", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
