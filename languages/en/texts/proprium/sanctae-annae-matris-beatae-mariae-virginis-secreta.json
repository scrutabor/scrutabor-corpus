  "text": "proprium.sanctae-annae-matris-beatae-mariae-virginis-secreta",
  "about": "The secreta of the formulary “Saint Anne, Mother of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Look with favor, O Lord, we pray, upon these sacrifices, so that, through the intercession of blessed Anne, who was the mother of the Mother of Your Son, our Lord Jesus Christ, they may benefit both our devotion and our salvation. Through the same our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God,", "alignments": [{ "words": ["w010", "w011"], "anchor": "w011", "gloss": "of blessed Anne" }, { "words": ["w014", "w015"], "anchor": "w014", "gloss": "of Your Son" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "our Lord" }, { "words": ["w020", "w021"], "anchor": "w021", "gloss": "was the mother" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "our devotion" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "our Lord" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "Thy Son" }, { "words": ["w043", "w044"], "anchor": "w043", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
