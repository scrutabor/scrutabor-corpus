  "text": "proprium.dominica-xiv-post-pentecosten-evangelium",
  "about": "The evangelium of the formulary “14th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At that time, Jesus said to His disciples: No one can serve two masters; for either he will hate the one and love the other, or he will stand by the one and despise the other. You cannot serve God and mammon. For this reason I say to you, do not be anxious about your life, what you will eat, nor about your body, what you will put on. Is life not more than food, and the body more than clothing? Look at the birds of the sky: they neither sow nor reap nor gather into barns, and your heavenly Father feeds them. Are you not worth far more than they? But which of you, by taking thought, can add one cubit to his stature? And about clothing, why are you anxious? Consider the lilies of the field, how they grow: they neither labor nor spin. But I say to you that not even Solomon in all his glory was clothed like one of these. Now if God so clothes the grass of the field, which exists today and tomorrow is thrown into the oven, how much more you, who are of little faith? Do not be anxious, then, saying: What will we eat, or what will we drink, or with what will we be clothed? For the Gentiles seek after all these things. For your Father knows that you have need of all these things. Seek first, therefore, the kingdom of God and His justice, and all these things will be added to you.", "alignments": [{ "words": ["w013", "w014"], "anchor": "w013", "gloss": "for either" }, { "words": ["w027", "w028"], "anchor": "w028", "gloss": "You cannot" }, { "words": ["w029", "w030"], "anchor": "w030", "gloss": "serve God" }, { "words": ["w051"], "reason": "idiom" }, { "words": ["w063", "w064"], "anchor": "w064", "gloss": "do not sow" }, { "words": ["w081"], "reason": "idiom" }, { "words": ["w105", "w106"], "anchor": "w106", "gloss": "they do not toil" }, { "words": ["w147", "w148"], "anchor": "w147", "gloss": "anxious" }, { "words": ["w158", "w159", "w160"], "anchor": "w158", "gloss": "For all these things" }, { "words": ["w163", "w164", "w165", "w166"], "anchor": "w163", "gloss": "For your Father knows" }] }
  },
