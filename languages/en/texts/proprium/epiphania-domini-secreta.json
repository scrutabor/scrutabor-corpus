  "text": "proprium.epiphania-domini-secreta",
  "about": "The secreta of the formulary “Epiphany of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Look graciously, we beseech You, O Lord, upon the gifts of Your Church, in which gold, frankincense, and myrrh are no longer offered, but He whom those gifts declare is sacrificed and received: Jesus Christ, Your Son, our Lord, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "Your Church’s" }, { "words": ["w009", "w010"], "anchor": "w009", "gloss": "no longer" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Your Son" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "our Lord" }, { "words": ["w030", "w031", "w032", "w033", "w034"], "anchor": "w032", "gloss": "who lives and reigns with You" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w040", "w041", "w042", "w043"], "anchor": "w042", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
