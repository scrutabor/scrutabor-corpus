  "text": "proprium.d-n-iesu-christi-regis-postcommunio",
  "about": "The postcommunio of the formulary “Christ the King” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We have received the food of eternal life, and we beseech You, O Lord, that we who are proud to serve under the banners of Christ the King may forever reign with Him in the heavenly abode. Who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002", "w003"], "anchor": "w003", "gloss": "Having received nourishment of immortality" }, { "words": ["w009", "w010", "w011"], "anchor": "w011", "gloss": "the banners of Christ the King" }, { "words": ["w012", "w013"], "anchor": "w013", "gloss": "glory in serving" }, { "words": ["w020", "w021"], "anchor": "w021", "gloss": "may reign" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
