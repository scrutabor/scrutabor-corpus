    "s01": { "translation": "Having received the gifts, we ask You, Lord: may salvation bear ever greater fruit in us through frequent participation in the mystery. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w014", "w015"], "anchor": "w014", "gloss": "our Lord" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "Jesus Christ" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "Your Son" }, { "words": ["w020", "w021", "w022", "w023", "w024"], "anchor": "w022", "gloss": "who lives and reigns with You" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "of the Holy Spirit" }, { "words": ["w030", "w031", "w032", "w033"], "anchor": "w032", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
