  "about": "The collecta of the formulary “15th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May Your abiding mercy, O Lord, cleanse and strengthen Your Church, and, since without You she cannot exist in safety, let her be ever guided by Your grace. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w013", "w014"], "anchor": "w014", "gloss": "it cannot" }, { "words": ["w015", "w016"], "anchor": "w016", "gloss": "subsist in safety" }, { "words": ["w017", "w018", "w019"], "anchor": "w019", "gloss": "always by Your gift" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
