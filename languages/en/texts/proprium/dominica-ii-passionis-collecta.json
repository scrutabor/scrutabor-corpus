  "text": "proprium.dominica-ii-passionis-collecta",
  "about": "The collecta of the formulary “Palm Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Almighty, eternal God, who caused our Savior to take flesh and undergo the cross, that mankind might imitate His example of humility, graciously grant that we may be worthy both to learn from His patience and to share in His resurrection. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006"], "anchor": "w006", "gloss": "for the human race" }, { "words": ["w009", "w010"], "anchor": "w010", "gloss": "the example of humility" }, { "words": ["w011", "w012", "w013", "w014", "w015", "w016", "w017", "w018"], "anchor": "w018", "gloss": "caused our Savior to take flesh and to undergo the Cross" }, { "words": ["w022", "w023", "w024", "w025", "w026", "w027", "w028", "w029", "w030"], "anchor": "w030", "gloss": "we may be worthy both to learn from His patience and to share in His resurrection" }, { "words": ["w032", "w033", "w034", "w035", "w036"], "anchor": "w033", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "Your Son" }, { "words": ["w039", "w040", "w041", "w042", "w043"], "anchor": "w041", "gloss": "who lives and reigns with You" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "of the Holy Spirit" }, { "words": ["w049", "w050", "w051", "w052"], "anchor": "w051", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
