  "about": "The evangelium of the formulary “Fourth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At that time, Jesus said to His disciples: I go to Him who sent Me, and none of you asks Me: Where are You going? But because I have spoken these things to you, sorrow has filled your heart. But I tell you the truth: it is expedient for you that I go; for if I do not go away, the Paraclete will not come to you; but if I go away, I will send Him to you. And when He comes, He will convict the world of sin, and of justice, and of judgment. Of sin, because they have not believed in Me; of justice, because I go to the Father, and you will see Me no longer; and of judgment, because the prince of this world has already been judged. I have yet many things to say to you, but you cannot bear them now. But when He, the Spirit of truth, comes, He will teach you all truth. For He will not speak from Himself, but whatever He hears, He will speak; and the things that are to come He will announce to you. He will glorify Me, because He will receive from what is Mine and will announce it to you.", "alignments": [{ "words": ["w001", "w002", "w003"], "anchor": "w003", "gloss": "At that time" }, { "words": ["w004", "w005"], "anchor": "w004", "gloss": "Jesus said" }, { "words": ["w006", "w007"], "anchor": "w006", "gloss": "to His disciples" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "I have spoken" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "your heart" }, { "words": ["w034", "w035"], "anchor": "w035", "gloss": "tell the truth" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "for if" }, { "words": ["w044", "w045"], "anchor": "w045", "gloss": "I do not go away" }, { "words": ["w047", "w048"], "anchor": "w048", "gloss": "will not come" }, { "words": ["w051", "w052", "w053"], "anchor": "w053", "gloss": "but if I go away" }, { "words": ["w060", "w061"], "anchor": "w060", "gloss": "He comes" }, { "words": ["w076", "w077"], "anchor": "w077", "gloss": "they have not believed" }, { "words": ["w080", "w081", "w082"], "anchor": "w081", "gloss": "but of justice" }, { "words": ["w084", "w085", "w086"], "anchor": "w086", "gloss": "I go to the Father" }, { "words": ["w088", "w089", "w090"], "anchor": "w090", "gloss": "you will no longer see" }, { "words": ["w092", "w093", "w094"], "anchor": "w093", "gloss": "and of judgment" }, { "words": ["w096", "w097", "w098"], "anchor": "w096", "gloss": "the prince of this world" }, { "words": ["w099", "w100", "w101"], "anchor": "w100", "gloss": "has already been judged" }, { "words": ["w102", "w103", "w104"], "anchor": "w104", "gloss": "Yet I have many things" }, { "words": ["w105", "w106"], "anchor": "w106", "gloss": "to say to you" }, { "words": ["w108", "w109"], "anchor": "w109", "gloss": "you cannot" }, { "words": ["w112", "w113"], "anchor": "w112", "gloss": "But when" }, { "words": ["w114", "w115"], "anchor": "w114", "gloss": "He comes" }, { "words": ["w122", "w123", "w124"], "anchor": "w124", "gloss": "For He will not speak" }, { "words": ["w133", "w134"], "anchor": "w133", "gloss": "are to come" }, { "words": ["w138", "w139"], "anchor": "w139", "gloss": "will glorify Me" }] }
