  "text": "proprium.dominica-iv-post-pascha-evangelium",
  "about": "The evangelium of the formulary “Fourth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At that time, Jesus said to His disciples: I go to Him who sent Me, and none of you asks Me: Where are You going? But because I have spoken these things to you, sorrow has filled your heart. Yet I tell you the truth: it is expedient for you that I go. For if I do not go, the Paraclete will not come to you; but if I go, I will send Him to you. And when He comes, He will convict the world of sin, and of justice, and of judgment: of sin, because they have not believed in Me; of justice, because I go to the Father and you will no longer see Me; and of judgment, because the prince of this world has already been judged. I have yet many things to say to you, but you cannot bear them now. But when He, the Spirit of truth, comes, He will teach you all truth. For He will not speak on His own, but whatever He hears He will speak, and the things that are to come He will declare to you. He will glorify Me, because He will receive of what is Mine and will declare it to you.", "alignments": [{ "words": ["w025", "w026"], "anchor": "w025", "gloss": "I have spoken" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "for if" }, { "words": ["w044", "w045"], "anchor": "w045", "gloss": "I do not go away" }, { "words": ["w047", "w048"], "anchor": "w048", "gloss": "will not come" }, { "words": ["w076", "w077"], "anchor": "w077", "gloss": "they have not believed" }, { "words": ["w088", "w089", "w090"], "anchor": "w090", "gloss": "you will no longer see" }, { "words": ["w100", "w101"], "anchor": "w100", "gloss": "has been judged" }, { "words": ["w108", "w109"], "anchor": "w109", "gloss": "you cannot" }, { "words": ["w122", "w123", "w124"], "anchor": "w124", "gloss": "For He will not speak" }, { "words": ["w133", "w134"], "anchor": "w133", "gloss": "are to come" }] }
  },
