  "about": "The introitus of the formularies “Fifth Sunday after Easter” and “Vigil of the Ascension of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Proclaim the joyful news, and let it be heard, alleluia; proclaim it to the end of the earth: the Lord has delivered His people, alleluia, alleluia. Shout for joy to God, all the earth; sing a psalm to His name; make His praise glorious. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. Proclaim the joyful news, and let it be heard, alleluia; proclaim it to the end of the earth: the Lord has delivered His people, alleluia, alleluia.", "alignments": [{ "words": ["w012", "w013"], "anchor": "w012", "gloss": "the Lord has delivered" }, { "words": ["w014", "w015"], "anchor": "w014", "gloss": "His people" }, { "words": ["w022", "w023"], "anchor": "w023", "gloss": "sing a psalm" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "to His name" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "to His praise" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "to the Holy Spirit" }, { "words": ["w046", "w047", "w048"], "anchor": "w047", "gloss": "forever and ever" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "the Lord has delivered" }, { "words": ["w063", "w064"], "anchor": "w063", "gloss": "His people" }] }
