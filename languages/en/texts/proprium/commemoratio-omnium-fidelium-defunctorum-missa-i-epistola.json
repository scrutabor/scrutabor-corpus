  "about": "The epistola of the formulary “Commemoration of All the Faithful Departed — Mass I” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Brothers: Behold, I tell you a mystery: we will indeed all rise, but we will not all be changed—in a moment, in the twinkling of an eye, at the last trumpet. For the trumpet will sound, and the dead will rise incorruptible, and we will be changed. For this corruptible body must put on incorruption, and this mortal body must put on immortality. But when this mortal body has put on immortality, then the word that has been written will come to pass: “Death has been swallowed up in victory.” O death, where is your victory? O death, where is your sting? Now the sting of death is sin, and the power of sin is the law. But thanks be to God, who has given us the victory through our Lord Jesus Christ.", "alignments": [{ "words": ["w006", "w007", "w008"], "anchor": "w008", "gloss": "we will indeed all rise" }, { "words": ["w010", "w011", "w012"], "anchor": "w012", "gloss": "we will not all be changed" }, { "words": ["w021", "w022", "w023"], "anchor": "w021", "gloss": "for the trumpet will sound" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "for it is necessary" }, { "words": ["w033", "w034"], "anchor": "w034", "gloss": "for this corruptible body" }, { "words": ["w038", "w039"], "anchor": "w039", "gloss": "for this mortal body" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "but when" }, { "words": ["w044", "w045"], "anchor": "w045", "gloss": "this mortal body" }, { "words": ["w052", "w053"], "anchor": "w052", "gloss": "has been written" }, { "words": ["w054", "w055"], "anchor": "w054", "gloss": "has been swallowed up" }, { "words": ["w062", "w063"], "anchor": "w062", "gloss": "your victory" }, { "words": ["w067", "w068"], "anchor": "w067", "gloss": "your sting" }, { "words": ["w069", "w070"], "anchor": "w069", "gloss": "now the sting" }, { "words": ["w072", "w073"], "anchor": "w072", "gloss": "is sin" }, { "words": ["w074", "w075"], "anchor": "w074", "gloss": "and the power" }, { "words": ["w078", "w079", "w080"], "anchor": "w080", "gloss": "but thanks to God" }, { "words": ["w086", "w087"], "anchor": "w086", "gloss": "our Lord" }] }
