  "text": "proprium.dominica-in-sexagesima-collecta",
  "about": "The collecta of the formulary “Sexagesima Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, You who see that we put no trust in any deed of our own, mercifully grant that we may be strengthened against all adversity by the protection of the Doctor of the Gentiles. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w003", "gloss": "You who see" }, { "words": ["w005", "w006", "w007", "w008", "w009"], "anchor": "w009", "gloss": "we put no trust in any deed of our own" }, { "words": ["w013", "w014", "w015", "w016", "w017", "w018", "w019"], "anchor": "w019", "gloss": "we may be strengthened against all adversity by the protection of the Doctor of the Gentiles" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "our Lord" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Your Son" }, { "words": ["w028", "w029", "w030", "w031"], "anchor": "w029", "gloss": "lives and reigns with You" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Spirit" }, { "words": ["w037", "w038", "w039", "w040"], "anchor": "w037", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
