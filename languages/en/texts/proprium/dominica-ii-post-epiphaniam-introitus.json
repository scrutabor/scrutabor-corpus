  "about": "Introit of the Second Sunday after Epiphany. The antiphon and psalm verse are printed on p. 44 of the Benziger 1962 Roman Missal. The full Gloria Patri is supplied from p. 1, and the antiphon is repeated under the rubrics there and the cue on p. 44. This is a declared same-edition composite, not a continuous transcription of one page.",
  "segments": {
    "s01": { "translation": "Let all the earth adore You, O God, and sing to You; let it sing a psalm to Your name, O Most High. Sing joyfully to God, all the earth; sing a psalm to His name, give glory to His praise. Glory be to the Father, and to the Son, and to the Holy Ghost. As it was in the beginning, is now, and ever shall be, world without end. Amen. Let all the earth adore You, O God, and sing to You; let it sing a psalm to Your name, O Most High.", "alignments": [{ "words": ["w001", "w002", "w003"], "anchor": "w003", "gloss": "Let all the earth adore" }, { "words": ["w009", "w010", "w011", "w012"], "anchor": "w010", "gloss": "let it sing a psalm to Your name" }, { "words": ["w018", "w019"], "anchor": "w019", "gloss": "sing a psalm" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "to His name" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "to His praise" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "to the Holy Spirit" }, { "words": ["w046", "w047", "w048"], "anchor": "w048", "gloss": "Let all the earth adore" }, { "words": ["w054", "w055", "w056", "w057"], "anchor": "w055", "gloss": "let it sing a psalm to Your name" }] }
