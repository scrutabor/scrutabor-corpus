  "about": "The Gospel reading of the formulary “Saint James the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At that time, the mother of the sons of Zebedee approached Jesus with her sons, worshiping Him and asking something of Him. He said to her, “What do you want?” She said to Him, “Say that these two sons of mine may sit, one at Your right hand and the other at Your left, in Your kingdom.” Jesus answered, “You do not know what you are asking. Can you drink the chalice that I am to drink?” They said to Him, “We can.” He said to them, “You will indeed drink My chalice; but to sit at My right or left hand is not Mine to give you, but it is for those for whom it has been prepared by My Father.”", "alignments": [{ "words": ["w011", "w012"], "anchor": "w011", "gloss": "her sons" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "my sons" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "Your right hand" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "Your kingdom" }, { "words": ["w044", "w045"], "anchor": "w044", "gloss": "But answering" }, { "words": ["w056", "w057"], "anchor": "w056", "gloss": "am to drink" }, { "words": ["w063", "w064", "w065"], "anchor": "w063", "gloss": "My chalice indeed" }, { "words": ["w067", "w068"], "anchor": "w067", "gloss": "but to sit" }, { "words": ["w070", "w071"], "anchor": "w070", "gloss": "My right hand" }, { "words": ["w074", "w075"], "anchor": "w075", "gloss": "that is not" }, { "words": ["w081", "w082"], "anchor": "w081", "gloss": "is prepared" }, { "words": ["w084", "w085"], "anchor": "w084", "gloss": "My Father" }] }
