  "about": "The Epistle of the formulary “Most Holy Name of Jesus” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "In those days, Peter, filled with the Holy Spirit, said: Rulers of the people and elders, hear. If we are examined today concerning the good deed done to an infirm man and by what means he has been made whole, let it be known to all of you and to all the people of Israel that in the name of our Lord Jesus Christ of Nazareth, whom you crucified and whom God raised from the dead, even by Him this man stands here before you whole. This is the stone rejected by you, the builders, which has become the head of the corner. Neither is there salvation in any other; for there is no other name under heaven given to men by which we must be saved.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "those days" }, { "words": ["w006", "w007"], "anchor": "w006", "gloss": "with the Holy Spirit" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "has been made" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "of our Lord" }, { "words": ["w063", "w064"], "anchor": "w063", "gloss": "was rejected" }, { "words": ["w069", "w070"], "anchor": "w069", "gloss": "has become" }, { "words": ["w071"], "reason": "idiom" }, { "words": ["w078", "w079"], "anchor": "w078", "gloss": "any other" }, { "words": ["w081", "w082"], "anchor": "w081", "gloss": "For no" }] }
  },
