  "text": "proprium.annuntiatio-beatae-mariae-virginis-postcommunio",
  "about": "The postcommunio of the formulary “Annunciation of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Pour forth, we beseech You, O Lord, Your grace into our hearts, that we, to whom the incarnation of Christ, Your Son, was made known by the message of an angel, may, by His passion and cross, be brought to the glory of the resurrection. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "Your grace" }, { "words": ["w005", "w006"], "anchor": "w005", "gloss": "our minds" }, { "words": ["w013", "w014"], "anchor": "w013", "gloss": "Your Son" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "our Lord" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "Your Son" }, { "words": ["w041", "w042"], "anchor": "w041", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
