  "about": "The collect of the Fourth Sunday of Advent. It asks for haste, that grace outrun the sins standing in its way.",
  "segments": {
    "s01": { "translation": "Stir up Your power, O Lord, we pray, and come; help us with great might, so that through the aid of Your grace Your merciful forgiveness may hasten what our sins delay. You who live and reign with God the Father in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w026", "w027", "w028", "w029"], "anchor": "w027", "gloss": "Thou who livest and reignest" }, { "words": ["w030", "w031", "w032"], "anchor": "w032", "gloss": "with God the Father" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Ghost" }, { "words": ["w038", "w039", "w040", "w041"], "anchor": "w040", "gloss": "world without end" }] },
    "s02": { "translation": "Amen." }
  },
