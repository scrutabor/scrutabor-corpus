  "text": "proprium.nativitas-domini-in-nocte-collecta",
  "about": "The collecta of the formulary “Nativity of the Lord — Mass during the Night” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who have made this most sacred night shine with the brightness of the true Light, grant, we beseech You, that we who have known the mysteries of His light on earth may also enjoy His joys in heaven. Who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w003", "w004", "w005", "w006", "w007", "w008", "w009", "w010"], "anchor": "w008", "gloss": "have made this most sacred night shine with the brightness of the true Light" }, { "words": ["w014", "w015", "w016", "w017", "w018", "w019"], "anchor": "w019", "gloss": "we who have known the mysteries of His light on earth" }, { "words": ["w020", "w021", "w022", "w023", "w024", "w025"], "anchor": "w025", "gloss": "may also enjoy His joys in heaven" }, { "words": ["w026", "w027", "w028", "w029", "w030"], "anchor": "w028", "gloss": "Who lives and reigns with You" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "of the Holy Spirit" }, { "words": ["w036", "w037", "w038", "w039"], "anchor": "w038", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
