  "text": "proprium.dominica-ii-post-pentecosten-secreta",
  "about": "The secreta of the formulary “2nd Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May the offering to be dedicated to Your name, Lord, purify us and day by day lead us to a heavenly way of life. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w004", "w005"], "anchor": "w005", "gloss": "to Your name" }, { "words": ["w009", "w010", "w011", "w012"], "anchor": "w010", "gloss": "day by day" }, { "words": ["w013", "w014", "w015", "w016", "w017"], "anchor": "w016", "gloss": "may lead to a heavenly way of life" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "our Lord" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Your Son" }, { "words": ["w025", "w026", "w027", "w028", "w029"], "anchor": "w027", "gloss": "who lives and reigns with You" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w035", "w036", "w037", "w038"], "anchor": "w037", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
