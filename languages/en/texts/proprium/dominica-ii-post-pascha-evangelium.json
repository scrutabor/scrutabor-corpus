  "about": "The evangelium of the formulary “Second Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At that time, Jesus said to the Pharisees: I am the good shepherd. The good shepherd gives his life for his own sheep. But a hired worker, who is not a shepherd and to whom the sheep do not belong, sees a wolf approaching, abandons the sheep and runs away; and the wolf seizes and scatters the sheep. The hired worker, however, runs away because he is a hired worker and has no care for the sheep. I am the good shepherd; I know My sheep, and My sheep know Me, just as the Father knows Me and I know the Father; and I lay down My life for My sheep. I also have other sheep that are not from this fold; I must bring them as well, and they will hear My voice, and there will be one fold and one shepherd.", "alignments": [{ "words": ["w004", "w005", "w006"], "anchor": "w004", "gloss": "Jesus said to the Pharisees" }, { "words": ["w009", "w010"], "anchor": "w009", "gloss": "the good shepherd" }, { "words": ["w011", "w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "The good shepherd gives his life" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "his own sheep" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "But a hired worker" }, { "words": ["w021", "w022", "w023", "w024", "w025"], "anchor": "w022", "gloss": "who is also not a shepherd" }, { "words": ["w026", "w027", "w028", "w029", "w030"], "anchor": "w026", "gloss": "to whom the sheep do not belong" }, { "words": ["w045", "w046"], "anchor": "w045", "gloss": "The hired worker, however" }, { "words": ["w049", "w050"], "anchor": "w050", "gloss": "he is a hired worker" }, { "words": ["w052", "w053", "w054", "w055", "w056", "w057"], "anchor": "w053", "gloss": "he has no care for the sheep" }, { "words": ["w060", "w061"], "anchor": "w060", "gloss": "the good shepherd" }, { "words": ["w066", "w067", "w068"], "anchor": "w066", "gloss": "My sheep know Me" }, { "words": ["w069", "w070", "w071", "w072"], "anchor": "w070", "gloss": "just as the Father knows Me" }, { "words": ["w078", "w079", "w080"], "anchor": "w080", "gloss": "I lay down My life" }, { "words": ["w082", "w083"], "anchor": "w082", "gloss": "My sheep" }, { "words": ["w085", "w086", "w087"], "anchor": "w087", "gloss": "I have other sheep" }, { "words": ["w089", "w090"], "anchor": "w090", "gloss": "are not" }, { "words": ["w095", "w096", "w097", "w098"], "anchor": "w096", "gloss": "I must bring them" }, { "words": ["w100", "w101", "w102"], "anchor": "w102", "gloss": "they will hear My voice" }] }
