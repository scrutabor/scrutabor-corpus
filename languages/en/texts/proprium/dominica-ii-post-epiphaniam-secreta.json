  "text": "proprium.dominica-ii-post-epiphaniam-secreta",
  "about": "The secreta of the formulary “Second Sunday after Epiphany” in the 1962 Roman Missal. Page 45 prints the proper body with a short Per Dóminum cue. The full conclusion is expanded under Rubricae generales 115 a from printed fragments on pages 123 and 226 of the same edition. It is not a continuous transcription of one page.",
  "segments": {
    "s01": { "translation": "Sanctify, O Lord, the gifts offered, and cleanse us from the stains of our sins. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002", "w003", "w004"], "anchor": "w004", "gloss": "Sanctify, Lord, the gifts offered" }, { "words": ["w005", "w006", "w007", "w008", "w009", "w010"], "anchor": "w010", "gloss": "and cleanse us from the stains of our sins" }, { "words": ["w012", "w013"], "anchor": "w012", "gloss": "our Lord" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "Your Son" }, { "words": ["w019", "w020", "w021", "w022"], "anchor": "w020", "gloss": "lives and reigns with You" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w028", "w029", "w030", "w031"], "anchor": "w030", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
