  "about": "The evangelium of the formulary “Epiphany of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "When Jesus was born in Bethlehem of Juda in the days of King Herod, behold, Magi from the East came to Jerusalem, saying: Where is He who is born King of the Jews? For we have seen His star in the East and have come to adore Him. King Herod, hearing this, was troubled, and all Jerusalem with him. Gathering together all the chief priests and scribes of the people, he inquired of them where Christ should be born. They said to him: In Bethlehem of Juda; for thus it is written by the prophet: And you, Bethlehem, land of Juda, are by no means least among the princes of Juda, for out of you will come forth a Ruler who will govern My people Israel. Then Herod, privately calling the Magi, diligently learned from them the time when the star appeared. Sending them into Bethlehem, he said: Go and inquire diligently concerning the Child; and when you have found Him, bring me word, that I also may come and adore Him. Having heard the king, they went their way. And behold, the star which they had seen in the East went before them until it came and stood over where the Child was. Seeing the star, they rejoiced with exceeding great joy. Entering into the house, they found the Child with Mary His mother.", "alignments": [{ "words": ["w002", "w003", "w004"], "anchor": "w002", "gloss": "Jesus had been born" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "has been born" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "For we have seen" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "His star" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "was troubled" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "chief priests" }, { "words": ["w068", "w069"], "anchor": "w068", "gloss": "for thus" }, { "words": ["w080", "w081"], "anchor": "w081", "gloss": "are least" }, { "words": ["w085", "w086", "w087"], "anchor": "w085", "gloss": "for from you" }, { "words": ["w092", "w093"], "anchor": "w092", "gloss": "My people" }, { "words": ["w146", "w147"], "anchor": "w147", "gloss": "until" }, { "words": ["w157", "w158"], "anchor": "w157", "gloss": "they rejoiced" }, { "words": ["w159", "w160"], "anchor": "w159", "gloss": "with great joy" }, { "words": ["w169", "w170"], "anchor": "w169", "gloss": "His mother" }] },
    "s02": { "narrative": "Here all genuflect." },
    "s03": { "translation": "Falling down, they adored Him; and opening their treasures, they offered Him gifts: gold, frankincense, and myrrh. Having received an answer in sleep that they should not return to Herod, they went back another way into their own country.", "alignments": [{ "words": ["w177", "w178"], "anchor": "w177", "gloss": "their treasures" }, { "words": ["w191", "w192"], "anchor": "w192", "gloss": "that they should not return" }, { "words": ["w198", "w199"], "anchor": "w198", "gloss": "they returned" }, { "words": ["w201", "w202"], "anchor": "w201", "gloss": "their country" }] }
  },
