  "segments": {
    "s01": { "translation": "Beloved by God and by men is he whose memory is blessed. He made him in glory like the saints, and made him great in the dread of his enemies, and by His words He stilled portents. He glorified him before kings, and commanded him in the presence of His people, and showed him His glory. In his faith and gentleness He made him holy, and chose him from all flesh. For He listened to him and to his voice, and led him into the cloud. And He gave him commandments face to face, and a law of life and of instruction.", "alignments": [{ "words": ["w007", "w008"], "anchor": "w008", "gloss": "in benediction" }] }
