  "segments": {
    "s01": { "translation": "At that time, Jesus was speaking in parables to the chief priests and the Pharisees, saying: The kingdom of heaven has been likened to a king who made a marriage feast for his son. And he sent his servants to call the invited guests to the marriage feast, and they would not come. Once more he sent other servants, saying: Tell the invited guests: Behold, I have prepared my banquet; my bulls and my fattened animals are slaughtered, and everything is ready; come to the marriage feast. But they took no notice, and went off, one to his farm and another to his business; while the others laid hold of his servants, treated them outrageously, and put them to death. When the king heard this, he became angry; and he sent his armies and destroyed those murderers, and burned down their city. Then he told his servants: The marriage feast is indeed ready, but those who were invited were not worthy. Go, then, to the crossroads, and call to the marriage feast whomever you find. And going out into the roads, his servants assembled all they found, the bad and the good; and the marriage feast was filled with those reclining at table. And the king went in to see those at table, and there he saw a man not dressed in a wedding garment. And he asked him: Friend, how did you enter here, not having a wedding garment? But he fell silent. Then the king told the attendants: Bind his hands and feet, and throw him into the outer darkness; there will be weeping and gnashing of teeth. For many are called, but few are chosen.", "alignments": [{ "words": ["w013", "w014", "w015"], "anchor": "w014", "gloss": "Has been likened" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "for his own son" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "his servants" }, { "words": ["w044", "w045"], "anchor": "w044", "gloss": "my banquet" }, { "words": ["w047", "w048"], "anchor": "w047", "gloss": "my oxen" }, { "words": ["w051", "w052"], "anchor": "w051", "gloss": "have been killed" }, { "words": ["w066", "w067"], "anchor": "w066", "gloss": "his estate" }, { "words": ["w071", "w072"], "anchor": "w071", "gloss": "his business" }, { "words": ["w086", "w087"], "anchor": "w086", "gloss": "became angry" }, { "words": ["w090", "w091"], "anchor": "w090", "gloss": "his armies" }, { "words": ["w101", "w102"], "anchor": "w101", "gloss": "to his servants" }, { "words": ["w105", "w106"], "anchor": "w105", "gloss": "is ready" }, { "words": ["w109", "w110"], "anchor": "w109", "gloss": "had been invited" }, { "words": ["w111", "w112"], "anchor": "w112", "gloss": "were not" }, { "words": ["w139", "w140"], "anchor": "w139", "gloss": "was filled" }, { "words": ["w191", "w192"], "anchor": "w191", "gloss": "For many" }] }
