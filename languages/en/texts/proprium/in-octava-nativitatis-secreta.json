  "text": "proprium.in-octava-nativitatis-secreta",
  "about": "The secreta of the formulary “Octave Day of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We beseech You, O Lord: having received our gifts and prayers, cleanse us by the heavenly mysteries and graciously hear us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005", "w006"], "anchor": "w003", "gloss": "We beseech You, Lord: having received our gifts and prayers," }, { "words": ["w008", "w009", "w010", "w011"], "anchor": "w010", "gloss": "cleanse us by the heavenly mysteries" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "our Lord" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "Jesus Christ" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "Your Son" }, { "words": ["w022", "w023", "w024", "w025", "w026"], "anchor": "w024", "gloss": "who lives and reigns with You" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w032", "w033", "w034", "w035"], "anchor": "w034", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
