  "text": "proprium.in-octava-nativitatis-secreta",
  "about": "The secreta of the formulary “Octave Day of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We beseech Thee, O Lord: having received our gifts and prayers, cleanse us by the heavenly mysteries and graciously hear us. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
