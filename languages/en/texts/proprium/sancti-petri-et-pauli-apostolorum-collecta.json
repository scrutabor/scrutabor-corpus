  "about": "The collecta of the formulary “Saints Peter and Paul, Apostles” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, Who made this day holy by the martyrdom of Your Apostles Peter and Paul, grant Your Church to follow in all things the teaching of those from whom she first received the faith. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006"], "anchor": "w005", "gloss": "of Your Apostles" }, { "words": ["w013", "w014"], "anchor": "w013", "gloss": "to Your Church" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "our Lord" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "Your Son" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
