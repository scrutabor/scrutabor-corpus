  "text": "proprium.commemoratio-omnium-fidelium-defunctorum-missa-iii-collecta",
  "about": "The collecta of the formulary “Commemoration of All the Faithful Departed — Mass III” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who forgives sins and desires to save mankind, we beseech Your mercy to grant, by the intercession of Blessed Mary, ever Virgin, and that of all Your saints, that the souls of Your servants and handmaids who have departed this life may enter upon the enjoyment of unending happiness. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w003", "gloss": "giver of pardon" }, { "words": ["w005", "w006", "w007"], "anchor": "w007", "gloss": "lover of human salvation" }, { "words": ["w009", "w010"], "anchor": "w009", "gloss": "Thy clemency" }, { "words": ["w061", "w062", "w063"], "anchor": "w061", "gloss": "of Thy servants and handmaids" }, { "words": ["w023", "w024", "w025", "w026", "w027"], "anchor": "w027", "gloss": "with blessed Mary, ever Virgin, interceding" }, { "words": ["w029", "w030", "w031"], "anchor": "w030", "gloss": "all Thy saints" }, { "words": ["w033", "w034", "w035"], "anchor": "w035", "gloss": "a share in everlasting happiness" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "our Lord" }, { "words": ["w043", "w044"], "anchor": "w043", "gloss": "Thy Son" }, { "words": ["w052", "w053"], "anchor": "w052", "gloss": "of the Holy Spirit" }, { "words": ["w055", "w056", "w057", "w058"], "anchor": "w057", "gloss": "world without end" }] },
    "s02": { "translation": "Amen." }
  },
