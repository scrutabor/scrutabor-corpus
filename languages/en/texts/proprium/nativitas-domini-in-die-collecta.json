  "text": "proprium.nativitas-domini-in-die-collecta",
  "about": "The collecta of the formulary “Nativity of the Lord — Mass during the Day” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, we beseech You, almighty God, that the new birth in the flesh of Your Only-begotten may set us free, whom the old bondage holds beneath the yoke of sin. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w007", "w008", "w009", "w010", "w011", "w012"], "anchor": "w012", "gloss": "the new birth in the flesh of Your Only-begotten" }, { "words": ["w015", "w016", "w017"], "anchor": "w017", "gloss": "beneath the yoke of sin" }, { "words": ["w022", "w023", "w024", "w025", "w026"], "anchor": "w023", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your Son" }, { "words": ["w029", "w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "who lives and reigns with You" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }, { "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
