  "about": "The collecta of the formulary “Ascension of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, we beseech You, almighty God, that we, who believe that Your Only-begotten, our Redeemer, ascended this day into heaven, may ourselves also dwell in mind amid heavenly things. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w038", "w039"], "anchor": "w038", "gloss": "of the Holy Spirit" }, { "words": ["w041", "w042", "w043", "w044"], "anchor": "w043", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
