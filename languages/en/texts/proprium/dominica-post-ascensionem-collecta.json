  "about": "The collecta of the formulary “Sunday after the Ascension” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Almighty and everlasting God, grant that our will may always be devoted to You and that we may always serve Your majesty with a sincere heart. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w006", "w007", "w008", "w009", "w010", "w011"], "anchor": "w010", "gloss": "ever have a will devoted to You" }, { "words": ["w013", "w014", "w015", "w016", "w017"], "anchor": "w017", "gloss": "serve Your majesty with a sincere heart" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "our Lord" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Your Son" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "of the Holy Spirit" }, { "words": ["w035", "w036", "w037", "w038"], "anchor": "w037", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
