  "about": "The Epistle of the feast of the Most Holy Body of Christ, 1 Corinthians 11:23–29. Saint Paul hands on the institution of the Eucharist and warns against receiving the Lord’s Body and Blood unworthily.",
  "segments": {
    "s01": { "translation": "Brothers: For I received from the Lord what I also handed on to you: the Lord Jesus, on the night when He was betrayed, took bread and, giving thanks, broke it and said: “Take and eat: this is My Body, which will be given up for you. Do this in remembrance of Me.”", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "For I" }, { "words": ["w014", "w015", "w016"], "anchor": "w014", "gloss": "on the night when" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "giving thanks" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "My Body" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "Do this" }, { "words": ["w039", "w040", "w041"], "anchor": "w039", "gloss": "in remembrance of Me" }] },
    "s02": { "translation": "Likewise, after supper He also took the chalice, saying: “This chalice is the new covenant in My Blood. Do this, whenever you drink, in remembrance of Me.”", "alignments": [{ "words": ["w048", "w049"], "anchor": "w049", "gloss": "This chalice" }, { "words": ["w050", "w051", "w052"], "anchor": "w052", "gloss": "is the new covenant" }, { "words": ["w056", "w057"], "anchor": "w056", "gloss": "Do this" }, { "words": ["w060", "w061", "w062"], "anchor": "w060", "gloss": "in remembrance of Me" }] },
    "s03": { "translation": "For whenever you eat this bread and drink the chalice, you will proclaim the Lord’s death until He comes.", "alignments": [{ "words": ["w063", "w064"], "anchor": "w063", "gloss": "For as often as" }, { "words": ["w066", "w067"], "anchor": "w066", "gloss": "this bread" }] },
    "s04": { "translation": "Therefore, whoever eats this bread or drinks the Lord’s chalice unworthily will be guilty of an offense against the Lord’s Body and Blood.", "alignments": [{ "words": ["w079", "w080"], "anchor": "w079", "gloss": "this bread" }, { "words": ["w086", "w087"], "anchor": "w086", "gloss": "will be guilty of an offense" }] },
    "s05": { "translation": "But let a person examine himself, and so eat of that bread and drink from the chalice.", "alignments": [{ "words": ["w092", "w093", "w094", "w095"], "anchor": "w092", "gloss": "But let a person examine himself" }, { "words": ["w099", "w100"], "anchor": "w099", "gloss": "that bread" }] },
    "s06": { "translation": "For whoever eats and drinks unworthily eats and drinks judgment on himself, without discerning the Lord’s Body.", "alignments": [{ "words": ["w106", "w107"], "anchor": "w106", "gloss": "For he who" }] }
  },
