  "segments": {
    "s01": { "translation": "At that time Jesus entered into a boat, and His disciples followed Him. Behold, a great tempest arose in the sea, so that the boat was covered with waves; but He was asleep. His disciples came to Him, awoke Him, and said: Lord, save us, we perish. Jesus said unto them: Why are ye fearful, O ye of little faith? Then rising, He commanded the winds and the sea, and there came a great calm. The men wondered, saying: What manner of Man is this, that the winds and the sea obey Him?", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "when Jesus entered" }, { "words": ["w008", "w009"], "anchor": "w008", "gloss": "followed" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "arose" }, { "words": ["w059", "w060"], "anchor": "w059", "gloss": "there came" }, { "words": ["w065", "w066"], "anchor": "w065", "gloss": "wondered" }] }
