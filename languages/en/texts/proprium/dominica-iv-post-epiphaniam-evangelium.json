  "about": "The evangelium of the formulary “Fourth Sunday after Epiphany” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At that time, Jesus entered into a boat, and His disciples followed Him. Behold, a great tempest arose in the sea, so that the boat was covered with waves; but He was asleep. His disciples came to Him, awoke Him, and said: Lord, save us, we perish. Jesus says to them: Why are you fearful, you of little faith? Then rising, He commanded the winds and the sea, and there came a great calm. The men wondered, saying: What manner of Man is this, that the winds and the sea obey Him?", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "when Jesus entered" }, { "words": ["w008", "w009", "w010", "w011", "w012"], "anchor": "w008", "gloss": "His disciples followed Him" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "a great tempest" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "arose" }, { "words": ["w030", "w031", "w032", "w033", "w034"], "anchor": "w030", "gloss": "His disciples came to Him" }, { "words": ["w044", "w045", "w046"], "anchor": "w044", "gloss": "Jesus says to them" }, { "words": ["w048", "w049", "w050", "w051"], "anchor": "w049", "gloss": "are you fearful, you of little faith" }, { "words": ["w059", "w060"], "anchor": "w059", "gloss": "there came" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "a great calm" }, { "words": ["w065", "w066"], "anchor": "w065", "gloss": "wondered" }] }
  },
