  "text": "proprium.dominica-infra-octavam-nativitatis-secreta",
  "about": "The secreta of the formulary “Sunday within the Octave of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, we beseech Thee, almighty God, that the gift offered may find favor in the sight of Thy majesty, obtain for us the grace of holy devotion, and bring forth the fruit of blessed eternity. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God,", "alignments": [{ "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }] },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
