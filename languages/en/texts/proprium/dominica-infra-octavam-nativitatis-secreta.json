  "text": "proprium.dominica-infra-octavam-nativitatis-secreta",
  "about": "The secreta of the formulary “Sunday within the Octave of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, we beseech You, almighty God, that the gift offered before the eyes of Your majesty may obtain for us the grace of pious devotion and gain the fruit of blessed eternity. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w007", "w008"], "anchor": "w007", "gloss": "of Your majesty" }, { "words": ["w012", "w013", "w014", "w015", "w016"], "anchor": "w016", "gloss": "may obtain for us the grace of pious devotion" }, { "words": ["w018", "w019", "w020", "w021"], "anchor": "w021", "gloss": "may gain the fruit of blessed eternity" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Jesus Christ" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your Son" }, { "words": ["w029", "w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "who lives and reigns with You" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
