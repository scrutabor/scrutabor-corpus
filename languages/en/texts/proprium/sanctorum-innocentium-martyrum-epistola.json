  "about": "The Epistle of the formulary “The Holy Innocents, Martyrs” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "In those days, I saw on Mount Sion the Lamb standing, and with Him one hundred forty-four thousand, who had His name and His Father’s name written on their foreheads. Then I heard a voice out of heaven, as the voice of many waters and as the voice of great thunder; and the voice I heard was like that of harpists playing their harps. And they kept singing what seemed a new song before the throne, and in front of the four living beings and the elders; and none could sing the song except those one hundred forty-four thousand, who were bought from the earth. These are the ones who have not been defiled with women, since they are virgins. These follow the Lamb wherever He may go. These were bought from among men, firstfruits for God and for the Lamb; and no lie has been found in their mouth, for they are without stain before God’s throne.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "those days" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "His name" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "of His Father" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "their foreheads" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "of many waters" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "of loud thunder" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "their harps" }, { "words": ["w055", "w056"], "anchor": "w055", "gloss": "a new song" }, { "words": ["w077", "w078"], "anchor": "w077", "gloss": "have been purchased" }, { "words": ["w086", "w087", "w088"], "anchor": "w088", "gloss": "have not been defiled" }, { "words": ["w089", "w090", "w091"], "anchor": "w089", "gloss": "for they are virgins" }, { "words": ["w098", "w099"], "anchor": "w098", "gloss": "were purchased" }, { "words": ["w108", "w109"], "anchor": "w108", "gloss": "their mouth" }, { "words": ["w110", "w111", "w112"], "anchor": "w112", "gloss": "was not found" }, { "words": ["w114", "w115", "w116", "w117"], "anchor": "w117", "gloss": "for they are without blemish" }] }
