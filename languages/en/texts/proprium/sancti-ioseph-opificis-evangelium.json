  "segments": {
    "s01": { "translation": "At that time, coming into His own country, Jesus was teaching them in their synagogues, so that they were amazed and said: How does this man come to have this wisdom and these miracles? Is this not the carpenter’s son? Is His mother not called Mary, and His brethren James and Joseph and Simon and Jude? And are His sisters not all among us? How then does this man come to have all these things? And they took offense at Him. But Jesus said to them: A prophet is not without honor except in his own country and in his own home. And He did not work many miracles there on account of their unbelief.", "alignments": [{ "words": ["w066", "w067", "w068"], "anchor": "w067", "gloss": "A prophet is not" }, { "words": ["w073", "w074"], "anchor": "w073", "gloss": "his own country" }, { "words": ["w077", "w078"], "anchor": "w077", "gloss": "his own house" }, { "words": ["w080", "w081"], "anchor": "w081", "gloss": "did not work" }] }
