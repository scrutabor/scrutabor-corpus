  "text": "proprium.sancti-andreae-apostoli-postcommunio",
  "about": "The postcommunio of the formulary “Saint Andrew the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord, we have received the divine mysteries, rejoicing in the feast of blessed Andrew the Apostle: grant, we beseech You, that as they bring glory to Your saints, so they may bring pardon to us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006", "w007", "w008"], "anchor": "w008", "gloss": "in the feast of blessed Andrew the Apostle" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "our Lord" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Jesus Christ" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "Your Son" }, { "words": ["w030", "w031", "w032", "w033", "w034"], "anchor": "w032", "gloss": "who lives and reigns with You" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "of the Holy Spirit" }, { "words": ["w040", "w041", "w042", "w043"], "anchor": "w042", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
