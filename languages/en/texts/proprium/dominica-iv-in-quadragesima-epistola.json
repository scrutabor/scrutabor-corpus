  "text": "proprium.dominica-iv-in-quadragesima-epistola",
  "about": "The epistola of the formulary “Fourth Sunday of Lent” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Brethren: It is written that Abraham had two sons, the one by a bondwoman and the other by a free woman. But he who was of the bondwoman was born according to the flesh, while he of the free woman was by promise. These things are said by way of allegory. For these are the two covenants: the one on Mount Sinai, bearing children into bondage, which is Hagar; for Sinai is a mountain in Arabia, which is joined to that Jerusalem which now is, and is in bondage with her children. But that Jerusalem which is above is free, which is our mother. For it is written: Rejoice, barren one, you who do not bear; break forth and cry, you who do not travail, for many are the children of the desolate, more than of her who has a husband. Now we, brethren, as Isaac was, are the children of promise. But as then he who was born according to the flesh persecuted him who was according to the spirit, so also it is now. But what does the Scripture say? Cast out the bondwoman and her son, for the son of the bondwoman will not be heir with the son of the free woman. So then, brethren, we are not children of the bondwoman, but of the free woman, by the freedom with which Christ has made us free.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "It is written" }, { "words": ["w006", "w007", "w008"], "anchor": "w008", "gloss": "had two sons" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "was born" }, { "words": ["w031", "w032", "w033", "w034"], "anchor": "w034", "gloss": "are said by way of allegory" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "For these" }, { "words": ["w045", "w046", "w047"], "anchor": "w047", "gloss": "bearing children into bondage" }, { "words": ["w051", "w052", "w053"], "anchor": "w053", "gloss": "for Mount Sinai" }, { "words": ["w058", "w059"], "anchor": "w058", "gloss": "is joined" }, { "words": ["w068", "w069"], "anchor": "w068", "gloss": "her children" }, { "words": ["w070", "w071"], "anchor": "w070", "gloss": "But that" }, { "words": ["w076", "w077"], "anchor": "w077", "gloss": "is free" }, { "words": ["w080", "w081"], "anchor": "w080", "gloss": "our mother" }, { "words": ["w082", "w083", "w084"], "anchor": "w082", "gloss": "For it is written" }, { "words": ["w088", "w089"], "anchor": "w089", "gloss": "do not bear" }, { "words": ["w094", "w095"], "anchor": "w095", "gloss": "do not travail" }, { "words": ["w111", "w112", "w113"], "anchor": "w113", "gloss": "are children of the promise" }, { "words": ["w121", "w122"], "anchor": "w121", "gloss": "was born" }, { "words": ["w138", "w139"], "anchor": "w138", "gloss": "her son" }, { "words": ["w140", "w141", "w142", "w143", "w144", "w145"], "anchor": "w142", "gloss": "for the son of the bondwoman will not be an heir" }, { "words": ["w151", "w152"], "anchor": "w152", "gloss": "we are not" }, { "words": ["w153", "w154"], "anchor": "w154", "gloss": "children of the bondwoman" }, { "words": ["w160", "w161"], "anchor": "w161", "gloss": "has set us free" }] }
  },
