  "text": "proprium.dominica-pentecostes-evangelium",
  "about": "Jesus speaks of keeping His word, promises the Holy Spirit, and gives His disciples peace before His departure.",
  "segments": {
    "s01": { "translation": "At that time Jesus said to His disciples: If anyone loves Me, he will keep My word, and My Father will love him, and We will come to him and will make Our abode with him. He who does not love Me does not keep My words. And the word which you have heard is not Mine, but the Father's who sent Me. These things I have spoken to you, abiding with you. But the Paraclete, the Holy Ghost, whom the Father will send in My name, He will teach you all things and bring all things to your mind, whatever I shall have said to you. Peace I leave with you; My peace I give to you; not as the world gives do I give to you. Let not your heart be troubled, nor let it be afraid. You have heard that I said to you: I go away, and I come to you. If you loved Me, you would indeed be glad because I go to the Father, for the Father is greater than I. And now I have told you before it comes to pass, that when it has come to pass you may believe. I will no longer speak many things with you. For the prince of this world is coming, and in Me he has nothing. But that the world may know that I love the Father, and as the Father has given Me a commandment, so I do.", "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "to His disciples" }, { "words": ["w012", "w013"], "anchor": "w012", "gloss": "My word" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "My Father" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "does not love" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "My words" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "does not keep" }, { "words": ["w041", "w042"], "anchor": "w041", "gloss": "is not" }, { "words": ["w051", "w052"], "anchor": "w051", "gloss": "I have spoken" }, { "words": ["w059", "w060"], "anchor": "w059", "gloss": "the Holy Spirit" }, { "words": ["w065", "w066"], "anchor": "w065", "gloss": "My name" }, { "words": ["w072", "w073"], "anchor": "w072", "gloss": "will remind you of" }, 