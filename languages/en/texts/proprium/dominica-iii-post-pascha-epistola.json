  "about": "The epistola of the formulary “Third Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Dearly beloved: I urge you, as strangers and pilgrims, to abstain from carnal desires, which wage war against the soul, keeping your conduct good among the Gentiles, so that, in the very matter in which they speak against you as evildoers, judging you by your good works, they may glorify God in the day of visitation. Be subject, therefore, to every human creature for God’s sake: whether to the king as supreme, or to governors as sent by him to punish evildoers and to praise those who do good; for such is the will of God, that by doing good you may silence the ignorance of foolish men — as free people, and not as those who hold their freedom as a cloak for malice, but as servants of God. Honor everyone; love the brotherhood; fear God; honor the king. Servants, be subject to your masters with all fear, not only to the good and gentle, but also to the harsh. For this is grace in Christ Jesus our Lord.", "alignments": [{ "words": ["w009"], "reason": "idiom" }, { "words": ["w017", "w018", "w019", "w020", "w021", "w022"], "anchor": "w021", "gloss": "keeping your conduct good among the Gentiles" }, { "words": ["w024", "w025", "w026"], "anchor": "w025", "gloss": "in the matter in which" }, { "words": ["w030", "w031", "w032"], "anchor": "w032", "gloss": "as evildoers" }, { "words": ["w033", "w034", "w035", "w036", "w037"], "anchor": "w037", "gloss": "judging you by your good works" }, { "words": ["w043", "w044", "w045"], "anchor": "w045", "gloss": "Therefore be subject" }, { "words": ["w046", "w047", "w048"], "anchor": "w048", "gloss": "to every human creature" }, { "words": ["w058", "w059", "w060"], "anchor": "w060", "gloss": "sent by him" }, { "words": ["w064", "w065", "w066"], "anchor": "w064", "gloss": "and praise of the good" }, { "words": ["w068", "w069"], "anchor": "w069", "gloss": "such is" }, { "words": ["w074", "w075"], "anchor": "w075", "gloss": "you may silence" }, { "words": ["w076", "w077", "w078"], "anchor": "w078", "gloss": "the ignorance of foolish men" }, { "words": ["w083", "w084", "w085", "w086", "w087"], "anchor": "w085", "gloss": "as those holding freedom as a cloak for malice" }, { "words": ["w092", "w093"], "anchor": "w093", "gloss": "Honor everyone" }, { "words": ["w094", "w095"], "anchor": "w095", "gloss": "love the brotherhood" }, { "words": ["w096", "w097"], "anchor": "w097", "gloss": "fear God" }, { "words": ["w098", "w099"], "anchor": "w099", "gloss": "honor the king" }, { "words": ["w101", "w102"], "anchor": "w102", "gloss": "be subject" }, { "words": ["w115", "w116", "w117"], "anchor": "w116", "gloss": "For this is" }, { "words": ["w122", "w123"], "anchor": "w122", "gloss": "our Lord" }] }
