  "text": "proprium.dedicatio-sancti-michaelis-archangeli-secreta",
  "about": "The secreta of the formulary “Dedication of Saint Michael the Archangel” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We offer You sacrifices of praise, O Lord, humbly praying You to accept them graciously and to grant that they may be helpful for our salvation through the intercession of the Angels who intercede for us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God," },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
