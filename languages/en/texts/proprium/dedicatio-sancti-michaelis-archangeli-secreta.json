  "text": "proprium.dedicatio-sancti-michaelis-archangeli-secreta",
  "about": "The secreta of the formulary “Dedication of Saint Michael the Archangel” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We offer You sacrifices of praise, O Lord, humbly asking that, through angelic intercession on our behalf, You graciously accept them and grant that they may serve our salvation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w010", "w011", "w012", "w013", "w014"], "anchor": "w013", "gloss": "with angelic intercession pleading for us" }, { "words": ["w019", "w020", "w021", "w022", "w023"], "anchor": "w023", "gloss": "may grant that they contribute to our salvation" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "our Lord" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "Your Son" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
