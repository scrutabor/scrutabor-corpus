  "text": "proprium.sancti-marci-evangelistae-postcommunio",
  "about": "The postcommunio of the formulary “Saint Mark the Evangelist” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May Your holy mysteries, we beseech You, O Lord, grant us continual protection, by which, through the prayers of blessed Mark, Your Evangelist, they may always guard us from all adversities. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }, { "words": ["w038", "w039", "w040", "w041"], "anchor": "w040", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
