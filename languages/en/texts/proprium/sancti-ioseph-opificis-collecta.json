    "s01": { "translation": "O God, Creator of all things, who established the law of labor for the human race: graciously grant that, by the example and patronage of Saint Joseph, we may accomplish the works You command and attain the rewards You promise. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w007", "w008"], "anchor": "w008", "gloss": "for the human race" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "our Lord" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "Your Son" }, { "words": ["w041", "w042"], "anchor": "w041", "gloss": "of the Holy Spirit" }, { "words": ["w044", "w045", "w046", "w047"], "anchor": "w046", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
