  "text": "proprium.dominica-xiv-post-pentecosten-secreta",
  "about": "The secreta of the formulary “14th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant us, Lord, we beseech You, that this salutary sacrifice may be not only a cleansing from our sins but also a propitiation of Your divine power. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
