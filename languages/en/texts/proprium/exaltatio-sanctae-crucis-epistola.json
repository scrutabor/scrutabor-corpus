  "text": "proprium.exaltatio-sanctae-crucis-epistola",
  "about": "The epistola of the formulary “Exaltation of the Holy Cross” in the 1962 Roman Missal. The same Epistle is read on Palm Sunday.",
  "segments": {
    "s01": { "translation": "Brethren: For let this be your mind, which was also in Christ Jesus: who, being in the form of God, did not regard it as robbery to be equal to God, but emptied Himself, taking the form of a servant, being made in the likeness of men, and found in outward bearing as a man. He humbled Himself and became obedient even to the point of death, and that the death of the cross. Because of this God also exalted Him, and granted Him the name which is above every name:", "alignments": [{ "words": ["w002", "w003", "w004"], "anchor": "w004", "gloss": "For have this in mind" }, { "words": ["w018", "w019", "w020", "w021"], "anchor": "w020", "gloss": "did not regard it as robbery" }, { "words": ["w023"], "reason": "idiom" }, { "words": ["w027", "w028"], "anchor": "w028", "gloss": "emptied Himself" }, { "words": ["w029", "w030", "w031"], "anchor": "w031", "gloss": "taking the form of a servant" }, { "words": ["w045", "w046"], "anchor": "w046", "gloss": "to the point of" }, { "words": ["w048", "w049"], "anchor": "w048", "gloss": "even death" }] },
    "s02": { "narrative": "Here all genuflect." },
    "s03": { "translation": "so that in the name of Jesus every knee should be bent, of those in heaven, on earth, and in the underworld, and that every tongue should confess that the Lord Jesus Christ is in the glory of God the Father.", "alignments": [{ "words": ["w085", "w086", "w087", "w088", "w089"], "anchor": "w087", "gloss": "is in the glory of God the Father" }] }
  },
