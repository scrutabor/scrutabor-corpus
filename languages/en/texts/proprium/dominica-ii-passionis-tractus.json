  "segments": {
    "s01": { "translation": "O God, my God, look upon me: why have You forsaken me? Far from my salvation are the words of my sins. O my God, I will cry by day, and You will not hear; and by night, and it will not be reckoned as folly in me. But You dwell in the holy place, the praise of Israel. In You our fathers hoped; they hoped, and You delivered them. They cried to You, and they were saved; they hoped in You, and were not confounded. But I am a worm, and no man; the reproach of men, and the outcast of the people. All who saw me scorned me; they spoke with their lips and shook the head. He hoped in the Lord, let Him deliver him; let Him save him, since He delights in him. But they themselves considered and looked closely at me; they divided my garments among them, and upon my vesture they cast lots. Deliver me from the lion’s mouth, and my lowliness from the horns of the unicorns. You who fear the Lord, praise Him; all you seed of Jacob, magnify Him. There will be declared to the Lord a generation to come, and the heavens will show forth His justice. To a people that will be born, which the Lord has made.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "my God" }, { "words": ["w008", "w009"], "anchor": "w009", "gloss": "have You forsaken me" }, { "words": ["w012", "w013"], "anchor": "w012", "gloss": "my salvation" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "of my sins" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "My God" }, { "words": ["w022", "w023"], "anchor": "w023", "gloss": "and You will not hear" }, { "words": ["w041", "w042"], "anchor": "w041", "gloss": "our fathers" }, { "words": ["w052", "w053"], "anchor": "w052", "gloss": "were made" }, { "words": ["w058", "w059", "w060"], "anchor": "w060", "gloss": "were not put to shame" }, { "words": ["w079", "w080"], "anchor": "w079", "gloss": "they spoke" }, { "words": ["w090", "w091"], "anchor": "w090", "gloss": "let Him save" }, { "words": ["w104", "w105"], "anchor": "w104", "gloss": "my garments" }, { "words": ["w108", "w109"], "anchor": "w108", "gloss": "my vesture" }, { "words": ["w115", "w116"], "anchor": "w115", "gloss": "the lion’s mouth" }, { "words": ["w121", "w122"], "anchor": "w121", "gloss": "my lowliness" }, { "words": ["w140", "w141"], "anchor": "w140", "gloss": "His justice" }] }
