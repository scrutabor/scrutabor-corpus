  "about": "The collecta of the formulary “Pentecost Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who on this day taught the hearts of the faithful by the illumination of the Holy Spirit, grant us in the same Spirit to relish what is right and ever to rejoice in His consolation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the same Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w007", "w008"], "anchor": "w008", "gloss": "of the Holy Spirit" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "Holy Spirit" }, { "words": ["w042", "w043", "w044", "w045"], "anchor": "w044", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
