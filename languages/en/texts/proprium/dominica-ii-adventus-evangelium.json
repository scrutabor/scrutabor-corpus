  "text": "proprium.dominica-ii-adventus-evangelium",
  "about": "The gospel of the Second Sunday of Advent. John the Baptist, already in prison, sends to ask whether this is He. The answer is not a claim but a list of what can be seen, and it ends with a word about John himself.",
  "segments": {
    "s01": { "translation": "At that time, when John heard in prison of the works of Christ, he sent two of his disciples and asked Him:", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 91–92", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w005", "w006"], "anchor": "w005", "gloss": "John had heard" }, { "words": ["w014", "w015"], "anchor": "w014", "gloss": "his disciples" }] },
    "s02": { "translation": "Are You the One who is to come, or should we look for another?", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 91–92", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w021", "w022"], "anchor": "w021", "gloss": "is to come" }] },
    "s03": { "translation": "Jesus answered them: Go and report to John what you have heard and seen.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 91–92", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s04": { "translation": "The blind see, the lame walk, lepers are cleansed, the deaf hear, the dead rise, and the Gospel is preached to the poor; blessed is the one who does not stumble because of Me.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 91–92", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w054", "w055", "w056"], "anchor": "w056", "gloss": "does not stumble" }] },
    "s05": { "translation": "As they went away, Jesus began to speak to the crowds about John: What did you go out into the desert to see? A reed shaken by the wind?", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 91–92", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w062", "w063"], "anchor": "w062", "gloss": "Jesus began" }] },
    "s06": { "translation": "What then did you go out to see? A man dressed in soft garments?", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 91–92", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w082", "w083"], "anchor": "w083", "gloss": "dressed in soft garments" }] },
    "s07": { "translation": "Behold, those who are dressed in soft garments are in the houses of kings.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "parallel Ordinary and Advent propers, examined edition", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w088", "w089", "w090", "w091"], "anchor": "w091", "gloss": "are in the houses of kings" }] },
    "s08": { "translation": "What then did you go out to see? A prophet? Yes, I tell you, and more than a prophet.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 91–92", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s09": { "translation": "For this is the one of whom it is written: Behold, I send My messenger before Your face, who will prepare Your way before You.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 91–92", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w104", "w105", "w106"], "anchor": "w105", "gloss": "For this is he" }, { "words": ["w109", "w110"], "anchor": "w109", "gloss": "it is written" }, { "words": ["w114", "w115"], "anchor": "w114", "gloss": "My messenger" }, { "words": ["w117", "w118"], "anchor": "w117", "gloss": "Your face" }, { "words": ["w121", "w122"], "anchor": "w121", "gloss": "Your way" }] }
  },
