  "text": "proprium.dominica-iv-in-quadragesima-postcommunio",
  "about": "The postcommunio of the formulary “Fourth Sunday of Lent” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant us, we beseech You, merciful God, that we may treat Your holy things, with which we are ceaselessly filled, with sincere devotion, and ever receive them with a faithful mind. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w007", "w008"], "anchor": "w007", "gloss": "Your holy things" }, { "words": ["w012", "w013", "w014"], "anchor": "w013", "gloss": "we may treat with sincere devotion" }, { "words": ["w016", "w017", "w018"], "anchor": "w017", "gloss": "ever with a faithful mind" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "our Lord" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Jesus Christ" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Your Son" }, { "words": ["w027", "w028", "w029", "w030", "w031"], "anchor": "w029", "gloss": "who lives and reigns with You" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Spirit" }, { "words": ["w037", "w038", "w039", "w040"], "anchor": "w039", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
