  "text": "proprium.dominica-iii-post-epiphaniam-secreta",
  "about": "The secreta of the formulary “Third Sunday after Epiphany” in the 1962 Roman Missal. The same prayer is used in the formularies of Quinquagesima and the Third Sunday of Lent, and when the formulary is resumed after Pentecost.",
  "segments": {
    "s01": { "translation": "May this Victim, O Lord, we beseech You, cleanse our offenses and, for the celebration of the sacrifice, sanctify the bodies and minds of those subject to You. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005"], "anchor": "w001", "gloss": "May this Victim, O Lord, we beseech You, cleanse" }, { "words": ["w010", "w011"], "anchor": "w010", "gloss": "the celebration of the sacrifice" }, { "words": ["w012", "w013", "w014", "w015", "w016"], "anchor": "w012", "gloss": "sanctify the bodies and minds of those subject to You" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "our Lord" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "Jesus Christ" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Your Son" }, { "words": ["w024", "w025", "w026", "w027", "w028"], "anchor": "w026", "gloss": "who lives and reigns with You" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w034", "w035", "w036", "w037"], "anchor": "w034", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
