  "text": "proprium.dominica-iii-post-epiphaniam-secreta",
  "about": "The secreta of the formulary “Third Sunday after Epiphany” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May this Victim, we beseech Thee, O Lord, cleanse our offenses and sanctify the bodies and minds of Thy servants for the celebration of the sacrifice. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
