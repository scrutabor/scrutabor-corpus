  "about": "The introitus of the formulary “6th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "The Lord is the strength of His people, and the protector of the salvation of His Anointed. Save Your people, O Lord, and bless Your inheritance, and govern them forever. To You, O Lord, I will cry; my God, do not be silent toward me, lest at any time You keep silent toward me and I be made like those who go down into the pit. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. The Lord is the strength of His people, and the protector of the salvation of His Anointed. Save Your people, O Lord, and bless Your inheritance, and govern them forever.", "alignments": [{ "words": ["w003", "w004"], "anchor": "w003", "gloss": "of His people" }, { "words": ["w008", "w009"], "anchor": "w008", "gloss": "of His Anointed" }, { "words": ["w011", "w012"], "anchor": "w011", "gloss": "save" }, { "words": ["w013", "w014"], "anchor": "w013", "gloss": "Your people" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "Your inheritance" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "my God" }, { "words": ["w051", "w052"], "anchor": "w051", "gloss": "to the Holy Spirit" }, { "words": ["w068", "w069"], "anchor": "w068", "gloss": "of His people" }, { "words": ["w073", "w074"], "anchor": "w073", "gloss": "of His Anointed" }, { "words": ["w076", "w077"], "anchor": "w076", "gloss": "save" }, { "words": ["w078", "w079"], "anchor": "w078", "gloss": "Your people" }, { "words": ["w083", "w084"], "anchor": "w083", "gloss": "Your inheritance" }] }
