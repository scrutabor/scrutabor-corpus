  "about": "The introitus of the formulary “6th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "The Lord is the strength of His people, and the protector of the salvation of His Anointed. Save Your people, O Lord, and bless Your inheritance, and govern them forever. To You, O Lord, I will cry; my God, do not be silent toward me, lest at any time You keep silent toward me and I be made like those who go down into the pit. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. The Lord is the strength of His people, and the protector of the salvation of His Anointed. Save Your people, O Lord, and bless Your inheritance, and govern them forever.", "alignments": [{ "words": ["w011", "w012"], "anchor": "w011", "gloss": "save" }, { "words": ["w076", "w077"], "anchor": "w076", "gloss": "save" }] }
