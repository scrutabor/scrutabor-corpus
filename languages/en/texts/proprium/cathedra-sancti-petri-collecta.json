  "language": "en",
  "text": "proprium.cathedra-sancti-petri-collecta",
  "about": "The collecta of the formulary “Chair of Saint Peter the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who gave Your blessed Apostle Peter the keys of the kingdom of heaven and entrusted to him the power of binding and loosing, grant that by the help of his intercession we may be freed from the bonds of our sins." },
    "s03": { "narrative": "The priest at once adds the commemoration of Saint Paul, who is always remembered together with Saint Peter. A single conclusion closes both prayers." },
    "s04": { "translation": "O God, who taught a multitude of nations through the preaching of blessed Paul the Apostle, grant, we beseech You, that we who celebrate his commemoration may experience his patronage before You. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God, world without end." },
    "s02": { "translation": "Amen." }
  },
