  "text": "proprium.sacratissimi-cordis-iesu-collecta",
  "about": "The Collect of the feast of the Most Sacred Heart of Jesus. It gives thanks for the infinite treasures of love bestowed from the wounded Heart of the Son of God and asks for worthy reparation.",
  "segments": {
    "s01": { "translation": "O God, who are mercifully pleased to bestow on us the infinite treasures of love in Your Son’s Heart, wounded by our sins, grant, we pray, that, as we offer Him our devoted worship, we may also fulfill the duty of worthy reparation. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "of Your Son" }, { "words": ["w008", "w009", "w010"], "anchor": "w009", "gloss": "wounded by our sins" }, { "words": ["w015", "w016"], "anchor": "w016", "gloss": "are pleased to bestow" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "of our piety" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "our Lord" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "Your Son" }, { "words": ["w039", "w040", "w041", "w042", "w043"], "anchor": "w041", "gloss": "who lives and reigns with You" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "of the Holy Spirit" }, { "words": ["w049", "w050", "w051", "w052"], "anchor": "w051", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
