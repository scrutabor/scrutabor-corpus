    "s01": { "translation": "Admitted to the sacred banquet, O Lord, we have drawn water in joy from the Savior’s fountains; may His Blood, we beseech You, become for us a fountain of water springing up to everlasting life. He lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w013", "w014"], "anchor": "w013", "gloss": "His Blood" }, { "words": ["w019", "w020", "w021", "w022", "w023"], "anchor": "w019", "gloss": "of water springing up to everlasting life" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
