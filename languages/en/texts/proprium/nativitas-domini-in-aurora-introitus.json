  "about": "The introitus of the formulary “Nativity of the Lord — Mass at Dawn” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "A light will shine upon us today, for the Lord is born to us; and He will be called Wonderful, God, Prince of peace, Father of the world to come, of whose kingdom there will be no end. The Lord has reigned, He is clothed with beauty; the Lord is clothed with strength and has girded Himself. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. A light will shine upon us today, for the Lord is born to us; and He will be called Wonderful, God, Prince of peace, Father of the world to come, of whose kingdom there will be no end.", "alignments": [{ "words": ["w007", "w008"], "anchor": "w007", "gloss": "is born" }, { "words": ["w018", "w019"], "anchor": "w019", "gloss": "of the age to come" }, { "words": ["w020", "w021"], "anchor": "w021", "gloss": "of whose kingdom" }, { "words": ["w022", "w023"], "anchor": "w023", "gloss": "there will not be" }, { "words": ["w027", "w028", "w029"], "anchor": "w028", "gloss": "He is clothed with beauty" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "to the Holy Spirit" }, { "words": ["w063", "w064"], "anchor": "w063", "gloss": "is born" }, { "words": ["w074", "w075"], "anchor": "w075", "gloss": "of the age to come" }, { "words": ["w076", "w077"], "anchor": "w077", "gloss": "of whose kingdom" }, { "words": ["w078", "w079"], "anchor": "w079", "gloss": "there will not be" }] }
