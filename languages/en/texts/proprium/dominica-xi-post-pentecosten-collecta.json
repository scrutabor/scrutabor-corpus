  "about": "The collecta of the formulary “11th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Almighty, eternal God, You Who in the abundance of Your love always grant more than Your humble petitioners deserve, and even more than they desire, pour forth Your mercy upon us that You may forgive whatever our conscience dreads, and give in addition what our prayer does not venture to ask. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w028", "w029"], "anchor": "w029", "gloss": "does not venture" }, { "words": ["w044", "w045"], "anchor": "w044", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
