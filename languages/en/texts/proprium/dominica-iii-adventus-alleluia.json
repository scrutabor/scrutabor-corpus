  "text": "proprium.dominica-iii-adventus-alleluia",
  "about": "The Alleluia verse of the Third Sunday of Advent, Psalm 79:3 in the Vulgate numbering (Psalm 80 in Hebrew), from the psalm of the gradual, repeats the opening of the First Sunday’s collect: a plea for the Lord to stir up His power and come to save us. On the ferias of Advent, when this Sunday Mass is used through the week, the Alleluia and its verse are omitted and only the gradual is said.",
  "segments": {
    "s01": { "translation": "Alleluia, alleluia.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 93", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s02": { "translation": "Stir up Your power, O Lord, and come to save us.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 93", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w005", "w006"], "anchor": "w005", "gloss": "Your power" }] },
