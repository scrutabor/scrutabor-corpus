  "segments": {
    "s01": { "translation": "O Lord, do not remove Your help far from me; look to my defense. Deliver me from the lion’s mouth, and my lowliness from the horns of the unicorns. O God, my God, look upon me; why have You forsaken me? Far from my salvation are the words of my sins. O Lord, do not remove Your help far from me; look to my defense. Deliver me from the lion’s mouth, and my lowliness from the horns of the unicorns.", "alignments": [{ "words": ["w002", "w003", "w004"], "anchor": "w004", "gloss": "do not remove far" }, { "words": ["w005", "w006"], "anchor": "w005", "gloss": "Your help" }, { "words": ["w010", "w011"], "anchor": "w010", "gloss": "my defense" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "the lion’s mouth" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "my lowliness" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "my God" }, { "words": ["w031", "w032"], "anchor": "w032", "gloss": "have You forsaken me" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "my salvation" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "of my sins" }, { "words": ["w041", "w042", "w043"], "anchor": "w043", "gloss": "do not remove far" }, { "words": ["w044", "w045"], "anchor": "w044", "gloss": "Your help" }, { "words": ["w049", "w050"], "anchor": "w049", "gloss": "my defense" }, { "words": ["w055", "w056"], "anchor": "w055", "gloss": "the lion’s mouth" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "my lowliness" }] }
