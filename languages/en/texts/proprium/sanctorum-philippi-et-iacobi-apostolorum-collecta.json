  "about": "The collecta of the formulary “Saints Philip and James, Apostles” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, Who gladden us each year by the feast of Your holy Apostles Philip and James, graciously grant that, as we rejoice in their merits, we may be inspired by their example. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
