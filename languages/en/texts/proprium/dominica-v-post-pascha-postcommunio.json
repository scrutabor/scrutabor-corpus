  "text": "proprium.dominica-v-post-pascha-postcommunio",
  "about": "The postcommunio of the formularies “Fifth Sunday after Easter” and “Vigil of the Ascension of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, O Lord, that we who have been filled with the strength of the heavenly table may both desire what is right and receive what we desire. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w004", "w005", "w006", "w007"], "anchor": "w007", "gloss": "filled with the strength of the heavenly table" }, { "words": ["w010", "w011", "w012"], "anchor": "w012", "gloss": "what is right" }, { "words": ["w014", "w015"], "anchor": "w015", "gloss": "to receive the things desired" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "our Lord" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "Your Son" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "of the Holy Spirit" }, { "words": ["w033", "w034", "w035", "w036"], "anchor": "w035", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
