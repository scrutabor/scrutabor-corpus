  "about": "The introitus of the formulary “Sunday after the Ascension” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Hear, O Lord, my voice with which I have cried to You, alleluia. My heart has said to You: I have sought Your face; Your face, O Lord, I will seek. Do not turn Your face away from me, alleluia, alleluia. The Lord is my light and my salvation: whom shall I fear? Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. Hear, O Lord, my voice with which I have cried to You, alleluia. My heart has said to You: I have sought Your face; Your face, O Lord, I will seek. Do not turn Your face away from me, alleluia, alleluia.", "alignments": [{ "words": ["w003", "w004"], "anchor": "w003", "gloss": "my voice" }, { "words": ["w012", "w013"], "anchor": "w012", "gloss": "my heart" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "Your face" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "Your face" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Your face" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "my light" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "my salvation" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "to the Holy Spirit" }, { "words": ["w053", "w054", "w055"], "anchor": "w054", "gloss": "forever and ever" }, { "words": ["w059", "w060"], "anchor": "w059", "gloss": "my voice" }, { "words": ["w068", "w069"], "anchor": "w068", "gloss": "my heart" }, { "words": ["w071", "w072"], "anchor": "w071", "gloss": "Your face" }, { "words": ["w073", "w074"], "anchor": "w073", "gloss": "Your face" }, { "words": ["w079", "w080"], "anchor": "w079", "gloss": "Your face" }] }
