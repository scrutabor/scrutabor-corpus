  "text": "proprium.corporis-christi-collecta",
  "about": "The Collect of the feast of the Most Holy Body of Christ. It asks that we so venerate the sacred mysteries of the Lord’s Body and Blood that we continually experience within us the fruit of His redemption.",
  "segments": {
    "s01": { "translation": "O God, who have left us under a wondrous sacrament the memorial of Your Passion, grant us, we pray, so to venerate the sacred mysteries of Your Body and Blood that we may continually experience within us the fruit of Your redemption. You live and reign with God the Father in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w004", "w005", "w006"], "anchor": "w005", "gloss": "under a wondrous sacrament" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "of Your Passion" }, { "words": ["w015", "w016", "w017", "w018"], "anchor": "w015", "gloss": "of Your Body and Blood" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "of Your redemption" }, { "words": ["w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "You live and reign" }, { "words": ["w034", "w035", "w036"], "anchor": "w035", "gloss": "with God the Father" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "of the Holy Spirit" }, { "words": ["w042", "w043", "w044", "w045"], "anchor": "w044", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
