  "text": "proprium.nativitas-domini-in-die-postcommunio",
  "about": "The postcommunio of the formulary “Nativity of the Lord — Mass during the Day” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, we beseech You, almighty God, that, as the Savior of the world, born today, is for us the author of divine generation, so He Himself may also be the giver of immortality. Who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w011", "w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "He is for us the author of divine generation" }, { "words": ["w018", "w019", "w020", "w021"], "anchor": "w021", "gloss": "may Himself be the giver of immortality" }, { "words": ["w022", "w023", "w024", "w025", "w026"], "anchor": "w024", "gloss": "Who lives and reigns with You" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "of the Holy Spirit" }, { "words": ["w032", "w033", "w034", "w035"], "anchor": "w034", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
