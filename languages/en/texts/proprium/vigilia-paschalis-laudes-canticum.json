  "text": "proprium.vigilia-paschalis-laudes-canticum",
  "about": "The chapter, hymn, and versicle are omitted. The celebrant sings Et valde mane, and the cantors continue the antiphon. Incensation takes place during the Benedictus as at Lauds. After the doxology, the whole antiphon is repeated before the postcommunion prayer.",
  "segments": {
    "s01": { "translation": "And very early in the morning" },
    "s02": { "translation": "on the first day of the week, they come to the tomb, with the sun already risen, alleluia.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w005", "gloss": "on the first day of the week" }, { "words": ["w009", "w010", "w011"], "anchor": "w009", "gloss": "with the sun already risen" }] },
    "s03": { "translation": "Blessed be the Lord, the God of Israel, for He has visited and redeemed His people,", "alignments": [{ "words": ["w021", "w022"], "anchor": "w021", "gloss": "His people" }] },
    "s04": { "translation": "and raised up saving power for us in the house of David, His servant,", "alignments": [{ "words": ["w025", "w026"], "anchor": "w025", "gloss": "saving power" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "His servant" }] },
    "s05": { "translation": "as He spoke through the mouth of His holy prophets who lived long ago:", "alignments": [{ "words": ["w034", "w035"], "anchor": "w034", "gloss": "He spoke" }, { "words": ["w038", "w039", "w040", "w041", "w042", "w043"], "anchor": "w041", "gloss": "of His holy prophets who lived long ago" }] },
    "s06": { "translation": "to free us from our enemies and from the grasp of all who hate us,", "alignments": [{ "words": ["w044", "w045"], "anchor": "w045", "gloss": "to free" }, { "words": ["w048", "w049"], "anchor": "w048", "gloss": "our enemies" }, { "words": ["w051", "w052"], "anchor": "w052", "gloss": "from the grasp" }] },
    "s07": { "translation": "to show mercy to our fathers and remember His holy covenant:", "alignments": [{ "words": ["w057", "w058", "w059"], "anchor": "w058", "gloss": "to show mercy" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "our fathers" }, { "words": ["w065", "w066", "w067"], "anchor": "w065", "gloss": "His holy covenant" }] },
    "s08": { "translation": "the oath He swore to Abraham, our father: He would grant us this:", "alignments": [{ "words": ["w072", "w073"], "anchor": "w072", "gloss": "our father" }, { "words": ["w074", "w075", "w076"], "anchor": "w074", "gloss": "He would grant us this" }] },
    "s09": { "translation": "that, freed from our enemies’ grasp, we might serve Him without fear,", "alignments": [{ "words": ["w078", "w079"], "anchor": "w079", "gloss": "without fear" }, { "words": ["w080", "w081", "w082", "w083", "w084"], "anchor": "w081", "gloss": "freed from our enemies’ grasp" }, { "words": ["w085", "w086"], "anchor": "w085", "gloss": "we might serve Him" }] },
    "s10": { "translation": "in holiness and justice before Him all our days.", "alignments": [{ "words": ["w093", "w094", "w095"], "anchor": "w094", "gloss": "all our days" }] },
    "s11": { "translation": "And you, child, will be called a prophet of the Most High, for you will go before the Lord to prepare His ways,", "alignments": [{ "words": ["w099", "w100", "w101"], "anchor": "w099", "gloss": "will be called a prophet of the Most High" }, { "words": ["w102", "w103"], "anchor": "w102", "gloss": "for you will go ahead" }, { "words": ["w104", "w105", "w106"], "anchor": "w105", "gloss": "before the Lord" }, { "words": ["w107", "w108"], "anchor": "w108", "gloss": "to prepare" }, { "words": ["w109", "w110"], "anchor": "w109", "gloss": "His ways" }] },
    "s12": { "translation": "to give His people knowledge of salvation in the forgiveness of their sins,", "alignments": [{ "words": ["w111", "w112"], "anchor": "w112", "gloss": "to give" }, { "words": ["w113", "w114"], "anchor": "w113", "gloss": "His people" }, { "words": ["w119", "w120"], "anchor": "w119", "gloss": "of their sins" }] },
    "s13": { "translation": "through the tender mercy of our God, by which the Rising Light from on high will visit us,", "alignments": [{ "words": ["w122", "w123"], "anchor": "w122", "gloss": "the tender mercy" }, { "words": ["w124", "w125"], "anchor": "w124", "gloss": "of our God" }, { "words": ["w127", "w128", "w129"], "anchor": "w127", "gloss": "the Rising Light will visit us" }, { "words": ["w130", "w131"], "anchor": "w130", "gloss": "from on high" }] },
    "s14": { "translation": "to give light to those who sit in darkness and in the shadow of death, to guide our feet into the way of peace.", "alignments": [{ "words": ["w132", "w133"], "anchor": "w133", "gloss": "to give light to" }, { "words": ["w136", "w137", "w138", "w139", "w140", "w141", "w142"], "anchor": "w137", "gloss": "sit in darkness and in the shadow of death" }, { "words": ["w143", "w144"], "anchor": "w144", "gloss": "to guide" }, { "words": ["w145", "w146"], "anchor": "w145", "gloss": "our feet" }] },
    "s15": { "translation": "Glory to the Father, and to the Son, and to the Holy Spirit,", "alignments": [{ "words": ["w155", "w156"], "anchor": "w155", "gloss": "to the Holy Spirit" }] },
    "s16": { "translation": "as it was in the beginning, so it is now and always, forever and ever. Amen.", "alignments": [{ "words": ["w166", "w167", "w168"], "anchor": "w167", "gloss": "forever and ever" }] },
    "s17": { "translation": "And very early in the morning, on the first day of the week, they come to the tomb, with the sun already risen, alleluia.", "alignments": [{ "words": ["w173", "w174"], "anchor": "w174", "gloss": "on the first day of the week" }, { "words": ["w178", "w179", "w180"], "anchor": "w178", "gloss": "with the sun already risen" }] }
  },
