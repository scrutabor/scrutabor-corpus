  "language": "en",
  "text": "proprium.nativitas-domini-in-aurora-secreta",
  "about": "The secreta of the formulary “Nativity of the Lord — Mass at Dawn” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May our gifts, we beseech You, O Lord, prove fitting for the mysteries of today’s Nativity and always pour peace into us, that, as He who was born a man shone forth also as God, so this earthly substance may bestow on us that which is divine. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever. Amen.", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "Our gifts" }, { "words": ["w005", "w006", "w007"], "anchor": "w007", "gloss": "for the mysteries of today’s Nativity" }, { "words": ["w008", "w009"], "anchor": "w009", "gloss": "may prove worthy" }, { "words": ["w011", "w012", "w013", "w014"], "anchor": "w014", "gloss": "may always pour peace into us" }, { "words": ["w017", "w018", "w019"], "anchor": "w019", "gloss": "the same, born a man," }, { "words": ["w029", "w030", "w031"], "anchor": "w030", "gloss": "that which is divine" }, { "words": ["w033", "w034", "w035", "w036", "w037"], "anchor": "w034", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "Your Son" }, { "words": ["w040", "w041", "w042", "w043", "w044"], "anchor": "w042", "gloss": "who lives and reigns with You" }, { "words": ["w047", "w048"], "anchor": "w047", "gloss": "of the Holy Spirit" }, { "words": ["w050", "w051", "w052", "w053"], "anchor": "w052", "gloss": "forever and ever" }] },
    "s02": { "narrative": "For Saint Anastasia." },
    "s03": { "translation": "Graciously accept, we beseech You, O Lord, the gifts offered, and, by the pleading merits of blessed Anastasia, Your Martyr, grant that they may serve to help our salvation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w062", "w063", "w064", "w065", "w066", "w067"], "anchor": "w067", "gloss": "by the pleading merits of blessed Anastasia, Your Martyr" }, { "words": ["w068", "w069", "w070", "w071"], "anchor": "w071", "gloss": "for the help of our salvation" }, { "words": ["w072", "w073"], "anchor": "w073", "gloss": "grant them to avail" }, { "words": ["w075", "w076"], "anchor": "w075", "gloss": "our Lord" }, { "words": ["w077", "w078"], "anchor": "w077", "gloss": "Jesus Christ" }, { "words": ["w079", "w080"], "anchor": "w079", "gloss": "Your Son" }, { "words": ["w081", "w082", "w083", "w084", "w085"], "anchor": "w083", "gloss": "who lives and reigns with You" }, { "words": ["w088", "w089"], "anchor": "w088", "gloss": "of the Holy Spirit" }] },
    "s04": { "translation": "forever and ever.", "alignments": [{ "words": ["w091", "w092", "w093", "w094"], "anchor": "w093", "gloss": "forever and ever" }] },
    "s05": { "translation": "Amen." }
  },
