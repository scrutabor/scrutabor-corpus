  "text": "proprium.vigilia-pentecostes-evangelium",
  "about": "The evangelium of the formulary “Vigil of Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At that time, Jesus said to His disciples: If you love Me, keep My commandments. And I will ask the Father, and He will give you another Paraclete, that He may remain with you forever, the Spirit of truth, whom the world cannot receive, because it neither sees Him nor knows Him. But you will know Him, because He will remain with you and will be in you. I will not leave you orphans; I will come to you. Yet a little while, and the world sees Me no more. But you see Me, because I live, and you will live. In that day you will know that I am in My Father, and you in Me, and I in you. The one who has My commandments and keeps them is the one who loves Me. And he who loves Me will be loved by My Father; and I will love him and will reveal Myself to him.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "Jesus said" }, { "words": ["w006", "w007"], "anchor": "w006", "gloss": "to His disciples" }, { "words": ["w011", "w012", "w013"], "anchor": "w013", "gloss": "keep My commandments" }, { "words": ["w019", "w020", "w021", "w022"], "anchor": "w021", "gloss": "He will give you another Paraclete" }, { "words": ["w032", "w033"], "anchor": "w033", "gloss": "cannot" }, { "words": ["w036", "w037", "w038"], "anchor": "w037", "gloss": "it does not see Him" }, { "words": ["w051", "w052", "w053"], "anchor": "w053", "gloss": "will be in you" }, { "words": ["w054", "w055"], "anchor": "w055", "gloss": "I will not leave" }, { "words": ["w065", "w066", "w067", "w068"], "anchor": "w068", "gloss": "sees Me no more" }, { "words": ["w088", "w089"], "anchor": "w088", "gloss": "My Father" }, { "words": ["w100", "w101"], "anchor": "w100", "gloss": "My commandments" }, { "words": ["w105", "w106", "w107"], "anchor": "w106", "gloss": "is the one who" }, { "words": ["w110", "w111"], "anchor": "w110", "gloss": "But the one who" }, { "words": ["w116", "w117"], "anchor": "w116", "gloss": "My Father" }, { "words": ["w124", "w125"], "anchor": "w125", "gloss": "Myself to him" }] }
  },
