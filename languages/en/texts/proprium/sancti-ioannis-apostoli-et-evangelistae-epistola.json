  "segments": {
    "s01": { "translation": "He who fears God will do good; and he who holds fast to justice will lay hold of her, and she will meet him like an honored mother. She will feed him with the bread of life and understanding, and with the water of saving wisdom she will give him drink; and she will be made firm in him, and he will not be swayed; and she will hold him fast, and he will not be confounded; and she will exalt him among his neighbors, and she will open his mouth in the midst of the church, and fill him with the spirit of wisdom and understanding, and array him in a robe of glory. The Lord our God will store up joy and exultation upon him, and will make him inherit an everlasting name.", "alignments": [{ "words": ["w008", "w009"], "anchor": "w008", "gloss": "is steadfast" }] }
  },
