  "about": "The epistola of the formulary “Saint John, Apostle and Evangelist” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "He who fears God will do good; and he who holds fast to justice will lay hold of her, and she will meet him like an honored mother. She will feed him with the bread of life and understanding, and with the water of saving wisdom she will give him drink; and she will be made firm in him, and he will not be swayed; and she will hold him fast, and he will not be confounded; and she will exalt him among his neighbors, and she will open his mouth in the midst of the church, and fill him with the spirit of wisdom and understanding, and array him in a robe of glory. The Lord our God will store up joy and exultation upon him, and will make him inherit an everlasting name.", "alignments": [{ "words": ["w008", "w009"], "anchor": "w008", "gloss": "is steadfast" }, { "words": ["w017", "w018"], "anchor": "w018", "gloss": "an honored mother" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "of saving wisdom" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "will give him to drink" }, { "words": ["w036", "w037"], "anchor": "w037", "gloss": "he will not be moved" }, { "words": ["w042", "w043"], "anchor": "w043", "gloss": "he will not be put to shame" }, { "words": ["w048", "w049"], "anchor": "w048", "gloss": "his fellows" }, { "words": ["w055", "w056"], "anchor": "w055", "gloss": "his mouth" }, { "words": ["w076", "w077"], "anchor": "w076", "gloss": "with an everlasting name" }, { "words": ["w078", "w079", "w080", "w081", "w082"], "anchor": "w078", "gloss": "the Lord our God will make him inherit" }] }
  },
