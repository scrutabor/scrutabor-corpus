  "language": "en",
  "text": "proprium.septem-dolorum-beatae-mariae-virginis-sequentia",
  "about": "The Sequence of the formulary “Seven Sorrows of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Weeping sore, the Mother stood\nNear the Cross, the fatal wood,\nWhere her Son hung dying." },
    "s02": { "translation": "Through her soul, in anguish crying,\nSunk in sorrow, spent with sighing,\nA sword had pierced her through." },
    "s03": { "translation": "Oh, how sad, how heavy laden,\nWas that meek and blessed Maiden,\nMother of God’s only Son!" },
    "s04": { "translation": "Grieving, bowed beneath her woes,\nThe loving Mother watched the throes\nOf her own glorious Son.", "alignments": [{ "words": ["w036", "w037", "w038"], "anchor": "w037", "gloss": "the torments of her glorious Son" }] },
    "s05": { "translation": "Who could look and fail to weep,\nSeeing grief so sore and deep\nIn the Mother of our Lord?", "alignments": [{ "words": ["w043", "w044"], "anchor": "w044", "gloss": "would not weep" }] },
    "s06": { "translation": "Who could look unmoved\nOn the Mother of our Lord,\nGrieving with her Son?", "alignments": [{ "words": ["w053", "w054"], "anchor": "w054", "gloss": "would not" }, { "words": ["w056", "w057", "w058"], "anchor": "w058", "gloss": "on beholding Christ’s Mother" }] },
    "s07": { "translation": "For the sins of His own people,\nShe saw Jesus in His torment,\nGiven over to the scourge." },
    "s08": { "translation": "She beheld her gentle Son,\nDying, desolate, alone,\nWhen He yielded up His spirit." },
    "s09": { "translation": "Come, dear Mother, love’s sweet spring,\nLet me feel the force of sorrow,\nLet me mourn with you." },
    "s10": { "translation": "Let my heart be wrapped in fire\nWith the love of Christ my God,\nSo that I may please Him.", "alignments": [{ "words": ["w097", "w098"], "anchor": "w097", "gloss": "my heart" }] },
    "s11": { "translation": "Holy Mother, hear my prayer.\nDeeply print upon my heart\nAll the wounds the Crucified bore.", "alignments": [{ "words": ["w113", "w114"], "anchor": "w113", "gloss": "in my heart" }] },
    "s12": { "translation": "Share with me the pains He bore,\nFor your wounded Son was willing\nTo endure them all for me." },
    "s13": { "translation": "Let our tears in one stream flow\nAs I grieve with Christ crucified,\nAll the days that I shall live." },
    "s14": { "translation": "By the Cross to take my station\nAnd to share your lamentation\nIs my most earnest prayer." },
    "s15": { "translation": "Virgin, brightest of all virgins,\nDo not turn from me in bitterness.\nLet me share your grief.", "alignments": [{ "words": ["w153", "w154"], "anchor": "w154", "gloss": "do not be" }] },
    "s16": { "translation": "Let me bear the very death He bore,\nShare with Him in all His Passion,\nAnd remember all His wounds." },
    "s17": { "translation": "Let His wounds be wounds to me.\nLet me drink my fill of the Cross\nAnd of the Blood of your dear Son." },
    "s18": { "translation": "Lest I burn amid the flames,\nVirgin, guard this soul of mine\nWhen the day of judgment comes.", "alignments": [{ "words": ["w189", "w190"], "anchor": "w190", "gloss": "may I be defended" }] },
    "s19": { "translation": "Christ, when these my days are done,\nLet Your Mother lead me on\nTo the palm of victory." },
    "s20": { "translation": "When this frail flesh has died,\nGrant that my soul may receive\nThe glory of Paradise. Amen. Alleluia." }
  },
