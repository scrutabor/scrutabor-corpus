  "text": "proprium.septem-dolorum-beatae-mariae-virginis-sequentia",
  "about": "The sequentia of the formulary “Seven Sorrows of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At the Cross her station keeping, Stood the mournful Mother weeping, Close to Jesus to the last." },
    "s02": { "translation": "Through her heart, His sorrow sharing, All His bitter anguish bearing Now at length the sword had passed." },
    "s03": { "translation": "Oh, how sad and sore distressed Was that Mother highly blessed Of the sole begotten One!" },
    "s04": { "translation": "Christ above in torment hangs, She beneath beholds the pangs Of her dying, glorious Son." },
    "s05": { "translation": "Is there one who would not weep, ’Whelmed in miseries so deep, Christ’s dear Mother to behold?" },
    "s06": { "translation": "Can the human heart refrain From partaking in her pain, In that Mother’s pain untold?" },
    "s07": { "translation": "For the sins of His own nation, She saw Jesus’ tribulation, Him with bloody scourges rent." },
    "s08": { "translation": "Her sweet Son she saw, her own, Dying desolate, alone, Till His spirit forth He sent." },
    "s09": { "translation": "O sweet Mother! fount of love, Let me sorrow’s power prove, Mourning with you in accord." },
    "s10": { "translation": "Make my heart with fire to burn, Loving Christ my God in turn, So that I may please my Lord.", "alignments": [{ "words": ["w099"], "reason": "inflection" }] },
    "s11": { "translation": "Holy Mother, pierce me through, In my heart each wound renew Of my Savior crucified." },
    "s12": { "translation": "Let me share with you His pain, Who for all our sins was slain, Who for me in torments died." },
    "s13": { "translation": "Mix’d with yours let my tears be, Mourning Him Who mourned for me, All the days that I may live." },
    "s14": { "translation": "By the Cross with you to stay, There with you to weep and pray, Is all I ask of you to give." },
    "s15": { "translation": "Virgin of all virgins blest! Listen to my fond request: Let me share that grief of yours." },
    "s16": { "translation": "Let me bear the death of Christ, Sharer of His sacrifice, And His holy wounds recall." },
    "s17": { "translation": "Wounded with His every wound, Steep my soul till it has swooned In His very Blood away." },
    "s18": { "translation": "Be to me, O Virgin, nigh, Lest in flames I burn and die, In His awful judgment day." },
    "s19": { "translation": "Christ, when You shall call me hence, Through Your Mother, my defense, Bring me to the victor’s prize." },
    "s20": { "translation": "When my body comes to die, Grant, O Christ, my soul on high The glory of Paradise. Amen. Alleluia." }
  },
