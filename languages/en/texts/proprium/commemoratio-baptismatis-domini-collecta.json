  "text": "proprium.commemoratio-baptismatis-domini-collecta",
  "about": "The collecta of the formulary “Commemoration of the Baptism of Our Lord Jesus Christ” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, whose only-begotten Son appeared in the substance of our flesh, grant, we beseech You, that we may be found worthy to be inwardly reformed by Him whom we have known outwardly to be like us. Who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w022", "w023", "w024", "w025", "w026"], "anchor": "w024", "gloss": "Who lives and reigns with You" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "of the Holy Spirit" }, { "words": ["w032", "w033", "w034", "w035"], "anchor": "w034", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
