  "text": "proprium.purificatio-beatae-mariae-virginis-collecta",
  "about": "The Collect of the formulary “Purification of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Almighty, eternal God, we humbly beseech Your majesty that, as Your only-begotten Son was this day presented in the temple in the nature of our flesh, so may You grant us to be presented to You with purified minds. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "Your majesty" }, { "words": ["w010", "w011", "w012"], "anchor": "w011", "gloss": "Your only-begotten Son" }, { "words": ["w016", "w017", "w018"], "anchor": "w018", "gloss": "the substance of our flesh" }, { "words": ["w026", "w027", "w028", "w029"], "anchor": "w029", "gloss": "to be presented to You with purified minds" }, { "words": ["w031", "w032", "w033", "w034", "w035"], "anchor": "w032", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "Your Son" }, { "words": ["w038", "w039", "w040", "w041", "w042"], "anchor": "w040", "gloss": "who lives and reigns with You" }, { "words": ["w045", "w046"], "anchor": "w045", "gloss": "of the Holy Spirit" }, { "words": ["w048", "w049", "w050", "w051"], "anchor": "w050", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
