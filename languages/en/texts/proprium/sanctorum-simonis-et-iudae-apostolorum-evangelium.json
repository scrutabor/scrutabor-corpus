  "segments": {
    "s01": { "translation": "At that time, Jesus said to His disciples: These things I command you, that you love one another. If the world hates you, know that it has hated me before you. If you had been of the world, the world would love its own; but because you are not of the world, but I have chosen you out of the world, therefore the world hates you. Remember my word that I said to you: A servant is not greater than his master. If they have persecuted me, they will also persecute you; if they have kept my word, they will also keep yours. But all these things they will do to you for my name’s sake, because they do not know Him who sent me. If I had not come and spoken to them, they would have no sin; but now they have no excuse for their sin. Whoever hates me hates my Father also. If I had not done among them the works that no one else has done, they would have no sin; but now they have both seen and hated both me and my Father. But that the word may be fulfilled which is written in their law: They have hated me without cause.", "alignments": [{ "words": ["w024"], "reason": "idiom" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "But because" }, { "words": ["w036", "w037", "w038", "w039"], "anchor": "w039", "gloss": "you are not of the world" }, { "words": ["w057", "w058", "w059"], "anchor": "w058", "gloss": "A servant is not" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "than his master" }, { "words": ["w065", "w066"], "anchor": "w065", "gloss": "persecuted" }, { "words": ["w092", "w093"], "anchor": "w093", "gloss": "had not come" }, { "words": ["w095", "w096"], "anchor": "w095", "gloss": "spoken" }, { "words": ["w098", "w099", "w100"], "anchor": "w100", "gloss": "they would not have sin" }, { "words": ["w104", "w105"], "anchor": "w105", "gloss": "they have not" }, { "words": ["w118", "w119"], "anchor": "w119", "gloss": "had not done" }, { "words": ["w126", "w127", "w128"], "anchor": "w128", "gloss": "they would not have sin" }, { "words": ["w152"], "reason": "idiom" }] }
  },
