  "about": "The secreta of the formulary “Second Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Lord, may the sacred offering always bring us a saving blessing, so that it may accomplish by its power what it performs in mystery. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005", "w006", "w007", "w008"], "anchor": "w004", "gloss": "Lord, may the sacred offering always bring us a saving blessing" }, { "words": ["w013", "w014"], "anchor": "w014", "gloss": "it may accomplish by its power" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "our Lord" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "Your Son" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w032", "w033", "w034", "w035"], "anchor": "w034", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
