  "text": "proprium.sancti-bartholomaei-apostoli-collecta",
  "about": "The collecta of the formulary “Saint Bartholomew the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Almighty, eternal God, who have given us the devout and holy joy of this day on the feast of Your blessed Apostle Bartholomew, grant to Your Church, we pray, both to love what he believed and to preach what he taught. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006"], "anchor": "w005", "gloss": "of this day" }, { "words": ["w011", "w012", "w013", "w014"], "anchor": "w012", "gloss": "of Your blessed Apostle Bartholomew" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "to Your Church" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "our Lord" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "Your Son" }, { "words": ["w036", "w037", "w038", "w039", "w040"], "anchor": "w038", "gloss": "who lives and reigns with You" }, { "words": ["w043", "w044"], "anchor": "w043", "gloss": "of the Holy Spirit" }, { "words": ["w046", "w047", "w048", "w049"], "anchor": "w048", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
