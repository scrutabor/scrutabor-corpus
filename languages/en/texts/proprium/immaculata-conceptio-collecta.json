  "text": "proprium.immaculata-conceptio-collecta",
  "about": "The collecta of the formulary “Immaculate Conception of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who by the Immaculate Conception of the Virgin prepared a worthy dwelling for Your Son, and who, in view of the foreseen death of that same Son, preserved her from every stain, grant, we beseech You, through her intercession, that we too may come to You unstained by sin. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w004", "w005", "w006"], "anchor": "w006", "gloss": "the Immaculate Conception of the Virgin" }, { "words": ["w007", "w008", "w009", "w010"], "anchor": "w010", "gloss": "a worthy dwelling for Your Son" }, { "words": ["w016", "w017", "w018", "w019", "w020"], "anchor": "w016", "gloss": "the foreseen death of that same Son of Yours" }, { "words": ["w029", "w030"], "anchor": "w030", "gloss": "through her intercession" }, { "words": ["w031", "w032", "w033", "w034"], "anchor": "w034", "gloss": "may You grant to come to You" }, { "words": ["w036", "w037", "w038", "w039", "w040"], "anchor": "w037", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w041", "w042"], "anchor": "w041", "gloss": "Your Son" }, { "words": ["w043", "w044", "w045", "w046", "w047"], "anchor": "w045", "gloss": "who lives and reigns with You" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "of the Holy Spirit" }, { "words": ["w053", "w054", "w055", "w056"], "anchor": "w055", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
