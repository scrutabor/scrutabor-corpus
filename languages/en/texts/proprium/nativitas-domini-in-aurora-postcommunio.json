  "text": "proprium.nativitas-domini-in-aurora-postcommunio",
  "about": "The postcommunio of the formulary “Nativity of the Lord — Mass at Dawn” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May the newness of the birth of this Sacrament ever renew us, O Lord, for its singular birth has cast away the oldness of humanity. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005", "w006", "w007", "w008"], "anchor": "w008", "gloss": "May the newness of the birth of this Sacrament ever renew us, O Lord" }, { "words": ["w009", "w010", "w011"], "anchor": "w010", "gloss": "for its singular Nativity" }, { "words": ["w012", "w013", "w014"], "anchor": "w013", "gloss": "has cast away human oldness" }, { "words": ["w016", "w017", "w018", "w019", "w020"], "anchor": "w017", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "Your Son" }, { "words": ["w023", "w024", "w025", "w026", "w027"], "anchor": "w025", "gloss": "who lives and reigns with You" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "of the Holy Spirit" }, { "words": ["w033", "w034", "w035", "w036"], "anchor": "w035", "gloss": "forever and ever" }] },
    "s04": { "translation": "Amen." },
    "s02": { "narrative": "For Saint Anastasia." },
    "s03": { "translation": "You have filled Your household, O Lord, with sacred gifts; always refresh us, we beseech You, through the intercession of her whose solemnity we celebrate. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w040", "w041"], "anchor": "w040", "gloss": "Your household" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "with sacred gifts" }, { "words": ["w044", "w045", "w046", "w047"], "anchor": "w047", "gloss": "always, we beseech You, by her intercession" }, { "words": ["w054", "w055"], "anchor": "w054", "gloss": "our Lord" }, { "words": ["w056", "w057"], "anchor": "w056", "gloss": "Jesus Christ" }, { "words": ["w058", "w059"], "anchor": "w058", "gloss": "Your Son" }, { "words": ["w060", "w061", "w062", "w063", "w064"], "anchor": "w062", "gloss": "who lives and reigns with You" }, { "words": ["w067", "w068"], "anchor": "w067", "gloss": "of the Holy Spirit" }, { "words": ["w070", "w071", "w072", "w073"], "anchor": "w072", "gloss": "forever and ever" }] },
    "s05": { "translation": "Amen." }
  },
