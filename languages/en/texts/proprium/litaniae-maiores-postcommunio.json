  "text": "proprium.litaniae-maiores-postcommunio",
  "about": "The postcommunion for the commemoration of the Greater Litanies in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Lord, we pray, attend to our prayers with loving favor, so that, as we receive Your gifts amid tribulation, we may grow in love for You through our consolation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005", "w006", "w007"], "anchor": "w007", "gloss": "Attend to our prayers with loving favor, we pray, Lord" }, { "words": ["w010", "w011", "w012", "w013", "w014"], "anchor": "w014", "gloss": "we receive Your gifts in tribulation" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "our consolation" }, { "words": ["w018", "w019", "w020", "w021"], "anchor": "w021", "gloss": "we may grow in love for You" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your Son" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }, { "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
