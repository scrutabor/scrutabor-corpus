  "text": "proprium.dominica-iv-adventus-epistola",
  "about": "The epistle of the Fourth Sunday of Advent. Paul takes the verdict away from the Corinthians and from himself alike — it belongs to the Lord, and it is not given until He comes.",
  "segments": {
    "s01": { "translation": "Brethren: Let each one regard us thus, as ministers of Christ and dispensers of the mysteries of God.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "parallel Ordinary and Advent propers, examined edition", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "let a man account" }] },
    "s02": { "translation": "Here, now, it is required among the dispensers that one be found faithful.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "parallel Ordinary and Advent propers, examined edition", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w019", "w020", "w021"], "anchor": "w021", "gloss": "a man be found faithful" }] },
    "s03": { "translation": "But to me it is of the least account that I be judged by you or by man’s day; but neither do I judge myself.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "parallel Ordinary and Advent propers, examined edition", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w022", "w023"], "anchor": "w022", "gloss": "But to me" }] },
    "s04": { "translation": "For I am not conscious of anything against myself, yet this does not justify me; the Lord is the One who judges me.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 106", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w039", "w040", "w041", "w042", "w043"], "anchor": "w042", "gloss": "For I am conscious of nothing against myself" }, { "words": ["w048", "w049"], "anchor": "w048", "gloss": "am I justified" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "but He who" }, { "words": ["w054", "w055"], "anchor": "w055", "gloss": "is the Lord" }] },
    "s05": { "translation": "Therefore do not judge before the time, until the Lord comes. He will bring to light the things hidden in darkness and reveal the counsels of hearts; then each will receive praise from God.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 106", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w062", "w063"], "anchor": "w062", "gloss": "the Lord comes" }] }
  },
