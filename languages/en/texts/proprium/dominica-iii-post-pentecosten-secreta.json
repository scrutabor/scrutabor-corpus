    "s01": { "translation": "Look favorably, O Lord, upon the offerings of Your prayerful Church and grant that those who believe may, in continual holiness, partake of them for their salvation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w014", "w015"], "anchor": "w014", "gloss": "our Lord" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "Your Son" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
