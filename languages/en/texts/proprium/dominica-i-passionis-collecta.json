  "about": "The collecta of the formulary “First Passion Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We beseech You, almighty God, look graciously upon Your household, that by Your bounty it may be governed in body and by Your protection guarded in mind. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "Your household" }, { "words": ["w009", "w010"], "anchor": "w010", "gloss": "through Your bounty" }, { "words": ["w015", "w016"], "anchor": "w016", "gloss": "by Your protection" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "our Lord" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Jesus Christ" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Your Son" }, { "words": ["w027", "w028", "w029", "w030", "w031"], "anchor": "w029", "gloss": "who lives and reigns with You" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "of the Holy Spirit" }, { "words": ["w037", "w038", "w039", "w040"], "anchor": "w039", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
