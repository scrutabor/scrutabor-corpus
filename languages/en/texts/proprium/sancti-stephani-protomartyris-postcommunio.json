  "text": "proprium.sancti-stephani-protomartyris-postcommunio",
  "about": "The postcommunio of the formulary “Saint Stephen, the First Martyr” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May the mysteries we have received aid us, O Lord, and by the intercession of blessed Stephen, Your Martyr, may they strengthen us with everlasting protection. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w010", "w011"], "anchor": "w010", "gloss": "Your Martyr" }, { "words": ["w012", "w013"], "anchor": "w013", "gloss": "with everlasting protection" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "our Lord" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "Jesus Christ" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "Your Son" }, { "words": ["w022", "w023", "w024", "w025", "w026"], "anchor": "w024", "gloss": "who lives and reigns with You" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "of the Holy Spirit" }, { "words": ["w032", "w033", "w034", "w035"], "anchor": "w034", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
