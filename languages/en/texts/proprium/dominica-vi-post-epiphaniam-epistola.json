  "text": "proprium.dominica-vi-post-epiphaniam-epistola",
  "about": "Paul gives thanks for the Thessalonians' faith and describes how they turned from idols to the living God and await His Son. Their reception of the Gospel becomes an example for believers elsewhere.",
  "segments": {
    "s01": { "translation": "Brethren: We thank God at all times for every one of you, calling you to mind in our prayers without ceasing, mindful of the work of your faith, and of labor, and of charity, and of the endurance of the hope of our Lord Jesus Christ, before God and our Father. And we know, brethren beloved of God, that you have been chosen, because our Gospel did not reach you in speech alone, but in power as well, and in the Holy Spirit, and in much fullness, as you know what we were like among you for your sake. And you have become our imitators, and the Lord's, welcoming the word in much distress, with joy of the Holy Spirit, so that you have been made an example to all who believe in Macedonia and in Achaia. For it is from you that the word of the Lord has spread abroad, not only in Macedonia and in Achaia, but your faith toward God has also gone out into every place, so that there is no need for us to say anything. For they themselves tell about us the manner of our coming to you, and how you turned from idols to God, to be servants of the living and true God, and to be waiting for His Son from the heavens (whom He raised from among the dead), Jesus, who has rescued us from the wrath that is to come.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "we give thanks" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "all of you" }, { "words": ["w009", "w010", "w011"], "anchor": "w009", "gloss": "remembering you" }, { "words": ["w013", "w014"], "anchor": "w013", "gloss": "our prayers" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "of your faith" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "in our Lord" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "our Father" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "beloved brethren" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "your being chosen" }, { "words": ["w045", "w046"], "anchor": "w045", "gloss": "our Gospel" }, { "words": ["w047", "w048"], "anchor": "w047", "gloss": "did not come" }, { "words": ["w060", "w061"], "anchor": "w060", "gloss": "the Holy Spirit" }, { "words": ["w078", "w079"], "anchor": "w078", "gloss": "became" }, { "words": ["w085", "w086"], "anchor": "w085", "gloss": "great suffering" }, { "words": ["w089", "w090"], "anchor": "w089", "gloss": "of the Holy Spirit" }, { "words": ["w093", "w094"], "anchor": "w093", "gloss": "you became" }, { "words": ["w096", "w097"], "anchor": "w096", "gloss": "for all believers" }, { "words": ["w106", "w107"], "anchor": "w106", "gloss": "has been spread abroad" }, { "words": ["w122", "w123"], "anchor": "w122", "gloss": "your faith" }, { "words": ["w128", "w129"], "anchor": "w128", "gloss": "has gone out" }, { "words": ["w132", "w133", "w134", "w135"], "anchor": "w132", "gloss": "we do not need" }, { "words": ["w136", "w137"], "anchor": "w136", "gloss": "to say anything" }, { "words": ["w150", "w151"], "anchor": "w150", "gloss": "you turned" }, { "words": ["w157", "w158", "w159", "w160"], "anchor": "w157", "gloss": "the living and true God" }, { "words": ["w163", "w164"], "anchor": "w163", "gloss": "His Son" }] }
