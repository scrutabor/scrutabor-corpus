  "about": "The Introit of the formulary “Nativity of the Lord — Mass during the Day” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "A Child is born to us, and a Son is given to us, whose government is upon His shoulder; and His name will be called the Angel of great counsel. Sing to the Lord a new song, for He has done wonderful things. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. A Child is born to us, and a Son is given to us, whose government is upon His shoulder; and His name will be called the Angel of great counsel.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "is born" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "is given" }, { "words": ["w013", "w014"], "anchor": "w013", "gloss": "His shoulder" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "His name" }, { "words": ["w019", "w020", "w021"], "anchor": "w021", "gloss": "the Angel of great counsel" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "a new song" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "to the Holy Spirit" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "is born" }, { "words": ["w055", "w056"], "anchor": "w055", "gloss": "is given" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "His shoulder" }, { "words": ["w065", "w066"], "anchor": "w065", "gloss": "His name" }, { "words": ["w067", "w068", "w069"], "anchor": "w069", "gloss": "the Angel of great counsel" }] }
