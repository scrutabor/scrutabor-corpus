  "text": "proprium.pretiosissimi-sanguinis-domini-nostri-iesu-christi-secreta",
  "about": "The secreta of the formulary “Most Precious Blood of Our Lord Jesus Christ” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Through these divine mysteries, we beseech You, may we draw near to Jesus, the mediator of the new covenant, and renew upon Your altars, O Lord of hosts, the sprinkling of blood that speaks better than Abel. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God," },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
