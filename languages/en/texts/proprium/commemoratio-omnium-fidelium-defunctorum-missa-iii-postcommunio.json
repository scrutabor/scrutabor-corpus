  "text": "proprium.commemoratio-omnium-fidelium-defunctorum-missa-iii-postcommunio",
  "about": "The postcommunio of the formulary “Commemoration of All the Faithful Departed — Mass III” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, we beseech You, O almighty and merciful God, that the souls of Your servants and handmaids for whom we have offered this sacrifice of praise to Your Majesty, cleansed of all sins by the power of this sacrament, may, by Your mercy, receive the joy of perpetual light. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w058", "w059", "w060"], "anchor": "w058", "gloss": "of Thy servants and handmaids" }, { "words": ["w019", "w020", "w021"], "anchor": "w020", "gloss": "we have offered to Thy Majesty" }, { "words": ["w023", "w024", "w025"], "anchor": "w024", "gloss": "the power of this sacrament" }, { "words": ["w026", "w027", "w028", "w029"], "anchor": "w029", "gloss": "cleansed from all sins" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "of everlasting light" }, { "words": ["w032", "w033"], "anchor": "w033", "gloss": "by Thy mercy" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "our Lord" }, { "words": ["w041", "w042"], "anchor": "w041", "gloss": "Thy Son" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "of the Holy Spirit" }, { "words": ["w053", "w054", "w055", "w056"], "anchor": "w055", "gloss": "world without end" }] },
    "s02": { "translation": "Amen." }
  },
