  "text": "proprium.dominica-i-passionis-secreta",
  "about": "The secreta “Hæc múnera” in the 1962 Roman Missal. It is said in the formulary “First Passion Sunday” and in the commemoration of the Greater Litanies.",
  "segments": {
    "s01": { "translation": "May these gifts, we beseech You, O Lord, both loose the bonds of our perversity and obtain for us the gifts of Your mercy. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w007", "w008"], "anchor": "w008", "gloss": "of our perversity" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "our Lord" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "Jesus Christ" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "Your Son" }, { "words": ["w023", "w024", "w025", "w026", "w027"], "anchor": "w025", "gloss": "who lives and reigns with You" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w033", "w034", "w035", "w036"], "anchor": "w035", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
