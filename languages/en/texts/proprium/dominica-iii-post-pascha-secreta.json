  "about": "The secreta of the formulary “Third Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "By these mysteries, O Lord, may it be granted to us that, subduing earthly desires, we may learn to love heavenly things. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005"], "anchor": "w005", "gloss": "By these mysteries, Lord, may it be granted to us" }, { "words": ["w007", "w008", "w009"], "anchor": "w009", "gloss": "subduing earthly desires" }, { "words": ["w014", "w015"], "anchor": "w014", "gloss": "our Lord" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "Your Son" }, { "words": ["w020", "w021", "w022", "w023", "w024"], "anchor": "w022", "gloss": "who lives and reigns with You" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w030", "w031", "w032", "w033"], "anchor": "w032", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
