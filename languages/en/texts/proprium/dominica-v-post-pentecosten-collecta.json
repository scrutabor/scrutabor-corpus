  "about": "The collecta of the formulary “5th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, You Who have prepared good things as yet unseen for those who love You, pour a burning love into our hearts, so that we, loving You in and above all things, may obtain Your promises which surpass all desire. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w009", "w010"], "anchor": "w009", "gloss": "into our hearts" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Your promises" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "our Lord" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "Your Son" }, { "words": ["w043", "w044"], "anchor": "w043", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
