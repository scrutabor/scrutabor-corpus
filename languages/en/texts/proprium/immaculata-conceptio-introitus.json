  "about": "The introitus of the formulary “Immaculate Conception of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "With joy I will rejoice in the Lord, and my soul will exult in my God; for He has clothed me with garments of salvation, and He has enfolded me in the robe of justice, like a bride adorned with her jewels. I will exalt You, O Lord, for You have upheld me, and You have not given my enemies joy over me. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. With joy I will rejoice in the Lord, and my soul will exult in my God; for He has clothed me with garments of salvation, and He has enfolded me in the robe of justice, like a bride adorned with her jewels.", "alignments": [{ "words": ["w006", "w007", "w008"], "anchor": "w006", "gloss": "my soul will exult" }, { "words": ["w010", "w011"], "anchor": "w010", "gloss": "my God" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "with her own jewels" }, { "words": ["w033", "w034"], "anchor": "w034", "gloss": "and You have not gladdened" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "my enemies" }, { "words": ["w044", "w045"], "anchor": "w044", "gloss": "to the Holy Spirit" }, { "words": ["w064", "w065", "w066"], "anchor": "w064", "gloss": "my soul will exult" }, { "words": ["w068", "w069"], "anchor": "w068", "gloss": "my God" }, { "words": ["w083", "w084"], "anchor": "w083", "gloss": "with her own jewels" }] }
  },
