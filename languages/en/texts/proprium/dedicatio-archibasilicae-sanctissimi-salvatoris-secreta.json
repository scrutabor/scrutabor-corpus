  "text": "proprium.dedicatio-archibasilicae-sanctissimi-salvatoris-secreta",
  "about": "The secreta of the formulary “Dedication of the Archbasilica of the Most Holy Savior” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Look with favor upon our prayers, we beseech You, O Lord, that, while we render these present offerings, we may, with Your help, be worthy to attain eternal rewards. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God," },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
