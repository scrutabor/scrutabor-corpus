  "text": "proprium.sancti-ioannis-apostoli-et-evangelistae-evangelium",
  "about": "The evangelium of the formulary “Saint John, Apostle and Evangelist” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At that time, Jesus said to Peter: Follow me. Peter, turning around, saw that disciple whom Jesus loved, following, the one who had also leaned on His breast at the supper and said: Lord, who is it that will betray You? So when Peter had seen him, he said to Jesus: Lord, and this man, what of him? Jesus says to him: Thus I want him to remain until I come; what is that to you? As for you, follow me. So this saying went out among the brothers, that that disciple does not die. And Jesus did not say to him: He does not die; but: Thus I want him to remain until I come; what is that to you? This is that disciple who bears witness of these things and has written these things; and we know that his witness is true.", "alignments": [{ "words": ["w015", "w016"], "anchor": "w016", "gloss": "Jesus loved" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "His breast" }, { "words": ["w036", "w037", "w038"], "anchor": "w036", "gloss": "when Peter had seen" }, { "words": ["w042", "w043", "w044"], "anchor": "w042", "gloss": "and what of this man" }, { "words": ["w062", "w063"], "anchor": "w062", "gloss": "this saying" }, { "words": ["w067", "w068"], "anchor": "w067", "gloss": "that disciple" }, { "words": ["w069", "w070"], "anchor": "w070", "gloss": "does not die" }, { "words": ["w072", "w073", "w074", "w075"], "anchor": "w073", "gloss": "Jesus did not say to him" }, { "words": ["w076", "w077"], "anchor": "w077", "gloss": "He does not die" }, { "words": ["w090", "w091"], "anchor": "w090", "gloss": "that disciple" }, { "words": ["w105", "w106"], "anchor": "w105", "gloss": "his witness" }] }
