  "text": "proprium.dominica-in-albis-collecta",
  "about": "The collecta of the formulary “Low Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Almighty God, we ask You to grant that we, who have celebrated the paschal feasts, may keep them in our conduct and life through Your generosity. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w006", "w007", "w008", "w009"], "anchor": "w009", "gloss": "we who have celebrated the paschal feasts" }, { "words": ["w010", "w011", "w012", "w013", "w014", "w015", "w016"], "anchor": "w016", "gloss": "may keep them, through Your generosity, in our conduct and life" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "our Lord" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Your Son" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "of the Holy Spirit" }, { "words": ["w034", "w035", "w036", "w037"], "anchor": "w036", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
