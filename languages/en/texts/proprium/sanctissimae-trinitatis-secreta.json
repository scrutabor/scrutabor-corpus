  "text": "proprium.sanctissimae-trinitatis-secreta",
  "about": "The Secret of the feast of the Most Holy Trinity. It asks that the oblation be sanctified by invocation of God’s holy name and that those who offer it themselves be perfected as an everlasting gift to God.",
  "segments": {
    "s01": { "translation": "Sanctify, we beseech You, O Lord our God, by the invocation of Your holy name, the victim of this oblation; and by it perfect our very selves as an everlasting gift to You. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "our God" }, { "words": ["w006", "w007", "w008", "w009", "w010"], "anchor": "w010", "gloss": "through the invocation of Your holy name" }, { "words": ["w011", "w012", "w013"], "anchor": "w013", "gloss": "the victim of this oblation" }, { "words": ["w017", "w018", "w019", "w020", "w021"], "anchor": "w019", "gloss": "perfect our very selves as an everlasting gift to You" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "Jesus Christ" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your Son" }, { "words": ["w029", "w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "who lives and reigns with You" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
