  "text": "proprium.sancti-lucae-evangelistae-postcommunio",
  "about": "The postcommunio of the formulary “Saint Luke the Evangelist” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Grant, we pray, almighty God, that what we have received from Your holy altar may, through the prayers of Your blessed evangelist Luke, sanctify our souls, so that through it we may be safe. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w007", "w008", "w009", "w010", "w011"], "anchor": "w011", "gloss": "we have received from Your holy altar" }, { "words": ["w013", "w014", "w015"], "anchor": "w014", "gloss": "of Your blessed evangelist" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "our souls" }, { "words": ["w020", "w021"], "anchor": "w021", "gloss": "and through it" }, { "words": ["w022", "w023", "w024"], "anchor": "w024", "gloss": "we may be safe" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "our Lord" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "Your Son" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "of the Holy Spirit" }, { "words": ["w042", "w043", "w044", "w045"], "anchor": "w044", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
