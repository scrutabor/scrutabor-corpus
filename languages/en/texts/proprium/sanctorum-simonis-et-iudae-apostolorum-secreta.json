  "text": "proprium.sanctorum-simonis-et-iudae-apostolorum-secreta",
  "about": "The secreta of the formulary “Saints Simon and Jude, Apostles” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We honor, O Lord, the everlasting glory of Your holy Apostles Simon and Jude; we beseech You, that, purified by this sacramental rite, we may the more worthily celebrate their glory. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w033", "w034"], "anchor": "w033", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
