  "text": "proprium.dominica-in-sexagesima-introitus",
  "about": "The introitus of the formulary “Sexagesima Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Arise, why do You sleep, O Lord? Arise and do not cast us off forever. Why do You turn Your face away and forget our distress? Our belly has clung to the earth. Arise, O Lord, help us and deliver us. O God, we have heard with our own ears. Our fathers have told us. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and always will be, forever and ever. Amen. Arise, why do You sleep, O Lord? Arise and do not cast us off forever. Why do You turn Your face away and forget our distress? Our belly has clung to the earth. Arise, O Lord, help us and deliver us.", "alignments": [{ "words": ["w002", "w003"], "anchor": "w003", "gloss": "why do You sleep" }, { "words": ["w007", "w008", "w009", "w010"], "anchor": "w008", "gloss": "do not cast us off forever" }, { "words": ["w011", "w012", "w013", "w014"], "anchor": "w014", "gloss": "why do You turn Your face away" }, { "words": ["w015", "w016", "w017"], "anchor": "w015", "gloss": "and forget our distress" }, { "words": ["w018", "w019", "w020", "w021", "w022"], "anchor": "w018", "gloss": "our belly has clung to the earth" }, { "words": ["w031", "w032", "w033"], "anchor": "w033", "gloss": "we have heard with our own ears" }, { "words": ["w034", "w035", "w036", "w037"], "anchor": "w036", "gloss": "our fathers have told us" }, { "words": ["w043", "w044"], "anchor": "w043", "gloss": "to the Holy Spirit" }, { "words": ["w045", "w046", "w047", "w048"], "anchor": "w046", "gloss": "As it was in the beginning" }, { "words": ["w049", "w050"], "anchor": "w050", "gloss": "and is now" }, { "words": ["w051", "w052"], "anchor": "w052", "gloss": "and always will be" }, { "words": ["w053", "w054", "w055", "w056"], "anchor": "w054", "gloss": "and forever and ever" }, { "words": ["w059", "w060"], "anchor": "w060", "gloss": "why do You sleep" }, { "words": ["w064", "w065", "w066", "w067"], "anchor": "w065", "gloss": "do not cast us off forever" }, { "words": ["w068", "w06