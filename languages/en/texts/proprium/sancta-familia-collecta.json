  "text": "proprium.sancta-familia-collecta",
  "about": "The collecta of the formulary “Holy Family of Jesus, Mary, and Joseph” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord Jesus Christ, who, being subject to Mary and Joseph, consecrated domestic life by ineffable virtues, grant that with the aid of them both we may be instructed by the examples of Your Holy Family and attain everlasting fellowship with it. You live and reign with God the Father in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w009", "w010", "w011", "w012", "w013"], "anchor": "w013", "gloss": "consecrated domestic life by ineffable virtues" }, { "words": ["w016", "w017"], "anchor": "w017", "gloss": "with the aid of them both" }, { "words": ["w018", "w019", "w020", "w021"], "anchor": "w021", "gloss": "by the examples of Your Holy Family" }, { "words": ["w024", "w025", "w026"], "anchor": "w025", "gloss": "may attain everlasting fellowship" }, { "words": ["w027", "w028", "w029", "w030"], "anchor": "w028", "gloss": "You live and reign" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }, { "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
