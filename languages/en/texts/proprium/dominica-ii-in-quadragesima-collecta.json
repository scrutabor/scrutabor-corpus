  "text": "proprium.dominica-ii-in-quadragesima-collecta",
  "about": "The collecta of the formulary “Second Sunday of Lent” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who see that we are bereft of all strength, guard us within and without, that we may be defended in body from all adversities and cleansed in mind from evil thoughts. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w004", "w005", "w006", "w007"], "anchor": "w007", "gloss": "us to be bereft of all strength" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "our Lord" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "Jesus Christ" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "Your Son" }, { "words": ["w032", "w033", "w034", "w035", "w036"], "anchor": "w034", "gloss": "who lives and reigns with You" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "of the Holy Spirit" }, { "words": ["w042", "w043", "w044", "w045"], "anchor": "w044", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
