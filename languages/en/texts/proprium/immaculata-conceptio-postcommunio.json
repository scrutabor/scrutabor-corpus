  "text": "proprium.immaculata-conceptio-postcommunio",
  "about": "The postcommunio of the formulary “Immaculate Conception of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May the sacrament we have received, O Lord our God, heal in us the wounds of that sin from which by a singular privilege, You kept immaculate the conception of blessed Mary. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
