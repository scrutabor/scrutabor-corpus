  "text": "proprium.immaculata-conceptio-postcommunio",
  "about": "The postcommunio of the formulary “Immaculate Conception of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May the sacraments we have received, O Lord our God, heal in us the wounds of that sin from which You singularly preserved the Immaculate Conception of blessed Mary. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006"], "anchor": "w005", "gloss": "our God" }, { "words": ["w007", "w008", "w009", "w010", "w011", "w012"], "anchor": "w012", "gloss": "may heal in us the wounds of that sin" }, { "words": ["w015", "w016", "w017", "w018"], "anchor": "w018", "gloss": "the Conception of blessed Mary immaculate" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "our Lord" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "Jesus Christ" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "Your Son" }, { "words": ["w028", "w029", "w030", "w031", "w032"], "anchor": "w030", "gloss": "who lives and reigns with You" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "of the Holy Spirit" }, { "words": ["w038", "w039", "w040", "w041"], "anchor": "w040", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
