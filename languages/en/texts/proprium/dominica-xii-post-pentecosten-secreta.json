  "text": "proprium.dominica-xii-post-pentecosten-secreta",
  "about": "The secreta of the formulary “12th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord, we beseech You, graciously look upon the offerings which we lay upon Your sacred altars; so that by bestowing forgiveness on us, they may give honor to Your name. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w019", "w020"], "anchor": "w019", "gloss": "our Lord" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Your Son" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
