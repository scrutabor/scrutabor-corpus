  "text": "proprium.sacratissimi-cordis-iesu-postcommunio",
  "about": "The Postcommunion of the feast of the Most Sacred Heart of Jesus. It asks that the holy gifts kindle divine fervor and teach the faithful to despise earthly things and love heavenly ones.",
  "segments": {
    "s01": { "translation": "May Your holy gifts, Lord Jesus, bestow divine fervor on us so that, having tasted the sweetness of Your most sweet Heart, we may learn to despise earthly things and love heavenly things. You live and reign with God the Father in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w006", "w007"], "anchor": "w007", "gloss": "Your holy gifts" }, { "words": ["w010", "w011", "w012"], "anchor": "w011", "gloss": "of Your most sweet Heart" }, { "words": ["w021", "w022", "w023", "w024"], "anchor": "w022", "gloss": "You live and reign" }, { "words": ["w025", "w026", "w027"], "anchor": "w026", "gloss": "with God the Father" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "of the Holy Spirit" }, { "words": ["w033", "w034", "w035", "w036"], "anchor": "w035", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
