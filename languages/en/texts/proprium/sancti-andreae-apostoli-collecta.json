  "about": "The collecta of the formulary “Saint Andrew the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We humbly entreat Your majesty, O Lord, that, as blessed Andrew the Apostle was a preacher and ruler in Your Church, so he may always intercede for us with You. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "Your majesty" }, { "words": ["w008", "w009"], "anchor": "w008", "gloss": "of Your Church" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "our Lord" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "Jesus Christ" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "Your Son" }, { "words": ["w032", "w033", "w034", "w035", "w036"], "anchor": "w034", "gloss": "who lives and reigns with You" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "of the Holy Spirit" }, { "words": ["w042", "w043", "w044", "w045"], "anchor": "w044", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
