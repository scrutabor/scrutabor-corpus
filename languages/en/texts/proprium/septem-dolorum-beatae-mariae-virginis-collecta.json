  "text": "proprium.septem-dolorum-beatae-mariae-virginis-collecta",
  "about": "The collect for the feast of the Seven Sorrows of the Blessed Virgin Mary on 15 September in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "God, during Your Passion a sword of sorrow pierced the most tender soul of the glorious Virgin and Mother Mary, as Simeon foretold. Graciously grant that we, who reverently commemorate her sorrows, may receive the blessed fruit of Your Passion. You live and reign with God the Father in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w008", "w009"], "anchor": "w009", "gloss": "the most tender soul" }, { "words": ["w010", "w011"], "anchor": "w011", "gloss": "of the glorious Virgin" }, { "words": ["w015", "w016"], "anchor": "w016", "gloss": "a sword of sorrow" }, { "words": ["w060", "w023"], "anchor": "w060", "gloss": "her sorrows" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "Thy Passion's" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "blessed fruit" }, { "words": ["w052", "w053"], "anchor": "w052", "gloss": "of the Holy Spirit" }, { "words": ["w055", "w056", "w057", "w058"], "anchor": "w057", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
