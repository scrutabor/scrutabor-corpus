  "text": "proprium.sancti-ioseph-sponsi-beatae-mariae-virginis-secreta",
  "about": "The secreta of the formulary “Saint Joseph, Spouse of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord, we render You the service we owe, humbly entreating You that, through the prayers of blessed Joseph, Spouse of the Mother of Your Son, Jesus Christ our Lord, You may guard Your gifts within us, as we offer You sacrifices of praise on his venerable feast. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w049", "w050"], "anchor": "w049", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
