  "text": "proprium.d-n-iesu-christi-regis-secreta",
  "about": "The secreta of the formulary “Christ the King” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O Lord, we offer You this sacrificial Victim of mankind's reconciliation with You; grant, we beseech You, that our Lord Jesus Christ, your Son, Whom we offer in this sacrifice, may bestow upon all peoples the gifts of unity and peace. Who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
