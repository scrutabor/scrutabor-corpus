  "text": "proprium.dominica-xxi-post-pentecosten-secreta",
  "about": "The secreta of the formulary “21st Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Graciously accept these sacrificial gifts, O Lord, by which You have willed both to be appeased and, in Your mighty love, to restore salvation to us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God," },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
