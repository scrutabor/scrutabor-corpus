  "text": "proprium.dominica-vi-post-epiphaniam-secreta",
  "about": "The secreta of the formulary “Transferred Sixth Sunday after Epiphany” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May this offering, O God, we beseech You, cleanse and renew us, govern and protect us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God," },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
