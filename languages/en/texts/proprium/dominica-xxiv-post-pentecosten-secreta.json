  "text": "proprium.dominica-xxiv-post-pentecosten-secreta",
  "about": "The secreta of the formulary “24th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Be merciful, O Lord, to our humble requests and accept the offerings and prayers of Your people: turn the hearts of all of us to You, that, freed from earthly cravings, we may pass over to heavenly yearnings. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
