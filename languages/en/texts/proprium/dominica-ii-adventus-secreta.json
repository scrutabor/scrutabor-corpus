  "text": "proprium.dominica-ii-adventus-secreta",
  "about": "The secret of the Second Sunday of Advent, said quietly over the gifts. It asks God to accept prayer and offering where merits do not suffice — the defense is to be His, not ours.",
  "segments": {
    "s01": { "translation": "Lord, we pray, let our humble prayers and offerings appease You; where merits offer no support, come to our aid through Your protection. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w020", "w021"], "anchor": "w020", "gloss": "our Lord" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Jesus Christ" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "Thy Son" }, { "words": ["w026", "w027", "w028", "w029", "w030"], "anchor": "w028", "gloss": "who liveth and reigneth with Thee" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "of the Holy Ghost" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w036", "w037", "w038", "w039"], "anchor": "w038", "gloss": "world without end" }] },
    "s03": { "translation": "Amen." }
  },
