  "about": "The evangelium of the formulary “Sunday after the Ascension” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At that time, Jesus said to His disciples: When the Paraclete comes, whom I will send to you from the Father—the Spirit of truth who proceeds from the Father—He will bear witness to Me. You too will bear witness, because you have been with Me from the beginning. I have spoken these things to you so that you may not fall away. They will put you out of the synagogues; indeed, the hour is coming when everyone who kills you will think he is offering service to God. And they will do these things to you because they have known neither the Father nor Me. But I have told you these things so that when their hour comes, you may remember that I told you.", "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "to His disciples" }, { "words": ["w024", "w025"], "anchor": "w025", "gloss": "will bear witness" }, { "words": ["w030", "w031"], "anchor": "w031", "gloss": "will bear witness" }, { "words": ["w035", "w036"], "anchor": "w036", "gloss": "you have been with Me" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "I have spoken" }, { "words": ["w042", "w043"], "anchor": "w043", "gloss": "you may not fall away" }, { "words": ["w057", "w058", "w059"], "anchor": "w059", "gloss": "he is offering service" }, { "words": ["w066", "w067"], "anchor": "w067", "gloss": "they have known neither" }, { "words": ["w073", "w074"], "anchor": "w073", "gloss": "I have spoken" }, { "words": ["w078", "w079", "w080"], "anchor": "w078", "gloss": "their hour comes" }] }
  },
