    "s01": { "translation": "O Lord, look upon Your covenant, and do not abandon the souls of Your poor forever; rise up, O Lord, and judge Your cause, and do not forget the cries of those who seek You. O God, why have You rejected us forever, and why is Your fury roused against the sheep of Your pasture? Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. O Lord, look upon Your covenant, and do not abandon the souls of Your poor forever; rise up, O Lord, and judge Your cause, and do not forget the cries of those who seek You.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "Your covenant" }, { "words": ["w008", "w009"], "anchor": "w008", "gloss": "of Your poor" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "Your cause" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "is raging" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "Your fury" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "of Your pasture" }, { "words": ["w045", "w046"], "anchor": "w045", "gloss": "to the Holy Spirit" }, { "words": ["w063", "w064"], "anchor": "w063", "gloss": "Your covenant" }, { "words": ["w067", "w068"], "anchor": "w067", "gloss": "of Your poor" }, { "words": ["w077", "w078"], "anchor": "w077", "gloss": "Your cause" }] }
