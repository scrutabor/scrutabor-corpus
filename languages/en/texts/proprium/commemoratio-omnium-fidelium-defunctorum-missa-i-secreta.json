  "text": "proprium.commemoratio-omnium-fidelium-defunctorum-missa-i-secreta",
  "about": "The secreta of the formulary “Commemoration of All the Faithful Departed — Mass I” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Look with mercy, we beseech You, O Lord, upon the sacrificial gifts we offer for the souls of Your servants and handmaids, so that, to those upon whom You conferred the merits of Christian faith, You will also grant its reward. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God,", "alignments": [{ "words": ["w006", "w007"], "anchor": "w007", "gloss": "for the souls" }] },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
