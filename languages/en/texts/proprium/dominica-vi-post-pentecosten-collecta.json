  "text": "proprium.dominica-vi-post-pentecosten-collecta",
  "about": "The collecta of the formulary “6th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "God of hosts, all that is best belongs to You. Plant love of Your name in our hearts and make our devotion grow, so that You may nourish what is good and, with loving care, preserve what You have nourished. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w003", "w004", "w005", "w006", "w007", "w008"], "anchor": "w004", "gloss": "to whom all that is best belongs" }, { "words": ["w010", "w011"], "anchor": "w010", "gloss": "in our hearts" }, { "words": ["w019", "w020"], "anchor": "w020", "gloss": "an increase of devotion" }, { "words": ["w022", "w023", "w024", "w025"], "anchor": "w025", "gloss": "You may nourish what is good" }, { "words": ["w027", "w028"], "anchor": "w028", "gloss": "with loving care" }, { "words": ["w029", "w030", "w031", "w032"], "anchor": "w032", "gloss": "You may guard what has been nourished" }, { "words": ["w034", "w035"], "anchor": "w034", "gloss": "our Lord" }, { "words": ["w038", "w039"], "anchor": "w038", "gloss": "Your Son" }, { "words": ["w047", "w048"], "anchor": "w047", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
