  "text": "proprium.sanctorum-simonis-et-iudae-apostolorum-epistola",
  "about": "The lesson from Ephesians 4:7–13, used in the 1962 Roman Missal for Saints Simon and Jude, Apostles, and for the Vigil of the Ascension.",
  "segments": {
    "s01": { "translation": "Brethren: Grace has been given to every one of us in the measure of Christ’s giving. For this reason it is said: Ascending on high, He led captivity captive; He gave gifts to men. Now what does “He ascended” mean, except that He also descended first into the lower regions of the earth? The One who descended is Himself the One who also ascended above all the heavens, so as to fill all things. And it was He who gave some indeed as apostles, some as prophets, others, in turn, as evangelists, and still others as shepherds and teachers, for the perfecting of the saints, for the work of the ministry, for the building up of Christ’s body, until all of us attain unity of faith and knowledge of the Son of God, mature manhood, and the measure of maturity that belongs to Christ’s fullness.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "has been given" }, { "words": ["w012"], "reason": "idiom" }, { "words": ["w017", "w018", "w019"], "anchor": "w018", "gloss": "He led captivity captive" }, { "words": ["w023", "w024", "w025"], "anchor": "w025", "gloss": "Now, “He ascended”" }, { "words": ["w026", "w027"], "anchor": "w027", "gloss": "what does it mean" }, { "words": ["w030", "w031"], "anchor": "w031", "gloss": "He also descended" }, { "words": ["w039", "w040", "w041", "w042"], "anchor": "w040", "gloss": "is Himself also the One who" }, { "words": ["w053", "w054", "w055"], "anchor": "w055", "gloss": "some as apostles" }, { "words": ["w056", "w057", "w058"], "anchor": "w058", "gloss": "others as prophets" }, { "words": ["w059", "w060", "w061"], "anchor": "w061", "gloss": "others as evangelists" }, { "words": ["w062", "w063", "w064"], "anchor": "w064", "gloss": "others as pastors" }, { "words": ["w078", "w079"], "anchor": "w078", "gloss": "we all come together" }, { "words": ["w088", "w089"], "anchor": "w088", "gloss": "a mature man" }] }
  },
