  "text": "proprium.dominica-vi-post-pentecosten-secreta",
  "about": "The secreta of the formulary “6th Sunday after Pentecost” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Mercifully hear our humble prayers, O Lord, and graciously accept these offerings of Your people, and grant that no prayer may be without effect, no petition in vain, so that what we ask in faith, we may really obtain. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w003", "w004"], "anchor": "w003", "gloss": "to our supplications" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "of Your people" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "our Lord" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "Your Son" }, { "words": ["w042", "w043"], "anchor": "w042", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
