  "text": "proprium.dominica-i-in-quadragesima-postcommunio",
  "about": "The postcommunio of the formulary “First Sunday of Lent” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May the holy partaking of Your Sacrament, O Lord, restore us and, cleansing us from our former state, cause us to pass into the fellowship of the saving mystery. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005", "w006", "w007"], "anchor": "w007", "gloss": "May the holy partaking of Your Sacrament, Lord, restore us" }, { "words": ["w012", "w013", "w014", "w015", "w016", "w017"], "anchor": "w015", "gloss": "may cause us to pass into the fellowship of the saving mystery" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "our Lord" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "Jesus Christ" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Your Son" }, { "words": ["w025", "w026", "w027", "w028", "w029"], "anchor": "w027", "gloss": "who lives and reigns with You" }, { "words": ["w032", "w033"], "anchor": "w032", "gloss": "of the Holy Spirit" }, { "words": ["w035", "w036", "w037", "w038"], "anchor": "w037", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
