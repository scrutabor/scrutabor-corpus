  "text": "proprium.dominica-v-post-pascha-collecta",
  "about": "The collecta of the formulary “Fifth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, from whom all good things proceed: grant to Your suppliants that by Your inspiration we may think what is right and by Your guidance accomplish it. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "all good things" }, { "words": ["w008", "w009"], "anchor": "w008", "gloss": "to Your suppliants" }, { "words": ["w012", "w013"], "anchor": "w013", "gloss": "as You inspire us" }, { "words": ["w014", "w015", "w016"], "anchor": "w016", "gloss": "what is right" }, { "words": ["w018", "w019"], "anchor": "w019", "gloss": "as You guide us" }, { "words": ["w020", "w021"], "anchor": "w021", "gloss": "we may do the same things" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "our Lord" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "Your Son" }, { "words": ["w029", "w030", "w031"], "anchor": "w029", "gloss": "who lives with You" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "of the Holy Spirit" }, { "words": ["w039", "w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
