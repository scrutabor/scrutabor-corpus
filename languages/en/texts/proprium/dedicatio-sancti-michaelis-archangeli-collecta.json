  "text": "proprium.dedicatio-sancti-michaelis-archangeli-collecta",
  "about": "The Collect of the formulary “Dedication of Saint Michael the Archangel” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who assign according to a wondrous order the duties of angels and men, mercifully grant that our life on earth be guarded by those who continually stand in Your presence and minister to You in heaven. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, for ever and ever.", "alignments": [{ "words": ["w003", "w004"], "anchor": "w004", "gloss": "in wondrous order" }, { "words": ["w012", "w013", "w014", "w015", "w016", "w017", "w018", "w019", "w020", "w021"], "anchor": "w013", "gloss": "by those who always stand in heaven ministering to You" }] },
    "s02": { "translation": "Amen." }
  },
