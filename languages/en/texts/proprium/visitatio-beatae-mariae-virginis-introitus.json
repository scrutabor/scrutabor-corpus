  "text": "proprium.visitatio-beatae-mariae-virginis-introitus",
  "about": "The introitus of the formulary “Visitation of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Hail, holy Mother, who gave birth to the King who rules heaven and earth forever and ever. My heart has poured out a noble word. I myself recite my compositions to the King. Glory be to the Father, and to the Son, and to the Holy Ghost. As it was in the beginning, is now, and ever shall be, world without end. Amen. Hail, holy Mother, who gave birth to the King who rules heaven and earth forever and ever.", "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w004", "gloss": "Mother who gave birth to" }, { "words": ["w008", "w009", "w010"], "anchor": "w010", "gloss": "rules heaven and earth" }, { "words": ["w011", "w012", "w013"], "anchor": "w012", "gloss": "forever and ever" }, { "words": ["w014", "w015", "w016"], "anchor": "w014", "gloss": "My heart has poured out" }, { "words": ["w017", "w018"], "anchor": "w017", "gloss": "a noble word" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "I myself recite" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "my compositions" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "to the Holy Spirit" }, { "words": ["w040", "w041", "w042"], "anchor": "w041", "gloss": "forever and ever" }, { "words": ["w046", "w047", "w048"], "anchor": "w047", "gloss": "Mother who gave birth to" }, { "words": ["w051", "w052", "w053"], "anchor": "w053", "gloss": "rules heaven and earth" }, { "words": ["w054", "w055", "w056"], "anchor": "w055", "gloss": "forever and ever" }] }
  },
