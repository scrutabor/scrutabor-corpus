  "about": "The epistola of the formulary “Nativity of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "The Lord possessed me at the beginning of His ways, before He made anything, from the beginning. I was ordained from eternity, and from ancient times, before the earth came to be. There were no depths as yet, and I had already been conceived; the springs of the waters had not yet burst forth; the mountains had not yet settled in their heavy mass; I was being brought forth before the hills; He had not yet made the earth, or the rivers, or the poles of the earth. When He was preparing the heavens, I was present; when He was enclosing the depths with a fixed law and a circle; when He was making the sky firm above and balancing the springs of the waters; when He was setting its boundary around the sea and laying down a law for the waters, that they should not pass their limits; when He was weighing the foundations of the earth. I was with Him, fashioning all things, and I delighted every day, playing in His presence at all times, playing in the world; and my delights were to be with the children of men. Now therefore, children, listen to me: Blessed are they who keep my ways. Listen to teaching, and be wise, and do not cast it away. Blessed is the man who listens to me, and who keeps vigil at my doors every day, and watches at the posts of my entrance. Whoever has found me will find life, and will draw salvation from the Lord.", "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "of His ways" }, { "words": ["w009", "w010"], "anchor": "w010", "gloss": "He made anything" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "I was ordained" }, { "words": ["w018", "w019"], "anchor": "w019", "gloss": "of old" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "was conceived" }, { "words": ["w046", "w047"], "anchor": "w047", "gloss": "He had not made" }, { "words": ["w076", "w077"], "anchor": "w076", "gloss": "its boundary" }, { "words": ["w084", "w085"], "anchor": "w084", "gloss": "their boundaries" }, { "words": ["w093", "w094"], "anchor": "w094", "gloss": "ordering all things" }, { "words": ["w110", "w111"], "anchor": "w110", "gloss": "my delight" }, { "words": ["w124", "w125"], "anchor": "w124", "gloss": "my ways" }, { "words": ["w144", "w145"], "anchor": "w144", "gloss": "my doors" }, { "words": ["w151", "w152"], "anchor": "w151", "gloss": "of my door" }] }
