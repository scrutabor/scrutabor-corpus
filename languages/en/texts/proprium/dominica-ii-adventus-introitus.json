  "text": "proprium.dominica-ii-adventus-introitus",
  "about": "The introit of the Second Sunday of Advent, from Isaiah, with a verse of Psalm 79. The antiphon addresses the people of Sion and says what the Lord comes for — to save the nations, and to let His voice be heard.",
  "segments": {
    "s01": { "translation": "O people of Sion, behold, the Lord will come to save the nations; the Lord will make the glory of His voice heard for the joy of your hearts.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 90", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w010", "w011"], "anchor": "w011", "gloss": "will make heard" }, { "words": ["w014", "w015"], "anchor": "w014", "gloss": "of His voice" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "of your heart" }] },
    "s02": { "translation": "You who rule Israel, give ear; You who lead Joseph like a sheep.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 90", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s03": { "translation": "Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 37", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s04": { "narrative": "After the doxology the Introit antiphon is repeated from Pópulus Sion to the psalm verse — by the choir at a sung Mass, by the priest himself at a low Mass." },
    "s05": { "translation": "O people of Sion, behold, the Lord will come to save the nations; the Lord will make the glory of His voice heard for the joy of your hearts.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 90", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w058", "w059"], "anchor": "w059", "gloss": "will make heard" }, { "words": ["w062", "w063"], "anchor": "w062", "gloss": "of His voice" }, { "words": ["w066", "w067"], "anchor": "w066", "gloss": "of your heart" }] }
  },
