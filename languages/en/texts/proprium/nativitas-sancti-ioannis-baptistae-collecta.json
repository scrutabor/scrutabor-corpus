  "about": "The collecta of the formulary “Nativity of Saint John the Baptist” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, Who made this a day most worthy of our celebration because of blessed John; grant Your people the grace of spiritual joys and direct the minds of all the faithful into the path of eternal salvation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w041", "w042"], "anchor": "w041", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
