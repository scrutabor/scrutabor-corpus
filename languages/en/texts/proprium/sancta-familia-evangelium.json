  "about": "The evangelium of the formulary “Holy Family of Jesus, Mary, and Joseph” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "When Jesus was twelve years old, they went up to Jerusalem according to the custom of the feast. When the days were ended and they returned, the Child Jesus remained in Jerusalem, and His parents did not know it. Thinking that He was in the company, they came a day’s journey and sought Him among their kinsfolk and acquaintances. Not finding Him, they returned to Jerusalem, seeking Him. After three days they found Him in the temple, sitting in the midst of the teachers, hearing them and asking them questions. All who heard Him were astonished at His wisdom and His answers. Seeing Him, they wondered; and His mother said to Him: Son, why have You done so to us? Behold, Your father and I have sought You sorrowing. He said to them: How is it that you sought Me? Did you not know that I must be about those things which are My Father’s? But they did not understand the word that He spoke to them. He went down with them and came to Nazareth and was subject to them. His mother kept all these words in her heart. And Jesus advanced in wisdom and age and grace with God and men.", "alignments": [{ "words": ["w002", "w003", "w004"], "anchor": "w002", "gloss": "Jesus was" }, { "words": ["w005", "w006"], "anchor": "w006", "gloss": "twelve years old" }, { "words": ["w014", "w015"], "anchor": "w014", "gloss": "and the days being ended" }, { "words": ["w024", "w025", "w026", "w027"], "anchor": "w025", "gloss": "His parents did not know" }, { "words": ["w047", "w048"], "anchor": "w047", "gloss": "they returned" }, { "words": ["w054", "w055"], "anchor": "w054", "gloss": "it came to pass" }, { "words": ["w074", "w075", "w076"], "anchor": "w076", "gloss": "who heard Him" }, { "words": ["w080", "w081"], "anchor": "w080", "gloss": "His answers" }, { "words": ["w084", "w085"], "anchor": "w084", "gloss": "they were astonished" }, { "words": ["w088", "w089"], "anchor": "w088", "gloss": "His mother" }, { "words": ["w098", "w099"], "anchor": "w098", "gloss": "Your father" }, { "words": ["w119", "w120"], "anchor": "w119", "gloss": "of My Father" }, { "words": ["w122", "w123"], "anchor": "w122", "gloss": "I must" }, { "words": ["w127", "w128"], "anchor": "w128", "gloss": "did not understand" }, { "words": ["w131", "w132"], "anchor": "w131", "gloss": "He had spoken" }, { "words": ["w147", "w148"], "anchor": "w147", "gloss": "His mother" }, { "words": ["w151", "w152"], "anchor": "w151", "gloss": "these words" }, { "words": ["w154", "w155"], "anchor": "w154", "gloss": "her heart" }] }
