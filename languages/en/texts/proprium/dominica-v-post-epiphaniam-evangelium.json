  "about": "The Gospel of the Fifth Sunday after Epiphany in the 1962 Roman Missal, also used when its formulary is resumed after Pentecost.",
  "segments": {
    "s01": { "translation": "At that time, Jesus spoke this parable to the crowds: The kingdom of heaven has been likened to a man who sowed good seed in his field. But while people were asleep, his enemy came and sowed darnel among the wheat, and went away. But when the plant had grown and borne fruit, then the darnel appeared as well. And the householder’s servants came up and said to him: Master, did you not sow good seed in your field? How, then, does it have darnel? And he said to them: An enemy has done this. Then the servants said to him: Would you have us go and gather it? And he said: No, lest perhaps in gathering the darnel you root up the wheat along with it. Let both grow until the harvest, and in the time of harvest I will tell the reapers: First gather the darnel and bind it in bundles to be burned, but gather the wheat into my barn.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "Jesus said" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "this parable" }, { "words": ["w009", "w010", "w011", "w012", "w013"], "anchor": "w010", "gloss": "The kingdom of heaven has been likened" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "his field" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "people slept" }, { "words": ["w026", "w027", "w028"], "anchor": "w026", "gloss": "his enemy came" }, { "words": ["w032", "w033", "w034"], "anchor": "w034", "gloss": "among the wheat" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "the plant had grown" }, { "words": ["w042", "w043"], "anchor": "w043", "gloss": "had borne fruit" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "the householder’s servants" }, { "words": ["w055", "w056", "w057", "w058"], "anchor": "w058", "gloss": "did you not sow good seed" }, { "words": ["w060", "w061"], "anchor": "w060", "gloss": "your field" }, { "words": ["w062", "w063", "w064", "w065"], "anchor": "w064", "gloss": "Where, then, does it get darnel?" }, { "words": ["w069", "w070"], "anchor": "w069", "gloss": "An enemy" }, { "words": ["w071", "w072"], "anchor": "w072", "gloss": "has done this" }, { "words": ["w087", "w088"], "anchor": "w087", "gloss": "in gathering the darnel" }, { "words": ["w089", "w090", "w091", "w092", "w093", "w094"], "anchor": "w089", "gloss": "you also uproot the wheat along with it" }, { "words": ["w098", "w099"], "anchor": "w099", "gloss": "until the" }, { "words": ["w103", "w104"], "anchor": "w103", "gloss": "the time of harvest" }, { "words": ["w117", "w118", "w119"], "anchor": "w119", "gloss": "but gather the wheat" }, { "words": ["w121", "w122"], "anchor": "w121", "gloss": "my barn" }] }
