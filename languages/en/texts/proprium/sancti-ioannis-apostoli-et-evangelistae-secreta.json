  "text": "proprium.sancti-ioannis-apostoli-et-evangelistae-secreta",
  "about": "The secreta of the formulary “Saint John, Apostle and Evangelist” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Accept, O Lord, the gifts we bring You on the feast of him by whose patronage we trust to be set free. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w005", "w006", "w007", "w008"], "anchor": "w008", "gloss": "to You on his feast" }, { "words": ["w010", "w011", "w012", "w013", "w014"], "anchor": "w012", "gloss": "by whose patronage we trust to be delivered" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "our Lord" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "Jesus Christ" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "Your Son" }, { "words": ["w022", "w023", "w024", "w025", "w026"], "anchor": "w024", "gloss": "who lives and reigns with You" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w032", "w033", "w034", "w035"], "anchor": "w034", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
