  "text": "proprium.transfiguratio-domini-secreta",
  "about": "The secreta of the formulary “Transfiguration of Our Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Hallow our offerings, we beseech You, O Lord, through the glorious Transfiguration of Your only-begotten Son, and cleanse us from the stains of sins by the splendors of that same illumination. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w033", "w034"], "anchor": "w033", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever." },
    "s03": { "translation": "Amen." }
  },
