  "text": "proprium.assumptio-beatae-mariae-virginis-secreta",
  "about": "The secreta of the formulary “Assumption of the Blessed Virgin Mary” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "May the offering of our devotion rise to You, Lord, and through the intercession of the most Blessed Virgin Mary, assumed into heaven, may our hearts, kindled with the fire of love, continually reach toward You. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w005", "w006"], "anchor": "w006", "gloss": "of our devotion" }, { "words": ["w016", "w017"], "anchor": "w016", "gloss": "our hearts" }, { "words": ["w018", "w019", "w020"], "anchor": "w020", "gloss": "kindled with the fire of love" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "our Lord" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "Your Son" }, { "words": ["w032", "w033", "w034", "w035", "w036"], "anchor": "w034", "gloss": "who lives and reigns with You" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w042", "w043", "w044", "w045"], "anchor": "w044", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
