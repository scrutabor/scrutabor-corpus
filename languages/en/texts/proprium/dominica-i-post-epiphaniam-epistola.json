  "text": "proprium.dominica-i-post-epiphaniam-epistola",
  "about": "The epistola of the formulary “Mass of the First Sunday after Epiphany” in the 1962 Roman Missal. This formulary serves the weekdays of that week. On the Sunday itself the feast of the Holy Family takes its place.",
  "segments": {
    "s01": { "translation": "Brethren: I beseech you by the mercy of God that you present your bodies as a living sacrifice, holy and pleasing to God, your reasonable service. And do not be conformed to this world, but be reformed in the newness of your mind, that you may prove what is the will of God: good, acceptable, and perfect. For by the grace that is given me, I say to every one among you not to be more wise than it behooves to be wise, but to be wise with sobriety, according as God has divided to every one the measure of faith. For as in one body we have many members, yet all the members do not have the same office, so we, being many, are one body in Christ, and every one members one of another, in Christ Jesus our Lord.", "alignments": [{ "words": ["w009", "w010"], "anchor": "w009", "gloss": "your bodies" }, { "words": ["w011", "w012"], "anchor": "w011", "gloss": "a living sacrifice" }, { "words": ["w016", "w017", "w018"], "anchor": "w017", "gloss": "your reasonable service" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "of your mind" }, { "words": ["w041", "w042"], "anchor": "w041", "gloss": "For I say" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "is given" }, { "words": ["w071", "w072"], "anchor": "w071", "gloss": "For as" }, { "words": ["w082", "w083", "w084", "w085"], "anchor": "w085", "gloss": "do not have the same office" }, { "words": ["w101", "w102"], "anchor": "w101", "gloss": "our Lord" }] }
  },
