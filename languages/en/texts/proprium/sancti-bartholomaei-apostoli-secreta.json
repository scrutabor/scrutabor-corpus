  "text": "proprium.sancti-bartholomaei-apostoli-secreta",
  "about": "The secreta of the formulary “Saint Bartholomew the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We beseech You, O Lord, that we who keep the feast of Your blessed Apostle Bartholomew, may, by his help, obtain Your blessings, since we offer You this sacrifice of praise in his honor. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
