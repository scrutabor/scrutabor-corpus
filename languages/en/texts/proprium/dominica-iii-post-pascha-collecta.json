  "about": "The collecta of the formulary “Third Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who show the light of Your truth to those who err, so that they may be able to return to the way of justice: grant that all who are counted as Christians by their profession may reject what is hostile to that name and pursue what is fitting to it. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w048", "w049"], "anchor": "w048", "gloss": "of the Holy Spirit" }, { "words": ["w051", "w052", "w053", "w054"], "anchor": "w053", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
