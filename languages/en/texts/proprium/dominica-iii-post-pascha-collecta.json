  "text": "proprium.dominica-iii-post-pascha-collecta",
  "about": "The collecta of the formulary “Third Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, who show the light of Your truth to those who err, so that they may be able to return to the way of justice: grant that all who are counted as Christians by their profession may reject what is hostile to that name and pursue what is fitting to it. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w005", "w006", "w007", "w008", "w009"], "anchor": "w007", "gloss": "they may be able to return to the way of justice" }, { "words": ["w010", "w011", "w012"], "anchor": "w012", "gloss": "the light of Your truth" }, { "words": ["w017", "w018", "w019"], "anchor": "w019", "gloss": "are counted as Christians by their profession" }, { "words": ["w021", "w022"], "anchor": "w022", "gloss": "to reject those things" }, { "words": ["w023", "w024", "w025", "w026", "w027"], "anchor": "w025", "gloss": "which are hostile to this name" }, { "words": ["w029", "w030", "w031", "w032", "w033"], "anchor": "w033", "gloss": "to pursue those things which are fitting" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "our Lord" }, { "words": ["w039", "w040"], "anchor": "w039", "gloss": "Your Son" }, { "words": ["w041", "w042", "w043", "w044", "w045"], "anchor": "w043", "gloss": "who lives and reigns with You" }, { "words": ["w048", "w049"], "anchor": "w048", "gloss": "of the Holy Spirit" }, { "words": ["w051", "w052", "w053", "w054"], "anchor": "w053", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
