  "language": "en",
  "text": "proprium.cathedra-sancti-petri-secreta",
  "about": "The secreta of the formulary “Chair of Saint Peter the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We beseech You, O Lord, may the prayer of the blessed Apostle Peter recommend the petitions and offerings of Your Church, so that what we celebrate in his honor may obtain forgiveness for us.", "alignments": [{ "words": ["w021", "w022"], "anchor": "w022", "gloss": "unto forgiveness" }] },
    "s04": { "narrative": "The priest at once adds the commemoration of Saint Paul, who is always remembered together with Saint Peter. A single conclusion closes both prayers." },
    "s05": { "translation": "By the prayers of Your Apostle Paul, O Lord, sanctify the gifts of Your people, so that what is pleasing to You by Your own institution may become more pleasing still through the patronage of him who intercedes. Through our Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God," },
    "s02": { "translation": "world without end." },
    "s03": { "translation": "Amen." }
  },
