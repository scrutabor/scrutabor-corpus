  "about": "The introitus of the formulary “Second Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "The earth is full of the Lord’s mercy, alleluia; by the Lord’s word the heavens were established, alleluia, alleluia. Rejoice in the Lord, you righteous: praise befits the upright. Glory be to the Father, and to the Son, and to the Holy Spirit. As it was in the beginning, is now, and ever shall be, world without end. Amen. The earth is full of the Lord’s mercy, alleluia; by the Lord’s word the heavens were established, alleluia, alleluia.", "alignments": [{ "words": ["w001", "w002", "w003", "w004", "w005"], "anchor": "w005", "gloss": "the earth is full of the Lord’s mercy" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "by the Lord’s word" }, { "words": ["w010", "w011"], "anchor": "w010", "gloss": "were established" }, { "words": ["w018", "w019", "w020"], "anchor": "w019", "gloss": "praise befits the upright" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "to the Holy Spirit" }, { "words": ["w037", "w038", "w039"], "anchor": "w038", "gloss": "forever and ever" }, { "words": ["w041", "w042", "w043", "w044", "w045"], "anchor": "w045", "gloss": "the earth is full of the Lord’s mercy" }, { "words": ["w047", "w048"], "anchor": "w047", "gloss": "by the Lord’s word" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "were established" }] }
