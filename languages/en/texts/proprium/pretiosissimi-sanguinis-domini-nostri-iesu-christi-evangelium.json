  "segments": {
    "s01": { "translation": "At that time, when Jesus had taken the vinegar, He said: It is finished. And bowing His head, He gave up His spirit. The Jews therefore, since it was the Preparation day, in order that the bodies might not remain on the cross on the Sabbath — for that was a great Sabbath day — asked Pilate that their legs might be broken and that the bodies might be taken away. The soldiers therefore came, and they did break the legs of the first, and of the other who had been crucified with Him. But when they had come to Jesus and saw Him already dead, they did not break His legs; but one of the soldiers opened His side with a lance, and at once there came out blood and water. And he who saw it has borne witness, and his witness is true.", "alignments": [{ "words": ["w009", "w010"], "anchor": "w009", "gloss": "It is finished" }, { "words": ["w022", "w023"], "anchor": "w023", "gloss": "might not remain" }, { "words": ["w028", "w029", "w030", "w031", "w032", "w033"], "anchor": "w028", "gloss": "for that Sabbath day was great" }, { "words": ["w053", "w054"], "anchor": "w053", "gloss": "had been crucified" }, { "words": ["w067", "w068"], "anchor": "w067", "gloss": "did not break" }, { "words": ["w087", "w088"], "anchor": "w087", "gloss": "has borne witness" }] }
