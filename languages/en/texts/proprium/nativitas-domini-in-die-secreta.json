  "text": "proprium.nativitas-domini-in-die-secreta",
  "about": "The secreta of the formulary “Nativity of the Lord — Mass during the Day” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Sanctify, O Lord, the gifts offered, by the new birth of Your Only-begotten, and cleanse us from the stains of our sins. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w001", "w002", "w003"], "anchor": "w003", "gloss": "The offered gifts, O Lord," }, { "words": ["w004", "w005", "w006", "w007"], "anchor": "w007", "gloss": "by the new Nativity of Your Only-begotten" }, { "words": ["w010", "w011", "w012", "w013"], "anchor": "w013", "gloss": "from the stains of our sins" }, { "words": ["w016", "w017", "w018", "w019", "w020"], "anchor": "w017", "gloss": "this same Jesus Christ, our Lord" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "Your Son" }, { "words": ["w023", "w024", "w025", "w026", "w027"], "anchor": "w025", "gloss": "who lives and reigns with You" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w033", "w034", "w035", "w036"], "anchor": "w035", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
