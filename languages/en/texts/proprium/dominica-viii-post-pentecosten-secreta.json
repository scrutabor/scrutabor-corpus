  "text": "proprium.dominica-viii-post-pentecosten-secreta",
  "about": "The prayer traces the offered gifts to God's own generosity. It joins two petitions: that the sacred mysteries sanctify us in our conduct in this present life and lead us to everlasting joys, through the working power of His grace.",
  "segments": {
    "s01": { "translation": "Lord, we pray, accept the gifts we bring You from Your generosity, so that these most holy mysteries, through the working power of Your grace, may both sanctify us in the way we live this present life and lead us to everlasting joys. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w015", "w016", "w017", "w018"], "anchor": "w018", "gloss": "with the power of Your grace at work" }, { "words": ["w020", "w021", "w022", "w023"], "anchor": "w023", "gloss": "us in the conduct of this present life" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "everlasting joys" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "our Lord" }, { "words": ["w035", "w036"], "anchor": "w035", "gloss": "Your Son" }, { "words": ["w044", "w045"], "anchor": "w044", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w047", "w048", "w049", "w050"], "anchor": "w049", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
