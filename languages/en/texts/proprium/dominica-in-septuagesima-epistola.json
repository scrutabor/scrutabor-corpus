  "text": "proprium.dominica-in-septuagesima-epistola",
  "about": "The epistola of the formulary “Septuagesima Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Brothers: Do you not know that those who run in the stadium all run indeed, but one receives the prize? Run in this way, that you may obtain it. Everyone who competes in the games abstains from all things; they indeed do so to receive a perishable crown, but we an imperishable one. I therefore run in this way, not as though without a clear aim; I fight in this way, not as one beating the air, but I chastise my body and bring it into subjection, lest perhaps, after preaching to others, I myself should become disqualified. For I do not want you to be ignorant, brothers, that our fathers were all under the cloud, and all passed through the sea; and all were baptized in Moses, in the cloud and in the sea; and all ate the same spiritual food, and all drank the same spiritual drink — for they drank from the spiritual rock that followed them, and the rock was Christ — but God was not pleased with most of them.", "alignments": [{ "words": ["w001", "w002"], "anchor": "w002", "gloss": "Brothers: Do you not know" }, { "words": ["w020", "w021"], "anchor": "w020", "gloss": "But everyone" }, { "words": ["w023", "w024", "w025"], "anchor": "w025", "gloss": "competes in the games" }, { "words": ["w026", "w027", "w028", "w029"], "anchor": "w029", "gloss": "abstains from all things" }, { "words": ["w030", "w031", "w032", "w033", "w034", "w035", "w036"], "anchor": "w036", "gloss": "And they indeed do so to receive a perishable crown" }, { "words": ["w037", "w038", "w039"], "anchor": "w039", "gloss": "but we do so to receive an imperishable one" }, { "words": ["w041", "w042", "w043"], "anchor": "w043", "gloss": "therefore run in this way" }, { "words": ["w045", "w046", "w047"], "anchor": "w047", "gloss": "as though without a clear aim" }, { "words": ["w048", "w049"], "anchor": "w049", "gloss": "I fight in this way" }, { "words": ["w051", "w052", "w053"], "anchor": "w053", "gloss": "as one beating the air" }, { "words": ["w056", "w057"], "anchor": "w056", "gloss": "my body" }, { "words": ["w059", "w060", "w061"], "anchor": "w061", "gloss": "bring it into subjection" }, { "words": ["w064", "w065", "w066"], "anchor": "w066", "gloss": "after I have preached to others," }, { "words": ["w067", "w068", "w069"], "anchor": "w069", "gloss": "I myself should become disqualified" }, { "words": ["w070", "w071"], "anchor": "w070", "gloss": "For I do not want" }, { "words": ["w076", "w077", "w078", "w079", "w080", "w081"], "anchor": "w081", "gloss": "our fathers were all under the cloud" }, { "words": ["w084", "w085"], "anchor": "w085", "gloss": "passed through the sea" }, { "words": ["w088", "w089", "w090", "w091"], "anchor": "w090", "gloss": "were baptized in Moses" }, { "words": ["w099", "w100", "w101", "w102"], "anchor": "w102", "gloss": "ate the same spiritual food" }, { "words": ["w105", "w106", "w107", "w108"], "anchor": "w108", "gloss": "drank the same spiritual drink" }, { "words": ["w109", "w110"], "anchor": "w109", "gloss": "for they drank" }, { "words": ["w111", "w112", "w113", "w114", "w115"], "anchor": "w115", "gloss": "from the spiritual rock that followed them" }, { "words": ["w116", "w117", "w118", "w119"], "anchor": "w118", "gloss": "and the rock was Christ" }, { "words": ["w121", "w122", "w123", "w124", "w125", "w126", "w127"], "anchor": "w125", "gloss": "God was not pleased with most of them" }] }
  },
