  "text": "proprium.dominica-infra-octavam-nativitatis-evangelium",
  "about": "The evangelium of the formulary “Sunday within the Octave of the Nativity of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "At that time, Joseph and Mary, the Mother of Jesus, were wondering at those things which were spoken concerning Him. Simeon blessed them and said to Mary His Mother: Behold, this Child is set for the fall and for the resurrection of many in Israel, and for a sign which will be contradicted; and a sword will pierce your own soul, that the thoughts of many hearts may be revealed. There was also Anna, a prophetess, the daughter of Phanuel, of the tribe of Aser. She was far advanced in years and had lived with her husband seven years from her virginity; and she was a widow up to eighty-four years. She did not depart from the temple, serving with fastings and prayers night and day. Coming in at that same hour, she gave praise to the Lord and spoke of Him to all who looked for the redemption of Israel. When they had accomplished all things according to the law of the Lord, they returned into Galilee, to their city Nazareth. And the Child grew and became strong, full of wisdom, and the grace of God was in Him.", "alignments": [{ "words": ["w018", "w019", "w020"], "anchor": "w018", "gloss": "Simeon blessed them" }, { "words": ["w025", "w026"], "anchor": "w025", "gloss": "His Mother" }, { "words": ["w045", "w046", "w047", "w048", "w049"], "anchor": "w048", "gloss": "a sword will pierce your own soul" }, { "words": ["w068", "w069"], "anchor": "w068", "gloss": "many days" }, { "words": ["w073", "w074"], "anchor": "w073", "gloss": "her husband" }, { "words": ["w075", "w076"], "anchor": "w076", "gloss": "seven years" }, { "words": ["w078", "w079"], "anchor": "w078", "gloss": "her virginity" }, { "words": ["w083", "w084"], "anchor": "w084", "gloss": "up to" }, { "words": ["w085", "w086", "w087"], "anchor": "w085", "gloss": "eighty-four years" }, { "words": ["w089", "w090"], "anchor": "w090", "gloss": "did not depart" }, { "words": ["w123", "w124"], "anchor": "w123", "gloss": "returned" }, { "words": ["w128", "w129"], "anchor": "w128", "gloss": "their own city" }, { "words": ["w131", "w132"], "anchor": "w131", "gloss": "And the Child" }] }
  },
