  "text": "proprium.dominica-iv-post-pascha-collecta",
  "about": "The collecta of the formulary “Fourth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, You bring the minds of the faithful into one accord. Grant that Your peoples may love what You command and desire what You promise, so that amid the changes of the world our hearts may be fixed where true joys are. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w002", "w003", "w004", "w005", "w006", "w007"], "anchor": "w006", "gloss": "who brings the minds of the faithful into one accord" }, { "words": ["w009", "w010"], "anchor": "w009", "gloss": "Your peoples" }, { "words": ["w011", "w012", "w013", "w014"], "anchor": "w012", "gloss": "may love what You command" }, { "words": ["w015", "w016", "w017", "w018"], "anchor": "w016", "gloss": "and desire what You promise" }, { "words": ["w023", "w024", "w025", "w026", "w027"], "anchor": "w025", "gloss": "our hearts may be fixed there" }, { "words": ["w028", "w029", "w030", "w031"], "anchor": "w030", "gloss": "where true joys are" }, { "words": ["w032", "w033", "w034"], "anchor": "w033", "gloss": "Through our Lord" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "Your Son" }, { "words": ["w039", "w040", "w041"], "anchor": "w041", "gloss": "who lives with You" }, { "words": ["w044", "w045", "w046", "w047"], "anchor": "w045", "gloss": "in the unity of the Holy Spirit" }, { "words": ["w049", "w050", "w051", "w052"], "anchor": "w051", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
