  "text": "proprium.dominica-iv-post-pascha-collecta",
  "about": "The collecta of the formulary “Fourth Sunday after Easter” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, You bring the minds of the faithful into one accord. Grant that Your peoples may love what You command and desire what You promise, so that amid the changes of the world our hearts may be fixed where true joys are. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w003", "w004"], "anchor": "w004", "gloss": "the minds of the faithful" }, { "words": ["w005", "w006", "w007"], "anchor": "w006", "gloss": "make of one will" }, { "words": ["w009", "w010"], "anchor": "w009", "gloss": "Your peoples" }, { "words": ["w011", "w012"], "anchor": "w012", "gloss": "may love that" }, { "words": ["w015", "w016"], "anchor": "w016", "gloss": "desire that" }, { "words": ["w024", "w025", "w026", "w027"], "anchor": "w025", "gloss": "our hearts may be fixed" }, { "words": ["w029", "w030", "w031"], "anchor": "w030", "gloss": "true joys are" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "our Lord" }, { "words": ["w037", "w038"], "anchor": "w037", "gloss": "Your Son" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "of the Holy Spirit" }, { "words": ["w049", "w050", "w051", "w052"], "anchor": "w051", "gloss": "forever and ever" }] },
    "s02": { "translation": "Amen." }
  },
