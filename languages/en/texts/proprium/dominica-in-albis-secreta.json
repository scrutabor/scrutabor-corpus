  "text": "proprium.dominica-in-albis-secreta",
  "about": "The secreta of the formulary “Low Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Lord, we ask You to receive the gifts of the rejoicing Church and grant the fruit of perpetual joy to the Church to which You have given a cause of such great joy. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w013", "w014", "w015", "w016"], "anchor": "w015", "gloss": "grant the fruit of everlasting joy" }, { "words": ["w018", "w019"], "anchor": "w018", "gloss": "our Lord" }, { "words": ["w022", "w023"], "anchor": "w022", "gloss": "Your Son" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w034", "w035", "w036", "w037"], "anchor": "w036", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
