  "text": "proprium.dominica-iii-post-epiphaniam-epistola",
  "about": "The epistola of the formulary “Third Sunday after Epiphany” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "Brethren: Do not be wise in your own estimation. Repay no one evil for evil; take care to do what is good not only before God but also before all men. If it is possible, as far as it depends on you, have peace with all men. Do not avenge yourselves, dearly beloved, but give place to wrath; for it is written: Vengeance is Mine, I will repay, says the Lord. But if your enemy is hungry, feed him; if he is thirsty, give him a drink. For in doing this you will heap coals of fire upon his head. Do not be overcome by evil, but overcome evil with good.", "alignments": [{ "words": ["w005", "w006"], "anchor": "w006", "gloss": "in your own estimation" }, { "words": ["w007", "w008", "w009", "w010", "w011"], "anchor": "w007", "gloss": "repay no one evil for evil" }, { "words": ["w012", "w013"], "anchor": "w012", "gloss": "take care to do what is good" }, { "words": ["w024", "w025"], "anchor": "w025", "gloss": "it is possible" }, { "words": ["w026", "w027", "w028", "w029"], "anchor": "w026", "gloss": "as far as it depends on you" }, { "words": ["w030", "w031", "w032", "w033", "w034"], "anchor": "w030", "gloss": "have peace with all men" }, { "words": ["w035", "w036", "w037"], "anchor": "w035", "gloss": "Do not avenge yourselves" }, { "words": ["w043", "w044", "w045"], "anchor": "w043", "gloss": "For it is written" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "Vengeance is Mine" }, { "words": ["w054", "w055", "w056"], "anchor": "w054", "gloss": "your enemy is hungry" }, { "words": ["w061", "w062", "w063"], "anchor": "w061", "gloss": "give him a drink" }, { "words": ["w064", "w065", "w066"], "anchor": "w066", "gloss": "for in doing this" }, { "words": ["w067", "w068", "w069"], "anchor": "w067", "gloss": "you will heap coals of fire" }, { "words": ["w071", "w072"], "anchor": "w071", "gloss": "his head" }, { "words": ["w078", "w079", "w080", "w081"], "anchor": "w078", "gloss": "overcome evil with good" }] }
