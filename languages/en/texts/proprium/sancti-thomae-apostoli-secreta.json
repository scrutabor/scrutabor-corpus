  "text": "proprium.sancti-thomae-apostoli-secreta",
  "about": "The secreta of the formulary “Saint Thomas the Apostle” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "We render You, O Lord, the debt of our service, humbly entreating that by the prayers of blessed Thomas the Apostle, by whose venerable confession we offer You sacrifices of praise, You may guard Your gifts in us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,", "alignments": [{ "words": ["w004", "w005", "w006"], "anchor": "w005", "gloss": "of our service we render" }, { "words": ["w022", "w023", "w024"], "anchor": "w024", "gloss": "to You sacrifices of praise" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "our Lord" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "Jesus Christ" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "Your Son" }, { "words": ["w033", "w034", "w035", "w036", "w037"], "anchor": "w035", "gloss": "who lives and reigns with You" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "forever and ever.", "alignments": [{ "words": ["w043", "w044", "w045", "w046"], "anchor": "w045", "gloss": "forever and ever" }] },
    "s03": { "translation": "Amen." }
  },
