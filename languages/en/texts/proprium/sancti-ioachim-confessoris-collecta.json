  "text": "proprium.sancti-ioachim-confessoris-collecta",
  "about": "The collecta of the formulary “Saint Joachim, Confessor” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "translation": "O God, Who, in preference to Your other Saints, willed St. Joachim to be the father of Your Son’s Mother; grant, we beseech You, that we may ever enjoy the spiritual help of him whose feast we celebrate. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever.", "alignments": [{ "words": ["w041", "w042"], "anchor": "w041", "gloss": "of the Holy Spirit" }] },
    "s02": { "translation": "Amen." }
  },
