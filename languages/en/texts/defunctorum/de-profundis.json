  "text": "defunctorum.de-profundis",
  "about": "Psalm 129 in Vulgate numbering (Psalm 130 in Hebrew numbering), traditionally prayed for the dead. Its Latin is the Gallican psalter, the version the Roman liturgy prays.",
  "segments": {
    "s001": { "translation": "From the depths I called out to You, O Lord." },
    "s002": { "translation": "Lord, hear my voice." },
    "s003": { "translation": "May Your ears listen closely to my pleading voice." },
    "s004": { "translation": "If You take note of iniquities, O Lord, Lord, who could stand?" },
    "s005": { "translation": "For with You there is forgiveness; for the sake of Your law I have waited for You, O Lord." },
    "s006": { "translation": "My soul has waited for His word; my soul has hoped in the Lord." },
    "s007": { "translation": "From the morning watch until night, let Israel hope in the Lord." },
    "s008": { "translation": "For mercy is with the Lord, and abundant redemption is with Him." },
    "s009": { "translation": "And He Himself will redeem Israel from all its iniquities." }
  },
