  "text": "defunctorum.requiem-aeternam",
  "about": "The brief suffrage for the faithful departed, in the Latin of the 1952 Enchiridion Indulgentiarum. It asks eternal rest and perpetual light for them, and closes with the wish that they rest in peace.",
  "segments": {
    "s001": { "translation": "Eternal rest grant unto them, O Lord, and let perpetual light shine upon them.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 281–282", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s002": { "translation": "May they rest in peace.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 282", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s003": { "translation": "Amen." }
  },
