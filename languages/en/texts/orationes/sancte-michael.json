  "language": "en",
  "text": "orationes.sancte-michael",
  "about": "The prayer Leo XIII composed for the prayers said after low Mass, where it stands after the collect. It asks Saint Michael the Archangel to defend us in battle against the wickedness and snares of the devil. It then prays that God may rebuke the devil, and again addresses Saint Michael, as prince of the heavenly host, asking him by the power of God to cast Satan and the other evil spirits into hell.",
  "segments": {
    "s01": { "translation": "Saint Michael the Archangel, defend us in battle. Be our protection against the wickedness and snares of the devil.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 140–141", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s02": { "translation": "May God rebuke him, we humbly pray.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 140–141", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s03": { "translation": "And do thou, O Prince of the heavenly hosts, by the power of God, thrust into hell Satan, and all the evil spirits, who prowl about the world seeking the ruin of souls. Amen.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 140–141", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] }
  },
