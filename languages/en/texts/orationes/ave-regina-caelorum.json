  "text": "orationes.ave-regina-caelorum",
  "about": "The Ave Regina Caelorum is the final Marian antiphon for the season from the Purification of the Blessed Virgin Mary into Holy Week. In successive salutations the faithful call Mary Queen of the heavens, Lady of the Angels, the root and gate from whom the Light arose for the world, and finally ask her to intercede with Christ.",
  "segments": {
    "s01": { "translation": "Hail, Queen of the heavens,", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 592–593", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 189 and 191", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s02": { "translation": "hail, Lady of the Angels:", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 592–593", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 189 and 191", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s03": { "translation": "hail, root, hail, gate,", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 592–593", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 189 and 191", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s04": { "translation": "from whom the Light arose for the world:", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 592–593", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 189 and 191", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s05": { "translation": "rejoice, glorious Virgin,", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 592–593", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 189 and 191", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s06": { "translation": "beautiful above all,", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 592–593", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 189 and 191", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s07": { "translation": "farewell, O exceedingly comely,", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 592–593", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 189 and 191", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s08": { "translation": "and entreat Christ for us.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 592–593", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 189 and 191", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] }
  },
