  "text": "orationes.memorare",
  "about": "The Memorare is a Marian prayer of supplication. It recalls the confidence that no one who sought Mary's protection, implored her help, and asked her intercession was abandoned. Inspired by that confidence, the sinner stands before the Mother of the Word and asks her graciously to hear and heed the speaker's words.",
  "segments": {
    "s01": { "translation": "Remember, O most gracious Virgin Mary, that it has never been heard", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 588", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 196, printed p. 175", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s02": { "translation": "that anyone who runs to your protection, implores your help, and seeks your intercession was abandoned.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 588", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 196, printed p. 175", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s03": { "translation": "Inspired by this confidence, I run to you, O Virgin of virgins and Mother;", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 588", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 196, printed p. 175", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s04": { "translation": "I come to you; before you I stand, a grieving sinner.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 588", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 196, printed p. 175", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s05": { "translation": "O Mother of the Word, do not despise my words,", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 588", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 196, printed p. 175", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s06": { "translation": "but hear them graciously and heed them.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 588", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 196, printed p. 175", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s07": { "translation": "Amen." }
  },
