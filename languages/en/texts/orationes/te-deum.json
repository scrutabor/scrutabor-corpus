  "text": "orationes.te-deum",
  "about": "The Te Deum is an ancient hymn of praise and thanksgiving. In it the Church confesses the majesty of the Holy Trinity, addresses Christ as King of glory and Judge, and then asks for salvation, protection and mercy. This edition retains the full traditional Roman text through its final act of trust.",
  "segments": {
    "s01": { "translation": "We praise Thee, O God; we acknowledge Thee to be the Lord.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s02": { "translation": "Thee, the Father everlasting, all the earth doth worship.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s03": { "translation": "To Thee all Angels; to Thee the heavens and all the Powers:", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s04": { "translation": "to Thee the Cherubim and Seraphim continually cry:", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s05": { "translation": "Holy, holy, holy, Lord God of Sabaoth.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s06": { "translation": "Heaven and earth are full of the majesty of Thy glory.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s07": { "translation": "Thee, the glorious choir of the Apostles; Thee, the admirable company of the Prophets,", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s08": { "translation": "Thee, the white-robed army of the Martyrs, doth praise.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s09": { "translation": "Thee throughout the world", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s10": { "translation": "the holy Church doth acknowledge:", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s11": { "translation": "the Father of infinite majesty; Thy adorable, true and only Son;", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s12": { "translation": "also the Holy Ghost, the Comforter. Thou, O Christ, art the King of glory.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s13": { "translation": "Thou art the everlasting Son of the Father. When Thou didst take upon Thee to deliver man,", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s14": { "translation": "Thou didst not disdain the Virgin's womb.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s15": { "translation": "Having overcome the sting of death,", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s16": { "translation": "Thou didst open the kingdom of heaven to all believers.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s17": { "translation": "Thou sittest at the right hand of God, in the glory of the Father.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s18": { "translation": "We believe that Thou shalt come to be our Judge.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s19": { "translation": "We therefore pray Thee to help Thy servants,", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s20": { "translation": "whom Thou hast redeemed with Thy Precious Blood.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s21": { "translation": "Make them to be numbered with Thy Saints in glory everlasting.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s22": { "translation": "Save Thy people, O Lord, and bless Thy inheritance.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s23": { "translation": "Govern them, and raise them up for ever.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s24": { "translation": "Every day we bless Thee.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s25": { "translation": "and we praise Thy name for ever, yea, for ever and ever.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s26": { "translation": "Vouchsafe, O Lord, this day to keep us without sin.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s27": { "translation": "Have mercy on us, O Lord, have mercy on us. Let Thy mercy, O Lord, be upon us, as we have hoped in Thee.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] },
    "s28": { "translation": "In Thee, O Lord, have I hoped; I shall not be confounded for ever.", "translation_citations": [{ "title": "Blessed Be God (1925)", "locator": "printed pp. 500–501", "url": "https://commons.wikimedia.org/wiki/File:Blessedbegodcomp00call.pdf" }, { "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. XCIV–XCV", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }] }
  },
