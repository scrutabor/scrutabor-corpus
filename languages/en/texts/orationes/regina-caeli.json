{
  "schema_version": "0.18.0",
  "language": "en",
  "text": "orationes.regina-caeli",
  "about": "The Marian antiphon of Paschaltide, which stands from Compline of Holy Saturday to the Saturday after Pentecost and takes the place of the Ángelus in that season. It calls the Blessed Virgin Mary to rejoice in the resurrection of her Son and asks her to pray for us. A versicle and response follow the antiphon, professing that the Lord has truly risen.",
  "segments": {
    "s01": { "translation": "Queen of heaven, rejoice, alleluia;", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 28", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s02": { "translation": "for He whom you did merit to bear, alleluia,", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 28", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s03": { "translation": "has risen, as He said, alleluia.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 28", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s04": { "translation": "Pray for us to God, alleluia.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 28", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s05": { "translation": "Rejoice and be glad, O Virgin Mary, alleluia.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 28", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s06": { "translation": "For the Lord has truly risen, alleluia.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 29 and 193", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] }
  },
