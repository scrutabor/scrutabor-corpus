  "text": "orationes.angele-dei",
  "about": "The Angele Dei is an individual prayer to the Guardian Angel. The speaker acknowledges having been entrusted to the angel by heavenly mercy and asks in order to be enlightened, guarded, ruled, and guided.",
  "segments": {
    "s01": { "translation": "Angel of God,", "translation_citations": [{ "title": "The Raccolta (1910)", "locator": "printed p. 267", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s02": { "translation": "who are my guardian,", "translation_citations": [{ "title": "The Raccolta (1910)", "locator": "printed p. 267", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s03": { "translation": "me, entrusted to you", "translation_citations": [{ "title": "The Raccolta (1910)", "locator": "printed p. 267", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s04": { "translation": "by heavenly mercy,", "translation_citations": [{ "title": "The Raccolta (1910)", "locator": "printed p. 267", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s05": { "translation": "enlighten, guard,", "translation_citations": [{ "title": "The Raccolta (1910)", "locator": "printed p. 267", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s06": { "translation": "rule and guide. Amen.", "translation_citations": [{ "title": "The Raccolta (1910)", "locator": "printed p. 267", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] }
  },
