  "about": "The invocation that closes the prayers of Leo XIII, added to them in 1904 under Pius X. It is said three times. This edition prints it once.",
  "segments": {
    "s01": { "translation": "Most Sacred Heart of Jesus.", "translation_citations": [{ "title": "The Raccolta (1910)", "locator": "printed p. 89", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s02": { "translation": "Have mercy on us.", "translation_citations": [{ "title": "The Raccolta (1910)", "locator": "printed p. 89", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] }
  },
  "words": {
    "w001": { "gloss": "Heart", "explanation": "A neuter has one form for naming and for address, and this edition reads the opening cry as a nominative naming, as in “Agnus Dei”." },
