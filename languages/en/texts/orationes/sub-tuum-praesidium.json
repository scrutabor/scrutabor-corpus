  "text": "orationes.sub-tuum-praesidium",
  "about": "The basic form is the antiphon ending “O glorious and blessed Virgin”: a prayer for Mary’s protection, for the petitions of the faithful to be heard, and for deliverance from danger. In the extended form often used in Poland, it is followed by the invocations beginning “Our Lady…” and further petitions. Beyond Polish prayer books that continuation is attested in the act of entrustment John Paul II made at Jasna Góra in 1991, where two of the titles stand in the other order.",
  "segments": {
    "s01": { "translation": "We fly to thy protection, O holy Mother of God; despise not our petitions in our necessities, but deliver us always from all dangers, O glorious and blessed Virgin.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 52", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed p. 40", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s02": { "translation": "Our Lady, our Mediatrix, our Advocate, our Comforter.", "alignments": [{ "words": ["w025", "w026"], "anchor": "w025", "gloss": "Our Lady" }, { "words": ["w027", "w028"], "anchor": "w027", "gloss": "our Mediatrix" }, { "words": ["w029", "w030"], "anchor": "w029", "gloss": "our Advocate" }, { "words": ["w031", "w032"], "anchor": "w031", "gloss": "our Comforter" }] },
    "s03": { "translation": "Reconcile us with thy Son, commend us to thy Son, present us to thy Son.", "alignments": [{ "words": ["w033", "w034"], "anchor": "w034", "gloss": "with your Son" }, { "words": ["w037", "w038"], "anchor": "w038", "gloss": "to your Son" }, { "words": ["w041", "w042"], "anchor": "w042", "gloss": "to your Son" }] },
    "s04": { "translation": "Amen." }
  },
