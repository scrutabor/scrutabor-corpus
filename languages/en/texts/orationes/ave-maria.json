{
  "schema_version": "0.16.0",
  "language": "en",
  "text": "orationes.ave-maria",
  "about": "The first part of the Hail Mary joins Gabriel's words (Lk 1:28) to Elizabeth's (Lk 1:42), and neither verse carries the names Maria and Iesus that the prayer supplies. The second part, the petition addressed to Mary, is of the sixteenth century.",
  "segments": {
    "s01": { "translation": "Hail Mary, full of grace, the Lord is with thee, blessed art thou among women, and blessed is the fruit of thy womb, Jesus.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 9–10", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s02": { "translation": "Holy Mary, Mother of God, pray for us sinners, now and at the hour of our death. Amen.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 10", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] }
  },
  "words": {
    "w001": { "gloss": "hail", "function": "The angel's greeting in Lk 1:28." },
    "w002": { "gloss": "Mary" },
    "w003": { "gloss": "with grace", "function": "Ablative complement of “plena” (w004)." },
    "w004": { "gloss": "full", "function": "Agrees with “María” (w002) and takes “grátia” (w003)." },
    "w005": { "gloss": "the Lord", "function": "Subject with an understood “est”: the Lord [is] with thee." },
    "w006": { "gloss": "with thee", "function": "A combination of “te” and “cum”. With personal pronouns, “cum” follows the pronoun." },
    "w007": { "gloss": "blessed", "function": "“Benedícta [es] tu” — with “es” understood." },
    "w008": { "gloss": "thou" },
    "w009": { "gloss": "among" },
    "w010": { "gloss": "women" },
    "w011": { "gloss": "and" },
    "w012": { "gloss": "blessed", "function": "Masculine in agreement with “fructus” (w013)." },
    "w013": { "gloss": "fruit" },
    "w014": { "gloss": "of the womb", "function": "A genitive dependent on “fructus” (w013)." },
    "w015": { "gloss": "thy", "function": "Agrees with “ventris” (w014)." },
    "w016": { "gloss": "Jesus", "function": "Apposition to “fructus” (w013): the fruit… — Iesus." },
    "w017": { "gloss": "Holy", "function": "Agrees with “María” (w018)." },
    "w018": { "gloss": "Mary" },
    "w019": { "gloss": "Mother", "function": "Apposition to “María” (w018)." },
    "w020": { "gloss": "of God", "function": "Genitive dependent on “Mater”: Mother of God." },
    "w021": { "gloss": "pray" },
    "w022": { "gloss": "for" },
    "w023": { "gloss": "us", "function": "Ablative after “pro” (w022)." },
    "w024": { "gloss": "sinners", "function": "Apposition to “nobis” (w023)." },
    "w025": { "gloss": "now" },
    "w026": { "gloss": "and" },
    "w027": { "gloss": "at" },
    "w028": { "gloss": "the hour", "function": "Ablative after “in” (w027) in a temporal phrase." },
    "w029": { "gloss": "of death", "function": "Genitive dependent on “hora” (w028)." },
    "w030": { "gloss": "our", "function": "Agrees with “mortis” (w029)." },
    "w031": { "gloss": "amen" }
  }
