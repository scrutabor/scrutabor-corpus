{
  "schema_version": "0.18.0",
  "language": "en",
  "text": "orationes.symbolum-apostolorum",
  "about": "The Apostles’ Creed is the ancient baptismal symbol of the Church of Rome, traditionally arranged in twelve articles. In the first person it professes faith in God the Father, Jesus Christ, and the Holy Spirit, and then professes the Church, forgiveness of sins, resurrection of the body, and everlasting life. This recension retains a repeated Credo before the articles concerning the Holy Spirit.",
  "segments": {
    "s01": { "translation": "I believe in God, the Father Almighty, Creator of heaven and earth;", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 2", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 10–11", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s02": { "translation": "and in Jesus Christ, His only Son, our Lord:", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 2", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 10–11", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s03": { "translation": "who was conceived by the Holy Spirit, born of the Virgin Mary,", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 2", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 10–11", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s04": { "translation": "suffered under Pontius Pilate, was crucified; died, and was buried.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 2", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 10–11", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s05": { "translation": "He descended into hell;", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 2", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 10–11", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s06": { "translation": "the third day He rose again from the dead;", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 2", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 10–11", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s07": { "translation": "He ascended into heaven,", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 2", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 10–11", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s08": { "translation": "sits at the right hand of God the Father Almighty;", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 2", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 10–11", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s09": { "translation": "from thence He shall come to judge the living and the dead.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 2", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 10–11", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s10": { "translation": "I believe in the Holy Spirit,", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 2", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 10–11", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s11": { "translation": "the Holy Catholic Church, the communion of Saints,", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 2", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 10–11", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s12": { "translation": "the forgiveness of sins, the resurrection of the body, and the life everlasting. Amen.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "printed p. 2", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 10–11", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] }
  },
