{
  "schema_version": "0.17.0",
  "language": "en",
  "text": "orationes.angelus-domini",
  "about": "The Ángelus is prayed three times a day, at dawn, at noon and toward evening, and this edition prints the three Hail Marys said in it. In Paschaltide the Regína cæli takes its place.",
  "segments": {
    "s01": { "translation": "The Angel of the Lord declared unto Mary.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 26", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s02": { "translation": "And she conceived of the Holy Spirit.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 26", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "ave1": { "translation": "Hail Mary, full of grace, the Lord is with thee, blessed art thou among women, and blessed is the fruit of thy womb, Jesus. Holy Mary, Mother of God, pray for us sinners, now and at the hour of our death. Amen.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 9–10 and 26–27", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s04": { "translation": "Behold the handmaid of the Lord.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 27", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s05": { "translation": "Be it done unto me according to thy word.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 27", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "ave2": { "translation": "Hail Mary, full of grace, the Lord is with thee, blessed art thou among women, and blessed is the fruit of thy womb, Jesus. Holy Mary, Mother of God, pray for us sinners, now and at the hour of our death. Amen.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 9–10 and 26–27", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s07": { "translation": "And the Word was made flesh.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 27", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s08": { "translation": "And dwelt among us.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 27", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "ave3": { "translation": "Hail Mary, full of grace, the Lord is with thee, blessed art thou among women, and blessed is the fruit of thy womb, Jesus. Holy Mary, Mother of God, pray for us sinners, now and at the hour of our death. Amen.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 9–10 and 26–27", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s10": { "translation": "Pray for us, O holy Mother of God.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 26", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s11": { "translation": "That we may be made worthy of the promises of Christ.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 26", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s12": { "translation": "Let us pray.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 27", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s13": { "translation": "Pour forth, we beseech thee, O Lord, thy grace into our hearts; that we, to whom the Incarnation of Christ, thy Son, was made known by the message of an angel, may by his Passion and Cross be brought to the glory of his Resurrection. Through the same Christ, our Lord. Amen.", "translation_citations": [{ "title": "Patrick Francis Moran, The Catholic Prayer Book (1883)", "locator": "printed p. 11", "url": "https://commons.wikimedia.org/wiki/File:The_Catholic_prayer_book.djvu" }] }
  },
