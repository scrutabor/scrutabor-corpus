  "text": "orationes.alma-redemptoris-mater",
  "about": "The Alma Redemptoris Mater is the final Marian antiphon for the season from Advent through the Purification of the Blessed Virgin Mary. The faithful ask Mary, Mother of the Redeemer, to help the falling people and have mercy on sinners.",
  "segments": {
    "s01": { "translation": "Loving Mother of the Redeemer, who remain the open gate of heaven,", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 590–591", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 183 and 185", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s02": { "translation": "and star of the sea, help the people who are falling,", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 590–591", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 183 and 185", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s03": { "translation": "yet strive to rise:", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 590–591", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 183 and 185", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s04": { "translation": "you who, while nature marvelled, gave birth to your holy Creator,", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 590–591", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 183 and 185", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s05": { "translation": "Virgin before and afterward,", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 590–591", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 183 and 185", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s06": { "translation": "receiving that Ave from Gabriel's mouth, have mercy on sinners.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed pp. 590–591", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 183 and 185", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] }
  },
