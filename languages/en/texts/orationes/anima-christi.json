{
  "schema_version": "0.17.0",
  "language": "en",
  "text": "orationes.anima-christi",
  "about": "The Anima Christi is a Christ-centered devotional prayer built from brief invocations. It asks Christ's soul, body, blood, the water from his side, and his Passion for sanctification, salvation, inebriation, cleansing, and strength, and asks Jesus to hear, hide the speaker within his wounds, defend, call at the hour of death, and receive the speaker into everlasting praise with the saints.",
  "segments": {
    "s01": { "translation": "Soul of Christ, sanctify me.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s02": { "translation": "Body of Christ, save me.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s03": { "translation": "Blood of Christ, inebriate me.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s04": { "translation": "Water from the side of Christ, wash me.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s05": { "translation": "Passion of Christ, strengthen me.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s06": { "translation": "O good Jesus, hear me.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s07": { "translation": "Within your wounds hide me.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s08": { "translation": "Do not permit me to be separated from you.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s09": { "translation": "Defend me from the evil enemy.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s10": { "translation": "At the hour of my death, call me.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s11": { "translation": "And bid me come to you,", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s12": { "translation": "that I may praise you with your saints", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s13": { "translation": "for ever and ever. Amen.", "translation_citations": [{ "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 448", "url": "https://archive.org/details/catholicgirlsgui00lasa" }, { "title": "The Raccolta (1910)", "locator": "n. 95, printed pp. 79–80", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] }
  },
