{
  "schema_version": "0.18.0",
  "language": "en",
  "text": "orationes.salve-regina",
  "about": "The Marian antiphon said after low Mass in the prayers of Leo XIII, and at Compline through the long season after Pentecost. It addresses the Blessed Virgin Mary as Queen and Mother of mercy, and the banished children of Eve ask her to turn her merciful eyes toward them and, after this exile, to show them Jesus. A versicle and response follow the antiphon.",
  "segments": {
    "s01": { "translation": "Hail, holy Queen, Mother of mercy, our life, our sweetness and our hope.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 25–26", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s02": { "translation": "To thee do we cry, poor banished children of Eve.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 25–26", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s03": { "translation": "To thee do we send up our sighs, mourning and weeping in this valley of tears.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 25–26", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s04": { "translation": "Turn, then, most gracious Advocate, thine eyes of mercy toward us.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 25–26", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s05": { "translation": "And after this our exile show unto us the blessed fruit of thy womb, Jesus.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 25–26", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s06": { "translation": "O clement, O loving, O sweet Virgin Mary.", "translation_citations": [{ "title": "The Raccolta (1910)", "locator": "printed p. 167", "url": "https://archive.org/details/theraccoltaorcol00unknuoft" }] },
    "s07": { "translation": "Pray for us, O holy Mother of God.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 25–26", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s08": { "translation": "That we may be made worthy of the promises of Christ.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 25–26", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] }
  },
