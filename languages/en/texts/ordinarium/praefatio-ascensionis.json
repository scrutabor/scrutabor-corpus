  "text": "ordinarium.praefatio-ascensionis",
  "about": "The Preface used in the season of the formulary “Ascension of the Lord” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere, O Lord, holy Father, almighty eternal God, through Christ our Lord. He, after His Resurrection, appeared openly to all His disciples and, while they beheld Him, was raised up into heaven, that He might grant us to be partakers of His divinity. And therefore with Angels and Archangels, with Thrones and Dominions, and with all the host of the heavenly army, we sing the hymn of Your glory, evermore saying:", "alignments": [{ "words": ["w024", "w025"], "anchor": "w024", "gloss": "our Lord" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "His resurrection" }, { "words": ["w030", "w031", "w032"], "anchor": "w031", "gloss": "to all His disciples" }, { "words": ["w038", "w039"], "anchor": "w039", "gloss": "was raised up" }, { "words": ["w042", "w043", "w044", "w045", "w046", "w047", "w048"], "anchor": "w046", "gloss": "that He might grant us a share in His divinity" }, { "words": ["w065", "w066"], "anchor": "w065", "gloss": "of Your glory" }] }
  },
