  "text": "ordinarium.praefatio-sanctae-crucis",
  "about": "The Preface of the Holy Cross. It praises the saving tree of the Cross, where the source of death became the source of life and the victor by a tree was overcome upon a tree.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:" },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "You established the salvation of mankind upon the tree of the Cross, so that from where death arose, from there life might rise again, and that he who conquered by a tree might also be conquered by a tree: through Christ our Lord." },
    "s05": { "translation": "Through Him the Angels praise Your majesty, the Dominions adore it, and the Powers tremble before it." },
    "s06": { "translation": "The heavens, the heavenly Virtues, and the blessed Seraphim join in joyful celebration of Your majesty." },
    "s07": { "translation": "We beseech You to admit our voices to join theirs as we speak in humble confession:", "alignments": [{ "words": ["w069", "w070", "w071", "w072", "w073", "w074", "w075", "w076", "w077"], "anchor": "w077", "gloss": "We pray that You command our voices also to be admitted with them" }, { "words": ["w078", "w079", "w080"], "anchor": "w080", "gloss": "saying in humble confession" }] }
  },
