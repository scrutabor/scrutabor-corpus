  "text": "ordinarium.communicantes-in-ascensione-domini",
  "about": "The priest prays this portion of the Canon quietly, in communion with the Church. This form is prescribed for the feast of the Ascension and recalls the human nature united to the Son being placed at the right hand of the Father’s glory. After commemorating the saints, he asks the Father for His protection through Christ.",
  "segments": {
    "s01": { "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w005", "gloss": "celebrate the most sacred day" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "our Lord" }, { "words": ["w009", "w010", "w011"], "anchor": "w010", "gloss": "Your Only-begotten Son" }, { "words": ["w012", "w013", "w014", "w015", "w016", "w017", "w018", "w019", "w020", "w021"], "anchor": "w021", "gloss": "placed our frail human nature, united to Himself, at the right hand of Your glory" }], "translation": "We are in communion and celebrate the most sacred day, on which our Lord, Your Only-begotten Son, placed our frail human nature, united to Himself, at the right hand of Your glory," },
    "s02": { "alignments": [{ "words": ["w022", "w023"], "anchor": "w022", "gloss": "and also" }, { "words": ["w024", "w025"], "anchor": "w025", "gloss": "we venerate the memory" }, { "words": ["w026", "w027"], "anchor": "w027", "gloss": "first of all" }, { "words": ["w029", "w030"], "anchor": "w030", "gloss": "ever-Virgin" }], "translation": "and we also venerate the memory, first of all, of the glorious ever-Virgin" },
    "s03": { "narrative": "The priest bows his head." },
    "s04": { "alignments": [{ "words": ["w036", "w037"], "anchor": "w036", "gloss": "our Lord" }], "translation": "Mary, Mother of the same God and our Lord" },
    "s05": { "narrative": "The priest bows his head." },
    "s06": { "translation": "Jesus Christ;" },
    "s07": { "alignments": [{ "words": ["w040", "w041"], "anchor": "w040", "gloss": "and also" }, { "words": ["w044", "w045", "w046"], "anchor": "w046", "gloss": "Spouse of the same Virgin" }], "translation": "and also of blessed Joseph, Spouse of the same Virgin," },
    "s08": { "alignments": [{ "words": ["w048", "w049", "w050", "w051", "w052"], "anchor": "w049", "gloss": "of Your blessed Apostles and Martyrs" }], "translation": "and of Your blessed Apostles and Martyrs: Peter and Paul, Andrew, James, John, Thomas, James, Philip, Bartholomew, Matthew, Simon and Thaddeus;" },
    "s09": { "translation": "Linus, Cletus, Clement, Sixtus, Cornelius, Cyprian, Lawrence, Chrysogonus, John and Paul, Cosmas and Damian;" },
    "s10": { "alignments": [{ "words": ["w082", "w083", "w084"], "anchor": "w083", "gloss": "of all Your saints" }, { "words": ["w090", "w091"], "anchor": "w091", "gloss": "in all things" }, { "words": ["w092", "w093", "w094", "w095"], "anchor": "w094", "gloss": "we may be defended by the help of Your protection" }], "translation": "and of all Your saints. Through their merits and prayers, grant that in all things we may be defended by the help of Your protection." },
    "s11": { "narrative": "The priest joins his hands." },
    "s12": { "alignments": [{ "words": ["w099", "w100"], "anchor": "w099", "gloss": "our Lord" }], "translation": "Through the same Christ, our Lord. Amen." }
  },
  "words": {
    "w001": { "gloss": "We are in communion", "explanation": "The communion of the praying Church includes the commemoration of Mary and the saints whose names follow in this prayer." },
    "w002": { "gloss": "and" },
    "w003": {  },
    "w004": {  },
    "w005": { "explanation": "The Son placed the human nature united to Himself at the right hand of the Father’s glory. Frailty describes our human nature." },
    "w006": { "gloss": "on which" },
