  "language": "en",
  "text": "ordinarium.gloria",
  "about": "The hymn begins with the song of the angels at the birth of Christ. It praises God the Father and then addresses Jesus Christ, the only-begotten Son and Lamb of God, asking Him to have mercy on us and receive our prayer. It ends by professing the glory of Christ with the Holy Spirit in the glory of God the Father.",
  "segments": {
    "s01": { "narrative": "At the middle of the altar, the priest extends and joins his hands, bows his head slightly and, if the hymn is to be said, begins it with “Glória in excélsis Deo”, continuing with hands joined. The priest bows his head to the cross at Deo, at Adorámus te, at Grátias ágimus tibi, at both Iesu Christe and at Súscipe deprecatiónem nostram, and signs himself from forehead to breast at Cum Sancto Spíritu." },
    "s02": { "translation": "Glory to God in the highest.", "translation_citations": [{ "title": "Douay-Rheims Bible (Challoner)", "locator": "Luke 2:14 (1914 edition, New Testament p. 67)", "url": "https://commons.wikimedia.org/wiki/File:The_Holy_Bible_-_Douay_Rheims_Version.pdf" }] },
    "s03": { "translation": "And on earth, peace for people of good will." },
    "s04": { "translation": "We praise You. We bless You. We adore You. We glorify You.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "pp. 65–66", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s05": { "translation": "We give You thanks for Your great glory.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "p. 65", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s06": { "translation": "Lord God, King of heaven, almighty God and Father." },
    "s07": { "translation": "Lord Jesus Christ, Only Begotten Son." },
    "s08": { "translation": "Lord God, Lamb of God, Son of the Father.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "p. 65", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s09": { "translation": "You who take away the sins of the world, have mercy on us.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "p. 65", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s10": { "translation": "You who take away the sins of the world, receive our supplication." },
    "s11": { "translation": "You who sit at the Father's right hand, have mercy on us.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "p. 66", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s12": { "translation": "For You alone are holy. You alone are Lord. You alone are Most High, Jesus Christ.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "p. 66", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s13": { "translation": "With the Holy Spirit in the glory of God the Father. Amen.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "p. 66", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] }
  },
