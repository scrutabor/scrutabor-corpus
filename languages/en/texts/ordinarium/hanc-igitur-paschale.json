  "language": "en",
  "text": "ordinarium.hanc-igitur-paschale",
  "about": "The priest holds his hands over the gifts and quietly prays this portion of the Canon for those whom God has regenerated from water and the Holy Spirit. The same form is prescribed in both the Easter and Pentecost periods: from the Easter Vigil or Pentecost Vigil through the Saturday of the corresponding octave.",
  "segments": {
    "s01": { "narrative": "Holding his outstretched hands over the gifts, the priest says:" },
    "s02": { "alignments": [{ "words": ["w001", "w002", "w003"], "anchor": "w003", "gloss": "Therefore this offering" }, { "words": ["w004", "w005"], "anchor": "w004", "gloss": "of our service" }, { "words": ["w006", "w007"], "anchor": "w006", "gloss": "and also" }, { "words": ["w008", "w009", "w010"], "anchor": "w009", "gloss": "of Your entire family" }], "translation": "Therefore this offering of our service, and also of Your entire family," },
    "s03": { "alignments": [{ "words": ["w012", "w013"], "anchor": "w013", "gloss": "we offer to You" }, { "words": ["w014", "w015", "w016"], "anchor": "w015", "gloss": "also on behalf of those" }, { "words": ["w018", "w019", "w020"], "anchor": "w019", "gloss": "You graciously regenerated" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "the Holy Spirit" }, { "words": ["w029", "w030"], "anchor": "w030", "gloss": "of all sins" }], "translation": "which we offer to You also on behalf of those whom You graciously regenerated from water and the Holy Spirit, granting them remission of all sins," },
    "s04": { "alignments": [{ "words": ["w033", "w034", "w035"], "anchor": "w035", "gloss": "that You graciously accept" }], "translation": "we ask, Lord, that You graciously accept," },
    "s05": { "alignments": [{ "words": ["w036", "w037", "w038", "w039", "w040", "w041"], "anchor": "w041", "gloss": "and order our days in Your peace" }, { "words": ["w043", "w044", "w045", "w046", "w047", "w048", "w049", "w050", "w051", "w052", "w053", "w054"], "anchor": "w052", "gloss": "command that we be rescued from eternal condemnation and counted in the flock of Your chosen" }], "translation": "and order our days in Your peace, and command that we be rescued from eternal condemnation and counted in the flock of Your chosen." },
    "s06": { "narrative": "The priest joins his hands." },
    "s07": { "alignments": [{ "words": ["w057", "w058"], "anchor": "w057", "gloss": "our Lord" }], "translation": "Through Christ, our Lord. Amen." }
  },
