  "text": "ordinarium.praefatio-d-n-iesu-christi-regis",
  "about": "The Preface of Christ the King. It praises Christ’s eternal priesthood and universal kingship and the kingdom of truth, life, holiness, grace, justice, love, and peace.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:" },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "You anointed with the oil of gladness Your only-begotten Son, our Lord Jesus Christ, eternal Priest and King of all, that offering Himself upon the altar of the Cross as a spotless and peace-giving Victim, He might accomplish the mysteries of mankind’s redemption; and that, all creatures having been subjected to His dominion, He might deliver to Your infinite Majesty an eternal and universal kingdom: a kingdom of truth and life, a kingdom of holiness and grace, a kingdom of justice, love, and peace.", "alignments": [{ "words": ["w023", "w024", "w025"], "anchor": "w024", "gloss": "Your only-begotten Son" }, { "words": ["w026", "w027"], "anchor": "w026", "gloss": "our Lord" }, { "words": ["w053", "w054", "w055", "w056", "w057"], "anchor": "w054", "gloss": "with all creatures subjected to His dominion" }, { "words": ["w058", "w059", "w060", "w061", "w062", "w063", "w064", "w065"], "anchor": "w064", "gloss": "He might deliver to Your infinite Majesty an eternal and universal kingdom" }] },
    "s05": { "translation": "And therefore with Angels and Archangels, with Thrones and Dominions, and with all the host of the heavenly army, we sing the hymn of Your glory, evermore saying:", "alignments": [{ "words": ["w095", "w096"], "anchor": "w095", "gloss": "of Your glory" }] }
  },
