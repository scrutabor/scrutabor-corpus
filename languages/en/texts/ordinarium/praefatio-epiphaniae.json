  "text": "ordinarium.praefatio-epiphaniae",
  "about": "The Preface of the Epiphany of the Lord. It praises the Only-begotten Son, Who appeared in our mortal nature and renewed us by the light of His immortality.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:", "alignments": [{ "words": ["w010", "w011", "w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "always and everywhere give thanks to You" }] },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "For when Your only-begotten Son appeared in the substance of our mortality, He renewed us by the new light of His immortality.", "alignments": [{ "words": ["w024", "w025"], "anchor": "w024", "gloss": "Your only-begotten Son" }, { "words": ["w031", "w032", "w033", "w034", "w035", "w036"], "anchor": "w036", "gloss": "He renewed us by the new light of His immortality" }] },
    "s05": { "translation": "And therefore with Angels and Archangels, with Thrones and Dominions, and with all the host of the heavenly army, we sing the hymn of Your glory, evermore saying:", "alignments": [{ "words": ["w053", "w054"], "anchor": "w053", "gloss": "of Your glory" }] }
  },
