{
  "schema_version": "0.18.0",
  "language": "en",
  "text": "ordinarium.libera-nos",
  "about": "The “Líbera nos” develops the final petition of the Lord's Prayer: “deliver us from evil”. It asks that deliverance through the intercession of the Virgin Mary, the Apostles Peter, Paul and Andrew, and all the saints. The priest says it secretly over the paten and signs himself with it, and only the closing Per ómnia sǽcula sæculórum is heard.",
  "segments": {
    "s01": { "narrative": "The priest takes the paten in his right hand, between the forefinger and the middle finger, holds it upright over the altar, and says the prayer silently." },
    "s02": { "translation": "Deliver us, we pray, Lord, from all evils, past, present, and future; and through the intercession of blessed and glorious Mary, ever Virgin and Mother of God, together with Your blessed Apostles Peter and Paul, Andrew, and all the saints,", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 29", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 94–95", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s03": { "narrative": "The priest signs himself with the paten, from forehead to breast." },
    "s04": { "translation": "in Your kindness, grant peace in our days,", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 29", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 94–95", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s05": { "narrative": "The priest kisses the paten." },
    "s06": { "translation": "so that, upheld by Your mercy, we may always be free from sin and protected from every disturbance.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 29", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 94–95", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s07": { "narrative": "The priest slips the paten under the Host, uncovers the chalice, genuflects, rises, takes the Host, and holding it over the chalice with both hands breaks it in two." },
    "s08": { "translation": "Through the same Jesus Christ, Your Son and our Lord,", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 29", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 94–95", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s09": { "narrative": "The priest lays the half held in his right hand on the paten and breaks a small particle from the half remaining in his left." },
    "s10": { "translation": "who, being God, lives and reigns with You in the unity of the Holy Spirit,", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 29", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 94–95", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s11": { "narrative": "The priest joins the other half to the half on the paten, holds the small particle over the chalice, and says in an audible voice or sings:" },
    "s12": { "translation": "for ever and ever.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 29", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 94–95", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s13": { "translation": "Amen.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 29", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 94–95", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] }
  },
