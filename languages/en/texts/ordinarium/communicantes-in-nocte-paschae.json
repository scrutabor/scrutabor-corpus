  "language": "en",
  "text": "ordinarium.communicantes-in-nocte-paschae",
  "about": "The priest prays this portion of the Canon quietly, in communion with the Church. The Easter Vigil has its own commemoration of the most sacred night of the Resurrection. This is not a selection by clock time alone. After commemorating the saints, he asks the Father for His protection through Christ.",
  "segments": {
    "s01": { "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w005", "gloss": "celebrate the most sacred night" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "of our Lord" }], "translation": "We are in communion and celebrate the most sacred night of the Resurrection of our Lord" },
    "s02": { "narrative": "The priest bows his head." },
    "s03": { "alignments": [{ "words": ["w011", "w012"], "anchor": "w012", "gloss": "according to the flesh" }], "translation": "Jesus Christ according to the flesh," },
    "s04": { "alignments": [{ "words": ["w013", "w014"], "anchor": "w013", "gloss": "and also" }, { "words": ["w015", "w016"], "anchor": "w016", "gloss": "we venerate the memory" }, { "words": ["w017", "w018"], "anchor": "w018", "gloss": "first of all" }, { "words": ["w020", "w021"], "anchor": "w021", "gloss": "ever-Virgin" }], "translation": "and we also venerate the memory, first of all, of the glorious ever-Virgin" },
    "s05": { "narrative": "The priest bows his head." },
    "s06": { "alignments": [{ "words": ["w027", "w028"], "anchor": "w027", "gloss": "our Lord" }], "translation": "Mary, Mother of the same God and our Lord" },
    "s07": { "narrative": "The priest bows his head." },
    "s08": { "translation": "Jesus Christ;" },
    "s09": { "alignments": [{ "words": ["w031", "w032"], "anchor": "w031", "gloss": "and also" }, { "words": ["w035", "w036", "w037"], "anchor": "w037", "gloss": "Spouse of the same Virgin" }], "translation": "and also of blessed Joseph, Spouse of the same Virgin," },
    "s10": { "alignments": [{ "words": ["w039", "w040", "w041", "w042", "w043"], "anchor": "w040", "gloss": "of Your blessed Apostles and Martyrs" }], "translation": "and of Your blessed Apostles and Martyrs: Peter and Paul, Andrew, James, John, Thomas, James, Philip, Bartholomew, Matthew, Simon and Thaddeus;" },
    "s11": { "translation": "Linus, Cletus, Clement, Sixtus, Cornelius, Cyprian, Lawrence, Chrysogonus, John and Paul, Cosmas and Damian;" },
    "s12": { "alignments": [{ "words": ["w073", "w074", "w075"], "anchor": "w074", "gloss": "of all Your saints" }, { "words": ["w081", "w082"], "anchor": "w082", "gloss": "in all things" }, { "words": ["w083", "w084", "w085", "w086"], "anchor": "w085", "gloss": "we may be defended by the help of Your protection" }], "translation": "and of all Your saints. Through their merits and prayers, grant that in all things we may be defended by the help of Your protection." },
    "s13": { "narrative": "The priest joins his hands." },
    "s14": { "alignments": [{ "words": ["w090", "w091"], "anchor": "w090", "gloss": "our Lord" }], "translation": "Through the same Christ, our Lord. Amen." }
  },
  "words": {
    "w001": { "gloss": "We are in communion", "explanation": "The communion of the praying Church includes the commemoration of Mary and the saints whose names follow in this prayer." },
    "w002": { "gloss": "and" },
    "w003": {  },
    "w004": {  },
    "w005": { "explanation": "The Resurrection commemorated is Christ’s Resurrection according to the flesh. The night or day names the particular form of the prayer." },
