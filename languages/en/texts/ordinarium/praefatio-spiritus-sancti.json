  "text": "ordinarium.praefatio-spiritus-sancti",
  "about": "This form of the Preface of the Holy Spirit is used from the Vigil of Pentecost through the following Saturday. It includes the words “on this day.”",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere, O Lord, holy Father, almighty eternal God, through Christ our Lord. He, ascending above all the heavens and sitting at Your right hand, on this day poured forth the promised Holy Spirit upon the children of adoption. Therefore the whole world throughout the earth rejoices with exceeding joy. The heavenly Virtues and the angelic Powers also sing together the hymn of Your glory, saying without end:", "alignments": [{ "words": ["w002", "w003", "w004", "w005"], "anchor": "w005", "gloss": "it is right and just" }, { "words": ["w010", "w011", "w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "always and everywhere give thanks to You" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "our Lord" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "Your right hand" }, { "words": ["w036", "w037"], "anchor": "w036", "gloss": "Holy Spirit" }, { "words": ["w047", "w048", "w049", "w050", "w051"], "anchor": "w051", "gloss": "the whole world throughout the earth" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "of Your glory" }] }
  },
