  "text": "ordinarium.praefatio-spiritus-sancti",
  "about": "The Preface used in the season of the formulary “Pentecost Sunday” in the 1962 Roman Missal.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere, O Lord, holy Father, almighty eternal God, through Christ our Lord. He, ascending above all the heavens and sitting at Your right hand, on this day poured forth the promised Holy Spirit upon the children of adoption. Therefore the whole world throughout the earth rejoices with exceeding joy. The heavenly Virtues also and the angelic Powers sing together the hymn of Your glory, evermore saying:", "alignments": [{ "words": ["w024", "w025"], "anchor": "w024", "gloss": "our Lord" }, { "words": ["w033", "w034"], "anchor": "w033", "gloss": "Your right hand" }, { "words": ["w049", "w050"], "anchor": "w049", "gloss": "the earth" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "of Your glory" }] }
  },
