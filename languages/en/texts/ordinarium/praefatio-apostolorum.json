  "text": "ordinarium.praefatio-apostolorum",
  "about": "The Preface of the Apostles. It asks the eternal Shepherd not to forsake His flock, but to preserve it under the protection of the Apostles and their successors.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation:" },
    "s03": { "translation": "To entreat You humbly, O Lord, that You, eternal Shepherd, would not forsake Your flock, but through Your blessed Apostles would keep it under constant protection:", "alignments": [{ "words": ["w014", "w015"], "anchor": "w014", "gloss": "Your flock" }, { "words": ["w022", "w023", "w024"], "anchor": "w023", "gloss": "Your blessed Apostles" }] },
    "s04": { "translation": "That it may be governed by those same rulers whom You appointed over it as pastors and vicars of Your work." },
    "s05": { "translation": "And therefore with Angels and Archangels, with Thrones and Dominions, and with all the host of the heavenly army, we sing the hymn of Your glory, evermore saying:", "alignments": [{ "words": ["w056", "w057"], "anchor": "w056", "gloss": "of Your glory" }] }
  },
