{
  "schema_version": "0.18.0",
  "language": "en",
  "text": "ordinarium.credo",
  "about": "The Nicene-Constantinopolitan Creed, said after the Gospel on every Sunday and on the greater feasts, and left out in Masses for the Dead. All genuflect at Et incarnátus est, where the Creed confesses the Word made flesh. Its articles run from the Father and the Son to the Holy Spirit, the Church, one baptism, the resurrection of the dead and the life of the world to come.",
  "segments": {
    "s01": { "narrative": "At the middle of the altar, the priest extends and raises his hands, joins them, says the Creed if prescribed, and continues with hands joined. The priest bows his head to the cross at in unum Deum, at Iesum Christum and at simul adorátur, and signs himself from forehead to breast at Et vitam ventúri sǽculi." },
    "s02": { "translation": "I believe in one God, the almighty Father, maker of heaven and earth, of all things visible and invisible.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s03": { "translation": "And in one Lord Jesus Christ, the only-begotten Son of God.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s04": { "translation": "And born of the Father before all ages.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s05": { "translation": "God from God, Light from Light, true God from true God.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s06": { "translation": "Begotten, not made, consubstantial with the Father; through whom all things were made.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s07": { "translation": "Who, for us human beings and for our salvation, came down from heaven.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s08": { "narrative": "Here a genuflection is made, held from Et incarnátus est through et homo factus est, and then all rise." },
    "s09": { "translation": "And He was incarnate by the Holy Spirit from the Virgin Mary, and became man.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s10": { "translation": "He was also crucified for us; He suffered under Pontius Pilate and was buried.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s11": { "translation": "And He rose again on the third day, according to the Scriptures.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s12": { "translation": "And He ascended into heaven and sits at the Father's right hand.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s13": { "translation": "And He will come again in glory to judge the living and the dead; His kingdom will have no end.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s14": { "translation": "And I believe in the Holy Spirit, the Lord and giver of life, who proceeds from the Father and the Son.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s15": { "translation": "Who is adored and glorified together with the Father and the Son; who spoke through the prophets.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s16": { "translation": "And I believe in one holy, catholic and apostolic Church.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s17": { "translation": "I confess one baptism for the forgiveness of sins.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s18": { "translation": "And I await the resurrection of the dead.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s19": { "translation": "And the life of the world to come. Amen.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "pp. 79–83", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] }
  },
