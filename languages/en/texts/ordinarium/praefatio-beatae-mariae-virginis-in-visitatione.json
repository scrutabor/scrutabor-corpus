  "text": "ordinarium.praefatio-beatae-mariae-virginis-in-visitatione",
  "about": "The Preface of the Blessed Virgin Mary with the formula “Visitatióne.” It praises Mary’s virginal motherhood and the eternal Light given to the world in Jesus Christ.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:", "alignments": [{ "words": ["w010", "w011", "w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "always and everywhere give thanks to You" }] },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "And that in the Visitation of the Blessed Mary ever-Virgin we should praise, bless, and proclaim You." },
    "s05": { "translation": "She conceived Your only-begotten Son by the overshadowing of the Holy Spirit and, the glory of her virginity abiding, brought forth to the world the eternal Light, Jesus Christ our Lord.", "alignments": [{ "words": ["w036", "w037"], "anchor": "w036", "gloss": "Your only-begotten Son" }, { "words": ["w038", "w039", "w040"], "anchor": "w040", "gloss": "by the overshadowing of the Holy Spirit" }, { "words": ["w043", "w044", "w045"], "anchor": "w044", "gloss": "the glory of her virginity abiding" }, { "words": ["w046", "w047"], "anchor": "w046", "gloss": "eternal Light" }, { "words": ["w052", "w053"], "anchor": "w052", "gloss": "our Lord" }] },
    "s06": { "translation": "Through Him the Angels praise Your majesty, the Dominions adore it, and the Powers tremble before it.", "alignments": [{ "words": ["w056", "w057"], "anchor": "w056", "gloss": "Your majesty" }, { "words": ["w058", "w059"], "anchor": "w058", "gloss": "the Angels praise" }, { "words": ["w060", "w061"], "anchor": "w060", "gloss": "the Dominions adore" }, { "words": ["w062", "w063"], "anchor": "w062", "gloss": "the Powers tremble" }] },
    "s07": { "translation": "The heavens, the heavenly Virtues, and the blessed Seraphim join in joyful celebration of Your majesty.", "alignments": [{ "words": ["w065", "w066"], "anchor": "w065", "gloss": "and the Virtues of the heavens" }] },
    "s08": { "translation": "We beseech You to admit our voices to join theirs as we speak in humble confession:", "alignments": [{ "words": ["w073", "w074", "w075", "w076", "w077", "w078", "w079", "w080", "w081"], "anchor": "w081", "gloss": "We pray that You command our voices also to be admitted with them" }, { "words": ["w082", "w083", "w084"], "anchor": "w084", "gloss": "saying in humble confession" }] }
  },
