  "language": "en",
  "text": "ordinarium.praefatio-dialogus",
  "about": "The dialog preceding the Preface. In “Sursum corda” the verb is left understood. In the response “Habémus ad Dóminum”, the unexpressed object is “corda”. The priest takes up the final response with “Vere dignum et iustum est”.",
  "segments": {
    "s01": { "narrative": "The priest lays both hands on the altar, one on either side, and raises them a little as he says Sursum corda. At Grátias agámus he joins them before his breast and bows his head." },
    "s02": { "translation": "The Lord be with you.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "p. 78", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s03": { "translation": "And with your spirit.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "pp. 78–79", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s04": { "translation": "Lift up your hearts.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "p. 79", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s05": { "translation": "We lift them up to the Lord.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "p. 79", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s06": { "translation": "Let us give thanks to the Lord our God.", "translation_citations": [{ "title": "The Family Prayer-book (1839)", "locator": "p. 79", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s07": { "translation": "It is right and just." }
  },
