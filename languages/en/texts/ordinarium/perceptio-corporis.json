    "s02": { "translation": "may it bring me neither judgment nor condemnation:", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 31", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 74–75", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 97", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 123–124", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }, { "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 477", "url": "https://archive.org/details/catholicgirlsgui00lasa" }] },
    "s03": { "translation": "but because of Your goodness, may it protect my mind and body and bring me healing:", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 31", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 74–75", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 97", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 123–124", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }, { "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 477", "url": "https://archive.org/details/catholicgirlsgui00lasa" }] },
    "s04": { "translation": "who, being God, live and reign with God the Father in the unity of the Holy Spirit for ever and ever. Amen.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 31", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 74–75", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 97", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 123–124", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }, { "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 477", "url": "https://archive.org/details/catholicgirlsgui00lasa" }] }
