  "text": "ordinarium.hanc-igitur",
  "about": "The priest says this prayer secretly, holding his hands spread over the offerings. He asks God to accept this offering, order our days in peace, deliver us from damnation and number us among the elect.",
  "segments": {
    "s01": { "narrative": "The priest holds his hands spread over the offerings, and a little before the Consecration the server warns the faithful with the bell." },
    "s02": { "translation": "We therefore ask You, Lord, to accept with favor this offering of our service and of Your whole household;", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 64", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s03": { "translation": "and to order our days in Your peace, and bid us be snatched from eternal damnation and counted in the flock of Your chosen ones.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 64", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w023", "w024", "w025", "w026", "w027", "w028", "w029", "w030", "w031", "w032", "w033", "w034"], "anchor": "w032", "gloss": "command that we be rescued from eternal damnation and counted in the flock of Your chosen ones" }] },
    "s04": { "narrative": "The priest joins his hands." },
    "s05": { "translation": "Through Christ our Lord. Amen.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 64", "url": "https://archive.org/details/TheMissalForTheLaity" }] }
  },
