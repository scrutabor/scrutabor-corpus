  "text": "ordinarium.hanc-igitur",
  "about": "The priest says this prayer secretly, holding his hands spread over the offerings. He asks God to accept this offering, order our days in peace, deliver us from damnation and number us among the elect.",
  "segments": {
    "s01": { "narrative": "The priest holds his hands spread over the offerings, and a little before the Consecration the server warns the faithful with the bell." },
    "s02": { "translation": "We therefore ask You, Lord, to accept with favor this offering of our service and of Your whole household;", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 64", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "of our service" }, { "words": ["w008", "w009", "w010"], "anchor": "w009", "gloss": "of Your whole household" }] },
    "s03": { "translation": "and to order our days in Your peace, and bid us be snatched from eternal damnation and counted in the flock of Your chosen ones.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 64", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w016", "w017"], "anchor": "w016", "gloss": "and our days" }, { "words": ["w030", "w031"], "anchor": "w030", "gloss": "of Your chosen ones" }] },
    "s04": { "narrative": "The priest joins his hands." },
    "s05": { "translation": "Through Christ our Lord. Amen.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 64", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w037", "w038"], "anchor": "w037", "gloss": "our Lord" }] }
  },
