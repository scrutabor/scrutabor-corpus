  "text": "ordinarium.confiteor-sacerdotis",
  "about": "The priest says the Confíteor first, bowed low. He addresses the ministers with “vobis, fratres” and “vos, fratres”. They then make their own confession, saying “tibi, pater” and “te, pater” where he said “vobis, fratres” and “vos, fratres”.",
  "segments": {
    "s01": { "narrative": "The priest joins his hands, bows deeply, and recites the Confíteor." },
    "s02": { "translation": "I confess to almighty God, to blessed Mary ever Virgin, to blessed Michael the Archangel, to blessed John the Baptist, to the holy Apostles Peter and Paul, to all the Saints, and to you, brethren:", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 12–13", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s03": { "translation": "that I have sinned exceedingly in thought, word and deed:", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 12–13", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s04": { "narrative": "The priest strikes his breast three times." },
    "s05": { "translation": "through my fault, through my fault, through my most grievous fault.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 12–13", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s06": { "translation": "Therefore I beseech blessed Mary ever Virgin, blessed Michael the Archangel, blessed John the Baptist, the holy Apostles Peter and Paul, all the Saints, and you, brethren, to pray for me to the Lord our God.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed pp. 12–13", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] }
  },
