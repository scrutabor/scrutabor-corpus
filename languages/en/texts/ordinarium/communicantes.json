  "text": "ordinarium.communicantes",
  "about": "In communion with the whole Church, the prayer honors the memory of the Blessed Virgin Mary, Saint Joseph, the Apostles, and the martyrs. After naming the saints, it asks God to surround the faithful with His protection through their merits and prayers.",
  "segments": {
    "s01": { "translation": "In communion, we venerate the memory above all of the glorious Mary, ever Virgin, Mother of our God and Lord Jesus Christ:", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 63–64", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s02": { "translation": "and also blessed Joseph, Spouse of that same Virgin," },
    "s03": { "translation": "and of Your blessed Apostles and Martyrs: Peter and Paul, Andrew, James, John, Thomas, James, Philip, Bartholomew, Matthew, Simon, and Thaddeus;", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 63–64", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s04": { "translation": "Linus, Cletus, Clement, Sixtus, Cornelius, Cyprian, Lawrence, Chrysogonus, John and Paul, Cosmas and Damian;", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 63–64", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s05": { "translation": "and of all Your Saints; through their merits and prayers, grant that we may be guarded in all things by Your protecting help.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 63–64", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s06": { "narrative": "The priest joins his hands." },
    "s07": { "translation": "Through the same Christ our Lord. Amen.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 63–64", "url": "https://archive.org/details/TheMissalForTheLaity" }] }
  },
