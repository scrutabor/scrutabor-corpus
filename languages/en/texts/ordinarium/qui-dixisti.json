  "text": "ordinarium.qui-dixisti",
  "about": "The first of three prayers said secretly by the priest before Communion. Its opening quotes John 14:27. The priest asks Christ to regard not his sins but the faith of the Church, and to grant the Church peace and unity. The kiss of peace follows where it is given, and in Masses for the Dead neither the peace nor this prayer is said.",
  "segments": {
    "s01": { "narrative": "The priest bows over the altar with his hands joined upon it, and says the three prayers that follow silently." },
    "s02": { "translation": "Lord Jesus Christ, who said to Your Apostles:", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 30", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed p. 73", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 96", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed p. 122", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }], "alignments": [{ "words": ["w006", "w007"], "anchor": "w006", "gloss": "to Your Apostles" }] },
    "s03": { "translation": "“Peace I leave you; My peace I give you” —", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 30", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed p. 73", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 96", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed p. 122", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }], "alignments": [{ "words": ["w011", "w012"], "anchor": "w011", "gloss": "my peace" }] },
    "s04": { "translation": "do not regard my sins, but the faith of Your Church;", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 30", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed p. 73", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 96", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed p. 122", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }], "alignments": [{ "words": ["w017", "w018"], "anchor": "w017", "gloss": "my sins" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "of Your Church" }] },
    "s05": { "translation": "and graciously grant her peace and unite her according to Your will,", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 30", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed p. 73", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 96", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed p. 122", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }], "alignments": [{ "words": ["w025", "w026"], "anchor": "w025", "gloss": "Your will" }] },
    "s06": { "translation": "who, being God, live and reign forever and ever. Amen.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 30", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed p. 73", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 96", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed p. 122", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s07": { "narrative": "If the peace is given, the priest kisses the altar and says:" },
    "s08": { "translation": "Peace be with you." },
    "s09": { "translation": "And with your spirit.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 29", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }], "alignments": [{ "words": ["w045", "w046"], "anchor": "w045", "gloss": "your spirit" }] },
    "s10": { "narrative": "In Masses for the Dead the peace is not given, and this prayer is left out." }
  },
