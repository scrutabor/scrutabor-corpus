  "text": "ordinarium.praefatio-sanctissimae-trinitatis",
  "about": "The Preface of the Most Holy Trinity. It confesses one God in three Persons, without confusion of Persons or division of substance, and leads into the common song with the choirs of angels.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:", "alignments": [{ "words": ["w002", "w003", "w004", "w005"], "anchor": "w005", "gloss": "it is right and just" }, { "words": ["w010", "w011", "w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "always and everywhere give thanks to You" }] },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "You, with Your only-begotten Son and the Holy Spirit, are one God and one Lord: not in the oneness of a single Person, but in the Trinity of one substance.", "alignments": [{ "words": ["w024", "w025", "w026"], "anchor": "w025", "gloss": "Your only-begotten Son" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "the Holy Spirit" }, { "words": ["w030", "w031", "w032"], "anchor": "w031", "gloss": "are one God" }, { "words": ["w033", "w034", "w035"], "anchor": "w034", "gloss": "are one Lord" }, { "words": ["w038", "w039", "w040"], "anchor": "w039", "gloss": "the singleness of one Person" }, { "words": ["w043", "w044", "w045"], "anchor": "w044", "gloss": "the Trinity of one substance" }] },
    "s05": { "translation": "For that which, by Your revelation, we believe of Your glory, the same we understand of Your Son and the same of the Holy Spirit, without difference arising from distinction.", "alignments": [{ "words": ["w046", "w047"], "anchor": "w046", "gloss": "For what" }, { "words": ["w051", "w052"], "anchor": "w051", "gloss": "by Your revelation" }, { "words": ["w055", "w056", "w057"], "anchor": "w056", "gloss": "of Your Son" }, { "words": ["w060", "w061"], "anchor": "w060", "gloss": "the Holy Spirit" }] },
    "s06": { "translation": "So that, in the confession of the true and eternal Godhead, distinction in Persons, unity in essence, and equality in majesty may be adored.", "alignments": [{ "words": ["w069", "w070", "w071"], "anchor": "w071", "gloss": "of the true and eternal Godhead" }, { "words": ["w072"], "reason": "idiom" }, { "words": ["w083", "w084"], "anchor": "w083", "gloss": "equality may be adored" }] },
    "s07": { "translation": "Which the Angels and Archangels, the Cherubim also and the Seraphim, praise; they do not cease daily to cry out with one voice, saying:", "alignments": [{ "words": ["w086", "w087", "w088", "w089", "w090", "w091", "w092", "w093"], "anchor": "w086", "gloss": "the Angels and Archangels, and also the Cherubim and Seraphim, praise" }, { "words": ["w095", "w096"], "anchor": "w096", "gloss": "do not cease" }, { "words": ["w099", "w100"], "anchor": "w100", "gloss": "with one voice" }] }
  },
