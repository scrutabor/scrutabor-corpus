  "text": "ordinarium.praefatio-sanctissimae-trinitatis",
  "about": "The Preface of the Most Holy Trinity. It confesses one God in three Persons, without confusion of Persons or division of substance, and leads into the common song with the choirs of angels.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:" },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "You, with Your only-begotten Son and the Holy Spirit, are one God and one Lord: not in the oneness of a single Person, but in the Trinity of one substance.", "alignments": [{ "words": ["w024", "w025", "w026"], "anchor": "w025", "gloss": "Your only-begotten Son" }] },
    "s05": { "translation": "For that which, by Your revelation, we believe of Your glory, the same we understand of Your Son and the same of the Holy Spirit, without difference arising from distinction.", "alignments": [{ "words": ["w046", "w047"], "anchor": "w046", "gloss": "For what" }, { "words": ["w051", "w052"], "anchor": "w051", "gloss": "by Your revelation" }, { "words": ["w055", "w056", "w057"], "anchor": "w056", "gloss": "about Your Son" }] },
    "s06": { "translation": "So that, in the confession of the true and eternal Godhead, distinction in Persons, unity in essence, and equality in majesty may be adored." },
    "s07": { "translation": "Which the Angels and Archangels, the Cherubim also and the Seraphim, praise; they do not cease daily to cry out with one voice, saying:" }
  },
