{
  "schema_version": "0.18.0",
  "language": "en",
  "text": "ordinarium.praefatio-beatae-mariae-virginis",
  "about": "The Preface of the Blessed Virgin Mary with the formula “Festivitáte.” It praises Mary's virginal motherhood and the eternal Light given to the world in Jesus Christ.",
  "segments": {
    "s01": {
      "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus."
    },
    "s02": {
      "translation": "It is truly meet and just, right and profitable for salvation, that we should at all times and in all places give thanks unto Thee:"
    },
    "s03": {
      "translation": "O Lord, holy Father, almighty eternal God:"
    },
    "s04": {
      "translation": "And that in the Feast of the Blessed Mary ever-Virgin we should praise, bless, and proclaim Thee."
    },
    "s05": {
      "translation": "She conceived Thine only-begotten Son by the overshadowing of the Holy Ghost and, the glory of her virginity abiding, brought forth to the world the eternal Light, Jesus Christ our Lord."
    },
    "s06": {
      "translation": "Through Whom the Angels praise Thy majesty, the Dominions adore it, and the Powers tremble before it."
    },
    "s07": {
      "translation": "The heavens, the heavenly Virtues, and the blessed Seraphim join in joyful celebration of Thy majesty."
    },
    "s08": {
      "translation": "We beseech Thee to admit our voices to join theirs as we speak in humble confession:"
    }
  },
