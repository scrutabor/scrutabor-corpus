  "language": "en",
  "text": "ordinarium.communicantes-in-epiphania-domini",
  "about": "The priest prays this portion of the Canon quietly, in communion with the Church. This form is prescribed for the feast of the Epiphany and recalls the visible bodily appearance of the Only-begotten Son. After commemorating the saints, he asks the Father for His protection through Christ.",
  "segments": {
    "s01": { "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w005", "gloss": "celebrate the most sacred day" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "Your Only-begotten Son" }, { "words": ["w009", "w010", "w011", "w012", "w013"], "anchor": "w013", "gloss": "coeternal with You in Your glory" }, { "words": ["w014", "w015", "w016", "w017"], "anchor": "w015", "gloss": "in our real flesh" }, { "words": ["w018", "w019", "w020"], "anchor": "w020", "gloss": "appeared visibly in bodily form" }], "translation": "We are in communion and celebrate the most sacred day, on which Your Only-begotten Son, coeternal with You in Your glory, appeared visibly in bodily form, in our real flesh," },
    "s02": { "alignments": [{ "words": ["w021", "w022"], "anchor": "w021", "gloss": "and also" }, { "words": ["w023", "w024"], "anchor": "w024", "gloss": "we venerate the memory" }, { "words": ["w025", "w026"], "anchor": "w026", "gloss": "first of all" }, { "words": ["w028", "w029"], "anchor": "w029", "gloss": "ever-Virgin" }], "translation": "and we also venerate the memory, first of all, of the glorious ever-Virgin" },
    "s03": { "narrative": "The priest bows his head." },
    "s04": { "alignments": [{ "words": ["w035", "w036"], "anchor": "w035", "gloss": "our Lord" }], "translation": "Mary, Mother of the same God and our Lord" },
    "s05": { "narrative": "The priest bows his head." },
    "s06": { "translation": "Jesus Christ;" },
    "s07": { "alignments": [{ "words": ["w039", "w040"], "anchor": "w039", "gloss": "and also" }, { "words": ["w043", "w044", "w045"], "anchor": "w045", "gloss": "Spouse of the same Virgin" }], "translation": "and also of blessed Joseph, Spouse of the same Virgin," },
    "s08": { "alignments": [{ "words": ["w047", "w048", "w049", "w050", "w051"], "anchor": "w048", "gloss": "of Your blessed Apostles and Martyrs" }], "translation": "and of Your blessed Apostles and Martyrs: Peter and Paul, Andrew, James, John, Thomas, James, Philip, Bartholomew, Matthew, Simon and Thaddeus;" },
    "s09": { "translation": "Linus, Cletus, Clement, Sixtus, Cornelius, Cyprian, Lawrence, Chrysogonus, John and Paul, Cosmas and Damian;" },
    "s10": { "alignments": [{ "words": ["w081", "w082", "w083"], "anchor": "w082", "gloss": "of all Your saints" }, { "words": ["w089", "w090"], "anchor": "w090", "gloss": "in all things" }, { "words": ["w091", "w092", "w093", "w094"], "anchor": "w093", "gloss": "we may be defended by the help of Your protection" }], "translation": "and of all Your saints. Through their merits and prayers, grant that in all things we may be defended by the help of Your protection." },
    "s11": { "narrative": "The priest joins his hands." },
    "s12": { "alignments": [{ "words": ["w098", "w099"], "anchor": "w098", "gloss": "our Lord" }], "translation": "Through the same Christ, our Lord. Amen." }
  },
  "words": {
    "w001": { "gloss": "We are in communion", "explanation": "The communion of the praying Church includes the commemoration of Mary and the saints whose names follow in this prayer." },
    "w002": { "gloss": "and" },
    "w003": {  },
    "w004": {  },
    "w005": { "explanation": "The appearance commemorated is that of the Son, coeternal with the Father. His visible bodily manifestation is joined to the reality of our flesh." },
    "w006": { "gloss": "on which" },
    "w007": {  },
