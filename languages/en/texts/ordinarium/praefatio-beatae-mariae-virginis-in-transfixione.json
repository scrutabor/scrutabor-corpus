  "text": "ordinarium.praefatio-beatae-mariae-virginis-in-transfixione",
  "about": "The Preface of the Blessed Virgin Mary with the formula “Transfixióne.” It praises Mary’s virginal motherhood and the eternal Light given to the world in Jesus Christ.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:" },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "And that in the Transfixion of the Blessed Mary ever-Virgin we should praise, bless, and proclaim You." },
    "s05": { "translation": "She conceived Your only-begotten Son by the overshadowing of the Holy Spirit and, the glory of her virginity abiding, brought forth to the world the eternal Light, Jesus Christ our Lord.", "alignments": [{ "words": ["w036", "w037"], "anchor": "w036", "gloss": "Your only-begotten Son" }, { "words": ["w052", "w053"], "anchor": "w052", "gloss": "our Lord" }] },
    "s06": { "translation": "Through Him the Angels praise Your majesty, the Dominions adore it, and the Powers tremble before it.", "alignments": [{ "words": ["w056", "w057"], "anchor": "w056", "gloss": "Your majesty" }] },
    "s07": { "translation": "The heavens, the heavenly Virtues, and the blessed Seraphim join in joyful celebration of Your majesty." },
    "s08": { "translation": "We beseech You to admit our voices to join theirs as we speak in humble confession:", "alignments": [{ "words": ["w073", "w074", "w075", "w076", "w077", "w078", "w079", "w080", "w081"], "anchor": "w081", "gloss": "We pray that You command our voices also to be admitted with them" }, { "words": ["w082", "w083", "w084"], "anchor": "w084", "gloss": "saying in humble confession" }] }
  },
