  "text": "ordinarium.praefatio-beatae-mariae-virginis-in-conceptione-immaculata",
  "about": "The Preface of the Blessed Virgin Mary with the formula “Conceptióne immaculáta.” It praises Mary’s virginal motherhood and the eternal Light given to the world in Jesus Christ.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:", "alignments": [{ "words": ["w010", "w011", "w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "always and everywhere give thanks to You" }] },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "And that in the Immaculate Conception of the Blessed Mary ever-Virgin we should praise, bless, and proclaim You.", "alignments": [{ "words": ["w025", "w026"], "anchor": "w025", "gloss": "the Immaculate Conception" }] },
    "s05": { "translation": "She conceived Your only-begotten Son by the overshadowing of the Holy Spirit and, the glory of her virginity abiding, brought forth to the world the eternal Light, Jesus Christ our Lord.", "alignments": [{ "words": ["w037", "w038"], "anchor": "w037", "gloss": "Your only-begotten Son" }, { "words": ["w039", "w040", "w041"], "anchor": "w041", "gloss": "by the overshadowing of the Holy Spirit" }, { "words": ["w044", "w045", "w046"], "anchor": "w045", "gloss": "the glory of her virginity abiding" }, { "words": ["w047", "w048"], "anchor": "w047", "gloss": "eternal Light" }, { "words": ["w053", "w054"], "anchor": "w053", "gloss": "our Lord" }] },
    "s06": { "translation": "Through Him the Angels praise Your majesty, the Dominions adore it, and the Powers tremble before it.", "alignments": [{ "words": ["w057", "w058"], "anchor": "w057", "gloss": "Your majesty" }, { "words": ["w059", "w060"], "anchor": "w059", "gloss": "the Angels praise" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "the Dominions adore" }, { "words": ["w063", "w064"], "anchor": "w063", "gloss": "the Powers tremble" }] },
    "s07": { "translation": "The heavens, the heavenly Virtues, and the blessed Seraphim join in joyful celebration of Your majesty.", "alignments": [{ "words": ["w066", "w067"], "anchor": "w066", "gloss": "and the Virtues of the heavens" }] },
    "s08": { "translation": "We beseech You to admit our voices to join theirs as we speak in humble confession:", "alignments": [{ "words": ["w074", "w075", "w076", "w077", "w078", "w079", "w080", "w081", "w082"], "anchor": "w082", "gloss": "We pray that You command our voices also to be admitted with them" }, { "words": ["w083", "w084", "w085"], "anchor": "w085", "gloss": "saying in humble confession" }] }
  },
