  "text": "ordinarium.te-igitur",
  "about": "The first prayer of the Canon. Through Jesus Christ, the priest asks the Father to accept the offerings and to grant the Church peace, protection, unity and governance. The missal leaves a slot here for the reigning Pope and the local bishop, named with all who keep the Catholic faith.",
  "segments": {
    "s01": { "narrative": "After the Preface the priest spreads his hands, raises them slightly and joins them, lifts his eyes to heaven and lowers them at once, then bows low before the altar and rests his hands upon it." },
    "s02": { "translation": "Therefore, most merciful Father, through Jesus Christ, Your Son, our Lord, we humbly pray and beseech You", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 61–62", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s03": { "narrative": "The priest kisses the altar and joins his hands before his breast." },
    "s04": { "translation": "to accept and bless", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 61–62", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s05": { "narrative": "The priest makes three signs of the cross over the Host and the chalice together." },
    "s06": { "translation": "these gifts, these offerings, these holy and undefiled sacrifices,", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 61–62", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s07": { "narrative": "The priest spreads his hands and goes on." },
    "s08": { "translation": "We offer them to You above all for Your holy Catholic Church. Graciously grant her peace, preserve her, unite her, and govern her throughout the world,", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 61–62", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s09": { "translation": "with Your servant, our Pope, our Bishop, and all who uphold the true Catholic and Apostolic faith.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 61–62", "url": "https://archive.org/details/TheMissalForTheLaity" }] }
  },
