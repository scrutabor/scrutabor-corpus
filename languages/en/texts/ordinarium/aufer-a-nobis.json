  "text": "ordinarium.aufer-a-nobis",
  "about": "As he ascends the altar steps, the priest asks God to take away iniquity so that we may enter the “Sancta sanctórum,” the holy of holies. In the second prayer he asks, in his own name, that his sins be forgiven through the merits of the saints whose relics are in this place, and of all the saints, kissing the altar as he names them.",
  "segments": {
    "s01": { "narrative": "The priest extends and joins his hands, then says one word aloud." },
    "s02": { "translation": "Let us pray.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 6", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 39–40", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 63–64", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s03": { "narrative": "The priest ascends the steps to the altar and continues silently." },
    "s04": { "translation": "Lord, we ask You to take away our iniquities, so that with pure minds we may be worthy to enter the Holy of Holies.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 6", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 39–40", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 63–64", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }], "alignments": [{ "words": ["w007", "w008"], "anchor": "w007", "gloss": "our iniquities" }, { "words": ["w011", "w012"], "anchor": "w011", "gloss": "the Holy of Holies" }, { "words": ["w013", "w014", "w015"], "anchor": "w014", "gloss": "with pure minds we may be worthy" }] },
    "s05": { "translation": "Through Christ our Lord. Amen.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 6", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 39–40", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 63–64", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }], "alignments": [{ "words": ["w019", "w020"], "anchor": "w019", "gloss": "our Lord" }] },
    "s06": { "narrative": "With joined hands resting on the altar the priest bows over it and begins the second prayer." },
    "s07": { "translation": "We ask You, Lord, by the merits of Your saints,", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 6", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 39–40", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 63–64", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }], "alignments": [{ "words": ["w027", "w028"], "anchor": "w027", "gloss": "of Your saints" }] },
    "s08": { "narrative": "The priest kisses the middle of the altar." },
    "s09": { "translation": "whose relics are here, and by the merits of all the saints, that You may be pleased to forgive all my sins. Amen.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 6", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 39–40", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 63–64", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }], "alignments": [{ "words": ["w031", "w032"], "anchor": "w032", "gloss": "are here" }, { "words": ["w037", "w038"], "anchor": "w038", "gloss": "You may be pleased to forgive" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "my sins" }] }
  },
