  "language": "en",
  "text": "ordinarium.praefatio-sancti-ioseph-in-solemnitate",
  "about": "The Preface of Saint Joseph with the formula “Solemnitáte.” It praises the just spouse of the Mother of God, faithful guardian of the Holy Family, and earthly protector of the Son of God.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "It is truly meet and just, right and profitable for salvation, that we should at all times and in all places give thanks unto Thee:" },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "And that in the Solemnity of blessed Joseph we should magnify Thee with due praises, bless, and proclaim Thee." },
    "s05": { "translation": "He, a just man, was by Thee given as spouse to the Virgin Mother of God; and was appointed a faithful and prudent servant over Thy household, that with a father's care he might guard Thine only-begotten Son, conceived by the overshadowing of the Holy Ghost, Jesus Christ our Lord.", "alignments": [{ "words": ["w035"], "reason": "idiom" }, { "words": ["w043", "w044"], "anchor": "w044", "gloss": "was given" }, { "words": ["w053", "w054"], "anchor": "w054", "gloss": "was appointed" }] },
    "s06": { "translation": "Through Whom the Angels praise Thy majesty, the Dominions adore it, and the Powers tremble before it." },
    "s07": { "translation": "The heavens, the heavenly Virtues, and the blessed Seraphim join in joyful celebration of Thy majesty." },
    "s08": { "translation": "We beseech Thee to admit our voices to join theirs as we speak in humble confession:" }
  },
