  "text": "ordinarium.fili-dei-vivi",
  "about": "The priest addresses Jesus Christ, the Son of the living God. He recalls the work of salvation accomplished through Christ's death, by the will of the Father and with the cooperation of the Holy Spirit. He asks to be delivered from iniquity and evil, to remain faithful to the commandments, and never to be separated from Christ.",
  "segments": {
    "s01": { "translation": "Lord Jesus Christ, Son of the living God,", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. 30–31", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 73–74", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 96–97", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 122–123", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }, { "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 477", "url": "https://archive.org/details/catholicgirlsgui00lasa" }] },
    "s02": { "translation": "who, by the will of the Father and with the cooperation of the Holy Spirit, brought the world to life through Your death:", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. 30–31", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 73–74", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 96–97", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 122–123", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }, { "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 477", "url": "https://archive.org/details/catholicgirlsgui00lasa" }] },
    "s03": { "translation": "deliver me through this most holy Body and Your Blood from all my iniquities and from all evils:", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. 30–31", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 73–74", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 96–97", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 122–123", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }, { "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 477", "url": "https://archive.org/details/catholicgirlsgui00lasa" }] },
    "s04": { "translation": "and make me always hold fast to Your commandments, and never permit me to be separated from You:", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. 30–31", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 73–74", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 96–97", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 122–123", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }, { "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 477", "url": "https://archive.org/details/catholicgirlsgui00lasa" }] },
    "s05": { "translation": "who, being God, live and reign with the same God the Father and with the Holy Spirit for ever and ever. Amen.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed pp. 30–31", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 73–74", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 96–97", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }, { "title": "Key of Heaven (1901)", "locator": "printed pp. 122–123", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }, { "title": "Francis X. Lasance, The Catholic Girl's Guide (1906)", "locator": "printed p. 477", "url": "https://archive.org/details/catholicgirlsgui00lasa" }] }
  },
