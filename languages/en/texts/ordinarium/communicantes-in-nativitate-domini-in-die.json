  "language": "en",
  "text": "ordinarium.communicantes-in-nativitate-domini-in-die",
  "about": "The priest prays this portion of the Canon quietly, in communion with the Church. This form commemorates the most sacred day at the other Nativity Masses and throughout the octave, ending on January 1. After commemorating the saints, he asks the Father for His protection through Christ.",
  "segments": {
    "s01": { "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w005", "gloss": "celebrate the most sacred day" }], "translation": "We are in communion and celebrate the most sacred day, on which blessed" },
    "s02": { "narrative": "The priest bows his head." },
    "s03": { "alignments": [{ "words": ["w011", "w012", "w013", "w014"], "anchor": "w013", "gloss": "brought forth the Savior for this world" }], "translation": "Mary’s inviolate virginity brought forth the Savior for this world," },
    "s04": { "alignments": [{ "words": ["w015", "w016"], "anchor": "w015", "gloss": "and also" }, { "words": ["w017", "w018"], "anchor": "w018", "gloss": "we venerate the memory" }, { "words": ["w019", "w020"], "anchor": "w020", "gloss": "first of all" }, { "words": ["w023", "w024"], "anchor": "w024", "gloss": "ever-Virgin" }], "translation": "and we also venerate the memory, first of all, of the same glorious ever-Virgin" },
    "s05": { "narrative": "The priest bows his head." },
    "s06": { "alignments": [{ "words": ["w030", "w031"], "anchor": "w030", "gloss": "our Lord" }], "translation": "Mary, Mother of the same God and our Lord" },
    "s07": { "narrative": "The priest bows his head." },
    "s08": { "translation": "Jesus Christ;" },
    "s09": { "alignments": [{ "words": ["w034", "w035"], "anchor": "w034", "gloss": "and also" }, { "words": ["w038", "w039", "w040"], "anchor": "w040", "gloss": "Spouse of the same Virgin" }], "translation": "and also of blessed Joseph, Spouse of the same Virgin," },
    "s10": { "alignments": [{ "words": ["w042", "w043", "w044", "w045", "w046"], "anchor": "w043", "gloss": "of Your blessed Apostles and Martyrs" }], "translation": "and of Your blessed Apostles and Martyrs: Peter and Paul, Andrew, James, John, Thomas, James, Philip, Bartholomew, Matthew, Simon and Thaddeus;" },
    "s11": { "translation": "Linus, Cletus, Clement, Sixtus, Cornelius, Cyprian, Lawrence, Chrysogonus, John and Paul, Cosmas and Damian;" },
    "s12": { "alignments": [{ "words": ["w076", "w077", "w078"], "anchor": "w077", "gloss": "of all Your saints" }, { "words": ["w084", "w085"], "anchor": "w085", "gloss": "in all things" }, { "words": ["w086", "w087", "w088", "w089"], "anchor": "w088", "gloss": "we may be defended by the help of Your protection" }], "translation": "and of all Your saints. Through their merits and prayers, grant that in all things we may be defended by the help of Your protection." },
    "s13": { "narrative": "The priest joins his hands." },
    "s14": { "alignments": [{ "words": ["w093", "w094"], "anchor": "w093", "gloss": "our Lord" }], "translation": "Through the same Christ, our Lord. Amen." }
  },
  "words": {
    "w001": { "gloss": "We are in communion", "explanation": "The communion of the praying Church includes the commemoration of Mary and the saints whose names follow in this prayer." },
    "w002": { "gloss": "and" },
    "w003": {  },
    "w004": {  },
    "w005": { "explanation": "The Savior’s birth is expressed through the image of Mary’s inviolate virginity bringing Him forth for the world. Mary remains the Mother named in the prayer." },
    "w006": { "gloss": "on which" },
