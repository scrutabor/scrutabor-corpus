  "text": "ordinarium.praefatio-nativitatis",
  "about": "The Preface of the Nativity of the Lord. It praises the light of divine glory revealed in the mystery of the Word made flesh.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:" },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "For through the mystery of the Word made flesh, a new light of Your glory has shone upon the eyes of our mind, so that while we know God visibly, through Him we may be caught up into the love of things invisible.", "alignments": [{ "words": ["w027", "w028", "w029", "w030", "w031", "w032", "w033", "w034"], "anchor": "w034", "gloss": "a new light of Your glory has shone upon the eyes of our mind" }] },
    "s05": { "translation": "And therefore with Angels and Archangels, with Thrones and Dominions, and with all the host of the heavenly army, we sing the hymn of Your glory, evermore saying:", "alignments": [{ "words": ["w062", "w063"], "anchor": "w062", "gloss": "of Your glory" }] }
  },
