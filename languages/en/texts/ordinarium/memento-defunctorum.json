  "text": "ordinarium.memento-defunctorum",
  "about": "The commemoration of the dead in the Canon. The priest prays for God's servants, men and women, who went before with the sign of faith and now sleep the sleep of peace, then joins his hands and prays in silence for those he intends to remember. He asks for them and for all who rest in Christ a place of refreshment, light, and peace.",
  "segments": {
    "s01": { "translation": "Remember also, O Lord, Your servants, men and women, who went before us bearing the sign of faith and now sleep the sleep of peace.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 27", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 68–69", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 92–93", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s02": { "narrative": "The priest joins his hands and prays a while in silence for those dead he means to remember, then spreads his hands and goes on." },
    "s03": { "translation": "We implore You, O Lord, to grant them and all who rest in Christ a place of refreshment, light, and peace.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 27", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 68–69", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 92–93", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s04": { "narrative": "The priest joins his hands and bows his head." },
    "s05": { "translation": "Through the same Christ our Lord. Amen.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 27", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 68–69", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed pp. 92–93", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] }
  },
