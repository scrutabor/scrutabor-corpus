  "language": "en",
  "text": "ordinarium.praefatio-sancti-ioseph-in-festivitate",
  "about": "The Preface of Saint Joseph with the formula “Festivitáte.” It praises the just spouse of the Mother of God, faithful guardian of the Holy Family, and earthly protector of the Son of God.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:" },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "And that in the Feast of blessed Joseph we should magnify You with due praises, bless, and proclaim You." },
    "s05": { "translation": "He, a just man, was given by You as spouse to the Virgin Mother of God; and was appointed a faithful and prudent servant over Your household, that with a father’s care he might guard Your only-begotten Son, conceived by the overshadowing of the Holy Spirit, Jesus Christ our Lord.", "alignments": [{ "words": ["w035"], "reason": "idiom" }, { "words": ["w043", "w044"], "anchor": "w044", "gloss": "was given" }, { "words": ["w053", "w054"], "anchor": "w054", "gloss": "was appointed" }] },
    "s06": { "translation": "Through Him the Angels praise Your majesty, the Dominions adore it, and the Powers tremble before it." },
    "s07": { "translation": "The heavens, the heavenly Virtues, and the blessed Seraphim join in joyful celebration of Your majesty." },
    "s08": { "translation": "We beseech You to admit our voices to join theirs as we speak in humble confession:" }
  },
