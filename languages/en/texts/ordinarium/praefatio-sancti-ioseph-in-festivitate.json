  "language": "en",
  "text": "ordinarium.praefatio-sancti-ioseph-in-festivitate",
  "about": "The Preface of Saint Joseph with the formula “Festivitáte.” It praises the just spouse of the Mother of God, faithful guardian of the Holy Family, and earthly protector of the Son of God.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:", "alignments": [{ "words": ["w010", "w011", "w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "always and everywhere give thanks to You" }] },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "And that in the Feast of blessed Joseph we should magnify You with due praises, bless, and proclaim You." },
    "s05": { "translation": "He, a just man, was given by You as spouse to the Virgin Mother of God; and was appointed a faithful and prudent servant over Your household, that with a father’s care he might guard Your only-begotten Son, conceived by the overshadowing of the Holy Spirit, Jesus Christ our Lord.", "alignments": [{ "words": ["w035"], "reason": "idiom" }, { "words": ["w043", "w044"], "anchor": "w044", "gloss": "was given" }, { "words": ["w051", "w052"], "anchor": "w051", "gloss": "Your household" }, { "words": ["w053", "w054"], "anchor": "w054", "gloss": "was appointed" }, { "words": ["w056", "w057"], "anchor": "w056", "gloss": "Your only-begotten Son" }, { "words": ["w058", "w059"], "anchor": "w059", "gloss": "of the Holy Spirit" }, { "words": ["w062", "w063"], "anchor": "w063", "gloss": "in a father’s place" }, { "words": ["w067", "w068"], "anchor": "w067", "gloss": "our Lord" }] },
    "s06": { "translation": "Through Him the Angels praise Your majesty, the Dominions adore it, and the Powers tremble before it.", "alignments": [{ "words": ["w071", "w072"], "anchor": "w071", "gloss": "Your majesty" }, { "words": ["w073", "w074"], "anchor": "w073", "gloss": "the Angels praise" }, { "words": ["w075", "w076"], "anchor": "w075", "gloss": "the Dominions adore" }, { "words": ["w077", "w078"], "anchor": "w077", "gloss": "the Powers tremble" }] },
    "s07": { "translation": "The heavens, the heavenly Virtues, and the blessed Seraphim join in joyful celebration of Your majesty.", "alignments": [{ "words": ["w080", "w081"], "anchor": "w080", "gloss": "and the Virtues of the heavens" }] },
    "s08": { "translation": "We beseech You to admit our voices to join theirs as we speak in humble confession:", "alignments": [{ "words": ["w088", "w089", "w090", "w091", "w092", "w093", "w094", "w095", "w096"], "anchor": "w096", "gloss": "We pray that You command our voices also to be admitted with them" }, { "words": ["w097", "w098", "w099"], "anchor": "w099", "gloss": "saying in humble confession" }] }
  },
