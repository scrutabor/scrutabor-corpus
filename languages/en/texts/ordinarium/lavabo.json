  "text": "ordinarium.lavabo",
  "about": "Psalm 25:6–12 in the Vulgate numbering (Psalm 26 in Hebrew), said during the washing of hands. At Masses for the Dead, and at Masses of the season from Passion Sunday through Maundy Thursday, the Glória Patri is omitted. The psalm itself remains.",
  "segments": {
    "s01": { "narrative": "The priest washes his fingertips, the thumb and forefinger, while saying the psalm." },
    "s02": { "translation": "I will wash my hands among the innocent and go around Your altar, O Lord,", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 50–51", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "my hands" }, { "words": ["w008", "w009"], "anchor": "w008", "gloss": "Your altar" }] },
    "s03": { "translation": "that I may hear the voice of praise and recount all Your wonders.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 50–51", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s04": { "translation": "O Lord, I have loved the beauty of Your house and the place where Your glory dwells.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 50–51", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w023", "w024"], "anchor": "w023", "gloss": "of Your house" }, { "words": ["w028", "w029"], "anchor": "w028", "gloss": "of Your glory" }] },
    "s05": { "translation": "O God, do not destroy my soul with the wicked, nor my life with bloodthirsty men,", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 50–51", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w035", "w036"], "anchor": "w035", "gloss": "my soul" }, { "words": ["w041", "w042"], "anchor": "w041", "gloss": "my life" }] },
    "s06": { "translation": "in whose hands are iniquities; their right hand is filled with gifts.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "parallel Ordinary and Advent propers, examined edition", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w050", "w051"], "anchor": "w050", "gloss": "is filled" }] },
    "s07": { "translation": "But I have walked in my innocence; redeem me and have mercy on me.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 50–51", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w056", "w057"], "anchor": "w056", "gloss": "my innocence" }, { "words": ["w058", "w059"], "anchor": "w058", "gloss": "have walked" }] },
    "s08": { "translation": "My foot has stood on level ground; in the assemblies I will bless You, O Lord.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed pp. 50–51", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w065", "w066"], "anchor": "w065", "gloss": "my foot" }] },
    "s09": { "translation": "Glory be to the Father, and to the Son, and to the Holy Spirit.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 37", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w080", "w081"], "anchor": "w080", "gloss": "to the Holy Spirit" }] },
    "s10": { "translation": "As it was in the beginning, is now, and ever shall be, world without end. Amen.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 37", "url": "https://archive.org/details/TheMissalForTheLaity" }] }
  },
