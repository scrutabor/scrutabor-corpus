  "text": "ordinarium.pater-noster",
  "about": "The rubrics call the sentence before Pater noster the preface of the Lord’s Prayer. After et ne nos indúcas in tentatiónem, they assign the response sed líbera nos a malo to the server. At low Mass the faithful may say the whole Our Father with the priest, in Latin, and add the Amen with him.",
  "segments": {
    "s01": { "narrative": "The priest joins his hands." },
    "s02": { "translation": "Let us pray.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 115", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s03": { "translation": "Taught by precepts that lead to salvation and formed through divine instruction, we dare to say:" },
    "s04": { "narrative": "The priest spreads his hands, and keeps them so through the prayer." },
    "s05": { "translation": "Our Father, who art in heaven,", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 9", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }], "alignments": [{ "words": ["w011", "w012"], "anchor": "w011", "gloss": "Our Father" }] },
    "s06": { "translation": "hallowed be Thy name.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 9", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }], "alignments": [{ "words": ["w018", "w019"], "anchor": "w018", "gloss": "Your name" }] },
    "s07": { "translation": "Thy kingdom come.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 9", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }], "alignments": [{ "words": ["w021", "w022"], "anchor": "w021", "gloss": "Your kingdom" }] },
    "s08": { "translation": "Thy will be done on earth as it is in heaven.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 9", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }], "alignments": [{ "words": ["w024", "w025"], "anchor": "w024", "gloss": "Your will" }] },
    "s09": { "translation": "Give us this day our daily bread.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 9", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }], "alignments": [{ "words": ["w032", "w033", "w034"], "anchor": "w032", "gloss": "Our daily bread" }] },
    "s10": { "translation": "And forgive us our trespasses, as we forgive those who trespass against us.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 9", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }], "alignments": [{ "words": ["w041", "w042"], "anchor": "w041", "gloss": "our debts" }, { "words": ["w047", "w048"], "anchor": "w047", "gloss": "our debtors" }] },
    "s11": { "translation": "And lead us not into temptation,", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 9", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s12": { "translation": "but deliver us from evil.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 9", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] },
    "s13": { "narrative": "The priest says Amen silently." },
    "s14": { "translation": "Amen.", "translation_citations": [{ "title": "Key of Heaven (1901)", "locator": "printed p. 9", "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu" }] }
  },
