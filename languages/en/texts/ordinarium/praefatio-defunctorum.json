  "text": "ordinarium.praefatio-defunctorum",
  "about": "The Preface for the Dead. It proclaims the hope of resurrection and confesses that the life of the faithful is changed, not ended, and that an eternal home in heaven awaits after the earthly dwelling.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:", "alignments": [{ "words": ["w010", "w011", "w012", "w013", "w014", "w015"], "anchor": "w015", "gloss": "always and everywhere give thanks to You" }] },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God: through Christ our Lord.", "alignments": [{ "words": ["w024", "w025"], "anchor": "w024", "gloss": "our Lord" }] },
    "s04": { "translation": "In Him the hope of a blessed resurrection has shone forth for us, so that those whom the certain lot of dying saddens may be consoled by the promise of future immortality." },
    "s05": { "translation": "For to Your faithful, O Lord, life is changed, not taken away; and when the house of this earthly sojourn is dissolved, an eternal dwelling is prepared in heaven.", "alignments": [{ "words": ["w044", "w045", "w046"], "anchor": "w046", "gloss": "For to Your faithful" }, { "words": ["w050", "w051"], "anchor": "w051", "gloss": "is not taken away" }, { "words": ["w054", "w055", "w056"], "anchor": "w056", "gloss": "of this earthly sojourn" }] },
    "s06": { "translation": "And therefore with Angels and Archangels, with Thrones and Dominions, and with all the host of the heavenly army, we sing the hymn of Your glory, evermore saying:", "alignments": [{ "words": ["w079", "w080"], "anchor": "w079", "gloss": "of Your glory" }] }
  },
