  "text": "ordinarium.praefatio-quadragesimae",
  "about": "The Lenten Preface. It praises God, Who by fasting restrains vices, uplifts the mind, and bestows virtue and rewards.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "Truly it is right and just, fitting and leading to salvation, that we should give You thanks always and everywhere:" },
    "s03": { "translation": "O Lord, holy Father, almighty eternal God:" },
    "s04": { "translation": "By bodily fasting You restrain vices, uplift the mind, and bestow virtue and rewards: through Christ our Lord." },
    "s05": { "translation": "Through Him the Angels praise Your majesty, the Dominions adore it, and the Powers tremble before it." },
    "s06": { "translation": "The heavens, the heavenly Virtues, and the blessed Seraphim join in joyful celebration of Your majesty." },
    "s07": { "translation": "We beseech You to admit our voices to join theirs as we speak in humble confession:", "alignments": [{ "words": ["w056", "w057", "w058", "w059", "w060", "w061", "w062", "w063", "w064"], "anchor": "w064", "gloss": "We pray that You command our voices also to be admitted with them" }, { "words": ["w065", "w066", "w067"], "anchor": "w067", "gloss": "saying in humble confession" }] }
  },
