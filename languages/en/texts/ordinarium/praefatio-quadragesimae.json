  "text": "ordinarium.praefatio-quadragesimae",
  "about": "The Lenten Preface. It praises God, Who by fasting restrains vices, uplifts the mind, and bestows virtue and rewards.",
  "segments": {
    "s01": { "narrative": "Then the priest separates his hands and holds them apart until the end of the Preface. When it is finished, he joins them again and, bowing, says: Sanctus." },
    "s02": { "translation": "It is truly meet and just, right and profitable for salvation, that we should at all times and in all places give thanks unto Thee:" },
    "s03": { "translation": "O Lord, holy Father, almighty, eternal God:" },
    "s04": { "translation": "Who by bodily fasting dost restrain vices, uplift the mind, and bestow virtue and rewards: through Christ our Lord." },
    "s05": { "translation": "Through Whom the Angels praise Thy majesty, the Dominions adore it, and the Powers tremble before it." },
    "s06": { "translation": "The heavens, the heavenly Virtues, and the blessed Seraphim join in joyful celebration of Thy majesty." },
    "s07": { "translation": "We beseech Thee to admit our voices to join theirs as we speak in humble confession:" }
  },
