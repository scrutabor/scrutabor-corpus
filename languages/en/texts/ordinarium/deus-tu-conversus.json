  "text": "ordinarium.deus-tu-conversus",
  "about": "The first three exchanges are Psalm 84:7–8 and Psalm 101:2 in the Vulgate numbering, from the Gallican psalter the Mass uses: it opens the first of them Deus, tu convérsus where later editions read Nonne tu convérsus. The last is the liturgical greeting “Dóminus vobíscum” and its response.",
  "segments": {
    "s01": { "narrative": "Bowed, the priest continues." },
    "s02": { "translation": "You will turn back, O God, and give us life.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "parallel Ordinary and Advent propers, examined edition", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s03": { "translation": "And Your people will rejoice in You.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 39", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s04": { "translation": "Show us Your mercy, O Lord.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 39", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s05": { "translation": "And grant us Your salvation.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 39", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s06": { "translation": "O Lord, hear my prayer.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 39", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s07": { "translation": "And let my cry come to You.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 39", "url": "https://archive.org/details/TheMissalForTheLaity" }] },
    "s08": { "translation": "The Lord be with you.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 39", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w032", "w033"], "anchor": "w032", "gloss": "The Lord be with you" }] },
    "s09": { "translation": "And with your spirit.", "translation_citations": [{ "title": "The Missal for the Laity (1846)", "locator": "printed p. 39", "url": "https://archive.org/details/TheMissalForTheLaity" }], "alignments": [{ "words": ["w036", "w037"], "anchor": "w036", "gloss": "your spirit" }] }
  },
