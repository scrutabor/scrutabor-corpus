  "text": "ordinarium.unde-et-memores",
  "about": "The Church remembers Christ's blessed Passion, Resurrection, and glorious Ascension. From the gifts received from God, it offers to His majesty a pure Victim, a holy Victim, a spotless Victim, the holy Bread of eternal life and the Chalice of everlasting salvation.",
  "segments": {
    "s01": { "narrative": "The priest parts his hands." },
    "s02": { "translation": "Therefore, O Lord, we, Your servants, and likewise Your holy people, mindful of the blessed Passion of the same Christ, Your Son, our Lord, of His Resurrection from the dead, and of His glorious Ascension into heaven:", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 26", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 66–67", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 91", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s03": { "translation": "offer to Your excellent majesty, from Your own gifts and all that You have bestowed upon us,", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 26", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 66–67", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 91", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s04": { "narrative": "The priest joins his hands and makes three signs of the cross over the Host and chalice together." },
    "s05": { "translation": "a pure Victim, a holy Victim, a spotless Victim,", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 26", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 66–67", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 91", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s06": { "narrative": "The priest makes one sign of the cross over the Host." },
    "s07": { "translation": "the holy Bread of eternal life", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 26", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 66–67", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 91", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] },
    "s08": { "narrative": "The priest makes one sign of the cross over the chalice." },
    "s09": { "translation": "and the Chalice of everlasting salvation.", "translation_citations": [{ "title": "The Missal for the Use of the Laity (1853)", "locator": "printed p. 26", "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth" }, { "title": "The Missal for the Laity (1846)", "locator": "printed pp. 66–67", "url": "https://archive.org/details/TheMissalForTheLaity" }, { "title": "The Family Prayer-book (1839)", "locator": "printed p. 91", "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf" }] }
