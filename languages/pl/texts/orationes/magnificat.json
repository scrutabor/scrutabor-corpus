{
  "schema_version": "0.17.0",
  "language": "pl",
  "text": "orationes.magnificat",
  "about": "Magníficat to pieśń Maryi z Ewangelii według św. Łukasza (Łk 1,46–55), śpiewana w rzymskich nieszporach. Ta edycja zachowuje tradycyjny tekst łaciński i dziesięć numerowanych wersetów biblijnych, po których umieszcza osobno doksologię Chwała Ojcu.",
  "segments": {
    "s01": { "translation": "Wielbi dusza moja Pana.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s02": { "translation": "I rozradował się duch mój w Bogu, moim Zbawicielu.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s03": { "translation": "Bo wejrzał na uniżenie swojej służebnicy: oto bowiem odtąd wszystkie pokolenia będą mnie zwać błogosławioną.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s04": { "translation": "Gdyż wielkie rzeczy uczynił mi Ten, który jest potężny, i święte jest Jego imię.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s05": { "translation": "A Jego miłosierdzie z pokolenia na pokolenie dla tych, którzy się Go boją.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s06": { "translation": "Okazał moc swoim ramieniem; rozproszył pyszniących się zamysłami swoich serc.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s07": { "translation": "Strącił możnych z tronu, a wywyższył pokornych.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s08": { "translation": "Głodnych napełnił dobrami, a bogatych odesłał z niczym.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s09": { "translation": "Ujął się za Izraelem, swoim sługą, pamiętając o swoim miłosierdziu.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s10": { "translation": "Jak powiedział naszym ojcom, Abrahamowi i jego potomstwu na wieki.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s11": { "translation": "Chwała Ojcu i Synowi, i Duchowi Świętemu.", "translation_citations": [{ "title": "Książka do nabożeństwa (1883)", "locator": "printed p. 498", "url": "https://commons.wikimedia.org/wiki/File:Ksi%C4%85%C5%BCka_do_nabo%C5%BCe%C5%84stwa_O._Karola_Antoniewicza.djvu" }, { "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 12", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s12": { "translation": "Jak była na początku, teraz i zawsze, i na wieki wieków. Amen.", "translation_citations": [{ "title": "Książka do nabożeństwa (1883)", "locator": "printed p. 498", "url": "https://commons.wikimedia.org/wiki/File:Ksi%C4%85%C5%BCka_do_nabo%C5%BCe%C5%84stwa_O._Karola_Antoniewicza.djvu" }, { "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 12", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] }
  },
