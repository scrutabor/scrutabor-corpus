{
  "schema_version": "0.16.0",
  "language": "pl",
  "text": "orationes.magnificat",
  "about": "Magníficat to pieśń Maryi z Ewangelii według św. Łukasza (Łk 1,46–55), śpiewana w rzymskich nieszporach. Ta edycja zachowuje tradycyjny tekst łaciński i dziesięć numerowanych wersetów biblijnych, po których umieszcza osobno doksologię Chwała Ojcu.",
  "segments": {
    "s01": { "translation": "Wielbi dusza moja Pana.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s02": { "translation": "I rozradował się duch mój w Bogu, moim Zbawicielu.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s03": { "translation": "Bo wejrzał na uniżenie swojej służebnicy: oto bowiem odtąd wszystkie pokolenia będą mnie zwać błogosławioną.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s04": { "translation": "Gdyż wielkie rzeczy uczynił mi Ten, który jest potężny, i święte jest Jego imię.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s05": { "translation": "A Jego miłosierdzie z pokolenia na pokolenie dla tych, którzy się Go boją.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s06": { "translation": "Okazał moc swoim ramieniem; rozproszył pyszniących się zamysłami swoich serc.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s07": { "translation": "Strącił możnych z tronu, a wywyższył pokornych.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s08": { "translation": "Głodnych napełnił dobrami, a bogatych odesłał z niczym.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s09": { "translation": "Ujął się za Izraelem, swoim sługą, pamiętając o swoim miłosierdziu.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s10": { "translation": "Jak powiedział naszym ojcom, Abrahamowi i jego potomstwu na wieki.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "Magnificat, printed pp. 324–325", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s11": { "translation": "Chwała Ojcu i Synowi, i Duchowi Świętemu.", "translation_citations": [{ "title": "Książka do nabożeństwa (1883)", "locator": "printed p. 498", "url": "https://commons.wikimedia.org/wiki/File:Ksi%C4%85%C5%BCka_do_nabo%C5%BCe%C5%84stwa_O._Karola_Antoniewicza.djvu" }, { "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 12", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s12": { "translation": "Jak była na początku, teraz i zawsze, i na wieki wieków. Amen.", "translation_citations": [{ "title": "Książka do nabożeństwa (1883)", "locator": "printed p. 498", "url": "https://commons.wikimedia.org/wiki/File:Ksi%C4%85%C5%BCka_do_nabo%C5%BCe%C5%84stwa_O._Karola_Antoniewicza.djvu" }, { "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 12", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] }
  },
  "words": {
    "w001": { "gloss": "wielbi", "function": "Orzeczenie, którego podmiotem jest „ánima” (w002), a dopełnieniem „Dóminum” (w004)." },
    "w002": { "gloss": "dusza" },
    "w003": { "gloss": "moja" },
    "w004": { "gloss": "Pana" },
    "w005": { "gloss": "i" },
    "w006": { "gloss": "rozradował się", "function": "Perfectum indicativi. Podmiotem jest „spíritus” (w007)." },
    "w007": { "gloss": "duch" },
    "w008": { "gloss": "mój" },
    "w009": { "gloss": "w" },
    "w010": { "gloss": "Bogu" },
    "w011": { "gloss": "Zbawicielu", "function": "Przymiotnik użyty rzeczownikowo, który z „Deo” tworzy określenie Boga jako mojego Zbawiciela." },
    "w012": { "gloss": "moim" },
    "w013": { "gloss": "bo", "function": "Wprowadza przyczynę radości Maryi." },
    "w014": { "gloss": "wejrzał na" },
    "w015": { "gloss": "uniżenie", "function": "Dopełnienie „respéxit”. Greckie ταπείνωσις potwierdza tutaj niski stan służebnicy, nie pochwałę jej własnego osiągnięcia moralnego." },
    "w016": { "gloss": "służebnicy" },
    "w017": { "gloss": "swojej", "function": "Odnosi służebnicę do Boga, domyślnego podmiotu „respéxit”." },
    "w018": { "gloss": "oto" },
    "w019": { "gloss": "bowiem" },
    "w020": { "gloss": "od" },
    "w021": { "gloss": "tej chwili", "function": "Z „ex” tworzy wyrażenie czasowe „odtąd”." },
    "w022": { "gloss": "błogosławioną", "function": "Orzecznik przy „me” w konstrukcji zależnej od „dicent”." },
    "w023": { "gloss": "mnie" },
    "w024": { "gloss": "będą zwać" },
    "w025": { "gloss": "wszystkie" },
    "w026": { "gloss": "pokolenia", "function": "Podmiot przyszłego „dicent”. Oznacza pokolenia, nie narody." },
    "w027": { "gloss": "gdyż" },
    "w028": { "gloss": "uczynił" },
    "w029": { "gloss": "mi", "function": "Celownik korzyści: wielkie rzeczy uczynione Maryi lub dla Maryi." },
    "w030": { "gloss": "wielkie rzeczy", "function": "Przymiotnik rodzaju nijakiego użyty rzeczownikowo jako dopełnienie „fecit”." },
    "w031": { "gloss": "Ten, który", "function": "Domyślny podmiot „fecit”, określony przez „potens est”." },
    "w032": { "gloss": "potężny" },
    "w033": { "gloss": "jest" },
    "w034": { "gloss": "i" },
    "w035": { "gloss": "święte", "function": "Orzecznik przy domyślnym „est”, odnoszący się do „nomen”." },
    "w036": { "gloss": "imię" },
    "w037": { "gloss": "Jego", "function": "Dopełniacz wskazujący na Boga, który uczynił wielkie rzeczy." },
    "w038": { "gloss": "a" },
    "w039": { "gloss": "miłosierdzie", "function": "Podmiot zdania z domyślnym łącznikiem „jest”." },
    "w040": { "gloss": "Jego" },
    "w041": { "gloss": "z" },
    "w042": { "gloss": "pokolenia" },
    "w043": { "gloss": "na" },
    "w044": { "gloss": "pokolenia", "function": "Z `a progénie` tworzy wyrażenie trwania miłosierdzia poprzez kolejne pokolenia." },
    "w045": { "gloss": "bojącym się", "function": "Imiesłów użyty rzeczownikowo w celowniku. Nazywa tych, ku którym zwraca się miłosierdzie." },
    "w046": { "gloss": "Go", "function": "Dopełnienie „timéntibus”. Odnosi się do Boga." },
    "w047": { "gloss": "okazał" },
    "w048": { "gloss": "moc", "function": "Dopełnienie „Fecit”: dosłownie uczynił/okazał moc." },
    "w049": { "gloss": "w" },
    "w050": { "gloss": "ramieniu", "function": "Ablativus instrumenti z „in”, obraz Bożego działania z mocą." },
    "w051": { "gloss": "swoim", "function": "Odnosi ramię do Boga, podmiotu „Fecit”." },
    "w052": { "gloss": "rozproszył" },
    "w053": { "gloss": "pysznych", "function": "Przymiotnik użyty rzeczownikowo jako dopełnienie „dispérsit”." },
    "w054": { "gloss": "zamysłem", "function": "Ablativus względu/sfery: pycha ujawnia się w zamyśle serca." },
    "w055": { "gloss": "serca" },
    "w056": { "gloss": "swojego", "function": "Łacińska liczba pojedyncza jest dystrybutywna: serce należy do każdego z pysznych. Greckie αὐτῶν jawnie potwierdza referent mnogi, nie serce Boga." },
    "w057": { "gloss": "strącił" },
    "w058": { "gloss": "możnych", "function": "Przymiotnik użyty rzeczownikowo jako dopełnienie „Depósuit”." },
    "w059": { "gloss": "z" },
    "w060": { "gloss": "tronu", "function": "Ablativus po „de”, oznaczający miejsce, z którego możni zostają strąceni." },
    "w061": { "gloss": "a" },
    "w062": { "gloss": "wywyższył" },
    "w063": { "gloss": "pokornych", "function": "Przymiotnik użyty rzeczownikowo, przeciwstawiony możnym." },
    "w064": { "gloss": "głodnych", "function": "Imiesłów użyty rzeczownikowo jako dopełnienie „implévit”." },
    "w065": { "gloss": "napełnił" },
    "w066": { "gloss": "dobrami", "function": "Przymiotnik użyty rzeczownikowo w narzędniku treści lub napełnienia." },
    "w067": { "gloss": "a" },
    "w068": { "gloss": "bogatych", "function": "Przymiotnik użyty rzeczownikowo jako dopełnienie „dimísit”." },
    "w069": { "gloss": "odesłał" },
    "w070": { "gloss": "z niczym", "function": "Orzecznik przy „dívites”: bogaci odchodzą puści." },
    "w071": { "gloss": "ujął się za", "function": "W tym biblijnym kontekście oznacza przyjście Izraelowi z pomocą. Greckie ἀντελάβετο potwierdza aktywne wsparcie." },
    "w072": { "gloss": "Izraelem" },
    "w073": { "gloss": "sługą", "function": "Dopowiedzenie do „Israël”. Greckie παῖς potwierdza znaczenie „sługa”, nie „chłopiec”." },
    "w074": { "gloss": "swoim" },
    "w075": { "gloss": "pamiętając", "function": "Imiesłów perfectum czasownika deponentnego. Forma bierna ma znaczenie czynne i odnosi się do Boga." },
    "w076": { "gloss": "o miłosierdziu", "function": "Dopełniacz zależny od „recordátus”." },
    "w077": { "gloss": "swoim", "function": "Odnosi miłosierdzie do Boga. Inaczej niż „sui” w s06 nie odnosi się do pysznych." },
    "w078": { "gloss": "jak", "function": "Łączy pomoc i pamięć o miłosierdziu z wcześniejszą obietnicą Boga." },
    "w079": { "gloss": "powiedział", "function": "Imiesłów deponentny z „est” (w080): forma bierna, znaczenie czynne." },
    "w080": { "gloss": "—" },
    "w081": { "gloss": "do" },
    "w082": { "gloss": "ojców" },
    "w083": { "gloss": "naszych" },
    "w084": { "gloss": "Abrahamowi", "function": "Biblijne imię użyte nieodmiennie w celowniku, równolegle do „sémini”." },
    "w085": { "gloss": "i" },
    "w086": { "gloss": "potomstwu", "function": "Celownik liczby pojedynczej. Rzeczownik zbiorowy oznacza potomstwo Abrahama." },
    "w087": { "gloss": "jego", "function": "Odnosi potomstwo do Abrahama." },
