  "text": "orationes.alma-redemptoris-mater",
  "about": "Alma Redemptoris Mater jest maryjną antyfoną końcową okresu od Adwentu do Oczyszczenia Najświętszej Maryi Panny. Wierni proszą Maryję, Matkę Odkupiciela, aby wspomogła upadający lud i zmiłowała się nad grzesznikami.",
  "segments": {
    "s01": { "translation": "Dobrotliwa Matko Odkupiciela, która trwasz jako otwarta brama nieba", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 117", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s02": { "translation": "i gwiazda morza, pospiesz z pomocą upadającemu", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 117", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s03": { "translation": "ludowi, który stara się powstać:", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 117", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s04": { "translation": "ty, która zrodziłaś, ku zdumieniu natury, swojego świętego Stwórcę,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 117", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s05": { "translation": "Panno przedtem i potem,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 117", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s06": { "translation": "przyjmując z ust Gabriela owo „Ave”, zmiłuj się nad grzesznikami.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 117", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] }
  },
