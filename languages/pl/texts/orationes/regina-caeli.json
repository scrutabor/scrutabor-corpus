  "text": "orationes.regina-caeli",
  "about": "Antyfona maryjna okresu wielkanocnego, która stoi od komplety Wielkiej Soboty do soboty po Zesłaniu Ducha Świętego i w tym okresie zastępuje Anioła Pańskiego. Wzywa Najświętszą Maryję Pannę do radości ze zmartwychwstania Jej Syna i prosi Ją o modlitwę za nami. Po antyfonie następuje werset z odpowiedzią, wyznający prawdziwe zmartwychwstanie Pana.",
  "segments": {
    "s01": { "translation": "Królowo nieba, wesel się, alleluja;", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 16", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 154", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s02": { "translation": "bo Ten, któregoś nosiła, alleluja,", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 16", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 154", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s03": { "translation": "zmartwychpowstał, jak powiedział, alleluja.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 16", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 154", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s04": { "translation": "Módl się za nami do Boga, alleluja.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 16", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 154", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s05": { "translation": "Raduj się i wesel, Panno Maryjo, alleluja.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 16", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 154", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s06": { "translation": "Bo zmartwychwstał Pan prawdziwie, alleluja.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 16", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 154", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] }
  },
  "words": {
    "w001": { "gloss": "Królowo" },
    "w002": { "gloss": "nieba", "function": "Dopełniacz zależny od „Regína” (w001)." },
    "w003": { "gloss": "wesel się", "function": "Tryb rozkazujący czasownika deponentnego: forma bierna, znaczenie czynne." },
    "w004": { "gloss": "alleluja" },
    "w005": { "gloss": "albowiem" },
    "w006": { "gloss": "którego", "function": "Biernik, dopełnienie „portáre” (w008)." },
    "w007": { "gloss": "zasłużyłaś", "function": "Perfectum indicativi czasownika deponentnego „méreor”. Z bezokolicznikiem znaczy tutaj: byłaś godna, aby coś uczynić." },
    "w008": { "gloss": "nosić", "function": "Bezokolicznik zależny od „meruísti” (w007)." },
    "w009": { "gloss": "alleluja" },
    "w010": { "gloss": "zmartwychwstał", "function": "Orzeczenie zdania głównego. Podmiotem jest domyślny poprzednik „quem” (w006)." },
    "w011": { "gloss": "jak" },
    "w012": { "gloss": "powiedział", "function": "Perfectum indicativi z tym samym podmiotem co „Resurréxit” (w010)." },
    "w013": { "gloss": "alleluja" },
    "w014": { "gloss": "módl się", "function": "Tryb rozkazujący skierowany do Maryi." },
    "w015": { "gloss": "za" },
    "w016": { "gloss": "nami", "function": "Ablativus po „pro” (w015): ci, w czyjej sprawie się prosi." },
    "w017": { "gloss": "Boga", "function": "Biernik, dopełnienie „Ora” (w014). Czasownik „oráre” łączy się z biernikiem osoby proszonej, a fraza pro nobis wskazuje, za kim wstawiana jest prośba." },
    "w018": { "gloss": "alleluja" },
    "w019": { "gloss": "raduj się", "function": "Czynny tryb rozkazujący. Synonimiczne „lætáre” (w021) jest deponentne." },
    "w020": { "gloss": "i" },
    "w021": { "gloss": "wesel się" },
    "w022": { "gloss": "Panno" },
    "w023": { "gloss": "Maryjo", "function": "Wołacz. Werset nazywa Maryję, do której zwraca się antyfona." },
    "w024": { "gloss": "alleluja" },
    "w025": { "gloss": "bo" },
    "w026": { "gloss": "zmartwychwstał", "function": "Forma od súrgo, bez przedrostka re-. Podobnie jak „Resurréxit” (w010), odnosi się tu do zmartwychwstania Chrystusa." },
    "w027": { "gloss": "Pan", "function": "Mianownik, podmiot „surréxit” (w026)." },
    "w028": { "gloss": "prawdziwie" },
    "w029": { "gloss": "alleluja" }
  }
