{
  "schema_version": "0.18.0",
  "language": "pl",
  "text": "orationes.angelus-domini",
  "about": "Anioł Pański odmawia się trzy razy dziennie: o świcie, w południe i pod wieczór, a to wydanie drukuje trzy Zdrowaś Maryjo, które się w nim odmawia. W okresie wielkanocnym jego miejsce zajmuje Regína cæli.",
  "segments": {
    "s01": { "translation": "Anioł Pański zwiastował Pannie Maryi.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 15", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s02": { "translation": "I poczęła z Ducha Świętego.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 15", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s03": { "translation": "Zdrowaś Maryjo, łaski pełna, Pan z Tobą, błogosławionaś Ty między niewiastami i błogosławiony owoc żywota Twojego, Jezus. Święta Maryjo, Matko Boża, módl się za nami grzesznymi teraz i w godzinę śmierci naszej. Amen.", "translation_citations": [{ "title": "Książka do nabożeństwa (1883)", "locator": "printed pp. 2–3", "url": "https://commons.wikimedia.org/wiki/File:Ksi%C4%85%C5%BCka_do_nabo%C5%BCe%C5%84stwa_O._Karola_Antoniewicza.djvu" }, { "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 11", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s04": { "translation": "Oto ja, służebnica Pańska.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 15", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s05": { "translation": "Niech mi się stanie według słowa Twego.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 15", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s06": { "translation": "Zdrowaś Maryjo, łaski pełna, Pan z Tobą, błogosławionaś Ty między niewiastami i błogosławiony owoc żywota Twojego, Jezus. Święta Maryjo, Matko Boża, módl się za nami grzesznymi teraz i w godzinę śmierci naszej. Amen.", "translation_citations": [{ "title": "Książka do nabożeństwa (1883)", "locator": "printed pp. 2–3", "url": "https://commons.wikimedia.org/wiki/File:Ksi%C4%85%C5%BCka_do_nabo%C5%BCe%C5%84stwa_O._Karola_Antoniewicza.djvu" }, { "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 11", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s07": { "translation": "A Słowo ciałem się stało.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 15", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }, { "title": "Gazeta Kościelna, R. 9, nr 16 (1901)", "locator": "printed p. 167", "url": "https://jbc.bj.uj.edu.pl/dlibra/publication/951462/edition/913560/gazeta-koscielna-pismo-poswiecone-sprawom-koscielnym-i-spolecznym-organ-towarzystwa-wzajem-pomocy-kaplanow-r-9-1901-nr-16" }] },
    "s08": { "translation": "I zamieszkało między nami.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 15", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }, { "title": "Gazeta Kościelna, R. 9, nr 16 (1901)", "locator": "printed p. 167", "url": "https://jbc.bj.uj.edu.pl/dlibra/publication/951462/edition/913560/gazeta-koscielna-pismo-poswiecone-sprawom-koscielnym-i-spolecznym-organ-towarzystwa-wzajem-pomocy-kaplanow-r-9-1901-nr-16" }] },
    "s09": { "translation": "Zdrowaś Maryjo, łaski pełna, Pan z Tobą, błogosławionaś Ty między niewiastami i błogosławiony owoc żywota Twojego, Jezus. Święta Maryjo, Matko Boża, módl się za nami grzesznymi teraz i w godzinę śmierci naszej. Amen.", "translation_citations": [{ "title": "Książka do nabożeństwa (1883)", "locator": "printed pp. 2–3", "url": "https://commons.wikimedia.org/wiki/File:Ksi%C4%85%C5%BCka_do_nabo%C5%BCe%C5%84stwa_O._Karola_Antoniewicza.djvu" }, { "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 11", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s10": { "translation": "Módl się za nami, święta Boża Rodzicielko.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 15", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s11": { "translation": "Abyśmy się stali godnymi obietnic Chrystusowych.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 15", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s12": { "translation": "Módlmy się.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 15", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s13": { "translation": "Łaskę Twoją, prosimy Cię, Panie, racz wlać w serca nasze, abyśmy, którzy za zwiastowaniem anielskim wcielenie Chrystusa, Syna Twego, poznali, przez mękę Jego i krzyż do chwały zmartwychwstania byli doprowadzeni. Przez tegoż Chrystusa, Pana naszego. Amen.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed pp. 15–16", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] }
  },
