{
  "schema_version": "0.17.0",
  "language": "pl",
  "text": "orationes.symbolum-apostolorum",
  "about": "Skład Apostolski jest starożytnym symbolem chrzcielnym Kościoła rzymskiego, tradycyjnie ujmowanym w dwunastu artykułach. W pierwszej osobie wyznaje wiarę w Boga Ojca, Jezusa Chrystusa i Ducha Świętego, a następnie w Kościół, odpuszczenie grzechów, zmartwychwstanie ciała i życie wieczne. Ta recenzja zachowuje powtórzone Credo przed artykułami o Duchu Świętym.",
  "segments": {
    "s01": { "translation": "Wierzę w Boga, Ojca wszechmogącego, Stworzyciela nieba i ziemi.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 7–8", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s02": { "translation": "I w Jezusa Chrystusa, Syna Jego jedynego, Pana naszego,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 7–8", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s03": { "translation": "który się począł z Ducha Świętego, narodził się z Maryi Panny,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 7–8", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s04": { "translation": "umęczon pod Ponckim Piłatem, ukrzyżowan, umarł i pogrzebion,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 7–8", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s05": { "translation": "zstąpił do piekieł,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 7–8", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s06": { "translation": "trzeciego dnia zmartwychwstał,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 7–8", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s07": { "translation": "wstąpił na niebiosa,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 7–8", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s08": { "translation": "siedzi po prawicy Boga Ojca wszechmogącego,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 7–8", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Mt 22, 44; DjVu scan 897, printed p. 31", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s09": { "translation": "stamtąd przyjdzie sądzić żywych i umarłych.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 7–8", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s10": { "translation": "Wierzę w Ducha Świętego,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 7–8", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s11": { "translation": "święty Kościół powszechny, świętych obcowanie,", "translation_citations": [{ "title": "Książka do nabożeństwa (1883)", "locator": "printed p. 3", "url": "https://commons.wikimedia.org/wiki/File:Ksi%C4%85%C5%BCka_do_nabo%C5%BCe%C5%84stwa_O._Karola_Antoniewicza.djvu" }] },
    "s12": { "translation": "grzechów odpuszczenie, ciała zmartwychwstanie, żywot wieczny. Amen.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 7–8", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] }
  },
