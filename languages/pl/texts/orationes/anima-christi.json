  "language": "pl",
  "text": "orationes.anima-christi",
  "about": "Anima Christi jest chrystocentryczną modlitwą dewocyjną zbudowaną z krótkich wezwań. Prosi duszę, ciało, krew, wodę z boku i mękę Chrystusa o uświęcenie, zbawienie, napojenie, obmycie i umocnienie, a Jezusa o wysłuchanie, ukrycie w ranach, obronę, wezwanie w godzinie śmierci i przyjęcie do wiecznej chwały ze świętymi.",
  "segments": {
    "s01": { "translation": "Duszo Chrystusowa, uświęć mnie.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s02": { "translation": "Ciało Chrystusowe, zbaw mnie.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s03": { "translation": "Krwi Chrystusowa, napój mnie.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s04": { "translation": "Wodo z boku Chrystusowego, obmyj mnie.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s05": { "translation": "Męko Chrystusowa, wzmocnij mnie.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s06": { "translation": "O dobry Jezu, wysłuchaj mnie.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s07": { "translation": "W ranach swoich ukryj mnie.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s08": { "translation": "Nie dozwól mi odłączyć się od Ciebie.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s09": { "translation": "Od złego ducha broń mnie.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s10": { "translation": "W godzinę śmierci wezwij mnie.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s11": { "translation": "I każ mi przyjść do siebie,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s12": { "translation": "abym ze świętymi Twoimi chwalił Cię", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s13": { "translation": "na wieki wieków. Amen.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }, { "title": "Katolik w modlitwie (1902)", "locator": "printed p. 157", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] }
  },
