  "text": "orationes.memorare",
  "about": "Memorare jest maryjną modlitwą błagalną. Przywołuje przekonanie, że nie opuszczono nikogo, kto uciekał się pod opiekę Maryi, wzywał Jej pomocy i prosił o wstawiennictwo. Ożywiony tą ufnością grzesznik staje przed Matką Słowa i prosi, aby łaskawie usłyszała i wysłuchała jego słów.",
  "segments": {
    "s01": { "translation": "Pomnij, o Najświętsza Panno Maryjo, że nigdy nie słyszano,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 155–156", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s02": { "translation": "abyś opuściła tego, kto się do Ciebie ucieka, Twej pomocy wzywa, Ciebie o przyczynę prosi.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 155–156", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s03": { "translation": "Tą ufnością ożywiony, do Ciebie, o Panno nad pannami i Matko, biegnę,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 155–156", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s04": { "translation": "do Ciebie przychodzę, przed Tobą jako grzesznik płaczący staję.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 155–156", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s05": { "translation": "O, Matko Słowa, racz nie gardzić słowami moimi,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 155–156", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s06": { "translation": "ale usłysz je łaskawie i wysłuchaj.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed pp. 155–156", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s07": { "translation": "Amen." }
  },
