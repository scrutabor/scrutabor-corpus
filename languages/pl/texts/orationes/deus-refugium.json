  "language": "pl",
  "text": "orationes.deus-refugium",
  "about": "Kolekta modlitw Leona XIII odmawianych po Mszy cichej, następująca po Salve Regína i jej wersecie. Prosi Boga, aby łaskawie wejrzał na wołający do Niego lud i wysłuchał próśb zanoszonych za wstawiennictwem Najświętszej Maryi Panny, św. Józefa, Apostołów Piotra i Pawła oraz wszystkich świętych. Wymienia dwie intencje: nawrócenie grzeszników oraz wolność i wywyższenie Kościoła.",
  "segments": {
    "s01": { "translation": "Módlmy się.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scan 121 / printed p. 107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s02": { "translation": "Boże, nasza ucieczko i mocy, łaskawie wejrzyj na lud wołający do Ciebie;", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scan 121 / printed p. 107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s03": { "translation": "a za wstawiennictwem chwalebnej i niepokalanej Dziewicy Maryi, Bożej Rodzicielki,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scan 121 / printed p. 107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s04": { "translation": "świętego Józefa, Jej Oblubieńca, Twoich świętych Apostołów Piotra i Pawła oraz wszystkich Świętych,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scan 121 / printed p. 107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s05": { "translation": "modlitwy, które zanosimy o nawrócenie grzeszników oraz o wolność i wywyższenie świętej Matki Kościoła,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scan 121 / printed p. 107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s06": { "translation": "wysłuchaj w swoim miłosierdziu i dobroci.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scan 121 / printed p. 107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s07": { "translation": "Przez tegoż Chrystusa, Pana naszego. Amen.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scan 121 / printed p. 107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] }
  },
