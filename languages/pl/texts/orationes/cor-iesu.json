  "text": "orationes.cor-iesu",
  "about": "Wezwanie zamykające modlitwy Leona XIII, dołączone do nich w 1904 r. za Piusa X. Powtarza się je trzy razy. To wydanie drukuje je raz.",
  "segments": {
    "s01": { "translation": "Najświętsze Serce Jezusa.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s02": { "translation": "Zmiłuj się nad nami.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 158", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] }
  },
  "words": {
    "w001": { "gloss": "Serce", "explanation": "Nijakie „Cor” ma jedną formę dla podmiotu i zawołania, a wydanie czyta początkowe wezwanie jako nazwanie w mianowniku, jak w „Agnus Dei”." },
    "w002": { "gloss": "Jezusa" },
    "w003": { "gloss": "najświętsze" },
    "w004": { "gloss": "zmiłuj się" },
    "w005": { "gloss": "nad nami" }
  }
}
