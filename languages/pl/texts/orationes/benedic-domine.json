  "text": "orationes.benedic-domine",
  "about": "Benedic, Domine jest krótką modlitwą błogosławieństwa przed posiłkiem. Zgromadzeni proszą Pana o pobłogosławienie ich samych i darów, które mają przyjąć z Jego hojności, a prośbę zanoszą przez Chrystusa.",
  "segments": {
    "s01": { "translation": "Pobłogosław, o Panie, nas", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 153", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s02": { "translation": "i te dary Twoje,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 153", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s03": { "translation": "które z Twej dobroci spożywać będziemy.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 153", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s04": { "translation": "Przez Chrystusa Pana naszego. Amen.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 153", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] }
