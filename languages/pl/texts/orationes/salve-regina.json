{
  "schema_version": "0.17.0",
  "language": "pl",
  "text": "orationes.salve-regina",
  "about": "Antyfona maryjna odmawiana po Mszy cichej w modlitwach Leona XIII, a w komplecie przez długi okres po Zesłaniu Ducha Świętego. Zwraca się do Najświętszej Maryi Panny jako Królowej i Matki miłosierdzia, a wygnańcy, synowie Ewy, proszą Ją, aby zwróciła ku nim swoje miłosierne oczy i po tym wygnaniu ukazała im Jezusa. Po antyfonie następuje werset z odpowiedzią.",
  "segments": {
    "s01": { "translation": "Witaj, Królowo, Matko miłosierdzia, życie, słodyczy i nadziejo nasza, witaj.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed pp. 106–107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 155", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s02": { "translation": "Do Ciebie wołamy wygnańcy, synowie Ewy.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed pp. 106–107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 155", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s03": { "translation": "Do Ciebie wzdychamy, jęcząc i płacząc na tym łez padole.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed pp. 106–107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 155", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s04": { "translation": "Przeto, Orędowniczko nasza, one miłosierne oczy Twoje na nas zwróć.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed pp. 106–107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 155", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s05": { "translation": "A Jezusa, błogosławiony owoc żywota Twojego, po tym wygnaniu nam okaż.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed pp. 106–107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 155", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s06": { "translation": "O łaskawa, o litościwa, o słodka Panno Maryjo.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed pp. 106–107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 155", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s07": { "translation": "Módl się za nami, święta Boża Rodzicielko.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 154", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s08": { "translation": "Abyśmy się stali godnymi obietnic Chrystusowych.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 107", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }, { "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 154", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] }
  },
