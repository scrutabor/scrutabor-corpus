  "text": "orationes.agimus-tibi-gratias",
  "about": "Agimus tibi gratias jest krótką modlitwą dziękczynną tradycyjnie odmawianą po posiłku. Zgromadzeni dziękują wszechmogącemu Bogu za wszystkie Jego dobrodziejstwa i wyznają, że żyje i króluje na wieki.",
  "segments": {
    "s01": { "translation": "Dziękujemy Ci, wszechmogący Boże,", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 153", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s02": { "translation": "za wszystkie Twoje dobrodziejstwa:", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 153", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s03": { "translation": "który żyjesz i królujesz na wieki wieków. Amen.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "printed p. 153", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] }
  },
