  "text": "orationes.gloria-patri",
  "about": "Glória Patri to krótka doksologia trynitarna. Kończy niemal każdy psalm i kantyk oficjum, a w tej książce czytelnik spotyka ją u stopni ołtarza, przy Lavábo i w introicie Mszy adwentowej.",
  "segments": {
    "s01": { "translation": "Chwała Ojcu i Synowi, i Duchowi Świętemu.", "translation_citations": [{ "title": "Książka do nabożeństwa (1883)", "locator": "printed p. 498", "url": "https://commons.wikimedia.org/wiki/File:Ksi%C4%85%C5%BCka_do_nabo%C5%BCe%C5%84stwa_O._Karola_Antoniewicza.djvu" }, { "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 12", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s02": { "translation": "Jak była na początku, teraz i zawsze, i na wieki wieków. Amen.", "translation_citations": [{ "title": "Książka do nabożeństwa (1883)", "locator": "printed p. 498", "url": "https://commons.wikimedia.org/wiki/File:Ksi%C4%85%C5%BCka_do_nabo%C5%BCe%C5%84stwa_O._Karola_Antoniewicza.djvu" }, { "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 12", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] }
  },
  "words": {
    "w001": { "gloss": "chwała", "function": "Z domyślnym „sit”: chwała [niech będzie]." },
    "w002": { "gloss": "Ojcu", "function": "Celownik zależny od „Glória” (w001)." },
    "w003": { "gloss": "i" },
    "w004": { "gloss": "Synowi" },
    "w005": { "gloss": "i" },
    "w006": { "gloss": "Duchowi" },
    "w007": { "gloss": "Świętemu", "function": "Zgadza się ze „Spirítui” (w006). Jako przymiotnik pierwszej i drugiej deklinacji ma w celowniku formę „Sancto”." },
    "w008": { "gloss": "jak" },
    "w009": { "gloss": "była", "function": "Imperfectum indicativi z domyślnym podmiotem „glória”." },
    "w010": { "gloss": "na" },
    "w011": { "gloss": "początku" },
    "w012": { "gloss": "i" },
    "w013": { "gloss": "teraz" },
    "w014": { "gloss": "i" },
    "w015": { "gloss": "zawsze" },
    "w016": { "gloss": "i" },
    "w017": { "gloss": "na", "function": "Przyimek „in” z biernikiem w wyrażeniu „in sǽcula”: na wieki." },
    "w018": { "gloss": "wieki" },
    "w019": { "gloss": "wieków", "function": "Dopełniacz zależny od „sǽcula” (w018)." },
    "w020": { "gloss": "amen" }
  }
