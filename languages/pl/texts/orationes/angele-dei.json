  "text": "orationes.angele-dei",
  "about": "Angele Dei jest indywidualną modlitwą do Anioła Stróża. Mówiący uznaje, że został powierzony jego opiece z dobroci Bożej, i prosi go kolejno o oświecenie, strzeżenie, rządzenie i prowadzenie.",
  "segments": {
    "s01": { "translation": "Aniele Boży,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 22", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s02": { "translation": "Stróżu mój,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 22", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s03": { "translation": "mnie, Tobie powierzonego", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 22", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s04": { "translation": "z dobroci Bożej,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 22", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s05": { "translation": "oświecaj, strzeż,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 22", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s06": { "translation": "rządź i prowadź. Amen.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 22", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] }
  },
