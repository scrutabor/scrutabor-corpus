  "language": "pl",
  "text": "orationes.actus-contritionis",
  "about": "Actus contritionis jest indywidualną modlitwą pokutną. Wyraża żal i odrazę wobec wszystkich grzechów, uznaje sprawiedliwe kary, a za najważniejszy motyw skruchy przyjmuje obrazę Boga, najwyższego Dobra godnego miłości ponad wszystko. Kończy się mocnym postanowieniem, aby z pomocą łaski już nie grzeszyć i unikać bliskich okazji do grzechu.",
  "segments": {
    "s01": { "translation": "Boże mój, z całego serca żałuję za wszystkie moje grzechy", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed pp. 12–13", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s02": { "translation": "i brzydzę się nimi,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed pp. 12–13", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s03": { "translation": "ponieważ grzesząc, zasłużyłem nie tylko na kary sprawiedliwie przez Ciebie ustanowione,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed pp. 12–13", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s04": { "translation": "lecz przede wszystkim dlatego, że obraziłem Ciebie, najwyższe Dobro, godne miłości ponad wszystko.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed pp. 12–13", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s05": { "translation": "Dlatego mocno postanawiam, z pomocą Twojej łaski, odtąd już nie grzeszyć", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed pp. 12–13", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s06": { "translation": "i unikać bliskich okazji do grzechu. Amen.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed pp. 12–13", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] }
  },
