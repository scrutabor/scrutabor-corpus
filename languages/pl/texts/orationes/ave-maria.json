{
  "schema_version": "0.16.0",
  "language": "pl",
  "text": "orationes.ave-maria",
  "about": "Pierwsza część Pozdrowienia anielskiego łączy słowa Gabriela (Łk 1, 28) i Elżbiety (Łk 1, 42), a w żadnym z tych wersetów nie ma imion Maryja i Jezus, które dodaje modlitwa. Druga część, prośba skierowana do Maryi, pochodzi z XVI wieku.",
  "segments": {
    "s01": { "translation": "Zdrowaś Maryjo, łaski pełna, Pan z Tobą, błogosławionaś Ty między niewiastami i błogosławiony owoc żywota Twojego, Jezus.", "translation_citations": [{ "title": "Książka do nabożeństwa (1883)", "locator": "printed pp. 2–3", "url": "https://commons.wikimedia.org/wiki/File:Ksi%C4%85%C5%BCka_do_nabo%C5%BCe%C5%84stwa_O._Karola_Antoniewicza.djvu" }, { "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 11", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s02": { "translation": "Święta Maryjo, Matko Boża, módl się za nami grzesznymi teraz i w godzinę śmierci naszej. Amen.", "translation_citations": [{ "title": "Książka do nabożeństwa (1883)", "locator": "printed p. 3", "url": "https://commons.wikimedia.org/wiki/File:Ksi%C4%85%C5%BCka_do_nabo%C5%BCe%C5%84stwa_O._Karola_Antoniewicza.djvu" }, { "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 11", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] }
  },
  "words": {
    "w001": { "gloss": "zdrowaś", "function": "Pozdrowienie anioła w Łk 1, 28." },
    "w002": { "gloss": "Maryjo" },
    "w003": { "gloss": "łaski", "function": "Ablativus zależny od „plena” (w004). Po polsku dopełniacz: „łaski pełna”." },
    "w004": { "gloss": "pełna", "function": "Zgadza się z „María” (w002) i łączy z „grátia” (w003)." },
    "w005": { "gloss": "Pan", "function": "Podmiot zdania z domyślnym „est”: Pan [jest] z Tobą." },
    "w006": { "gloss": "z Tobą", "function": "Połączenie „te” i „cum”. Przy zaimkach osobowych „cum” stoi po zaimku." },
    "w007": { "gloss": "błogosławiona", "function": "„Benedícta [es] tu” — z domyślnym „es”." },
    "w008": { "gloss": "Ty" },
    "w009": { "gloss": "między" },
    "w010": { "gloss": "niewiastami" },
    "w011": { "gloss": "i" },
    "w012": { "gloss": "błogosławiony", "function": "Zgadza się z „fructus” (w013) i dlatego ma rodzaj męski." },
    "w013": { "gloss": "owoc" },
    "w014": { "gloss": "żywota", "function": "Dopełniacz zależny od „fructus” (w013)." },
    "w015": { "gloss": "Twojego", "function": "Zgadza się z „ventris” (w014)." },
    "w016": { "gloss": "Jezus", "function": "Apozycja (dopowiedzenie) do „fructus” (w013): owoc… — Jezus." },
    "w017": { "gloss": "Święta", "function": "Zgadza się z „María” (w018)." },
    "w018": { "gloss": "Maryjo" },
    "w019": { "gloss": "Matko", "function": "Apozycja (dopowiedzenie) do „María” (w018)." },
    "w020": { "gloss": "Boga", "function": "Dopełniacz zależny od „Mater”: Matka Boga." },
    "w021": { "gloss": "módl się" },
    "w022": { "gloss": "za" },
    "w023": { "gloss": "nami", "function": "Ablativus po „pro” (w022)." },
    "w024": { "gloss": "grzesznikami", "function": "Apozycja (dopowiedzenie) do „nobis” (w023)." },
    "w025": { "gloss": "teraz" },
    "w026": { "gloss": "i" },
    "w027": { "gloss": "w" },
    "w028": { "gloss": "godzinie", "function": "Ablativus po „in” (w027) w określeniu czasu." },
    "w029": { "gloss": "śmierci", "function": "Dopełniacz zależny od „hora” (w028)." },
    "w030": { "gloss": "naszej", "function": "Zgadza się z „mortis” (w029)." },
    "w031": { "gloss": "amen" }
  }
}
