  "text": "orationes.ave-regina-caelorum",
  "about": "Ave Regina Caelorum jest maryjną antyfoną końcową okresu od Oczyszczenia Najświętszej Maryi Panny do Wielkiego Tygodnia. W kolejnych pozdrowieniach wierni nazywają Maryję Królową niebios, Panią Aniołów, korzeniem i bramą, z której wzeszło dla świata Światło, a na końcu proszą Ją o wstawiennictwo u Chrystusa.",
  "segments": {
    "s01": { "translation": "Bądź pozdrowiona, Królowo niebios,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 139", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s02": { "translation": "bądź pozdrowiona, Pani Aniołów:", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 139", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s03": { "translation": "witaj, korzeniu, witaj, bramo,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 139", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s04": { "translation": "z której dla świata wzeszło Światło:", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 139", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s05": { "translation": "raduj się, Panno chwalebna,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 139", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s06": { "translation": "piękna ponad wszystkie,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 139", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s07": { "translation": "żegnaj, o nader urodziwa,", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 139", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s08": { "translation": "i błagaj Chrystusa za nami.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "printed p. 139", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] }
  },
