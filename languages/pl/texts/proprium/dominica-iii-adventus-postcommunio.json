  "text": "proprium.dominica-iii-adventus-postcommunio",
  "about": "Modlitwa po Komunii III Niedzieli Adwentu. Prosi, aby otrzymana pomoc Boża oczyściła nas z wad i przygotowała na nadchodzące święta.",
  "segments": {
    "s01": { "translation": "Błagamy, Panie, Twoją łaskawość, aby to boskie wsparcie oczyściło nas z wad i przygotowało na nadchodzące święta. Przez Pana naszego Jezusa Chrystusa, Syna Twojego, który z Tobą żyje i króluje w jedności Ducha Świętego, Bóg, na wieki wieków.", "alignments": [{ "words": ["w006", "w007", "w008"], "anchor": "w008", "gloss": "to boskie wsparcie" }] },
    "s02": { "translation": "Amen." }
  },
