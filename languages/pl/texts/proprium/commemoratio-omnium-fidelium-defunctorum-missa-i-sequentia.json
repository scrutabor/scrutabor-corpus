  "language": "pl",
  "text": "proprium.commemoratio-omnium-fidelium-defunctorum-missa-i-sequentia",
  "about": "Sekwencja Dies irae należy do wszystkich trzech formularzy Wspomnienia Wszystkich Wiernych Zmarłych. Gdy kapłan odprawia trzy Msze bez przerwy, odmawia ją obowiązkowo we Mszy głównej. W przeciwnym razie odmawia ją w pierwszej Mszy. W pozostałych Mszach może ją opuścić, chyba że są śpiewane (Mszał Rzymski z 1962 roku, s. 722).",
  "segments": {
    "s01": { "translation": "W gniewu dzień, w tę pomsty chwilę, Świat w popielnym legnie pyle: Zważ Dawida i Sybillę." },
    "s02": { "translation": "Jakiż będzie płacz i łkanie, Gdy dzieł naszych sędzia stanie, Odpowiedzieć każąc za nie.", "alignments": [{ "words": ["w015", "w016"], "anchor": "w016", "gloss": "będzie" }, { "words": ["w019", "w020"], "anchor": "w020", "gloss": "przyjdzie" }] },
    "s03": { "translation": "Trąba groźnym zabrzmi tonem Nad grobami śpiących zgonem, Wszystkich stawi nas przed tronem." },
    "s04": { "translation": "Śmierć z naturą się zadziwi, Gdy umarli wstaną żywi, Win brzemieniem nieszczęśliwi." },
    "s05": { "translation": "Księgi się otworzą karty, Gdzie spis grzechów jest zawarty, Za co świat karania warty." },
    "s06": { "translation": "Kiedy sędzia więc zasiędzie, Wszystko tajne jawnym będzie, Gniewu dłoń dosięże wszędzie." },
    "s07": { "translation": "Cóż mam, nędzarz, ku obronie, Czyją pieczą się zasłonię, Gdy i święty zadrży w łonie?" },
    "s08": { "translation": "Panie w grozie swej bezmierny, Zbawisz z łaski lud Twój wierny, Zbaw mnie, zdroju miłosierny." },
    "s09": { "translation": "Racz pamiętać, Jezu drogi, Żeś wziął dla mnie żywot srogi, Nie gub mnie w dzień straszny trwogi." },
    "s10": { "translation": "Długoś szukał mnie znużony, Zbawił krzyżem umęczony, Niech ten trud nie będzie płony." },
    "s11": { "translation": "Sędzio pomsty sprawiedliwy, Bądź mym grzechom litościwy, Zanim przyjdzie sąd straszliwy." },
    "s12": { "translation": "Jęcząc, pomnąc win bezdroże, Wstydem me oblicze gorze, Szczędź mnie, błagam, Panie Boże." },
    "s13": { "translation": "Ty coś Marii grzech wybaczył I wysłuchać łotra raczył, Nie pozwolisz, bym zrozpaczył." },
    "s14": { "translation": "Choć niegodne me błaganie, Nie daj mi, dobroci Panie, W ognia wieczne wpaść otchłanie." },
    "s15": { "translation": "Daj mi mieszkać w owiec gronie, Z dala kozłów, przy Twym tronie Postaw mnie po prawej stronie." },
    "s16": { "translation": "Gdy uśmierzysz potępionych, Srogim żarom przeznaczonych, Weź mnie do błogosławionych." },
    "s17": { "translation": "Błagam kornie bijąc czołem, Z sercem, co się zda popiołem, Wspomóż mnie nad śmierci dołem." },
    "s18": { "translation": "O dniu jęku, o dniu szlochu, Kiedy z popielnego prochu Człowiek winny na sąd stanie." },
    "s19": { "translation": "Oszczędź go, o dobry Boże, Jezu nasz, i w zgonu porze Daj mu wieczne spoczywanie. Amen." }
  },
