  "text": "proprium.sacratissimi-cordis-iesu-introitus",
  "about": "Introit święta Najświętszego Serca Jezusowego. Ukazuje odwieczne zamysły Serca Chrystusa, które wybawia dusze od śmierci i żywi je w głodzie.",
  "segments": {
    "s01": { "translation": "Zamysły Jego Serca trwają z pokolenia na pokolenie: aby wybawić ich dusze od śmierci i żywić ich w głodzie." },
    "s02": { "translation": "Radujcie się, sprawiedliwi, w Panu; prawym przystoi pieśń chwały." },
    "s03": { "translation": "Chwała Ojcu i Synowi, i Duchowi Świętemu. Jak była na początku, teraz i zawsze, i na wieki wieków. Amen." },
    "s04": { "narrative": "Po jego zakończeniu powtarza się antyfonę „Cogitatiónes Cordis eius” aż do psalmu." },
    "s05": { "translation": "Zamysły Jego Serca trwają z pokolenia na pokolenie: aby wybawić ich dusze od śmierci i żywić ich w głodzie." }
  },
