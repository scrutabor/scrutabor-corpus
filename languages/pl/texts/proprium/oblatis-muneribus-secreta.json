  "text": "proprium.oblatis-muneribus-secreta",
  "about": "Sekreta w intencji Kościoła, jego pasterzy i pomyślności owczarni.",
  "segments": {
    "s01": { "translation": "Po złożeniu darów, Panie, prosimy, oświeć łaskawie swój Kościół, aby Twoja owczarnia wszędzie pomyślnie się rozwijała, a pasterze pod Twoim kierownictwem stawali się mili Twojemu imieniu. Przez Pana naszego Jezusa Chrystusa, Syna Twojego, który z Tobą żyje i króluje w jedności Ducha Świętego, Bóg,", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "Po złożeniu darów" }, { "words": ["w005", "w006"], "anchor": "w005", "gloss": "swój Kościół" }, { "words": ["w007", "w008"], "anchor": "w008", "gloss": "oświeć łaskawie" }, { "words": ["w011", "w012"], "anchor": "w011", "gloss": "Twojej owczarni" }, { "words": ["w017", "w018"], "anchor": "w018", "gloss": "stawali się mili" }, { "words": ["w019", "w020"], "anchor": "w019", "gloss": "Twojemu imieniu" }, { "words": ["w021", "w022"], "anchor": "w022", "gloss": "pod Twoim kierownictwem" }] },
    "s03": { "translation": "na wieki wieków." },
    "s04": { "translation": "Amen." }
  },
  "words": {
