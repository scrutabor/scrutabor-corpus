  "text": "proprium.corporis-christi-introitus",
  "about": "Introit uroczystości Najświętszego Ciała Chrystusa. Przedstawia Boga karmiącego lud najlepszą pszenicą i miodem ze skały, a w wersecie wzywa do radosnego śpiewu.",
  "segments": {
    "s01": { "translation": "Nakarmił ich najlepszą pszenicą, alleluja, i nasycił ich miodem ze skały, alleluja, alleluja, alleluja.", "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w004", "gloss": "najlepszą pszenicą" }] },
    "s02": { "translation": "Radujcie się Bogiem, naszym wspomożycielem; radośnie wołajcie do Boga Jakuba." },
    "s03": { "translation": "Chwała Ojcu i Synowi, i Duchowi Świętemu. Jak była na początku, teraz i zawsze, i na wieki wieków. Amen." },
    "s04": { "narrative": "Po jego zakończeniu powtarza się antyfonę „Cibávit eos” aż do psalmu." },
    "s05": { "translation": "Nakarmił ich najlepszą pszenicą, alleluja, i nasycił ich miodem ze skały, alleluja, alleluja, alleluja.", "alignments": [{ "words": ["w045", "w046", "w047"], "anchor": "w046", "gloss": "najlepszą pszenicą" }] }
  },
