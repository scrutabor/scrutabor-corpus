    "s01": { "translation": "Wspomożycielu w stosownych chwilach, w utrapieniu: niech Tobie ufają ci, którzy Cię znają, bo nie opuszczasz tych, którzy Cię szukają, Panie. Bo nie na zawsze ubogi pójdzie w zapomnienie, cierpliwość ubogich nie przepadnie na wieki: powstań, Panie, niech człowiek nie weźmie góry.", "alignments": [{ "words": ["w006", "w007", "w008"], "anchor": "w006", "gloss": "niech Tobie ufają" }, { "words": ["w019", "w020", "w021", "w022", "w023", "w024"], "anchor": "w023", "gloss": "ubogi nie będzie zapomniany na zawsze" }, { "words": ["w033", "w034", "w035"], "anchor": "w034", "gloss": "niech człowiek nie weźmie góry" }] }
