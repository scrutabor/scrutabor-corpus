  "schema_version": "0.18.0",
  "language": "pl",
  "text": "proprium.corporis-christi-evangelium",
  "about": "Ewangelia uroczystości Najświętszego Ciała Chrystusa, J 6, 56–59. Chrystus obiecuje trwanie w Nim i życie wieczne tym, którzy spożywają Jego Ciało i piją Jego Krew.",
  "segments": {
    "s01": { "translation": "W owym czasie Jezus powiedział do tłumów żydowskich: Ciało moje prawdziwie jest pokarmem, a Krew moja prawdziwie jest napojem." },
    "s02": { "translation": "Kto spożywa moje Ciało i pije moją Krew, trwa we Mnie, a Ja w nim." },
    "s03": { "translation": "Jak posłał Mnie żyjący Ojciec, a Ja żyję przez Ojca, tak i ten, kto Mnie spożywa, będzie żył przeze Mnie." },
    "s04": { "translation": "To jest Chleb, który zstąpił z nieba." },
    "s05": { "translation": "Nie tak jak wasi ojcowie spożywali mannę i pomarli." },
    "s06": { "translation": "Kto spożywa ten Chleb, będzie żył na wieki." }
  },
