  "language": "pl",
  "text": "proprium.dominica-ii-adventus-epistola",
  "about": "Lekcja II Niedzieli Adwentu, z Listu do Rzymian. Paweł czyta Pisma jako napisane dla nas — po to, by z cierpliwości i pociechy rodziła się nadzieja — i kończy szeregiem cytatów, w których narody chwalą Boga razem z Izraelem.",
  "segments": {
    "s01": { "translation": "Bracia: Cokolwiek zostało napisane, dla naszego pouczenia zostało napisane, abyśmy przez cierpliwość i pocieszenie Pism mieli nadzieję.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Romans 15:4–13, DjVu scan 1046", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }], "alignments": [{ "words": ["w008", "w009"], "anchor": "w008", "gloss": "napisano" }] },
    "s02": { "translation": "A Bóg cierpliwości i pociechy niech wam da, byście byli między sobą jednej myśli według Jezusa Chrystusa, abyście jednomyślni, jednymi ustami czcili Boga i Ojca Pana naszego Jezusa Chrystusa.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Romans 15:4–13, DjVu scan 1046", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s03": { "translation": "Dlatego przyjmujcie jedni drugich, jak i Chrystus was przyjął, ku czci Boga.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Romans 15:4–13, DjVu scan 1046", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }], "alignments": [{ "words": ["w045"], "reason": "idiom" }] },
    "s04": { "translation": "Mówię bowiem, że Chrystus Jezus był sługą obrzezania dla prawdy Bożej, aby potwierdzić obietnice ojców, a narody czczą Boga za miłosierdzie, jak jest napisane: Dlatego będę Cię chwalił wśród narodów, Panie, i będę śpiewał Twojemu imieniu.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Romans 15:4–13, DjVu scan 1046", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }], "alignments": [{ "words": ["w077", "w078"], "anchor": "w077", "gloss": "napisano" }] },
    "s05": { "translation": "I znowu mówi: Weselcie się, narody, wraz z Jego ludem.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Romans 15:4–13, DjVu scan 1046", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s06": { "translation": "I znowu: Chwalcie Pana, wszystkie narody, i wielbcie Go, wszystkie ludy.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Romans 15:4–13, DjVu scan 1046", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s07": { "translation": "I znów mówi Izajasz: Będzie korzeń Jessego i Ten, który powstanie, by rządzić narodami, w Nim narody będą pokładać nadzieję.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Romans 15:4–13, DjVu scan 1046", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s08": { "translation": "A Bóg nadziei niech was napełni wszelką radością i pokojem, gdy wierzycie, abyście obfitowali w nadzieję i w moc Ducha Świętego.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Romans 15:4–13, DjVu scan 1046", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] }
  },
