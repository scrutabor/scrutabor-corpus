  "text": "proprium.litaniae-maiores-collecta",
  "about": "Collecta wspomnienia Litanii Większych w Mszale Rzymskim z 1962 roku.",
  "segments": {
    "s01": { "translation": "Spraw, prosimy, wszechmogący Boże, abyśmy my, którzy w naszym utrapieniu ufamy Twojej dobroci, byli zawsze osłaniani Twoją opieką przed wszelkimi przeciwnościami. Przez Pana naszego Jezusa Chrystusa, Syna Twojego, który z Tobą żyje i króluje w jedności Ducha Świętego, Bóg, na wieki wieków.", "alignments": [{ "words": ["w008", "w009"], "anchor": "w008", "gloss": "naszym utrapieniu" }, { "words": ["w010", "w011", "w012"], "anchor": "w012", "gloss": "Twojej dobroci" }, { "words": ["w015", "w016"], "anchor": "w015", "gloss": "wszelkimi przeciwnościami" }, { "words": ["w017", "w018", "w019"], "anchor": "w019", "gloss": "zawsze Twoją opieką" }] },
    "s02": { "translation": "Amen." }
  },
