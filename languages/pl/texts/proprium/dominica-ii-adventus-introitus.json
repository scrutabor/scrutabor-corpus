  "text": "proprium.dominica-ii-adventus-introitus",
  "about": "Introit II Niedzieli Adwentu, z Izajasza, z wersetem Psalmu 79. Antyfona zwraca się do ludu Syjonu i mówi, po co Pan przychodzi — zbawić narody, i dać usłyszeć swój głos.",
  "segments": {
    "s01": { "translation": "Ludu Syjonu, oto Pan przyjdzie, aby zbawić narody; Pan pozwoli wam usłyszeć chwałę swojego głosu ku radości waszych serc.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Isaiah 30:19,30 and Psalm 79:2", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }], "alignments": [{ "words": ["w010", "w011"], "anchor": "w010", "gloss": "pozwoli usłyszeć" }] },
    "s02": { "translation": "Ty, który pasiesz Izraela, usłysz; Ty, który prowadzisz Józefa jak owcę.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Isaiah 30:19,30 and Psalm 79:2", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s03": { "translation": "Chwała Ojcu i Synowi, i Duchowi Świętemu. Jak była na początku, teraz i zawsze, i na wieki wieków. Amen.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Isaiah 30:19,30 and Psalm 79:2", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s04": { "narrative": "Po doksologii powtarza się antyfonę na wejście od Pópulus Sion do wersetu psalmu — we Mszy śpiewanej czyni to schola, we Mszy cichej sam kapłan." },
    "s05": { "translation": "Ludu Syjonu, oto Pan przyjdzie, aby zbawić narody; Pan pozwoli wam usłyszeć chwałę swojego głosu ku radości waszych serc.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Isaiah 30:19,30 and Psalm 79:2", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }], "alignments": [{ "words": ["w058", "w059"], "anchor": "w058", "gloss": "pozwoli usłyszeć" }] }
  },
