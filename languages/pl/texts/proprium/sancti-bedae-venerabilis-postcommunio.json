  "text": "proprium.sancti-bedae-venerabilis-postcommunio",
  "about": "Modlitwa łączy prośbę o orędownictwo świętego Bedy z prośbą, by Boże ofiary przyniosły modlącym się zbawienie.",
  "segments": {
    "s01": { "translation": "Prosimy, Panie, aby błogosławiony Beda, Twój Wyznawca i znakomity Doktor, wystąpił jako orędownik, by Twoje ofiary przyniosły nam zbawienie. Przez Pana naszego Jezusa Chrystusa, Syna Twojego, który z Tobą żyje i króluje w jedności Ducha Świętego, Bóg, na wieki wieków.", "alignments": [{ "words": ["w001", "w002", "w003"], "anchor": "w001", "gloss": "Aby nam, Panie" }, { "words": ["w004", "w005", "w006", "w007"], "anchor": "w006", "gloss": "Twoje ofiary przyniosły zbawienie" }, { "words": ["w008", "w009", "w010", "w011"], "anchor": "w009", "gloss": "błogosławiony Beda, Twój Wyznawca" }, { "words": ["w012", "w013", "w014"], "anchor": "w013", "gloss": "i znakomity Doktor" }, { "words": ["w016", "w017"], "anchor": "w017", "gloss": "niech wystąpi jako orędownik" }, { "words": ["w018", "w019", "w020"], "anchor": "w019", "gloss": "Przez Pana naszego" }, { "words": ["w021", "w022"], "anchor": "w021", "gloss": "Jezusa Chrystusa" }, { "words": ["w023", "w024"], "anchor": "w023", "gloss": "Syna Twojego" }, { "words": ["w025", "w026", "w027", "w028", "w029"], "anchor": "w027", "gloss": "który z Tobą żyje i króluje" }, { "words": ["w030", "w031", "w032", "w033"], "anchor": "w031", "gloss": "w jedności Ducha Świętego" }, { "words": ["w035", "w036", "w037", "w038"], "anchor": "w037", "gloss": "przez wszystkie wieki wieków" }] },
    "s02": { "translation": "Amen." }
  },
