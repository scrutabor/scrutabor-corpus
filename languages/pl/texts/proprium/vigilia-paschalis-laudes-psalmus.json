  "language": "pl",
  "text": "proprium.vigilia-paschalis-laudes-psalmus",
  "about": "Po Komunii i ablucjach śpiewa się Psalm 150 w ramach Jutrzni Niedzieli Zmartwychwstania. Psalm poprzedza potrójne Alleluja. Po doksologii powtarza się tę antyfonę.",
  "segments": {
    "s01": { "translation": "Alleluja, alleluja, alleluja." },
    "s02": { "translation": "Chwalcie Pana w Jego przybytku, chwalcie Go na Jego majestatycznym nieboskłonie.", "alignments": [{ "words": ["w007", "w008"], "anchor": "w007", "gloss": "Jego przybytku" }, { "words": ["w012", "w013", "w014"], "anchor": "w012", "gloss": "Jego majestatycznym nieboskłonie" }] },
    "s03": { "translation": "Chwalcie Go za Jego wielkie dzieła, chwalcie Go za Jego najwyższy majestat.", "alignments": [{ "words": ["w018", "w019", "w020"], "anchor": "w018", "gloss": "Jego wielkie dzieła" }, { "words": ["w024", "w025", "w026"], "anchor": "w024", "gloss": "Jego najwyższy majestat" }] },
    "s04": { "translation": "Chwalcie Go dźwiękiem trąby, chwalcie Go grą na psałterium i cytrze." },
    "s05": { "translation": "Chwalcie Go bębnem i tańcem, chwalcie Go strunami i piszczałką." },
    "s06": { "translation": "Chwalcie Go dźwięcznymi talerzami, chwalcie Go brzęczącymi talerzami. Wszystko, co oddycha, niech chwali Pana!" },
    "s07": { "translation": "Chwała Ojcu i Synowi, i Duchowi Świętemu." },
    "s08": { "translation": "Jak była na początku, teraz i zawsze, i na wieki wieków. Amen." },
    "s09": { "translation": "Alleluja, alleluja, alleluja." }
  },
