  "language": "pl",
  "text": "proprium.dominica-ii-adventus-evangelium",
  "about": "Ewangelia II Niedzieli Adwentu. Jan Chrzciciel, już w więzieniu, posyła zapytać, czy to Ten. Odpowiedź nie jest twierdzeniem, lecz listą tego, co widać, i kończy się słowem o samym Janie.",
  "segments": {
    "s01": { "translation": "W owym czasie, gdy Jan usłyszał w więzieniu o dziełach Chrystusa, posłał dwóch swoich uczniów i zapytał Go:", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Matthew 11:2–10, DjVu scan 882", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s02": { "translation": "Czy Ty jesteś Tym, który ma przyjść, czy mamy oczekiwać innego?", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Matthew 11:2–10, DjVu scan 882", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }], "alignments": [{ "words": ["w021", "w022"], "anchor": "w021", "gloss": "ma przyjść" }] },
    "s03": { "translation": "Jezus odpowiedział im: Idźcie i oznajmijcie Janowi, co usłyszeliście i zobaczyliście.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Matthew 11:2–10, DjVu scan 882", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s04": { "translation": "Ślepi widzą, chromi chodzą, trędowaci zostają oczyszczeni, głusi słyszą, umarli powstają, ubogim głosi się Ewangelię; błogosławiony jest ten, kto się Mną nie zgorszy.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Matthew 11:2–10, DjVu scan 882", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }], "alignments": [{ "words": ["w055", "w056"], "anchor": "w056", "gloss": "zgorszy się" }] },
    "s05": { "translation": "Gdy oni odchodzili, Jezus zaczął mówić do tłumów o Janie: Co wyszliście zobaczyć na pustynię? Trzcinę kołysaną przez wiatr?", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Matthew 11:2–10, DjVu scan 882", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s06": { "translation": "Co więc wyszliście zobaczyć? Człowieka ubranego w miękkie szaty?", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Matthew 11:2–10, DjVu scan 882", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s07": { "translation": "Oto ci, którzy noszą miękkie szaty, mieszkają w pałacach królewskich.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Matthew 11:2–10, DjVu scan 882", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s08": { "translation": "Co więc wyszliście zobaczyć? Proroka? Tak, mówię wam, nawet więcej niż proroka.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Matthew 11:2–10, DjVu scan 882", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s09": { "translation": "To o nim napisano: Oto Ja posyłam mojego posłańca przed Tobą; przygotuje on Twoją drogę przed Tobą.", "translation_citations": [{ "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "Matthew 11:2–10, DjVu scan 882", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }], "alignments": [{ "words": ["w109", "w110"], "anchor": "w109", "gloss": "napisano" }] }
  },
