  "text": "proprium.sanctae-petronillae-postcommunio",
  "about": "Pokomunia na wspomnienie św. Petroneli.",
  "segments": {
    "s01": { "translation": "Nasyciłeś, Panie, Twoją rodzinę świętymi darami; prosimy, umacniaj nas zawsze wstawiennictwem tej, której uroczystość obchodzimy." },
    "s02": { "translation": "Przez Pana naszego Jezusa Chrystusa, Syna Twojego, który z Tobą żyje i króluje w jedności Ducha Świętego, Bóg," },
    "s03": { "translation": "na wieki wieków." },
    "s04": { "translation": "Amen." }
  },
