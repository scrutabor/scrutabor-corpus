{
  "schema_version": "0.21.0",
  "language": "pl",
  "text": "proprium.vigilia-paschalis-laudes-canticum",
  "about": "Bez kapitulum, hymnu i wersetu kapłan rozpoczyna antyfonę słowami Et valde mane, a śpiewacy ją kończą. Podczas kantyku Zachariasza dokonuje się okadzenia jak na Jutrzni. Po doksologii powtarza się całą antyfonę, a następnie kapłan odmawia modlitwę po Komunii.",
  "segments": {
    "s01": { "translation": "I bardzo wcześnie rano,", "alignments": [{ "words": ["w002", "w003"], "anchor": "w002", "gloss": "bardzo wcześnie rano" }] },
    "s02": { "translation": "pierwszego dnia tygodnia przychodzą do grobu, gdy słońce już wzeszło, alleluja.", "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "pierwszego dnia tygodnia" }, { "words": ["w009", "w010", "w011"], "anchor": "w009", "gloss": "gdy słońce już wzeszło" }] },
    "s03": { "translation": "Błogosławiony Pan, Bóg Izraela, bo nawiedził i odkupił swój lud,", "alignments": [{ "words": ["w021", "w022"], "anchor": "w021", "gloss": "swój lud" }] },
    "s04": { "translation": "i wzbudził dla nas moc zbawienia w domu Dawida, swojego sługi,", "alignments": [{ "words": ["w031", "w032"], "anchor": "w031", "gloss": "swojego sługi" }] },
    "s05": { "translation": "jak powiedział przez usta swoich świętych proroków, którzy żyli niegdyś:", "alignments": [{ "words": ["w034", "w035"], "anchor": "w034", "gloss": "powiedział" }, { "words": ["w038", "w039", "w040", "w041", "w042", "w043"], "anchor": "w038", "gloss": "swoich świętych proroków, którzy żyli niegdyś" }] },
    "s06": { "translation": "aby uwolnić nas od naszych nieprzyjaciół i z ręki wszystkich, którzy nas nienawidzą,", "alignments": [{ "words": ["w044", "w045"], "anchor": "w044", "gloss": "aby uwolnić" }, { "words": ["w048", "w049"], "anchor": "w048", "gloss": "naszych nieprzyjaciół" }] },
    "s07": { "translation": "aby okazać miłosierdzie naszym ojcom i pamiętać o swoim świętym przymierzu:", "alignments": [{ "words": ["w057", "w058"], "anchor": "w057", "gloss": "aby okazać" }, { "words": ["w060"], "reason": "idiom" }, { "words": ["w061", "w062"], "anchor": "w061", "gloss": "naszym ojcom" }, { "words": ["w065", "w066", "w067"], "anchor": "w065", "gloss": "o swoim świętym przymierzu" }] },
    "s08": { "translation": "o przysiędze złożonej Abrahamowi, naszemu ojcu, że da nam możliwość,", "alignments": [{ "words": ["w072", "w073"], "anchor": "w072", "gloss": "naszemu ojcu" }, { "words": ["w074", "w075", "w076"], "anchor": "w074", "gloss": "że da nam możliwość" }] },
    "s09": { "translation": "byśmy uwolnieni z ręki naszych nieprzyjaciół służyli Mu bez lęku,", "alignments": [{ "words": ["w082", "w083"], "anchor": "w082", "gloss": "naszych nieprzyjaciół" }] },
    "s10": { "translation": "w świętości i sprawiedliwości przed Nim przez wszystkie nasze dni.", "alignments": [{ "words": ["w094", "w095"], "anchor": "w094", "gloss": "nasze dni" }] },
    "s11": { "translation": "I ty, dziecko, będziesz nazwane prorokiem Najwyższego, bo pójdziesz przed obliczem Pana, aby przygotować Jego drogi,", "alignments": [{ "words": ["w107", "w108"], "anchor": "w107", "gloss": "aby przygotować" }, { "words": ["w109", "w110"], "anchor": "w109", "gloss": "Jego drogi" }] },
    "s12": { "translation": "aby dać Jego ludowi poznać zbawienie w odpuszczeniu ich grzechów,", "alignments": [{ "words": ["w111", "w112"], "anchor": "w111", "gloss": "aby dać" }, { "words": ["w113", "w114"], "anchor": "w113", "gloss": "Jego ludowi" }, { "words": ["w119", "w120"], "anchor": "w119", "gloss": "ich grzechów" }] },
    "s13": { "translation": "dzięki serdecznemu miłosierdziu naszego Boga, przez które nawiedzi nas Wschodzący z wysoka,", "alignments": [{ "words": ["w122", "w123"], "anchor": "w122", "gloss": "serdecznemu miłosierdziu" }, { "words": ["w124", "w125"], "anchor": "w124", "gloss": "naszego Boga" }, { "words": ["w130", "w131"], "anchor": "w130", "gloss": "z wysoka" }] },
    "s14": { "translation": "aby oświecić tych, którzy siedzą w ciemnościach i w cieniu śmierci, aby skierować nasze stopy na drogę pokoju.", "alignments": [{ "words": ["w132", "w133"], "anchor": "w132", "gloss": "aby oświecić" }, { "words": ["w143", "w144"], "anchor": "w143", "gloss": "aby skierować" }, { "words": ["w145", "w146"], "anchor": "w145", "gloss": "nasze stopy" }] },
    "s15": { "translation": "Chwała Ojcu i Synowi, i Duchowi Świętemu." },
    "s16": { "translation": "Jak była na początku, teraz i zawsze, i na wieki wieków. Amen." },
    "s17": { "translation": "I bardzo wcześnie rano, pierwszego dnia tygodnia przychodzą do grobu, gdy słońce już wzeszło, alleluja.", "alignments": [{ "words": ["w171", "w172"], "anchor": "w171", "gloss": "bardzo wcześnie rano" }, { "words": ["w173", "w174"], "anchor": "w173", "gloss": "pierwszego dnia tygodnia" }, { "words": ["w178", "w179", "w180"], "anchor": "w178", "gloss": "gdy słońce już wzeszło" }] }
  },
