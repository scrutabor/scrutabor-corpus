  "language": "pl",
  "text": "proprium.sacratissimi-cordis-iesu-evangelium",
  "about": "Ewangelia święta Najświętszego Serca Jezusowego, J 19, 31–37. Żołnierz otwiera włócznią bok zmarłego Chrystusa, z którego natychmiast wypływają krew i woda.",
  "segments": {
    "s01": { "translation": "W owym czasie Żydzi, skoro był dzień Przygotowania, aby ciała nie pozostały na krzyżu przez szabat (był to bowiem wielki dzień szabatu), poprosili Piłata, aby połamano im golenie i aby ich zabrano." },
    "s02": { "translation": "Przyszli więc żołnierze i połamali golenie pierwszemu oraz drugiemu, który był z Nim ukrzyżowany.", "alignments": [{ "words": ["w034"], "reason": "idiom" }, { "words": ["w040", "w041"], "anchor": "w040", "gloss": "ukrzyżowany" }] },
    "s03": { "translation": "Kiedy zaś przyszli do Jezusa i ujrzeli Go już martwego, nie połamali Mu goleni, lecz jeden z żołnierzy otworzył Mu bok włócznią i zaraz wypłynęła krew i woda." },
    "s04": { "translation": "A ten, który widział, złożył świadectwo, a jego świadectwo jest prawdziwe. I on wie, że mówi prawdę, abyście i wy uwierzyli." },
    "s05": { "translation": "Stało się to bowiem, aby wypełniło się Pismo: Kości jego nie skruszycie. I znowu inne Pismo mówi: Będą patrzeć na Tego, którego przebili.", "alignments": [{ "words": ["w091", "w092"], "anchor": "w091", "gloss": "stały się" }] }
  },
