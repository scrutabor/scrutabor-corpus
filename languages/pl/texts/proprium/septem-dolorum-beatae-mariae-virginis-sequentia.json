  "language": "pl",
  "text": "proprium.septem-dolorum-beatae-mariae-virginis-sequentia",
  "about": "Sequentia formularza „Siedmiu Boleści Najświętszej Maryi Panny” w Mszale Rzymskim z 1962 roku.",
  "segments": {
    "s01": {
      "translation": "Bolejąca Matka stała U stóp krzyża, we łzach cała, Kiedy na nim zawisł Syn."
    },
    "s02": {
      "translation": "A w Jej pełnej jęku duszy, Od męczarni i katuszy, Tkwił miecz ostry naszych win."
    },
    "s03": {
      "translation": "Jakże smutna i strapiona Była ta błogosławiona, Z której się narodził Bóg."
    },
    "s04": {
      "translation": "Jak cierpiała i bolała, Jakże drżała gdy widziała Dziecię swe wśród śmierci trwóg."
    },
    "s05": {
      "translation": "Któryż człowiek nie zapłacze, Widząc męki i rozpacze Matki Bożej w żalu tym?"
    },
    "s06": {
      "translation": "Któż od smutku się powstrzyma, Mając matkę przed oczyma, Która cierpi z Synem swym?"
    },
    "s07": {
      "translation": "Widzi, jak za ludzkie winy Znosi męki Syn jedyny, Jezus – jak Go smaga bat."
    },
    "s08": {
      "translation": "Widzi jak samotnie kona Owoc Jej czystego łona, Dając życie za ten świat."
    },
    "s09": {
      "translation": "Matko, coś miłości zdrojem, Przejmij mnie cierpieniem swoim Abym boleć z Tobą mógł."
    },
    "s10": {
      "translation": "Niechaj serce moje pała, By radością mą się stała Miłość, którą – Chrystus Bóg."
    },
    "s11": {
      "translation": "Matko święta, srogie rany, Które zniósł Ukrzyżowany, Wyryj mocno w duszy mej."
    },
    "s12": {
      "translation": "Męką, Syna rodzonego, Co dla dobra cierpiał mego, Ze mną się podzielić chciej."
    },
    "s13": {
      "translation": "Pragnę płakać w Twym pobliżu, Cierpiąc z Tym, co zmarł na krzyżu Po mojego życia kres."
    },
    "s14": {
      "translation": "Chcę pod krzyżem stać przy Tobie, Z Tobą łączyć się w żałobie, I wylewać zdroje łez."
    },
    "s15": {
      "translation": "Panno czysta nad pannami, Niechaj dobroć Twoja da mi Płakać z żalu z Tobą współ."
    },
    "s16": {
      "translation": "Bym z Chrystusem konał razem, Męki Jego był obrazem, Rany Jego w sobie czuł."
    },
    "s17": {
      "translation": "Niech mnie do krwi rani zgraja, Niech mnie męki krzyż upaja I Twojego Syna krew."
    },
    "s18": {
      "translation": "W ogniu Panno, niech nie płonę, Więc mnie w swoją weź obronę, Gdy nadejdzie sądu gniew."
    },
    "s19": {
      "translation": "Gdy kres dni przede mną stanie, Przez Twą Matkę dojść mi Panie, Do zwycięstwa palmy daj."
    },
    "s20": {
      "translation": "Kiedy umrze moje ciało, Niechaj duszę ma z swą chwałą Czeka Twój wieczysty raj. Amen. Alleluja."
    }
  },
