  "language": "pl",
  "text": "proprium.septem-dolorum-beatae-mariae-virginis-sequentia",
  "about": "Sequentia formularza „Siedmiu Boleści Najświętszej Maryi Panny” w Mszale Rzymskim z 1962 roku.",
  "segments": {
    "s01": { "translation": "Stała Matka bolesna przy Krzyżu, we łzach, gdy wisiał Syn." },
    "s02": { "translation": "Jej duszę jęczącą, zasmuconą i bolejącą przeszył miecz." },
    "s03": { "translation": "O, jakże smutna i strapiona była owa błogosławiona Matka Jednorodzonego!" },
    "s04": { "translation": "Która smuciła się i bolała, kochająca Matka, gdy widziała męki swego chwalebnego syna." },
    "s05": { "translation": "Któż z ludzi by nie zapłakał, gdyby ujrzał Matkę Chrystusa w tak wielkiej udręce?" },
    "s06": { "translation": "Któż nie mógłby się zasmucić, wpatrując się w Matkę Chrystusa, bolejącą wraz z Synem?" },
    "s07": { "translation": "Za grzechy swojego ludu ujrzała Jezusa w męczarniach i poddanego biczom." },
    "s08": { "translation": "Ujrzała swego słodkiego syna, opuszczonego w konaniu, gdy oddał ducha." },
    "s09": { "translation": "O matko, źródło miłości, spraw, abym poczuł siłę boleści, bym z tobą trwał w żałobie." },
    "s10": { "translation": "Spraw, aby moje serce płonęło w miłowaniu Chrystusa Boga, abym Mu się podobał." },
    "s11": { "translation": "Święta Matko, uczyń to: rany Ukrzyżowanego wyryj mocno w moim sercu." },
    "s12": { "translation": "Męki twojego zranionego syna, który tak zechciał za mnie cierpieć, podziel ze mną." },
    "s13": { "translation": "Spraw, abym z tobą płakał z miłością, współcierpiał z Ukrzyżowanym, dopóki będę żył." },
    "s14": { "translation": "Pragnę stać z tobą przy Krzyżu i przyłączyć się do ciebie w lamencie." },
    "s15": { "translation": "Dziewico dziewic przesławna, nie bądź już dla mnie surowa: spraw, abym z tobą lamentował." },
    "s16": { "translation": "Spraw, abym nosił śmierć Chrystusa, spraw, abym był uczestnikiem Męki i rozpamiętywał rany." },
    "s17": { "translation": "Spraw, aby rany mnie zraniły, spraw, abym się upoił Krzyżem i krwią Syna." },
    "s18": { "translation": "Abym nie płonął objęty płomieniami, niech przez ciebie, Dziewico, będę obroniony w dniu sądu." },
    "s19": { "translation": "Chryste, gdy przyjdzie mi stąd odejść, daj, abym przez Matkę doszedł do palmy zwycięstwa." },
    "s20": { "translation": "Gdy ciało umrze, spraw, aby duszy dana została chwała raju. Amen. Alleluja." }
  },
