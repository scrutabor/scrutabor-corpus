  "text": "proprium.litaniae-maiores-postcommunio",
  "about": "Postcommunio wspomnienia Litanii Większych w Mszale Rzymskim z 1962 roku.",
  "segments": {
    "s01": { "translation": "Przychyl się łaskawie, prosimy, Panie, do naszych próśb, abyśmy, przyjmując w utrapieniu Twoje dary, dzięki otrzymanej pociesze wzrastali w miłości do Ciebie. Przez Pana naszego Jezusa Chrystusa, Syna Twojego, który z Tobą żyje i króluje w jedności Ducha Świętego, Bóg, na wieki wieków.", "alignments": [{ "words": ["w001", "w002"], "anchor": "w001", "gloss": "Do naszych próśb" }, { "words": ["w005", "w006", "w007"], "anchor": "w007", "gloss": "przychyl się łaskawie" }, { "words": ["w010", "w011"], "anchor": "w010", "gloss": "Twoje dary" }, { "words": ["w015", "w016", "w017"], "anchor": "w016", "gloss": "dzięki naszej pociesze" }, { "words": ["w018", "w019", "w020"], "anchor": "w020", "gloss": "w miłości do Ciebie" }] },
    "s02": { "translation": "Amen." }
  },
