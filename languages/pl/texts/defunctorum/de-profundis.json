  "language": "pl",
  "text": "defunctorum.de-profundis",
  "about": "Psalm 129 według numeracji Wulgaty (Ps 130 w numeracji hebrajskiej), tradycyjnie odmawiany za zmarłych. Jego łacina to psałterz gallikański, wersja, którą modli się liturgia rzymska.",
  "segments": {
    "s001": { "translation": "Z głębin wołałem do Ciebie, Panie." },
    "s002": { "translation": "Panie, wysłuchaj mojego głosu." },
    "s003": { "translation": "Niech Twoje uszy uważnie słuchają głosu mojego błagania." },
    "s004": { "translation": "Jeśli będziesz zważał na nieprawości, Panie, Panie, któż się ostoi?" },
    "s005": { "translation": "Bo u Ciebie jest przebaczenie; przez wzgląd na Twoje prawo czekałem na Ciebie, Panie." },
    "s006": { "translation": "Moja dusza czekała na Jego słowo; moja dusza pokładała nadzieję w Panu." },
    "s007": { "translation": "Od porannej straży aż do nocy niech Izrael pokłada nadzieję w Panu." },
    "s008": { "translation": "Bo u Pana jest miłosierdzie i u Niego jest obfite odkupienie." },
    "s009": { "translation": "I On sam odkupi Izraela ze wszystkich jego nieprawości." }
  },
