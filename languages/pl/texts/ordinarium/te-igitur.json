{
  "schema_version": "0.17.0",
  "language": "pl",
  "text": "ordinarium.te-igitur",
  "about": "Pierwsza modlitwa Kanonu. Kapłan prosi Ojca przez Jezusa Chrystusa o przyjęcie darów oraz o pokój, opiekę, jedność i kierowanie Kościołem. Mszał zostawia tu miejsce na imię papieża i biskupa miejsca, wymienianych wraz ze wszystkimi strzegącymi wiary katolickiej.",
  "segments": {
    "s01": { "narrative": "Po prefacji kapłan rozkłada ręce, nieco je unosi i składa, wznosi oczy ku niebu i zaraz je opuszcza, po czym pochyla się głęboko przed ołtarzem i opiera na nim ręce." },
    "s02": { "translation": "Ciebie więc, najmiłosierniejszy Ojcze, przez Jezusa Chrystusa, Twojego Syna, naszego Pana, pokornie prosimy i błagamy,", "translation_citations": [{ "title": "Powściągliwość i Praca (1912)", "locator": "no. 1, printed p. 4", "url": "https://jbc.bj.uj.edu.pl/dlibra/publication/969117/edition/929713/powsciagliwosc-i-praca-organ-towarzystwa-r-15-1912-nr-1" }] },
    "s03": { "narrative": "Kapłan całuje ołtarz i składa ręce przed piersią." },
    "s04": { "translation": "abyś przyjął i pobłogosławił", "translation_citations": [{ "title": "Powściągliwość i Praca (1912)", "locator": "no. 1, printed p. 4", "url": "https://jbc.bj.uj.edu.pl/dlibra/publication/969117/edition/929713/powsciagliwosc-i-praca-organ-towarzystwa-r-15-1912-nr-1" }] },
    "s05": { "narrative": "Kapłan czyni trzy znaki krzyża nad Hostią i kielichem jednocześnie." },
    "s06": { "translation": "te dary, te daniny, te święte i nieskalane ofiary,", "translation_citations": [{ "title": "Powściągliwość i Praca (1912)", "locator": "no. 1, printed p. 4", "url": "https://jbc.bj.uj.edu.pl/dlibra/publication/969117/edition/929713/powsciagliwosc-i-praca-organ-towarzystwa-r-15-1912-nr-1" }] },
    "s07": { "narrative": "Kapłan rozkłada ręce i mówi dalej." },
    "s08": { "translation": "które ofiarujemy Ci najpierw za Twój święty Kościół katolicki; racz obdarzyć go pokojem, strzec go, jednoczyć i nim rządzić na całym świecie,", "translation_citations": [{ "title": "Powściągliwość i Praca (1912)", "locator": "no. 1, printed p. 4", "url": "https://jbc.bj.uj.edu.pl/dlibra/publication/969117/edition/929713/powsciagliwosc-i-praca-organ-towarzystwa-r-15-1912-nr-1" }] },
    "s09": { "translation": "wraz ze sługą Twoim, naszym papieżem, i naszym biskupem, oraz ze wszystkimi prawowiernymi wyznawcami wiary katolickiej i apostolskiej.", "translation_citations": [{ "title": "Powściągliwość i Praca (1912)", "locator": "no. 1, printed p. 4", "url": "https://jbc.bj.uj.edu.pl/dlibra/publication/969117/edition/929713/powsciagliwosc-i-praca-organ-towarzystwa-r-15-1912-nr-1" }] }
  },
