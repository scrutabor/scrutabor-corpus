  "text": "ordinarium.panem-caelestem",
  "about": "Formuła Dómine, non sum dignus opiera się na słowach setnika z Mt 8, 8. Zamiast puer meus — sługa mój — występuje w niej ánima mea — dusza moja. Panem cæléstem accípiam podobnie nawiązuje do Ps 115, 4 w numeracji Wulgaty (Ps 116, 13 w numeracji hebrajskiej): Cálicem salutáris accípiam — kielich zbawienia przyjmę. Kapłan trzykrotnie powtarza Dómine, non sum dignus, rozpoczynając każde wezwanie nieco podniesionym głosem i kontynuując po cichu.",
  "segments": {
    "s01": { "narrative": "Kapłan przyklęka, wstaje i mówi:" },
    "s02": { "translation": "Przyjmę chleb niebieski i będę wzywał imienia Pana.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 67–68 / printed pp. 64–65", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s03": { "narrative": "Lekko pochylony, kapłan bierze obie części Hostii w lewą rękę i podsuwa pod nie patenę. Bijąc się trzykrotnie prawą ręką w piersi, trzykrotnie mówi nieco podniesionym głosem, pobożnie i pokornie:" },
    "s04": { "translation": "Panie, nie jestem godzien,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 67–68 / printed pp. 64–65", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s05": { "narrative": "Kapłan mówi dalej po cichu." },
    "s06": { "translation": "abyś wszedł pod dach mój: ale powiedz tylko słowo, a będzie uzdrowiona dusza moja.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 67–68 / printed pp. 64–65", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s07": { "translation": "Panie, nie jestem godzien,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 67–68 / printed pp. 64–65", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s08": { "narrative": "Kapłan mówi dalej po cichu." },
    "s09": { "translation": "abyś wszedł pod dach mój: ale powiedz tylko słowo, a będzie uzdrowiona dusza moja.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 67–68 / printed pp. 64–65", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s10": { "translation": "Panie, nie jestem godzien,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 67–68 / printed pp. 64–65", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s11": { "narrative": "Kapłan mówi dalej po cichu." },
    "s12": { "translation": "abyś wszedł pod dach mój: ale powiedz tylko słowo, a będzie uzdrowiona dusza moja.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 67–68 / printed pp. 64–65", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s13": { "narrative": "Kapłan żegna się Hostią nad pateną i mówi:" },
    "s14": { "translation": "Ciało Pana naszego Jezusa Chrystusa niech strzeże mojej duszy na życie wieczne. Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 67–68 / printed pp. 64–65", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s15": { "narrative": "Pochylony, kapłan przyjmuje z czcią obie części Hostii, kładzie patenę na korporale, składa ręce i przez chwilę trwa w rozmyślaniu o Najświętszym Sakramencie." }
  },
