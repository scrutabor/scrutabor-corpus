  "text": "ordinarium.hanc-igitur-paschale",
  "about": "Kapłan, trzymając ręce nad darami, odmawia po cichu tę modlitwę Kanonu za tych, których Bóg odrodził z wody i Ducha Świętego. Ta sama postać jest używana w przepisanych okresach Wielkanocy i Zesłania Ducha Świętego: od Wigilii Paschalnej lub Wigilii Zesłania do soboty odpowiedniej oktawy włącznie.",
  "segments": {
    "s01": { "narrative": "Kapłan trzyma rozłożone ręce nad darami i mówi:" },
    "s02": { "alignments": [{ "words": ["w004", "w005"], "anchor": "w004", "gloss": "naszej służby" }, { "words": ["w006", "w007"], "anchor": "w006", "gloss": "a także" }, { "words": ["w008", "w009", "w010"], "anchor": "w009", "gloss": "całej Twojej rodziny" }, { "words": ["w014", "w015", "w016"], "anchor": "w015", "gloss": "także za tych" }, { "words": ["w018", "w019", "w020"], "anchor": "w019", "gloss": "raczyłeś odrodzić" }, { "words": ["w024", "w025"], "anchor": "w024", "gloss": "Ducha Świętego" }, { "words": ["w029", "w030"], "anchor": "w030", "gloss": "wszystkich grzechów" }], "translation": "Tę więc ofiarę naszej służby, a także całej Twojej rodziny, którą składamy Tobie także za tych, których raczyłeś odrodzić z wody i Ducha Świętego, udzielając im odpuszczenia wszystkich grzechów, prosimy, Panie, abyś łaskawie przyjął," },
    "s05": { "alignments": [{ "words": ["w036", "w037"], "anchor": "w036", "gloss": "i nasze dni" }, { "words": ["w038", "w039", "w040"], "anchor": "w040", "gloss": "w Twoim pokoju" }, { "words": ["w043", "w044", "w045"], "anchor": "w045", "gloss": "od wiecznego potępienia" }, { "words": ["w050", "w051"], "anchor": "w050", "gloss": "Twoich wybranych" }], "translation": "i nasze dni uporządkował w Twoim pokoju, a także nakazał, byśmy zostali uwolnieni od wiecznego potępienia i zaliczeni do trzody Twoich wybranych." },
    "s06": { "narrative": "Kapłan składa ręce." },
    "s07": { "translation": "Przez Chrystusa, Pana naszego. Amen." }
  },
