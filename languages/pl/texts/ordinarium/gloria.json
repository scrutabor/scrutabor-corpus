  "language": "pl",
  "text": "ordinarium.gloria",
  "about": "Hymn rozpoczyna się słowami pieśni aniołów przy narodzeniu Chrystusa. Wielbi Boga Ojca, a następnie zwraca się do Jezusa Chrystusa, Jednorodzonego Syna i Baranka Bożego, prosząc Go o miłosierdzie i przyjęcie modlitwy. Kończy się wyznaniem chwały Chrystusa wraz z Duchem Świętym w chwale Boga Ojca.",
  "segments": {
    "s01": { "narrative": "Na środku ołtarza kapłan rozkłada i składa ręce, lekko pochyla głowę i, jeśli hymn należy odmówić, rozpoczyna go słowami „Glória in excélsis Deo”. Odmawia dalszy ciąg ze złożonymi rękami, pochylając głowę ku krzyżowi przy Deo, przy Adorámus te, przy Grátias ágimus tibi, przy obu Iesu Christe i przy Súscipe deprecatiónem nostram, a przy Cum Sancto Spíritu żegnając się od czoła do piersi." },
    "s02": { "translation": "Chwała na wysokości Bogu.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s03": { "translation": "A na ziemi pokój ludziom dobrej woli.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s04": { "translation": "Chwalimy Cię. Błogosławimy Cię. Wielbimy Cię. Wysławiamy Cię.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s05": { "translation": "Dzięki Ci składamy, bo wielka jest chwała Twoja.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s06": { "translation": "Panie Boże, Królu nieba, Boże Ojcze wszechmogący.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s07": { "translation": "Panie, Synu Jednorodzony, Jezu Chryste.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s08": { "translation": "Panie Boże, Baranku Boży, Synu Ojca.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s09": { "translation": "Który gładzisz grzechy świata, zmiłuj się nad nami.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s10": { "translation": "Który gładzisz grzechy świata, przyjm błaganie nasze.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s11": { "translation": "Który siedzisz po prawicy Ojca, zmiłuj się nad nami.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s12": { "translation": "Albowiem tylko Tyś jest święty. Tylko Tyś jest Panem. Tylko Tyś Najwyższy, Jezu Chryste.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s13": { "translation": "Z Duchem Świętym w chwale Boga Ojca. Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] }
  },
