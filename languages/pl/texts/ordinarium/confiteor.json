  "text": "ordinarium.confiteor",
  "about": "Confíteor usługujących w modlitwach u stopni ołtarza. Zwraca się do kapłana słowami „tibi, pater” i „te, pater”. W drugim stopniu uczestnictwa we Mszy cichej wierni mogą odmawiać je wraz z usługującym.",
  "segments": {
    "s01": { "narrative": "Usługujący powtarzają Confíteor." },
    "s02": { "translation": "Spowiadam się Bogu wszechmogącemu, Najświętszej Maryi zawsze Dziewicy, świętemu Michałowi Archaniołowi, świętemu Janowi Chrzcicielowi, świętym Apostołom Piotrowi i Pawłowi, wszystkim Świętym i tobie, ojcze:", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scans 69–70 / printed pp. 55–56", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s03": { "translation": "że bardzo zgrzeszyłem myślą, mową i uczynkiem:", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scans 69–70 / printed pp. 55–56", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s04": { "narrative": "Trzykrotnie uderzają się w piersi." },
    "s05": { "translation": "moja wina, moja wina, moja bardzo wielka wina.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scans 69–70 / printed pp. 55–56", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s06": { "translation": "Przeto błagam Najświętszą Maryję zawsze Dziewicę, świętego Michała Archanioła, świętego Jana Chrzciciela, świętych Apostołów Piotra i Pawła, wszystkich Świętych i ciebie, ojcze, o modlitwę za mnie do Pana Boga naszego.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scans 69–70 / printed pp. 55–56", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] }
  },
