  "text": "ordinarium.hanc-igitur",
  "about": "Kapłan odmawia tę modlitwę po cichu, trzymając ręce rozłożone nad darami. Prosi Boga, aby przyjął tę ofiarę, napełnił nasze życie pokojem, zachował nas od potępienia i zaliczył do grona wybranych.",
  "segments": {
    "s01": { "narrative": "Kapłan trzyma rozłożone ręce nad darami, a krótko przed Przeistoczeniem usługujący uprzedza wiernych dzwonkiem." },
    "s02": { "translation": "Prosimy Cię więc, Panie, abyś łaskawie przyjął tę ofiarę naszej służby, a także całej Twojej rodziny;", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 57", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s03": { "translation": "uporządkował nasze dni w Twoim pokoju oraz rozkazał wyrwać nas od wiecznego potępienia i zaliczyć do grona Twoich wybranych.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 57", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s04": { "narrative": "Kapłan składa ręce." },
    "s05": { "translation": "Przez Chrystusa Pana naszego. Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 57", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] }
  },
