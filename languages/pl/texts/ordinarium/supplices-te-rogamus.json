  "text": "ordinarium.supplices-te-rogamus",
  "about": "Kapłan, głęboko pochylony i ze złożonymi rękami opartymi na ołtarzu, prosi Boga, aby ofiara została zaniesiona przez ręce Jego świętego Anioła na wzniosły ołtarz przed oblicze Bożego majestatu. Modlitwa nie nadaje Aniołowi imienia. Zdanie rozpoczynające się od „ut” prowadzi do „repleámur”: przyjmujący Ciało i Krew Chrystusa proszą o pełnię błogosławieństwa i łaski.",
  "segments": {
    "s01": { "narrative": "Kapłan pochyla się głęboko i kładzie złożone ręce na ołtarzu." },
    "s02": { "translation": "Pokornie Cię prosimy, wszechmogący Boże: rozkaż, aby te dary zostały zaniesione przez ręce Twojego świętego Anioła na Twój ołtarz na wysokości, w obliczu Twojego boskiego majestatu:", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 59–60", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 70", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s04": { "translation": "abyśmy wszyscy, którzy", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 59–60", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 70", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s03": { "narrative": "Kapłan całuje ołtarz." },
    "s11": { "translation": "przez to uczestnictwo w ołtarzu", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 59–60", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 70", "url": "https://archive.org/details/pimiennictwopol03macigoog" }, { "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "1 Kor 10,16–18, printed p. 189", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s05": { "narrative": "Kapłan składa ręce i czyni jeden znak krzyża nad Hostią i jeden nad kielichem." },
    "s06": { "translation": "przyjmiemy Najświętsze Ciało i Krew Twojego Syna,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 59–60", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 70", "url": "https://archive.org/details/pimiennictwopol03macigoog" }, { "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "1 Kor 10,16–18, printed p. 189", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s07": { "narrative": "Kapłan żegna się." },
    "s08": { "translation": "zostali napełnieni wszelkim błogosławieństwem niebieskim i łaską.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 59–60", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 70", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s09": { "narrative": "Kapłan składa ręce." },
    "s10": { "translation": "Przez tegoż Chrystusa, Pana naszego. Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 59–60", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 70", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] }
  },
