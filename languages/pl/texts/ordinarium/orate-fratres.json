  "text": "ordinarium.orate-fratres",
  "about": "„Meum ac vestrum” określa „sacrifícium” w liczbie pojedynczej: „moja i wasza ofiara”. Odpowiedź prosi, by Pan przyjął ją „de mánibus tuis” — z rąk kapłana — na chwałę swojego imienia oraz dla dobra obecnych i całego Kościoła. Rubryka nakazuje kapłanowi wypowiedzieć wezwanie nieco podniesionym głosem, a końcowe „Amen” głosem zniżonym.",
  "segments": {
    "s01": { "narrative": "Kapłan całuje ołtarz, odwraca się do ludu, rozkłada i składa ręce. Głos podnosi tylko na słowach „Oráte, fratres”, resztę mówi po cichu." },
    "s02": { "translation": "Módlcie się, bracia, aby moją i waszą ofiarę przyjął Bóg Ojciec wszechmogący.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scan 57 / printed p. 54", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s03": { "narrative": "Odpowiada usługujący albo obecni. Jeśli nie ma komu odpowiedzieć, kapłan odpowiada sam sobie, mówiąc meis — moich — zamiast tuis." },
    "s04": { "translation": "Niech Pan przyjmie ofiarę z rąk twoich na cześć i chwałę swojego imienia, a także na pożytek nasz i całego swojego Kościoła świętego.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scan 57 / printed p. 54", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s05": { "narrative": "Kapłan mówi Amen zniżonym głosem." },
    "s06": { "translation": "Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scan 57 / printed p. 54", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] }
  },
