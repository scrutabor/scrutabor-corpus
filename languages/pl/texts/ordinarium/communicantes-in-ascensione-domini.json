  "language": "pl",
  "text": "ordinarium.communicantes-in-ascensione-domini",
  "about": "Kapłan odmawia tę część Kanonu po cichu, we wspólnocie z Kościołem. Ta postać jest przeznaczona na święto Wniebowstąpienia Pańskiego i wspomina wyniesienie natury ludzkiej zjednoczonej z Synem. Po wspomnieniu świętych prosi Ojca o Jego opiekę, przez Chrystusa.",
  "segments": {
    "s01": { "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w005", "gloss": "obchodzimy najświętszy dzień" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "nasz Pan" }, { "words": ["w009", "w010", "w011"], "anchor": "w010", "gloss": "Twój Jednorodzony Syn" }, { "words": ["w012", "w013", "w014", "w015", "w016"], "anchor": "w016", "gloss": "naszą słabą naturę zjednoczoną z sobą" }, { "words": ["w017", "w018", "w019", "w020"], "anchor": "w020", "gloss": "po prawicy Twojej chwały" }], "translation": "Trwamy we wspólnocie i obchodzimy najświętszy dzień, w którym nasz Pan, Twój Jednorodzony Syn, umieścił po prawicy Twojej chwały naszą słabą naturę zjednoczoną z sobą," },
    "s02": { "alignments": [{ "words": ["w022", "w023"], "anchor": "w022", "gloss": "a także" }, { "words": ["w024", "w025"], "anchor": "w025", "gloss": "czcimy pamięć" }, { "words": ["w026", "w027"], "anchor": "w027", "gloss": "przede wszystkim" }, { "words": ["w029", "w030"], "anchor": "w030", "gloss": "zawsze Dziewicy" }], "translation": "a także czcimy pamięć przede wszystkim chwalebnej zawsze Dziewicy" },
    "s03": { "narrative": "Kapłan skłania głowę." },
    "s04": { "translation": "Maryi, Matki Tego samego Boga i Pana naszego" },
    "s05": { "narrative": "Kapłan skłania głowę." },
    "s06": { "translation": "Jezusa Chrystusa;" },
    "s07": { "alignments": [{ "words": ["w040", "w041"], "anchor": "w040", "gloss": "a także" }, { "words": ["w044", "w045", "w046"], "anchor": "w046", "gloss": "Oblubieńca tej samej Dziewicy" }], "translation": "a także błogosławionego Józefa, Oblubieńca tej samej Dziewicy," },
    "s08": { "alignments": [{ "words": ["w048", "w049", "w050", "w051", "w052"], "anchor": "w049", "gloss": "Twoich błogosławionych Apostołów i Męczenników" }], "translation": "i Twoich błogosławionych Apostołów i Męczenników: Piotra i Pawła, Andrzeja, Jakuba, Jana, Tomasza, Jakuba, Filipa, Bartłomieja, Mateusza, Szymona i Tadeusza;" },
    "s09": { "translation": "Linusa, Kleta, Klemensa, Sykstusa, Korneliusza, Cypriana, Wawrzyńca, Chryzogona, Jana i Pawła, Kosmy i Damiana;" },
    "s10": { "alignments": [{ "words": ["w082", "w083", "w084"], "anchor": "w083", "gloss": "wszystkich Twoich świętych" }, { "words": ["w090", "w091"], "anchor": "w091", "gloss": "we wszystkim" }, { "words": ["w092", "w093", "w094", "w095"], "anchor": "w094", "gloss": "byli umocnieni pomocą Twojej opieki" }], "translation": "i wszystkich Twoich świętych. Przez ich zasługi i modlitwy racz sprawić, abyśmy we wszystkim byli umocnieni pomocą Twojej opieki." },
    "s11": { "narrative": "Kapłan składa ręce." },
    "s12": { "translation": "Przez Tego samego Chrystusa, Pana naszego. Amen." }
  },
  "words": {
    "w001": { "gloss": "Trwamy we wspólnocie", "explanation": "Wspólnota modlącego się Kościoła obejmuje także wspomnienie Maryi i świętych, których imiona następują w tej modlitwie." },
