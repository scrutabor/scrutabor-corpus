  "language": "pl",
  "text": "ordinarium.communicantes-in-epiphania-domini",
  "about": "Kapłan odmawia tę część Kanonu po cichu, we wspólnocie z Kościołem. Ta postać jest przeznaczona na święto Objawienia Pańskiego i wspomina widzialne ukazanie się Jednorodzonego w ciele. Po wspomnieniu świętych prosi Ojca o Jego opiekę, przez Chrystusa.",
  "segments": {
    "s01": { "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w005", "gloss": "obchodzimy najświętszy dzień" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "Twój Jednorodzony" }, { "words": ["w009", "w010", "w011", "w012", "w013"], "anchor": "w013", "gloss": "współwieczny z Tobą w Twojej chwale" }, { "words": ["w014", "w015", "w016", "w017"], "anchor": "w015", "gloss": "w naszym prawdziwym ciele" }], "translation": "Trwamy we wspólnocie i obchodzimy najświętszy dzień, w którym Twój Jednorodzony, współwieczny z Tobą w Twojej chwale, ukazał się widzialnie w cielesnej postaci, w naszym prawdziwym ciele," },
    "s02": { "alignments": [{ "words": ["w021", "w022"], "anchor": "w021", "gloss": "a także" }, { "words": ["w023", "w024"], "anchor": "w024", "gloss": "czcimy pamięć" }, { "words": ["w025", "w026"], "anchor": "w026", "gloss": "przede wszystkim" }, { "words": ["w028", "w029"], "anchor": "w029", "gloss": "zawsze Dziewicy" }], "translation": "a także czcimy pamięć przede wszystkim chwalebnej zawsze Dziewicy" },
    "s03": { "narrative": "Kapłan skłania głowę." },
    "s04": { "translation": "Maryi, Matki Tego samego Boga i Pana naszego" },
    "s05": { "narrative": "Kapłan skłania głowę." },
    "s06": { "translation": "Jezusa Chrystusa;" },
    "s07": { "alignments": [{ "words": ["w039", "w040"], "anchor": "w039", "gloss": "a także" }, { "words": ["w043", "w044", "w045"], "anchor": "w045", "gloss": "Oblubieńca tej samej Dziewicy" }], "translation": "a także błogosławionego Józefa, Oblubieńca tej samej Dziewicy," },
    "s08": { "alignments": [{ "words": ["w047", "w048", "w049", "w050", "w051"], "anchor": "w048", "gloss": "Twoich błogosławionych Apostołów i Męczenników" }], "translation": "i Twoich błogosławionych Apostołów i Męczenników: Piotra i Pawła, Andrzeja, Jakuba, Jana, Tomasza, Jakuba, Filipa, Bartłomieja, Mateusza, Szymona i Tadeusza;" },
    "s09": { "translation": "Linusa, Kleta, Klemensa, Sykstusa, Korneliusza, Cypriana, Wawrzyńca, Chryzogona, Jana i Pawła, Kosmy i Damiana;" },
    "s10": { "alignments": [{ "words": ["w081", "w082", "w083"], "anchor": "w082", "gloss": "wszystkich Twoich świętych" }, { "words": ["w089", "w090"], "anchor": "w090", "gloss": "we wszystkim" }, { "words": ["w091", "w092", "w093", "w094"], "anchor": "w093", "gloss": "byli umocnieni pomocą Twojej opieki" }], "translation": "i wszystkich Twoich świętych. Przez ich zasługi i modlitwy racz sprawić, abyśmy we wszystkim byli umocnieni pomocą Twojej opieki." },
    "s11": { "narrative": "Kapłan składa ręce." },
    "s12": { "translation": "Przez Tego samego Chrystusa, Pana naszego. Amen." }
  },
  "words": {
    "w001": { "gloss": "Trwamy we wspólnocie", "explanation": "Wspólnota modlącego się Kościoła obejmuje także wspomnienie Maryi i świętych, których imiona następują w tej modlitwie." },
    "w002": { "gloss": "i" },
    "w003": {  },
    "w004": {  },
