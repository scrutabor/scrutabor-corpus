  "schema_version": "0.18.0",
  "language": "pl",
  "text": "ordinarium.praefatio-sancti-ioseph-in-solemnitate",
  "about": "Prefacja o świętym Józefie z formułą «Solemnitáte». Wysławia sprawiedliwego Oblubieńca Bogarodzicy, wiernego opiekuna Świętej Rodziny i ziemskiego stróża Syna Bożego.",
  "segments": {
    "s01": { "narrative": "Następnie kapłan rozłącza ręce i trzyma je rozłożone aż do końca Prefacji. Po jej zakończeniu ponownie je składa i pochylony mówi: Sanctus." },
    "s02": { "translation": "Zaprawdę godne to i sprawiedliwe, słuszne i zbawienne, byśmy Tobie zawsze i wszędzie składali dzięki:" },
    "s03": { "translation": "Panie, Ojcze święty, wszechmogący, wieczny Boże:" },
    "s04": { "translation": "I abyśmy Cię w uroczystość świętego Józefa należnymi pochwałami uwielbiali, błogosławili i wysławiali." },
    "s05": { "translation": "On, mąż sprawiedliwy, został przez Ciebie dany Bogarodzicy Dziewicy za Oblubieńca; jako sługa wierny i roztropny został postawiony nad Twoją Rodziną, aby w ojcowskim zastępstwie strzegł Jednorodzonego Syna Twojego, poczętego za sprawą Ducha Świętego, Jezusa Chrystusa, Pana naszego." },
    "s06": { "translation": "Przez Niego Aniołowie chwalą Twój majestat, Państwa go uwielbiają, a Potęgi przed nim drżą." },
    "s07": { "translation": "Niebiosa, Moce niebios i błogosławieni Serafini wspólnie i radośnie wysławiają Twój majestat." },
    "s08": { "translation": "Prosimy Cię, pozwól, aby także nasze głosy dołączyły do ich głosów, gdy z pokorą wyznajemy:" }
  },
