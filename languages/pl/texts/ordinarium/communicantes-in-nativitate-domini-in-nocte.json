  "text": "ordinarium.communicantes-in-nativitate-domini-in-nocte",
  "about": "Kapłan odmawia tę część Kanonu po cichu, we wspólnocie z Kościołem. Pierwsza Msza Narodzenia Pańskiego ma własne wspomnienie najświętszej nocy. O wyborze tej postaci decyduje formularz Mszy, nie sama pora zegarowa. Po wspomnieniu świętych prosi Ojca o Jego opiekę, przez Chrystusa.",
  "segments": {
    "s01": { "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w005", "gloss": "obchodzimy najświętszą noc" }], "translation": "Trwamy we wspólnocie i obchodzimy najświętszą noc, w której błogosławionej" },
    "s02": { "narrative": "Kapłan skłania głowę." },
    "s03": { "translation": "Maryi nieskalane dziewictwo zrodziło temu światu Zbawiciela," },
    "s04": { "alignments": [{ "words": ["w015", "w016"], "anchor": "w015", "gloss": "a także" }, { "words": ["w017", "w018"], "anchor": "w018", "gloss": "czcimy pamięć" }, { "words": ["w019", "w020"], "anchor": "w020", "gloss": "przede wszystkim" }, { "words": ["w023", "w024"], "anchor": "w024", "gloss": "zawsze Dziewicy" }], "translation": "a także czcimy pamięć przede wszystkim tej samej chwalebnej zawsze Dziewicy" },
    "s05": { "narrative": "Kapłan skłania głowę." },
    "s06": { "translation": "Maryi, Matki Tego samego Boga i Pana naszego" },
    "s07": { "narrative": "Kapłan skłania głowę." },
    "s08": { "translation": "Jezusa Chrystusa;" },
    "s09": { "alignments": [{ "words": ["w034", "w035"], "anchor": "w034", "gloss": "a także" }, { "words": ["w038", "w039", "w040"], "anchor": "w040", "gloss": "Oblubieńca tej samej Dziewicy" }], "translation": "a także błogosławionego Józefa, Oblubieńca tej samej Dziewicy," },
    "s10": { "alignments": [{ "words": ["w042", "w043", "w044", "w045", "w046"], "anchor": "w043", "gloss": "Twoich błogosławionych Apostołów i Męczenników" }], "translation": "i Twoich błogosławionych Apostołów i Męczenników: Piotra i Pawła, Andrzeja, Jakuba, Jana, Tomasza, Jakuba, Filipa, Bartłomieja, Mateusza, Szymona i Tadeusza;" },
    "s11": { "translation": "Linusa, Kleta, Klemensa, Sykstusa, Korneliusza, Cypriana, Wawrzyńca, Chryzogona, Jana i Pawła, Kosmy i Damiana;" },
    "s12": { "alignments": [{ "words": ["w076", "w077", "w078"], "anchor": "w077", "gloss": "wszystkich Twoich świętych" }, { "words": ["w084", "w085"], "anchor": "w085", "gloss": "we wszystkim" }, { "words": ["w086", "w087", "w088", "w089"], "anchor": "w088", "gloss": "byli umocnieni pomocą Twojej opieki" }], "translation": "i wszystkich Twoich świętych. Przez ich zasługi i modlitwy racz sprawić, abyśmy we wszystkim byli umocnieni pomocą Twojej opieki." },
    "s13": { "narrative": "Kapłan składa ręce." },
    "s14": { "translation": "Przez Tego samego Chrystusa, Pana naszego. Amen." }
  },
  "words": {
    "w001": { "gloss": "Trwamy we wspólnocie", "explanation": "Wspólnota modlącego się Kościoła obejmuje także wspomnienie Maryi i świętych, których imiona następują w tej modlitwie." },
    "w002": { "gloss": "i" },
    "w003": {  },
    "w004": {  },
    "w005": { "explanation": "Narodzenie Zbawiciela jest opisane przez obraz nieskalanego dziewictwa Maryi, które zrodziło Go światu. Maryja pozostaje wskazaną w modlitwie Matką." },
