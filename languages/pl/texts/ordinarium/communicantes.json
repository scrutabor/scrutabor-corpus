  "text": "ordinarium.communicantes",
  "about": "Modlitwa wspomina w jedności z całym Kościołem Najświętszą Maryję Pannę, św. Józefa, Apostołów i męczenników. Po wymienieniu świętych prosi Boga, aby przez ich zasługi i modlitwy otaczał wiernych swoją opieką.",
  "segments": {
    "s01": { "translation": "Trwając we wspólnocie, ze czcią wspominamy przede wszystkim Maryję, pełną chwały i zawsze Dziewicę, Matkę Jezusa Chrystusa, naszego Boga i Pana:", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 57", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s02": { "translation": "a także świętego Józefa, Oblubieńca tej samej Dziewicy," },
    "s03": { "translation": "oraz Twoich świętych Apostołów i Męczenników: Piotra i Pawła, Andrzeja, Jakuba, Jana, Tomasza, Jakuba, Filipa, Bartłomieja, Mateusza, Szymona i Tadeusza;", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 57", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s04": { "translation": "Linusa, Kleta, Klemensa, Sykstusa, Korneliusza, Cypriana, Wawrzyńca, Chryzogona, Jana i Pawła, Kosmy i Damiana;", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 57", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s05": { "translation": "i wszystkich Twoich Świętych; przez ich zasługi i modlitwy racz sprawić, aby Twoja opiekuńcza pomoc strzegła nas we wszystkim.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 57", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s06": { "narrative": "Kapłan składa ręce." },
    "s07": { "translation": "Przez tegoż Chrystusa Pana naszego. Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 57", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] }
  },
