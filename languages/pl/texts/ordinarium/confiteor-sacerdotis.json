  "language": "pl",
  "text": "ordinarium.confiteor-sacerdotis",
  "about": "Kapłan odmawia Confíteor jako pierwszy, głęboko pochylony. Zwraca się do usługujących słowami „vobis, fratres” i „vos, fratres”. Oni odmawiają potem własne wyznanie, mówiąc „tibi, pater” i „te, pater” tam, gdzie kapłan mówił „vobis, fratres” i „vos, fratres”.",
  "segments": {
    "s01": { "narrative": "Kapłan składa ręce, głęboko się pochyla i odmawia Confíteor." },
    "s02": { "translation": "Spowiadam się Bogu wszechmogącemu, Najświętszej Maryi zawsze Dziewicy, świętemu Michałowi Archaniołowi, świętemu Janowi Chrzcicielowi, świętym Apostołom Piotrowi i Pawłowi, wszystkim Świętym i wam, bracia:", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scans 69–70 / printed pp. 55–56", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s03": { "translation": "że bardzo zgrzeszyłem myślą, mową i uczynkiem:", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scans 69–70 / printed pp. 55–56", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s04": { "narrative": "Kapłan trzykrotnie uderza się w piersi." },
    "s05": { "translation": "moja wina, moja wina, moja bardzo wielka wina.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scans 69–70 / printed pp. 55–56", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] },
    "s06": { "translation": "Przeto błagam Najświętszą Maryję zawsze Dziewicę, świętego Michała Archanioła, świętego Jana Chrzciciela, świętych Apostołów Piotra i Pawła, wszystkich Świętych i was, bracia, o modlitwę za mnie do Pana Boga naszego.", "translation_citations": [{ "title": "Katolik w modlitwie (1902)", "locator": "PDF scans 69–70 / printed pp. 55–56", "url": "https://obc.opole.pl/dlibra/publication/13965/edition/12961/katolik-w-modlitwie-czyli-ksiazka-do-nabozenstwa-oraz-spiewnik-koscielny" }] }
  },
