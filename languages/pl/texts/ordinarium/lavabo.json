{
  "schema_version": "0.18.0",
  "language": "pl",
  "text": "ordinarium.lavabo",
  "about": "Ps 25, 6–12 według numeracji Wulgaty (Ps 26 w numeracji hebrajskiej), odmawiany podczas obmycia rąk. We Mszach za zmarłych oraz we Mszach okresowych od Niedzieli Męki Pańskiej do Wielkiego Czwartku włącznie opuszcza się „Glória Patri”. Sam psalm pozostaje.",
  "segments": {
    "s01": { "narrative": "Kapłan obmywa końce palców, kciuka i wskazującego, odmawiając psalm." },
    "s02": { "translation": "Obmyję ręce pośród niewinnych i obejdę Twój ołtarz, Panie,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 55–56 / printed pp. 52–53", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s03": { "translation": "abym usłyszał głos uwielbienia i opowiadał o wszystkich Twoich cudach.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 55–56 / printed pp. 52–53", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s04": { "translation": "Panie, umiłowałem piękno Twojego domu i miejsce, w którym mieszka Twoja chwała.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 55–56 / printed pp. 52–53", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s05": { "translation": "Boże, nie zatracaj mojej duszy razem z bezbożnymi ani mojego życia z ludźmi żądnymi krwi,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 55–56 / printed pp. 52–53", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s06": { "translation": "w których rękach jest nieprawość, a ich prawica pełna jest przekupstwa.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 55–56 / printed pp. 52–53", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s07": { "translation": "Ja zaś postępowałem niewinnie; wykup mnie i zmiłuj się nade mną.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 55–56 / printed pp. 52–53", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s08": { "translation": "Moja stopa stanęła na równej drodze; w zgromadzeniach będę Cię błogosławił, Panie.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 55–56 / printed pp. 52–53", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s09": { "translation": "Chwała Ojcu i Synowi, i Duchowi Świętemu.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 55–56 / printed pp. 52–53", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s10": { "translation": "Jak była na początku, teraz i zawsze, i na wieki wieków. Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 55–56 / printed pp. 52–53", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] }
  },
