    "w009": { "gloss": "rozraduje się", "function": "Czas przyszły, równoległy do „vivificábis” (w004): lud będzie się radował w Bogu." },
    "w010": { "gloss": "w" },
    "w011": { "gloss": "Tobie", "function": "Ablativus po „in” (w010)." },
