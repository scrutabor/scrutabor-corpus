  "text": "ordinarium.deus-tu-conversus",
  "about": "Pierwsze trzy wezwania pochodzą z Ps 84, 7–8 i Ps 101, 2 według numeracji Wulgaty, z psałterza gallikańskiego, którym posługuje się Msza: zaczyna on pierwsze z nich słowami Deus, tu convérsus, gdzie późniejsze wydania mają Nonne tu convérsus. Ostatnie to liturgiczne pozdrowienie „Dóminus vobíscum” i odpowiedź na nie.",
  "segments": {
    "s01": { "narrative": "Kapłan, pochylony, mówi dalej." },
    "s02": { "translation": "Boże, Ty zwrócisz się ku nam i przywrócisz nam życie.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 47–48 / printed pp. 44–45", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s03": { "translation": "A Twój lud rozraduje się w Tobie.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 47–48 / printed pp. 44–45", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s04": { "translation": "Okaż nam, Panie, swoje miłosierdzie.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 47–48 / printed pp. 44–45", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s05": { "translation": "I daj nam swoje zbawienie.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 47–48 / printed pp. 44–45", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s06": { "translation": "Panie, wysłuchaj mojej modlitwy.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 47–48 / printed pp. 44–45", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s07": { "translation": "A moje wołanie niech do Ciebie dotrze.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 47–48 / printed pp. 44–45", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s08": { "translation": "Pan z wami.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 47–48 / printed pp. 44–45", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s09": { "translation": "I z duchem twoim.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 47–48 / printed pp. 44–45", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] }
  },
