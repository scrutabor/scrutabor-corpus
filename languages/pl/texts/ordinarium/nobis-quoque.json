    "w045": { "gloss": "nas" },
    "w046": { "gloss": "grona", "function": "Biernik jako dopełnienie „intra” (w043)." },
    "w047": { "gloss": "nie" },
    "w048": { "gloss": "ten, kto szacuje", "function": "Mianownik przy „admítte” (w054) w trybie rozkazującym, równoległy do „largítor” (w053)." },
    "w049": { "gloss": "zasługi" },
    "w050": { "gloss": "lecz" },
    "w051": { "gloss": "przebaczenia", "function": "Dopełniacz zależny od „largítor” (w053)." },
    "w052": { "gloss": "prosimy" },
    "w053": { "gloss": "szczodry dawca", "function": "Mianownik w dopowiedzeniu do niewyrażonego podmiotu „admítte” (w054). Łacina dopuszcza taką konstrukcję przy trybie rozkazującym." },
    "w054": { "gloss": "dopuść" },
    "w055": { "gloss": "przez" },
    "w056": { "gloss": "Chrystusa" },
    "w057": { "gloss": "Pana" },
    "w058": { "gloss": "naszego", "function": "Modlitwa nie kończy się słowem Amen. Zdanie biegnie dalej w Per quem hæc ómnia." }
