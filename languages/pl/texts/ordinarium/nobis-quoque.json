  "language": "pl",
  "text": "ordinarium.nobis-quoque",
  "about": "Przy słowach „Nobis quoque peccatóribus” rubryka nakazuje kapłanowi nieco podnieść głos i uderzyć się w piersi. Modlitwa prosi, by grzeszni słudzy Boga zostali dopuszczeni do wspólnoty ze Świętymi.",
  "segments": {
    "s01": { "narrative": "Kapłan uderza się prawą ręką w piersi i mówi głosem nieco podniesionym:" },
    "s02": { "translation": "Także nam, grzesznikom,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 60–61", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 71", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s03": { "narrative": "Kapłan rozkłada ręce jak przedtem i mówi dalej po cichu." },
    "s04": { "translation": "Twoim sługom, pokładającym nadzieję w obfitości Twoich zmiłowań, racz dać pewien udział i wspólnotę z Twoimi świętymi Apostołami i Męczennikami:", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 60–61", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 71", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s05": { "translation": "z Janem, Szczepanem, Maciejem, Barnabą, Ignacym, Aleksandrem, Marcelinem, Piotrem, Felicytą, Perpetuą, Agatą, Łucją, Agnieszką, Cecylią, Anastazją i wszystkimi Twoimi świętymi:", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 60–61", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 71", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s06": { "translation": "Dopuść nas, prosimy Cię, do ich wspólnoty, nie oceniając zasługi, lecz udzielając przebaczenia.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 60–61", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 71", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s07": { "narrative": "Kapłan składa ręce." },
    "s08": { "translation": "Przez Chrystusa, Pana naszego.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 60–61", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 71", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] }
  },
