  "language": "pl",
  "text": "ordinarium.qui-dixisti",
  "about": "Pierwsza z trzech modlitw odmawianych przez kapłana po cichu przed Komunią. Jej początek przytacza J 14, 27. Kapłan prosi, aby Chrystus nie zważał na jego grzechy, lecz na wiarę Kościoła, i obdarzył Kościół pokojem oraz jednością. Potem, gdzie się go przekazuje, następuje pocałunek pokoju, a we Mszach za zmarłych nie przekazuje się pokoju ani nie odmawia tej modlitwy.",
  "segments": {
    "s01": { "narrative": "Kapłan pochyla się nad ołtarzem, ręce złożone na nim, i odmawia po cichu trzy następujące modlitwy." },
    "s02": { "translation": "Panie Jezu Chryste, który powiedziałeś swoim apostołom:", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 63", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s03": { "translation": "„Pokój zostawiam wam; pokój mój wam daję” —", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 63", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s04": { "translation": "nie zważaj na moje grzechy, lecz na wiarę Twojego Kościoła;", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 63", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s05": { "translation": "i zgodnie z Twoją wolą racz obdarzyć go pokojem i jednoczyć,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 63", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s06": { "translation": "który, będąc Bogiem, żyjesz i królujesz przez wszystkie wieki wieków. Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 63", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s07": { "narrative": "Jeżeli przekazuje się pokój, kapłan całuje ołtarz i mówi:" },
    "s08": { "translation": "Pokój z tobą." },
    "s09": { "translation": "I z duchem twoim.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 62", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s10": { "narrative": "We Mszach za zmarłych nie przekazuje się pokoju i tę modlitwę się opuszcza." }
  },
  "words": {
    "w001": { "gloss": "Panie" },
