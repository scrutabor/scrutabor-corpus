    "w032": { "gloss": "wszystkimi", "function": "Ablativus liczby mnogiej rodzaju męskiego. Zgadza się z „Sanctis” (w033)." },
    "w033": { "gloss": "Świętymi", "function": "Przymiotnik użyty rzeczownikowo: święci." },
