  "language": "pl",
  "text": "ordinarium.libera-nos",
  "about": "Modlitwa „Líbera nos” rozwija ostatnią prośbę Modlitwy Pańskiej: „wybaw nas od złego”. Prosi o to wybawienie przez wstawiennictwo Najświętszej Maryi Panny, Apostołów Piotra, Pawła i Andrzeja oraz wszystkich świętych. Kapłan odmawia ją po cichu nad pateną i żegna się nią, a słychać dopiero końcowe Per ómnia sǽcula sæculórum.",
  "segments": {
    "s01": { "narrative": "Kapłan bierze patenę prawą ręką, między palec wskazujący a środkowy, trzyma ją pionowo nad ołtarzem i odmawia modlitwę po cichu." },
    "s02": { "translation": "Wybaw nas, prosimy Cię, Panie, od wszelkiego zła przeszłego, obecnego i przyszłego; i za wstawiennictwem błogosławionej i chwalebnej Maryi, zawsze Dziewicy, Bożej Rodzicielki, wraz z Twoimi błogosławionymi apostołami Piotrem i Pawłem, Andrzejem i wszystkimi świętymi,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 62", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s03": { "narrative": "Kapłan żegna się pateną, od czoła do piersi." },
    "s04": { "translation": "łaskawie udziel nam pokoju w naszych dniach,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 62", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s05": { "narrative": "Kapłan całuje patenę." },
    "s06": { "translation": "abyśmy, wspomożeni Twoim miłosierdziem, zawsze byli wolni od grzechu i chronieni przed wszelkim zamętem.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 62", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s07": { "narrative": "Kapłan wsuwa patenę pod Hostię, odkrywa kielich, przyklęka, wstaje, bierze Hostię i trzymając ją oburącz nad kielichem, łamie na dwoje." },
    "s08": { "translation": "Przez tego samego Pana naszego Jezusa Chrystusa, Twojego Syna,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 62", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s09": { "narrative": "Połowę trzymaną w prawej ręce kapłan kładzie na patenie, a z połowy pozostałej w lewej odłamuje małą cząstkę." },
    "s10": { "translation": "który, będąc Bogiem, żyje i króluje z Tobą w jedności Ducha Świętego,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 62", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s11": { "narrative": "Drugą połowę kapłan dołącza do połowy leżącej na patenie, trzyma małą cząstkę nad kielichem i mówi głosem słyszalnym albo śpiewa:" },
    "s12": { "translation": "przez wszystkie wieki wieków.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 62", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s13": { "translation": "Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 62", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed pp. 71–72", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] }
  },
  "words": {
