    "w040": { "gloss": "abyśmy", "function": "Wprowadza zdanie celowe z orzeczeniem „simus” (w048)." },
    "w041": { "gloss": "pomocą", "function": "Ablativus narzędzia przy „adiúti” (w044)." },
