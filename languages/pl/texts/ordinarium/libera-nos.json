    "w007": { "gloss": "zła", "function": "Ablativus liczby mnogiej zależny od „ab” (w005)." },
    "w008": { "gloss": "przeszłego", "function": "Pierwszy z trzech przymiotników w ablativie liczby mnogiej. Zgadza się z „malis” (w007)." },
    "w009": { "gloss": "obecnego" },
