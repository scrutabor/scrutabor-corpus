    "w002": { "gloss": "nas" },
    "w003": { "gloss": "prosimy", "function": "Pierwsza osoba liczby mnogiej czasu teraźniejszego, użyta jako wtrącenie." },
    "w004": { "gloss": "Panie" },
    "w005": { "gloss": "od" },
