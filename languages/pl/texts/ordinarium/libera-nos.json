    "w045": { "gloss": "i", "function": "Pierwsza połowa pary et… et… ze spójnikiem „et” (w051): i wolni od grzechu, i bezpieczni od zamętu." },
    "w046": { "gloss": "od" },
    "w047": { "gloss": "grzechu" },
    "w048": { "gloss": "byli", "function": "Orzeczenie zdania rozpoczętego przez „ut” (w040), z orzecznikami „líberi” (w050) i „secúri” (w055)." },
