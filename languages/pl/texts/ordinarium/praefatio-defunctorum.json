  "schema_version": "0.18.0",
  "language": "pl",
  "text": "ordinarium.praefatio-defunctorum",
  "about": "Prefacja za zmarłych. Głosi nadzieję zmartwychwstania i wyznaje, że życie wiernych zmienia się, lecz się nie kończy, a po ziemskim mieszkaniu czeka wieczny dom w niebie.",
  "segments": {
    "s01": {
      "narrative": "Następnie kapłan rozłącza ręce i trzyma je rozłożone aż do końca Prefacji. Po jej zakończeniu ponownie je składa i pochylony mówi: Sanctus."
    },
    "s02": {
      "translation": "Zaprawdę godne to i sprawiedliwe, słuszne i zbawienne, byśmy Tobie zawsze i wszędzie składali dzięki:"
    },
    "s03": {
      "translation": "Panie, Ojcze święty, wszechmogący, wieczny Boże: przez Chrystusa, Pana naszego."
    },
    "s04": {
      "translation": "W Nim zabłysła nam nadzieja błogosławionego zmartwychwstania, aby tych, których zasmuca pewny los śmierci, pocieszała obietnica przyszłej nieśmiertelności."
    },
    "s05": {
      "translation": "Albowiem życie Twoich wiernych, Panie, zmienia się, lecz się nie kończy, a gdy rozpadnie się dom tego ziemskiego pobytu, przygotowane jest wieczne mieszkanie w niebie."
    },
    "s06": {
      "translation": "Przeto z Aniołami i Archaniołami, z Tronami i Państwami oraz ze wszystkimi hufcami wojska niebieskiego śpiewamy hymn ku Twojej chwale, wołając bez końca:"
    }
  },
