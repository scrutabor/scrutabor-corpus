  "text": "ordinarium.praefatio-dialogus",
  "about": "Dialog poprzedzający Prefację. W wezwaniu „Sursum corda” czasownik pozostaje domyślny. W odpowiedzi „Habémus ad Dóminum” niewypowiedzianym dopełnieniem są „corda”. Ostatnią odpowiedź kapłan podejmuje słowami „Vere dignum et iustum est”.",
  "segments": {
    "s01": { "narrative": "Kapłan kładzie obie ręce na ołtarzu, po jego obu stronach, i unosi je nieco, mówiąc „Sursum corda”. Przy „Grátias agámus” składa je przed piersią i pochyla głowę." },
    "s02": { "translation": "Pan z wami.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 54", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s03": { "translation": "I z duchem twoim.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 54", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s04": { "translation": "W górę serca.", "translation_citations": [{ "title": "Katechizm religji rzymsko-katolickiej (1925)", "locator": "s. 168", "url": "https://sbc.org.pl/dlibra/publication/339133/edition/320337/katechizm-religji-rzymsko-katolickiej-dla-uzytku-szkol-polskich-w-republice-czechoslowackiej" }] },
    "s05": { "translation": "Wznosimy je do Pana.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 55", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s06": { "translation": "Dzięki składajmy Panu, Bogu naszemu.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "s. 55", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s07": { "translation": "Godne to i sprawiedliwe." }
  },
