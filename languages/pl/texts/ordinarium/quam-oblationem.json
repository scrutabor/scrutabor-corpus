  "text": "ordinarium.quam-oblationem",
  "about": "Kapłan prosi Boga, aby zechciał uczynić ofiarę błogosławioną, uznaną, zatwierdzoną, rozumną i miłą. Końcowa prośba brzmi: aby stała się dla nas Ciałem i Krwią najmilszego Syna Bożego, Pana naszego Jezusa Chrystusa.",
  "segments": {
    "s01": { "translation": "Prosimy Cię, Boże, abyś raczył tę ofiarę pod każdym względem uczynić", "translation_citations": [{ "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 69", "url": "https://archive.org/details/pimiennictwopol03macigoog" }, { "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 58", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s02": { "narrative": "Kapłan czyni trzy znaki krzyża nad darami." },
    "s03": { "translation": "błogosławioną, uznaną, zatwierdzoną, rozumną i miłą Tobie:", "translation_citations": [{ "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 69", "url": "https://archive.org/details/pimiennictwopol03macigoog" }, { "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 58", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s04": { "narrative": "Kapłan czyni jeden znak krzyża nad samą Hostią, przy słowie Corpus, i jeden nad samym kielichem, przy Sanguis." },
    "s05": { "translation": "aby dla nas stała się Ciałem i Krwią Twojego najmilszego Syna,", "translation_citations": [{ "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 69", "url": "https://archive.org/details/pimiennictwopol03macigoog" }, { "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 58", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s06": { "narrative": "Kapłan składa ręce." },
    "s07": { "translation": "naszego Pana Jezusa Chrystusa.", "translation_citations": [{ "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 69", "url": "https://archive.org/details/pimiennictwopol03macigoog" }, { "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 58", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] }
  },
