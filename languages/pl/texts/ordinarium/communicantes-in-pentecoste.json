  "schema_version": "0.21.0",
  "language": "pl",
  "text": "ordinarium.communicantes-in-pentecoste",
  "about": "Kapłan odmawia tę część Kanonu po cichu, we wspólnocie z Kościołem. Ta postać wspomina ukazanie się Ducha Świętego Apostołom. Jest używana od Wigilii Zesłania Ducha Świętego do soboty oktawy włącznie. Po wspomnieniu świętych prosi Ojca o Jego opiekę, przez Chrystusa.",
  "segments": {
    "s01": { "alignments": [{ "words": ["w003", "w004", "w005", "w006"], "anchor": "w006", "gloss": "obchodzimy najświętszy dzień Pięćdziesiątnicy" }, { "words": ["w008", "w009"], "anchor": "w008", "gloss": "Duch Święty" }, { "words": ["w011", "w012"], "anchor": "w012", "gloss": "w niezliczonych językach" }], "translation": "Trwamy we wspólnocie i obchodzimy najświętszy dzień Pięćdziesiątnicy, w którym Duch Święty ukazał się Apostołom w niezliczonych językach," },
    "s02": { "alignments": [{ "words": ["w014", "w015"], "anchor": "w014", "gloss": "a także" }, { "words": ["w016", "w017"], "anchor": "w017", "gloss": "czcimy pamięć" }, { "words": ["w018", "w019"], "anchor": "w019", "gloss": "przede wszystkim" }, { "words": ["w021", "w022"], "anchor": "w022", "gloss": "zawsze Dziewicy" }], "translation": "a także czcimy pamięć przede wszystkim chwalebnej zawsze Dziewicy" },
    "s03": { "narrative": "Kapłan skłania głowę." },
    "s04": { "translation": "Maryi, Matki Boga i Pana naszego" },
    "s05": { "narrative": "Kapłan skłania głowę." },
    "s06": { "translation": "Jezusa Chrystusa;" },
    "s07": { "alignments": [{ "words": ["w031", "w032"], "anchor": "w031", "gloss": "a także" }, { "words": ["w035", "w036", "w037"], "anchor": "w037", "gloss": "Oblubieńca tej samej Dziewicy" }], "translation": "a także błogosławionego Józefa, Oblubieńca tej samej Dziewicy," },
    "s08": { "alignments": [{ "words": ["w039", "w040", "w041", "w042", "w043"], "anchor": "w040", "gloss": "Twoich błogosławionych Apostołów i Męczenników" }], "translation": "i Twoich błogosławionych Apostołów i Męczenników: Piotra i Pawła, Andrzeja, Jakuba, Jana, Tomasza, Jakuba, Filipa, Bartłomieja, Mateusza, Szymona i Tadeusza;" },
    "s09": { "translation": "Linusa, Kleta, Klemensa, Sykstusa, Korneliusza, Cypriana, Wawrzyńca, Chryzogona, Jana i Pawła, Kosmy i Damiana;" },
    "s10": { "alignments": [{ "words": ["w073", "w074", "w075"], "anchor": "w074", "gloss": "wszystkich Twoich świętych" }, { "words": ["w081", "w082"], "anchor": "w082", "gloss": "we wszystkim" }, { "words": ["w083", "w084", "w085", "w086"], "anchor": "w085", "gloss": "byli umocnieni pomocą Twojej opieki" }], "translation": "i wszystkich Twoich świętych. Przez ich zasługi i modlitwy racz sprawić, abyśmy we wszystkim byli umocnieni pomocą Twojej opieki." },
    "s11": { "narrative": "Kapłan składa ręce." },
    "s12": { "translation": "Przez Tego samego Chrystusa, Pana naszego. Amen." }
  },
  "words": {
    "w001": { "gloss": "Trwamy we wspólnocie", "explanation": "Wspólnota modlącego się Kościoła obejmuje także wspomnienie Maryi i świętych, których imiona następują w tej modlitwie." },
    "w002": { "gloss": "i" },
    "w003": {  },
    "w004": {  },
    "w005": {  },
    "w006": { "explanation": "Wspominane ukazanie się Ducha Świętego ma Apostołów za odbiorców. Wyrażenie o niezliczonych językach opisuje sposób tego ukazania się." },
    "w007": { "gloss": "w którym" },
    "w008": {  },
    "w009": {  },
    "w010": { "gloss": "Apostołom" },
    "w011": {  },
