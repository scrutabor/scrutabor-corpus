  "schema_version": "0.18.0",
  "language": "pl",
  "text": "ordinarium.praefatio-sanctissimae-trinitatis",
  "about": "Prefacja o Trójcy Przenajświętszej. Wyznaje jednego Boga w trzech Osobach, bez pomieszania Osób i bez podziału istoty, oraz prowadzi do wspólnego śpiewu z chórami anielskimi.",
  "segments": {
    "s01": { "narrative": "Następnie kapłan rozłącza ręce i trzyma je rozłożone aż do końca Prefacji. Po jej zakończeniu ponownie je składa i pochylony mówi: Sanctus." },
    "s02": { "translation": "Zaprawdę godne to i sprawiedliwe, słuszne i zbawienne, byśmy Tobie zawsze i wszędzie składali dzięki:" },
    "s03": { "translation": "Panie, Ojcze święty, wszechmogący, wieczny Boże:" },
    "s04": { "translation": "Który z Jednorodzonym Synem Twoim i Duchem Świętym jesteś jednym Bogiem, jednym Panem: nie w jedności jednej osoby, lecz w Trójcy jednej istoty." },
    "s05": { "translation": "Co bowiem dzięki Twemu objawieniu wierzymy o Twojej chwale, to samo pojmujemy o Twoim Synu i to samo o Duchu Świętym, bez różnicy wynikającej z odrębności." },
    "s06": { "translation": "Aby w wyznaniu prawdziwego i wiecznego Bóstwa była uwielbiana odrębność Osób, jedność istoty i równość majestatu." },
    "s07": { "translation": "Tę równość chwalą Aniołowie i Archaniołowie, Cherubini i Serafini, którzy nie przestają codziennie wołać jednym głosem, mówiąc:" }
  },
