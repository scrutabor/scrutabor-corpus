  "text": "ordinarium.unde-et-memores",
  "about": "Kościół wspomina błogosławioną mękę, zmartwychwstanie i chwalebne wniebowstąpienie Chrystusa. Z darów otrzymanych od Boga ofiaruje Jego majestatowi Ofiarę czystą, Ofiarę świętą, Ofiarę niepokalaną, święty Chleb życia wiecznego oraz Kielich wiecznego zbawienia.",
  "segments": {
    "s01": { "narrative": "Kapłan rozłącza ręce." },
    "s02": { "translation": "Przeto i my, Panie, Twoi słudzy, a także Twój lud święty, pomni na błogosławioną mękę tegoż Chrystusa, Twojego Syna, naszego Pana, na Jego zmartwychwstanie spośród umarłych i chwalebne wniebowstąpienie:", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 59", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed pp. 69–70", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s03": { "translation": "ofiarujemy Twojemu przesławnemu majestatowi z Twoich darów i udzielonych nam dóbr,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 59", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed pp. 69–70", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s04": { "narrative": "Kapłan składa ręce i czyni trzy znaki krzyża nad Hostią i kielichem jednocześnie." },
    "s05": { "translation": "Ofiarę czystą, Ofiarę świętą, Ofiarę niepokalaną,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 59", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed pp. 69–70", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s06": { "narrative": "Kapłan czyni jeden znak krzyża nad Hostią." },
    "s07": { "translation": "Chleb święty życia wiecznego", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 59", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed pp. 69–70", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s08": { "narrative": "Kapłan czyni jeden znak krzyża nad kielichem." },
    "s09": { "translation": "i Kielich wiekuistego zbawienia.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 59", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed pp. 69–70", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] }
  },
