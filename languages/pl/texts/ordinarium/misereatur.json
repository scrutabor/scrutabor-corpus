  "text": "ordinarium.misereatur",
  "about": "Dwie formuły błagalne: pierwsza zwraca się do wszechmogącego Boga, druga do wszechmogącego i miłosiernego Pana. Pierwsza prosi o miłosierdzie, odpuszczenie grzechów i życie wieczne, druga o przebaczenie, rozgrzeszenie i odpuszczenie grzechów. Nie jest to sakramentalna formuła Ego te absolvo.",
  "segments": {
    "s01": { "narrative": "Kapłan, ze złożonymi rękami, odmawia modlitwę o odpuszczenie." },
    "s02": { "translation": "Niech się zmiłuje nad wami Bóg wszechmogący, a odpuściwszy wam grzechy, niech was doprowadzi do życia wiecznego.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 47–48 / printed pp. 44–45", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s03": { "translation": "Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 47–48 / printed pp. 44–45", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s04": { "narrative": "Kapłan żegna się i odmawia drugą modlitwę." },
    "s05": { "translation": "Przebaczenia, rozgrzeszenia i odpuszczenia grzechów naszych niech nam udzieli wszechmogący i miłosierny Pan.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 47–48 / printed pp. 44–45", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s06": { "translation": "Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "PDF scans 47–48 / printed pp. 44–45", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] }
  },
