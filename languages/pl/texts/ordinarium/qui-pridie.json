  "language": "pl",
  "text": "ordinarium.qui-pridie",
  "about": "Opowiadanie o ustanowieniu i konsekracja chleba. Kapłan bierze Hostię, podnosi oczy ku niebu i wypowiada nad nią słowa konsekracji cicho, wyraźnie i uważnie. Następnie przyklęka, ukazuje konsekrowaną Hostię ludowi i ponownie przyklęka. Od tej chwili nie rozłącza kciuków i palców wskazujących, chyba że dotyka Hostii, aż do obmycia palców.",
  "segments": {
    "s01": { "narrative": "Kapłan bierze Hostię." },
    "s02": { "translation": "Który w przeddzień swej męki wziął chleb w swe święte i czcigodne ręce,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 58", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 69", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s03": { "narrative": "Kapłan wznosi oczy ku niebu." },
    "s04": { "translation": "a wzniósłszy oczy ku niebu, ku Tobie, Bogu, swojemu Ojcu wszechmogącemu,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 58", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 69", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s05": { "narrative": "Kapłan pochyla głowę." },
    "s06": { "translation": "składając Ci dzięki,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 58", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 69", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s07": { "narrative": "Kapłan czyni znak krzyża nad Hostią." },
    "s08": { "translation": "pobłogosławił, połamał i dał swoim uczniom, mówiąc:", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 58", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 69", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s09": { "translation": "Bierzcie i jedzcie z tego wszyscy:", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 58", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 69", "url": "https://archive.org/details/pimiennictwopol03macigoog" }, { "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "1 Kor 11, 23–24, printed pp. 190–191", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s10": { "narrative": "Kapłan trzyma Hostię obiema rękami między palcami wskazującymi a kciukami i wymawia słowa konsekracji po cichu, wyraźnie i uważnie nad Hostią, a jeśli Hostii jest więcej — nad wszystkimi razem." },
    "s11": { "translation": "To jest bowiem Ciało moje.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 58", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 69", "url": "https://archive.org/details/pimiennictwopol03macigoog" }, { "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)", "locator": "1 Kor 11, 23–24, printed pp. 190–191", "url": "https://commons.wikimedia.org/wiki/File:PL_Wujek-Biblia_to_jest_ksi%C4%99gi_Starego_i_Nowego_Testamentu_1923.djvu" }] },
    "s12": { "narrative": "Po wymówieniu tych słów kapłan przyklęka i adoruje konsekrowaną Hostię, wstaje, ukazuje ją ludowi — to podniesienie, przy którym usługujący trzykrotnie dzwoni — składa na korporale i znów przyklęka. Odtąd aż do obmycia palców trzyma kciuk i palec wskazujący złączone, rozłączając je tylko do dotknięcia Hostii." }
  },
