  "language": "pl",
  "text": "ordinarium.praefatio-beatae-mariae-virginis-in-conceptione-immaculata",
  "about": "Prefacja o Najświętszej Maryi Pannie, z formułą «Conceptióne immaculáta». Wysławia dziewicze macierzyństwo Maryi i wieczną Światłość daną światu w Jezusie Chrystusie.",
  "segments": {
    "s01": { "narrative": "Następnie kapłan rozłącza ręce i trzyma je rozłożone aż do końca Prefacji. Po jej zakończeniu ponownie je składa i pochylony mówi: Sanctus." },
    "s02": { "translation": "Zaprawdę godne to i sprawiedliwe, słuszne i zbawienne, abyśmy Tobie zawsze i wszędzie składali dzięki:" },
    "s03": { "translation": "Panie, Ojcze święty, wszechmogący, wieczny Boże:" },
    "s04": { "translation": "I abyśmy Cię z okazji Niepokalanego Poczęcia Najświętszej Maryi zawsze Dziewicy wielbili, błogosławili i wysławiali." },
    "s05": { "translation": "Ona to przez ocienienie Ducha Świętego poczęła Twojego Jednorodzonego i, pozostając w chwale dziewictwa, wydała na świat światłość wieczną, Jezusa Chrystusa, Pana naszego.", "alignments": [{ "words": ["w044", "w045", "w046"], "anchor": "w046", "gloss": "gdy trwała chwała dziewictwa" }] },
    "s06": { "translation": "Przez Niego Aniołowie chwalą Twój majestat, Państwa go uwielbiają, a Potęgi przed nim drżą." },
    "s07": { "translation": "Niebiosa, Moce niebios i błogosławieni Serafini wspólnie i radośnie wysławiają Twój majestat." },
    "s08": { "translation": "Prosimy Cię, pozwól, aby także nasze głosy dołączyły do ich głosów, gdy z pokorą wyznajemy:", "alignments": [{ "words": ["w074", "w075", "w076", "w077", "w078", "w079", "w080", "w081", "w082"], "anchor": "w082", "gloss": "Prosimy, abyś nakazał dopuścić także nasze głosy wraz z nimi" }, { "words": ["w083", "w084", "w085"], "anchor": "w085", "gloss": "mówiąc w pokornym wyznaniu" }] }
  },
