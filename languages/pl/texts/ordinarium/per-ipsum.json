  "language": "pl",
  "text": "ordinarium.per-ipsum",
  "about": "Ta doksologia zamyka Kanon. Kapłan czyni Hostią trzy znaki krzyża nad kielichem, a następnie dwa między sobą a kielichem. Przy omnis honor et glória nieco unosi kielich wraz z Hostią. Końcowe Per ómnia sǽcula sæculórum wypowiada głosem słyszalnym, a lud odpowiada Amen.",
  "segments": {
    "s01": { "narrative": "Kapłan odsłania kielich, przyklęka, bierze Hostię w prawą rękę, a kielich w lewą, po czym czyni Hostią trzy znaki krzyża od brzegu do brzegu kielicha." },
    "s02": { "translation": "Przez Niego i z Nim, i w Nim,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 61", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 71", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s03": { "narrative": "Hostią kapłan czyni dwa znaki krzyża między sobą a kielichem." },
    "s04": { "translation": "należy się Tobie, Bogu Ojcu wszechmogącemu, w jedności Ducha Świętego,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 61", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 71", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s05": { "narrative": "Kapłan unosi nieco kielich wraz z Hostią." },
    "s06": { "translation": "wszelka cześć i chwała,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 61", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 71", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s07": { "narrative": "Kapłan odkłada Hostię, nakrywa kielich palką, przyklęka, wstaje i mówi głosem słyszalnym albo śpiewa:" },
    "s08": { "translation": "przez wszystkie wieki wieków.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 61", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 71", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] },
    "s09": { "translation": "Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 61", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }, { "title": "Piśmiennictwo polskie, tom III (1852)", "locator": "printed p. 71", "url": "https://archive.org/details/pimiennictwopol03macigoog" }] }
  },
