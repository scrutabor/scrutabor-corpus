  "language": "pl",
  "text": "ordinarium.aufer-a-nobis",
  "about": "Wchodząc po stopniach ołtarza, kapłan prosi Boga o usunięcie nieprawości, abyśmy mogli wejść do „Sancta sanctórum”, miejsca najświętszego. W drugiej modlitwie prosi we własnym imieniu o odpuszczenie swoich grzechów przez zasługi świętych, których relikwie znajdują się w tym miejscu, oraz wszystkich świętych, całując ołtarz, gdy o nich mówi.",
  "segments": {
    "s01": { "narrative": "Kapłan rozkłada i składa ręce, po czym mówi na głos jedno słowo." },
    "s02": { "translation": "Módlmy się.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 45–46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s03": { "narrative": "Kapłan wstępuje po stopniach do ołtarza i dalszy ciąg mówi po cichu." },
    "s04": { "translation": "Panie, prosimy Cię, zabierz od nas nasze nieprawości, abyśmy z czystymi sercami byli godni wejść do Miejsca Najświętszego.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 45–46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s05": { "translation": "Przez Chrystusa, Pana naszego. Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 45–46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s06": { "narrative": "Ze złożonymi rękami opartymi o ołtarz kapłan pochyla się nad nim i zaczyna drugą modlitwę." },
    "s07": { "translation": "Prosimy Cię, Panie, przez zasługi Twoich świętych,", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 45–46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s08": { "narrative": "Kapłan całuje środek ołtarza." },
    "s09": { "translation": "których relikwie są tutaj, a także przez zasługi wszystkich świętych, abyś raczył odpuścić wszystkie moje grzechy. Amen.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed pp. 45–46", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] }
  },
