  "language": "pl",
  "text": "ordinarium.communicantes-in-nocte-paschae",
  "about": "Kapłan odmawia tę część Kanonu po cichu, we wspólnocie z Kościołem. Wigilia Paschalna ma własne wspomnienie najświętszej nocy Zmartwychwstania. Nie jest to wybór jedynie według pory zegarowej. Po wspomnieniu świętych prosi Ojca o Jego opiekę, przez Chrystusa.",
  "segments": {
    "s01": { "alignments": [{ "words": ["w003", "w004", "w005"], "anchor": "w005", "gloss": "obchodzimy najświętszą noc" }, { "words": ["w007", "w008"], "anchor": "w007", "gloss": "naszego Pana" }], "translation": "Trwamy we wspólnocie i obchodzimy najświętszą noc Zmartwychwstania naszego Pana" },
    "s02": { "narrative": "Kapłan skłania głowę." },
    "s03": { "alignments": [{ "words": ["w011", "w012"], "anchor": "w012", "gloss": "według ciała" }], "translation": "Jezusa Chrystusa według ciała," },
    "s04": { "alignments": [{ "words": ["w013", "w014"], "anchor": "w013", "gloss": "a także" }, { "words": ["w015", "w016"], "anchor": "w016", "gloss": "czcimy pamięć" }, { "words": ["w017", "w018"], "anchor": "w018", "gloss": "przede wszystkim" }, { "words": ["w020", "w021"], "anchor": "w021", "gloss": "zawsze Dziewicy" }], "translation": "a także czcimy pamięć przede wszystkim chwalebnej zawsze Dziewicy" },
    "s05": { "narrative": "Kapłan skłania głowę." },
    "s06": { "translation": "Maryi, Matki Tego samego Boga i Pana naszego" },
    "s07": { "narrative": "Kapłan skłania głowę." },
    "s08": { "translation": "Jezusa Chrystusa;" },
    "s09": { "alignments": [{ "words": ["w031", "w032"], "anchor": "w031", "gloss": "a także" }, { "words": ["w035", "w036", "w037"], "anchor": "w037", "gloss": "Oblubieńca tej samej Dziewicy" }], "translation": "a także błogosławionego Józefa, Oblubieńca tej samej Dziewicy," },
    "s10": { "alignments": [{ "words": ["w039", "w040", "w041", "w042", "w043"], "anchor": "w040", "gloss": "Twoich błogosławionych Apostołów i Męczenników" }], "translation": "i Twoich błogosławionych Apostołów i Męczenników: Piotra i Pawła, Andrzeja, Jakuba, Jana, Tomasza, Jakuba, Filipa, Bartłomieja, Mateusza, Szymona i Tadeusza;" },
    "s11": { "translation": "Linusa, Kleta, Klemensa, Sykstusa, Korneliusza, Cypriana, Wawrzyńca, Chryzogona, Jana i Pawła, Kosmy i Damiana;" },
    "s12": { "alignments": [{ "words": ["w073", "w074", "w075"], "anchor": "w074", "gloss": "wszystkich Twoich świętych" }, { "words": ["w081", "w082"], "anchor": "w082", "gloss": "we wszystkim" }, { "words": ["w083", "w084", "w085", "w086"], "anchor": "w085", "gloss": "byli umocnieni pomocą Twojej opieki" }], "translation": "i wszystkich Twoich świętych. Przez ich zasługi i modlitwy racz sprawić, abyśmy we wszystkim byli umocnieni pomocą Twojej opieki." },
    "s13": { "narrative": "Kapłan składa ręce." },
    "s14": { "translation": "Przez Tego samego Chrystusa, Pana naszego. Amen." }
  },
  "words": {
    "w001": { "gloss": "Trwamy we wspólnocie", "explanation": "Wspólnota modlącego się Kościoła obejmuje także wspomnienie Maryi i świętych, których imiona następują w tej modlitwie." },
    "w002": { "gloss": "i" },
    "w003": {  },
    "w004": {  },
    "w005": { "explanation": "Wspominane Zmartwychwstanie jest Zmartwychwstaniem Chrystusa według ciała. Określenie nocy lub dnia odpowiada właściwej postaci modlitwy." },
    "w006": { "gloss": "Zmartwychwstania" },
