  "text": "ordinarium.pater-noster",
  "about": "Rubryki nazywają zdanie poprzedzające Pater noster prefacją Modlitwy Pańskiej. Po słowach et ne nos indúcas in tentatiónem odpowiedź sed líbera nos a malo przypisują usługującemu. We Mszy cichej wierni mogą odmówić całe Ojcze nasz razem z kapłanem, po łacinie, i dodać z nim Amen.",
  "segments": {
    "s01": { "narrative": "Kapłan składa ręce." },
    "s02": { "translation": "Módlmy się.", "translation_citations": [{ "title": "Pamiątka Missyi dla ludu katolickiego (1903)", "locator": "printed p. 61", "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego" }] },
    "s03": { "translation": "Pouczeni zbawiennymi nakazami i ukształtowani przez Bożą naukę, ośmielamy się powiedzieć:" },
    "s04": { "narrative": "Kapłan rozkłada ręce i tak je trzyma przez całą modlitwę." },
    "s05": { "translation": "Ojcze nasz, któryś jest w niebie,", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 10", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s06": { "translation": "święć się imię Twoje.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 10", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s07": { "translation": "Przyjdź królestwo Twoje.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 10", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s08": { "translation": "Bądź wola Twoja, jako w niebie, tak i na ziemi.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 10", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s09": { "translation": "Chleba naszego powszedniego daj nam dzisiaj.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 10", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s10": { "translation": "I odpuść nam nasze winy, jako i my odpuszczamy naszym winowajcom.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 10", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s11": { "translation": "I nie wódź nas na pokuszenie,", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 10", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s12": { "translation": "ale nas zbaw ode złego.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 10", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] },
    "s13": { "narrative": "Kapłan mówi po cichu Amen." },
    "s14": { "translation": "Amen.", "translation_citations": [{ "title": "Ludwik Skowronek, Droga do Nieba (1907)", "locator": "printed p. 10", "url": "https://sbc.org.pl/dlibra/publication/230307/edition/217677/droga-do-nieba-wyborek-modlitw-i-piesni" }] }
  },
