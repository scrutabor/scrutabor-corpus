        { "id": "w044", "form": "sum", "post": ".", "lemma": "sum", "morph": { "pos": "verb", "person": 1, "number": "sg", "tense": "pres", "mood": "ind", "voice": "act" }, "gloss": { "pl": "jestem", "en": "I am" } },
        { "id": "w045", "form": "Prophéta", "lemma": "propheta", "morph": { "pos": "noun", "case": "nom", "number": "sg", "gender": "m", "decl": 1 }, "gloss": { "pl": "prorokiem", "en": "the prophet" }, "function": { "pl": "Łacina nie ma rodzajnika, więc sama nie rozstrzyga, czy pytają o jakiegoś proroka, czy o Proroka zapowiedzianego Mojżeszowi. Grecki oryginał ma rodzajnik określony i to jego czyta ta edycja. Polszczyzna nie ma rodzajników i nie potrafi tego rozróżnienia zapisać w samym słowie.", "en": "Latin has no article, so by itself it cannot say whether they ask about a prophet or about the Prophet promised to Moses. The Greek behind it has the definite article, and this edition reads it so — the gloss says the prophet." }, "function_citations": { "pl": [{ "title": "Biblia Sacra Vulgata", "locator": "Deuteronomy 18:15" }], "en": [{ "title": "Biblia Sacra Vulgata", "locator": "Deuteronomy 18:15" }] } },
