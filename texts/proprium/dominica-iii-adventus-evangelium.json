        { "id": "w026", "form": "conféssus", "lemma": "confiteor", "morph": { "pos": "verb", "case": "nom", "number": "sg", "gender": "m", "tense": "perf", "mood": "part", "voice": "dep", "conj": 2 }, "head": "w027", "gloss": { "pl": "wyznał", "en": "confessed" } },
        { "id": "w027", "form": "est", "post": ":", "lemma": "sum", "morph": { "pos": "verb", "person": 3, "number": "sg", "tense": "pres", "mood": "ind", "voice": "act" }, "gloss": { "pl": "—", "en": "(has)" }, "function": { "pl": "To samo złożone perfectum co przy pierwszym „conféssus”, powtórzone.", "en": "The same compound perfect as at the first “conféssus”, repeated." } },
        { "id": "w028", "form": "Quia", "lemma": "quia", "morph": { "pos": "conj" }, "gloss": { "pl": "że", "en": "that" }, "function": { "pl": "Wprowadza mowę niezależną, a nie zdanie podrzędne. Grecki oryginał stawia tu „hóti” przed cytatem, a łacina oddaje je słowo w słowo. Przekład je pomija, bo polszczyzna otwiera cytat dwukropkiem.", "en": "It opens direct speech rather than a subordinate clause. The Greek puts “hoti” before the quotation and the Latin renders it word for word. The translation drops it, because English opens a quotation with the colon alone." } },
