        { "id": "w020", "form": "conféssus", "lemma": "confiteor", "morph": { "pos": "verb", "case": "nom", "number": "sg", "gender": "m", "tense": "perf", "mood": "part", "voice": "dep", "conj": 2 }, "head": "w021", "gloss": { "pl": "wyznał", "en": "confessed" } },
        { "id": "w021", "form": "est", "post": ",", "lemma": "sum", "morph": { "pos": "verb", "person": 3, "number": "sg", "tense": "pres", "mood": "ind", "voice": "act" }, "gloss": { "pl": "—", "en": "(has)" }, "function": { "pl": "Z „conféssus” (w020) tworzy perfectum czasownika deponentnego. Polszczyzna oddaje je jednym słowem i dla łacińskiego „est” nie ma osobnej komórki.", "en": "With “conféssus” (w020) this forms the perfect of a deponent verb. English builds the same tense with an auxiliary, which this cell supplies." } },
