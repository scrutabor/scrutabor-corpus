  "about": {
    "pl": "Introit I Niedzieli Adwentu, Mszy otwierającej rok liturgiczny. Antyfona to Ps 24, 1–3 według numeracji Wulgaty (Ps 25 w numeracji hebrajskiej), a werset — czwarty werset tego samego psalmu. Antyfona na ofiarowanie tej Mszy wraca do tych samych trzech wersetów.",
    "en": "The introit of the First Sunday of Advent, the Mass that opens the liturgical year. Its antiphon is Psalm 24:1–3 in the Vulgate numbering (Psalm 25 in Hebrew) and its verse is the fourth verse of the same psalm. The offertory of this Mass returns to the same three verses."
  },
  "about_citations": {
    "pl": [
      {
        "title": "Missale Romanum (1962)",
        "locator": "Dominica I Adventus, printed page 2",
        "url": "https://archive.org/details/missale_romanum-1962"
      }
    ],
    "en": [
      {
        "title": "Missale Romanum (1962)",
        "locator": "Dominica I Adventus, printed page 2",
        "url": "https://archive.org/details/missale_romanum-1962"
      }
    ]
  },
  "segments": [
    {
      "id": "s01",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "clara",
      "participation": {
        "lecta": {
          "gradus": 4,
          "source": "DMS 31 d"
        },
        "cantu": {
          "gradus": 3,
          "source": "DMS 25 c"
        }
      },
      "translation": {
        "pl": "Do Ciebie, Boże mój, wznoszę moją duszę. Tobie ufam. Niech nie doznam zawodu i niech nie szydzą ze mnie moi wrogowie, bo nikt, kto Ciebie oczekuje, nie będzie zawstydzony.",
        "en": "To You, O my God, I lift up my soul. In You I trust. Let me not be put to shame, nor let my enemies mock me, for none who await You shall be put to shame."
      },
      "words": [
        { "id": "w001", "form": "Ad", "lemma": "ad", "morph": { "governs": "acc", "pos": "prep" }, "head": "w002", "gloss": { "pl": "do", "en": "to" } },
