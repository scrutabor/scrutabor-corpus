  "id": "proprium.dominica-i-adventus-introitus",
  "title": "Ad te levávi ánimam meam",
  "category": "proprium",
  "section": "missa-catechumenorum",
  "variant": "dominica-i-adventus",
  "sung": true,
  "ids": {
