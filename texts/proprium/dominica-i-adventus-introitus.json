        { "id": "w015", "form": "me", "lemma": "ego", "morph": { "pos": "pron", "case": "acc", "number": "sg" }, "gloss": { "pl": "mnie", "en": "me" } },
        { "id": "w016", "form": "inimíci", "lemma": "inimicus", "morph": { "pos": "noun", "case": "nom", "number": "pl", "gender": "m", "decl": 2 }, "gloss": { "pl": "wrogowie", "en": "enemies" } },
        { "id": "w017", "form": "mei", "post": ":", "lemma": "meus", "morph": { "pos": "adj", "case": "nom", "number": "pl", "gender": "m" }, "head": "w016", "gloss": { "pl": "moi", "en": "my" }, "function": { "pl": "Mianownik liczby mnogiej rodzaju męskiego, zgadzający się z „inimíci” (w016).", "en": "A masculine nominative plural agreeing with “inimíci” (w016)." } },
        { "id": "w018", "form": "étenim", "lemma": "etenim", "morph": { "pos": "conj" }, "gloss": { "pl": "bowiem", "en": "for indeed" } },
        { "id": "w019", "form": "univérsi", "post": ",", "lemma": "universus", "morph": { "pos": "adj", "case": "nom", "number": "pl", "gender": "m" }, "head": "w020", "gloss": { "pl": "wszyscy", "en": "all" }, "function": { "pl": "Przymiotnik występuje rzeczownikowo jako „wszyscy”. Zdanie względne wskazuje, że chodzi o oczekujących Pana.", "en": "The adjective stands substantivally for all people. Its relative clause identifies them as those who await the Lord." } },
