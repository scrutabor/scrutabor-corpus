        { "id": "w010", "form": "confído", "post": ",", "lemma": "confido", "morph": { "pos": "verb", "person": 1, "number": "sg", "tense": "pres", "mood": "ind", "voice": "act", "conj": 3 }, "gloss": { "pl": "ufam", "en": "I trust" } },
        { "id": "w011", "form": "non", "lemma": "non", "morph": { "pos": "adv" }, "gloss": { "pl": "nie", "en": "not" } },
