    {
      "id": "s02",
      "type": "verse",
      "translation": {
        "pl": "abyś opuściła tego, kto się do Ciebie ucieka, Twej pomocy wzywa, Ciebie o przyczynę prosi.",
        "en": "that anyone who runs to your protection, implores your help, and seeks your intercession was abandoned."
      },
