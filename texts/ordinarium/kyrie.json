  "about": {
    "pl": "Greckie wezwanie o miłosierdzie. Trzykrotne „Kýrie eléison” prowadzi do trzykrotnego „Christe eléison”, po którym „Kýrie eléison” powraca jeszcze trzy razy.",
    "en": "A Greek invocation for mercy. Three repetitions of “Kýrie eléison” lead to three of “Christe eléison”, after which “Kýrie eléison” returns three more times."
  },
  "segments": [
    {
      "id": "s01",
      "type": "rubric",
      "text": "Qua finita, iunctis manibus, et alternatim cum Ministris, dicit:",
      "narrative": {
        "pl": "Ze złożonymi rękami kapłan odmawia wezwania na przemian z usługującymi. Jeśli nikt mu nie odpowiada, sam mówi wszystkie dziewięć.",
        "en": "With hands joined, the priest says the invocations alternately with the ministers. If no one answers him, he says all nine himself."
      }
    },
