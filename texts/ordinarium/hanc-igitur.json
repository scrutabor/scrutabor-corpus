  "about": {
    "pl": "Kapłan odmawia tę modlitwę po cichu, trzymając ręce rozłożone nad darami. Prosi Boga, aby przyjął tę ofiarę, napełnił nasze życie pokojem, zachował nas od potępienia i zaliczył do grona wybranych.",
    "en": "The priest says this prayer secretly, holding his hands spread over the offerings. He asks God to accept this offering, order our days in peace, deliver us from damnation and number us among the elect."
  },
  "segments": [
    {
      "id": "s01",
      "type": "rubric",
      "text": "Tenens manus expansas super Oblata, dicit:",
      "narrative": {
        "pl": "Kapłan trzyma rozłożone ręce nad darami, a krótko przed Przeistoczeniem usługujący uprzedza wiernych dzwonkiem.",
        "en": "The priest holds his hands spread over the offerings, and a little before the Consecration the server warns the faithful with the bell."
      }
    },
    {
      "id": "s02",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "Prosimy Cię więc, Panie, abyś łaskawie przyjął tę ofiarę naszej służby, a także całej Twojej rodziny;",
        "en": "We therefore ask You, Lord, to accept with favor this offering of our service and of Your whole household;"
      },
