      "translation": {
        "pl": "Przeto błagam Najświętszą Maryję zawsze Dziewicę, świętego Michała Archanioła, świętego Jana Chrzciciela, świętych Apostołów Piotra i Pawła, wszystkich Świętych i ciebie, ojcze, o modlitwę za mnie do Pana Boga naszego.",
        "en": "Therefore I beseech blessed Mary ever Virgin, blessed Michael the Archangel, blessed John the Baptist, the holy Apostles Peter and Paul, all the Saints, and you, father, to pray for me to the Lord our God."
      },
      "words": [
        { "id": "w038", "form": "Ídeo", "lemma": "ideo", "morph": { "pos": "adv" }, "gloss": { "pl": "przeto", "en": "therefore" }, "function": { "pl": "Łączy wyznanie z prośbą o wstawiennictwo.", "en": "Links the confession with the request for intercession." } },
        { "id": "w039", "form": "precor", "lemma": "precor", "morph": { "pos": "verb", "person": 1, "number": "sg", "tense": "pres", "mood": "ind", "voice": "dep", "conj": 1 }, "gloss": { "pl": "błagam", "en": "I beseech" }, "function": { "pl": "Rządzi biernikiem osoby i bezokolicznikiem.", "en": "Takes an accusative of the person and an infinitive." } },
