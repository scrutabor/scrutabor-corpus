    {
      "id": "s01",
      "type": "rubric",
      "text": "Deinde Ministri repetunt Confessionem.",
      "narrative": {
        "pl": "Usługujący powtarzają Confíteor.",
        "en": "The ministers repeat the Confíteor."
      }
    },
    {
      "id": "s02",
      "type": "verse",
      "voice": "clara",
      "speaker": "minister",
      "participation": {
        "lecta": {
          "gradus": 2,
          "source": "DMS 31 b"
        }
      },
      "translation": {
        "pl": "Spowiadam się Bogu wszechmogącemu, Najświętszej Maryi zawsze Dziewicy, świętemu Michałowi Archaniołowi, świętemu Janowi Chrzcicielowi, świętym Apostołom Piotrowi i Pawłowi, wszystkim Świętym i tobie, ojcze:",
        "en": "I confess to almighty God, to blessed Mary ever Virgin, to blessed Michael the Archangel, to blessed John the Baptist, to the holy Apostles Peter and Paul, to all the Saints, and to you, father:"
      },
      "words": [
        { "id": "w001", "form": "Confíteor", "lemma": "confiteor", "morph": { "pos": "verb", "person": 1, "number": "sg", "tense": "pres", "mood": "ind", "voice": "dep", "conj": 2 }, "gloss": { "pl": "spowiadam się", "en": "I confess" }, "function": { "pl": "Łączy się z następującym dalej szeregiem celowników.", "en": "Governs the chain of datives that follows." } },
        { "id": "w002", "form": "Deo", "lemma": "deus", "morph": { "pos": "noun", "case": "dat", "number": "sg", "gender": "m", "decl": 2 }, "gloss": { "pl": "Bogu", "en": "to God" }, "function": { "pl": "Celownik, pierwsze dopełnienie „Confíteor” (w001).", "en": "Dative, the first complement of “Confíteor” (w001)." } },
        { "id": "w003", "form": "omnipoténti", "post": ",", "lemma": "omnipotens", "morph": { "pos": "adj", "case": "dat", "number": "sg", "gender": "m" }, "head": "w002", "gloss": { "pl": "wszechmogącemu", "en": "almighty" }, "function": { "pl": "Zgadza się z „Deo” (w002).", "en": "Agrees with “Deo” (w002)." } },
        { "id": "w004", "form": "beátæ", "lemma": "beatus", "morph": { "pos": "adj", "case": "dat", "number": "sg", "gender": "f" }, "head": "w005", "gloss": { "pl": "błogosławionej", "en": "to blessed" }, "function": { "pl": "Zgadza się z „Maríæ” (w005).", "en": "Agrees with “Maríæ” (w005)." } },
        { "id": "w005", "form": "Maríæ", "lemma": "Maria", "morph": { "pos": "noun", "case": "dat", "number": "sg", "gender": "f", "decl": 1 }, "gloss": { "pl": "Maryi", "en": "Mary" } },
