      },
      "translation": {
        "pl": "że bardzo zgrzeszyłem myślą, mową i uczynkiem:",
        "en": "that I have sinned exceedingly in thought, word and deed:"
      },
      "words": [
        { "id": "w024", "form": "quia", "lemma": "quia", "morph": { "pos": "conj" }, "gloss": { "pl": "że", "en": "that" }, "function": { "pl": "Wprowadza zdanie „quia peccávi”, które podaje treść wyznania.", "en": "Introduces the clause “quia peccávi”, which states what is confessed." } },
