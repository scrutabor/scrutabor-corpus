        { "id": "w007", "form": "Vírgini", "post": ",", "lemma": "virgo", "morph": { "pos": "noun", "case": "dat", "number": "sg", "gender": "f", "decl": 3 }, "gloss": { "pl": "Dziewicy", "en": "Virgin" }, "function": { "pl": "Dopowiedzenie tytułu do „Maríæ” (w005).", "en": "The title in apposition to “Maríæ” (w005)." } },
