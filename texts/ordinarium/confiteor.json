    {
      "id": "s04",
      "type": "rubric",
      "text": "Percutiunt sibi pectus ter, dicentes:",
      "narrative": {
        "pl": "Trzykrotnie uderzają się w piersi.",
        "en": "They strike their breasts three times."
      }
    },
    {
      "id": "s05",
      "type": "verse",
      "voice": "clara",
      "speaker": "minister",
      "participation": {
        "lecta": {
          "gradus": 2,
          "source": "DMS 31 b"
        }
      },
      "translation": {
        "pl": "moja wina, moja wina, moja bardzo wielka wina.",
        "en": "through my fault, through my fault, through my most grievous fault."
      },
