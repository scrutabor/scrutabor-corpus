        { "id": "w041", "form": "Maríam", "lemma": "Maria", "morph": { "pos": "noun", "case": "acc", "number": "sg", "gender": "f", "decl": 1 }, "gloss": { "pl": "Maryję", "en": "Mary" }, "function": { "pl": "Dopełnienie „precor” (w039) w bierniku.", "en": "Accusative object of “precor” (w039)." } },
