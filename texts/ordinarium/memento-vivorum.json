    {
      "id": "s02",
      "type": "rubric",
      "text": "Iungit manus, orat aliquantulum pro quibus orare intendit: deinde manibus extensis prosequitur:",
      "narrative": {
        "pl": "Kapłan składa ręce i modli się chwilę w milczeniu za tych, których chce wspomnieć. Potem rozkłada ręce i mówi dalej.",
        "en": "The priest joins his hands and prays a while in silence for those he means to remember, then spreads his hands and goes on."
      }
    },
    {
