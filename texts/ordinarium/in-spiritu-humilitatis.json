      }
    ]
  },
  "segments": [
    {
      "id": "s01",
      "type": "rubric",
      "text": "Deinde facit signum crucis cum Calice, et illum ponit super Corporale, et Palla cooperit: tum, iunctis manibus super Altare, aliquantulum inclinatus, dicit:",
      "narrative": {
        "pl": "Kapłan czyni kielichem znak krzyża, stawia go na korporale i przykrywa palką, a potem, lekko pochylony, ze złożonymi rękami opartymi na ołtarzu, odmawia modlitwę.",
        "en": "The priest makes the sign of the cross with the chalice, sets it on the corporal and covers it with the pall, then, bowed slightly with hands joined upon the altar, says the prayer."
      },
      "narrative_citations": {
        "pl": [
