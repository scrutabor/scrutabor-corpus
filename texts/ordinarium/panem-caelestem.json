        { "id": "w003", "form": "accípiam", "post": ",", "lemma": "accipio", "morph": { "pos": "verb", "person": 1, "number": "sg", "tense": "fut", "mood": "ind", "voice": "act", "conj": 3 }, "gloss": { "pl": "wezmę", "en": "I will take" }, "function": { "pl": "Czas przyszły trybu oznajmującego, co potwierdza współrzędny czasownik invocábo.", "en": "Future indicative, as the coordinated invocábo confirms." } },
