        { "id": "w007", "form": "invocábo", "post": ".", "lemma": "invoco", "morph": { "pos": "verb", "person": 1, "number": "sg", "tense": "fut", "mood": "ind", "voice": "act", "conj": 1 }, "gloss": { "pl": "wzywać będę", "en": "I will call upon" } }
      ]
    },
    {
      "id": "s03",
      "type": "rubric",
      "text": "Deinde parum inclinatus, accipit ambas partes Hostiæ inter pollicem et indicem sinistræ manus, et Patenam inter eundem indicem et medium supponit, et dextera tribus vicibus percutiens pectus, elata aliquantulum voce, ter dicit devote et humiliter:",
      "narrative": {
        "pl": "Lekko pochylony, kapłan bierze obie części Hostii w lewą rękę i podsuwa pod nie patenę. Bijąc się trzykrotnie prawą ręką w piersi, trzykrotnie mówi nieco podniesionym głosem, pobożnie i pokornie:",
        "en": "Bowing a little, the priest takes both halves of the Host in his left hand and slips the paten beneath them. Striking his breast three times with his right hand, he says the following three times in a slightly raised voice, devoutly and humbly:"
      }
    },
    {
      "id": "s04",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "clara",
      "translation": {
        "pl": "Panie, nie jestem godzien,",
        "en": "Lord, I am not worthy,"
      },
