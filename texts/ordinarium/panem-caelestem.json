  "segments": [
    {
      "id": "s01",
      "type": "rubric",
      "text": "Genuflectit, surgit, et dicit:",
      "narrative": {
        "pl": "Kapłan przyklęka, wstaje i mówi:",
        "en": "The priest genuflects, rises, and says:"
      }
    },
    {
      "id": "s02",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "Chleb niebiański przyjmę i imienia Pańskiego wzywać będę.",
        "en": "I will take the Bread of heaven, and will call upon the name of the Lord."
      },
      "translation_citations": {
        "pl": [
          {
            "title": "Biblia w przekładzie ks. Jakuba Wujka (1923)",
