        { "id": "w011", "form": "dignus", "post": ",", "lemma": "dignus", "morph": { "pos": "adj", "case": "nom", "number": "sg", "gender": "m" }, "head": "w010", "gloss": { "pl": "godzien", "en": "worthy" }, "function": { "pl": "Pierwsze cztery słowa kapłan wypowiada nieco podniesionym głosem, uderzając się w piersi. Resztę zdania mówi po cichu.", "en": "The priest says the first four words in a slightly raised voice while striking his breast. He continues the sentence under his breath." } }
