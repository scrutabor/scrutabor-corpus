    {
      "id": "s07",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "Ja zaś postępowałem niewinnie; wykup mnie i zmiłuj się nade mną.",
        "en": "But I have walked in innocence; redeem me and have mercy on me."
      },
      "words": [
