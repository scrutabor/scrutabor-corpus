    {
      "id": "s01",
      "type": "rubric",
      "text": "Deinde, iunctis manibus super Altare, inclinatus dicit secrete sequentes Orationes:",
      "narrative": {
        "pl": "Kapłan pochyla się nad ołtarzem, ręce złożone na nim, i odmawia po cichu trzy następujące modlitwy.",
        "en": "The priest bows over the altar with his hands joined upon it, and says the three prayers that follow silently."
      }
    },
