  "about": {
    "pl": "Kapłan odmawia Confíteor jako pierwszy, głęboko pochylony. Zwraca się do usługujących słowami „vobis, fratres” i „vos, fratres”. Oni odmawiają potem własne wyznanie, mówiąc „tibi, pater” i „te, pater” tam, gdzie kapłan mówił „vobis, fratres” i „vos, fratres”.",
    "en": "The priest says the Confíteor first, bowed low. He addresses the ministers with “vobis, fratres” and “vos, fratres”. They then make their own confession, saying “tibi, pater” and “te, pater” where he said “vobis, fratres” and “vos, fratres”."
  },
  "segments": [
    {
      "id": "s01",
      "type": "rubric",
      "text": "Deinde iunctis manibus profunde inclinatus facit Confessionem.",
      "narrative": {
        "pl": "Kapłan składa ręce, głęboko się pochyla i odmawia Confíteor.",
        "en": "The priest joins his hands, bows deeply, and recites the Confíteor."
      },
      "narrative_citations": {
        "pl": [
          {
            "title": "Missale Romanum (1962)",
            "locator": "Ordo Missae, rubric before the priest's Confiteor",
            "url": "https://archive.org/details/missale_romanum-1962"
          }
        ],
        "en": [
          {
            "title": "Missale Romanum (1962)",
            "locator": "Ordo Missae, rubric before the priest's Confiteor",
            "url": "https://archive.org/details/missale_romanum-1962"
          }
        ]
      }
    },
    {
      "id": "s02",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "clara",
      "translation": {
        "pl": "Spowiadam się Bogu wszechmogącemu, Najświętszej Maryi zawsze Dziewicy, świętemu Michałowi Archaniołowi, świętemu Janowi Chrzcicielowi, świętym Apostołom Piotrowi i Pawłowi, wszystkim Świętym i wam, bracia:",
        "en": "I confess to almighty God, to blessed Mary ever Virgin, to blessed Michael the Archangel, to blessed John the Baptist, to the holy Apostles Peter and Paul, to all the Saints, and to you, brethren:"
      },
      "translation_citations": {
