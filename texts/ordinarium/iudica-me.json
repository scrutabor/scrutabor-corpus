    {
      "id": "s06",
      "type": "verse",
      "voice": "clara",
      "speaker": "minister",
      "participation": {
        "lecta": {
          "gradus": 2,
          "source": "DMS 31 b"
        }
      },
      "translation": {
        "pl": "I przystąpię do ołtarza Bożego: do Boga, który rozwesela młodość moją.",
        "en": "And I will go in unto the altar of God: to God, who gladdens my youth."
      },
