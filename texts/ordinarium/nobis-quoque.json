    {
      "id": "s03",
      "type": "rubric",
      "text": "Extensis manibus ut prius, secrete prosequitur:",
      "narrative": {
        "pl": "Kapłan rozkłada ręce jak przedtem i mówi dalej po cichu.",
        "en": "The priest spreads his hands as before and goes on silently."
      }
    },
    {
      "id": "s04",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "Twoim sługom, pokładającym nadzieję w obfitości Twoich zmiłowań, racz dać pewien udział i wspólnotę z Twoimi świętymi Apostołami i Męczennikami:",
        "en": "Your servants who trust in Your abundant mercies, be pleased to bestow some portion and communion with Your holy Apostles and Martyrs:"
      },
