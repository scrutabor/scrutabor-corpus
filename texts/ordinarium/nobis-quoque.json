        "url": "https://archive.org/details/missale_romanum-1962"
      }
    ]
  },
  "segments": [
    {
      "id": "s01",
      "type": "rubric",
      "text": "Manu dextera percutit sibi pectus, elata aliquantulum voce dicens:",
      "narrative": {
        "pl": "Kapłan uderza się prawą ręką w piersi i mówi głosem nieco podniesionym:",
        "en": "The priest strikes his breast with his right hand and says, with his voice raised a little:"
      }
    },
    {
      "id": "s02",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "clara",
      "translation": {
        "pl": "Także nam, grzesznikom,",
        "en": "To us also, sinners,"
      },
