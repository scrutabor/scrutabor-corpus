{
  "schema_version": "0.14.0",
  "id": "ordinarium.ecce-agnus-dei",
  "title": "Ecce Agnus Dei",
  "category": "ordinarium",
  "section": "missa-fidelium",
  "variant": "missae",
  "sung": false,
  "ids": {
    "next": 72
  },
  "about": {
    "pl": "Kapłan ukazuje Hostię i wskazuje Chrystusa jako Baranka Bożego, który gładzi grzechy świata. Następnie trzykrotnie odmawia Dómine, non sum dignus. Każdemu przyjmującemu podaje Najświętszy Sakrament ze słowami prośby, aby Ciało Chrystusa strzegło jego duszy na życie wieczne.",
    "en": "The priest shows the Host and points to Christ as the Lamb of God who takes away the sins of the world. He then says Dómine, non sum dignus three times. He gives the Blessed Sacrament to each communicant with a prayer that the Body of Christ may preserve that person's soul unto eternal life."
  },
  "segments": [
    {
      "id": "s01",
      "type": "rubric",
      "text": "Postea genuflectens, accipit manu sinistra Pyxidem seu Patenam cum Sacramento, dextera vero sumit unam particulam, quam inter pollicem et indicem tenet aliquantulum elevatam super Pyxidem seu Patenam, et conversus ad communicandos in medio Altaris, dicit:",
      "narrative": {
        "pl": "Następnie kapłan przyklęka. Bierze w lewą rękę puszkę albo patenę z Najświętszym Sakramentem, a w prawą jedną cząstkę. Trzymając ją między kciukiem a palcem wskazującym nieco uniesioną nad naczyniem, pośrodku ołtarza zwraca się do przystępujących do Komunii i mówi:",
        "en": "Then the priest genuflects and takes the ciborium or paten with the Blessed Sacrament in his left hand and one particle in his right. Holding the particle between his thumb and forefinger slightly above the vessel, he turns at the middle of the altar toward those about to communicate and says:"
      }
    },
    {
      "id": "s02",
      "type": "verse",
      "voice": "clara",
      "speaker": "sacerdos",
      "translation": {
        "pl": "Oto Baranek Boży, oto Ten, który gładzi grzechy świata.",
        "en": "Behold the Lamb of God, behold Him who takes away the sins of the world."
      },
      "translation_citations": {
        "pl": [
          {
            "title": "Mszał Rzymski dla diecezji polskich",
            "locator": "Obrzędy Mszy świętej"
          }
        ],
        "en": [
          {
            "title": "The Roman Missal, English translation according to the third typical edition",
            "locator": "The Order of Mass"
          }
        ]
      },
      "words": [
        { "id": "w001", "form": "Ecce", "lemma": "ecce", "morph": { "pos": "intj" }, "gloss": { "pl": "oto", "en": "behold" }, "function": { "pl": "Wykrzyknik, po którym stoi tu mianownik „Agnus” (w002).", "en": "Interjection followed here by the nominative “Agnus” (w002)." } },
        { "id": "w002", "form": "Agnus", "lemma": "agnus", "morph": { "pos": "noun", "case": "nom", "number": "sg", "gender": "m", "decl": 2 }, "gloss": { "pl": "Baranek", "en": "the Lamb" } },
        { "id": "w003", "form": "Dei", "post": ",", "lemma": "deus", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m", "decl": 2 }, "gloss": { "pl": "Boga", "en": "of God" } },
        { "id": "w004", "form": "ecce", "lemma": "ecce", "morph": { "pos": "intj" }, "gloss": { "pl": "oto", "en": "behold" } },
        { "id": "w005", "form": "qui", "lemma": "qui", "morph": { "pos": "pron", "case": "nom", "number": "sg", "gender": "m" }, "gloss": { "pl": "Ten, który", "en": "Him who" } },
        { "id": "w006", "form": "tollit", "lemma": "tollo", "morph": { "pos": "verb", "person": 3, "number": "sg", "tense": "pres", "mood": "ind", "voice": "act", "conj": 3 }, "gloss": { "pl": "gładzi", "en": "takes away" }, "function": { "pl": "Trzecia osoba liczby pojedynczej. Por. drugą osobę „tollis” w Agnus Dei.", "en": "Third-person singular. Compare the second-person “tollis” in the Agnus Dei." } },
        { "id": "w007", "form": "peccáta", "lemma": "peccatum", "morph": { "pos": "noun", "case": "acc", "number": "pl", "gender": "n", "decl": 2 }, "gloss": { "pl": "grzechy", "en": "the sins" }, "function": { "pl": "W J 1, 29 stoi liczba pojedyncza „peccátum mundi”. Tekst liturgiczny ma tu liczbę mnogą „peccáta mundi”.", "en": "John 1:29 has the singular “peccátum mundi”. The liturgical text here has the plural “peccáta mundi”." }, "function_citations": { "pl": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:29" }], "en": [{ "title": "Biblia Sacra Vulgata", "locator": "John 1:29" }] } },
        { "id": "w008", "form": "mundi", "post": ".", "lemma": "mundus", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m", "decl": 2 }, "gloss": { "pl": "świata", "en": "of the world" } }
      ]
    },
    {
      "id": "s03",
      "type": "rubric",
      "text": "Deinde dicit:",
      "narrative": {
        "pl": "Następnie kapłan mówi:",
        "en": "Then the priest says:"
      }
    },
