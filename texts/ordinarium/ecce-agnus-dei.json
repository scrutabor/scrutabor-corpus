    {
      "id": "s07",
      "type": "rubric",
      "text": "Quibus verbis tertio repetitis, accedit ad eorum dexteram, hoc est, ad latus Epistolæ, et unicuique porrigit Sacramentum faciens cum eo signum crucis super Pyxidem vel Patenam, et simul dicens:",
      "narrative": {
        "pl": "Po trzykrotnym powtórzeniu tych słów kapłan przechodzi na ich prawą stronę, czyli stronę lekcji. Każdemu podaje Sakrament, czyniąc nim znak krzyża nad puszką albo pateną i mówiąc:",
        "en": "After repeating these words three times, the priest goes to their right, the Epistle side, and gives the Sacrament to each, making the sign of the cross with it over the ciborium or paten and saying:"
      }
    },
    {
      "id": "s08",
      "type": "verse",
      "voice": "clara",
      "speaker": "sacerdos",
      "translation": {
        "pl": "Ciało Pana naszego Jezusa Chrystusa niech strzeże duszy twojej na żywot wieczny. Amen.",
        "en": "May the Body of our Lord Jesus Christ keep thy soul unto life everlasting. Amen."
      },
      "words": [
        { "id": "w060", "form": "Corpus", "lemma": "corpus", "morph": { "pos": "noun", "case": "nom", "number": "sg", "gender": "n", "decl": 3 }, "gloss": { "pl": "Ciało", "en": "The Body" } },
        { "id": "w061", "form": "Dómini", "lemma": "dominus", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m", "decl": 2 }, "gloss": { "pl": "Pana", "en": "of the Lord" } },
        { "id": "w062", "form": "nostri", "lemma": "noster", "morph": { "pos": "adj", "case": "gen", "number": "sg", "gender": "m" }, "head": "w061", "gloss": { "pl": "naszego", "en": "our" } },
        { "id": "w063", "form": "Iesu", "lemma": "Iesus", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m" }, "gloss": { "pl": "Jezusa", "en": "Jesus" } },
        { "id": "w064", "form": "Christi", "lemma": "Christus", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m", "decl": 2 }, "gloss": { "pl": "Chrystusa", "en": "Christ" } },
