  "segments": [
    {
      "id": "s01",
      "type": "rubric",
      "text": "Tunc, detecto Calice, dicit:",
      "narrative": {
        "pl": "Kapłan odsłania kielich.",
        "en": "The priest uncovers the chalice."
      }
    },
    {
      "id": "s02",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "Podobnie po wieczerzy",
        "en": "In a similar way, when supper was ended,"
      },
      "words": [
        { "id": "w001", "form": "Símili", "lemma": "similis", "morph": { "pos": "adj", "case": "abl", "number": "sg", "gender": "m" }, "head": "w002", "gloss": { "pl": "podobnym", "en": "in like" }, "function": { "pl": "„Símili modo” to ablativus sposobu: „w podobny sposób”.", "en": "“Símili modo” is an ablative of manner: “in a similar way”." } },
        { "id": "w002", "form": "modo", "lemma": "modus", "morph": { "pos": "noun", "case": "abl", "number": "sg", "gender": "m", "decl": 2 }, "gloss": { "pl": "sposobem", "en": "manner" } },
        { "id": "w003", "form": "postquam", "lemma": "postquam", "morph": { "pos": "conj" }, "gloss": { "pl": "gdy", "en": "when" } },
        { "id": "w004", "form": "cenátum", "lemma": "ceno", "morph": { "pos": "verb", "case": "nom", "number": "sg", "gender": "n", "tense": "perf", "mood": "part", "voice": "pass", "conj": 1 }, "head": "w005", "gloss": { "pl": "po wieczerzy", "en": "supper was ended" }, "function": { "pl": "Bezosobowa konstrukcja czasu przeszłego: „gdy skończono wieczerzę”.", "en": "An impersonal past construction: “when supper was ended”." } },
        { "id": "w005", "form": "est", "post": ",", "lemma": "sum", "morph": { "pos": "verb", "person": 3, "number": "sg", "tense": "pres", "mood": "ind", "voice": "act" }, "gloss": { "pl": "było", "en": "was" } }
      ]
    },
    {
      "id": "s03",
      "type": "rubric",
      "text": "Ambabus manibus accipit Calicem.",
      "narrative": {
        "pl": "Kapłan bierze kielich obiema rękami.",
        "en": "The priest takes the chalice in both hands."
      }
    },
    {
      "id": "s04",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "wziął ten przesławny kielich w swoje święte i czcigodne ręce,",
        "en": "He took this precious chalice in His holy and venerable hands,"
      },
      "words": [
        { "id": "w006", "form": "accípiens", "lemma": "accipio", "morph": { "pos": "verb", "case": "nom", "number": "sg", "gender": "m", "tense": "pres", "mood": "part", "voice": "act", "conj": 3 }, "head": "w021", "gloss": { "pl": "biorąc", "en": "taking" }, "function": { "pl": "Imiesłów czasu teraźniejszego odnoszący się do Chrystusa, podmiotu „benedíxit” (w021).", "en": "A present participle referring to Christ, the subject of “benedíxit” (w021)." } },
        { "id": "w007", "form": "et", "lemma": "et", "morph": { "pos": "conj" }, "gloss": { "pl": "i", "en": "also" } },
        { "id": "w008", "form": "hunc", "lemma": "hic", "morph": { "pos": "pron", "case": "acc", "number": "sg", "gender": "m" }, "gloss": { "pl": "ten", "en": "this" } },
        { "id": "w009", "form": "præclárum", "lemma": "praeclarus", "morph": { "pos": "adj", "case": "acc", "number": "sg", "gender": "m" }, "head": "w010", "gloss": { "pl": "przesławny", "en": "excellent" }, "function": { "pl": "Przydawka przy „Cálicem” (w010) — echo Ps 22, 5: calix meus inébrians quam præclárus est.", "en": "The epithet with “Cálicem” (w010) — an echo of Ps 22:5: calix meus inébrians quam præclárus est." }, "function_citations": { "pl": [{ "title": "Biblia Sacra Vulgata", "locator": "Psalm 22:5" }], "en": [{ "title": "Biblia Sacra Vulgata", "locator": "Psalm 22:5" }] } },
        { "id": "w010", "form": "Cálicem", "lemma": "calix", "morph": { "pos": "noun", "case": "acc", "number": "sg", "gender": "m", "decl": 3 }, "gloss": { "pl": "kielich", "en": "chalice" } },
        { "id": "w011", "form": "in", "lemma": "in", "morph": { "pos": "prep", "governs": "acc" }, "head": "w015", "gloss": { "pl": "w", "en": "into" } },
        { "id": "w012", "form": "sanctas", "lemma": "sanctus", "morph": { "pos": "adj", "case": "acc", "number": "pl", "gender": "f" }, "head": "w015", "gloss": { "pl": "święte", "en": "holy" } },
        { "id": "w013", "form": "ac", "lemma": "ac", "morph": { "pos": "conj" }, "gloss": { "pl": "i", "en": "and" } },
        { "id": "w014", "form": "venerábiles", "lemma": "venerabilis", "morph": { "pos": "adj", "case": "acc", "number": "pl", "gender": "f" }, "head": "w015", "gloss": { "pl": "czcigodne", "en": "venerable" } },
        { "id": "w015", "form": "manus", "lemma": "manus", "morph": { "pos": "noun", "case": "acc", "number": "pl", "gender": "f", "decl": 4 }, "gloss": { "pl": "ręce", "en": "hands" } },
        { "id": "w016", "form": "suas", "post": ":", "lemma": "suus", "morph": { "pos": "adj", "case": "acc", "number": "pl", "gender": "f" }, "head": "w015", "gloss": { "pl": "swoje", "en": "His" } }
      ]
    },
    {
      "id": "s05",
      "type": "rubric",
      "text": "Item caput inclinat.",
      "narrative": {
        "pl": "Kapłan znów pochyla głowę.",
        "en": "The priest bows his head again."
      }
    },
    {
      "id": "s06",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "ponownie dzięki Tobie składając,",
        "en": "and once more giving You thanks,"
      },
      "words": [
        { "id": "w017", "form": "item", "lemma": "item", "morph": { "pos": "adv" }, "gloss": { "pl": "znów", "en": "again" }, "function": { "pl": "Przysłówek wskazujący na powtórzenie pochylenia głowy wykonanego przy chlebie.", "en": "An adverb marking the repetition of the bow made at the consecration of the bread." } },
        { "id": "w018", "form": "tibi", "lemma": "tu", "morph": { "pos": "pron", "case": "dat", "number": "sg" }, "gloss": { "pl": "Ci", "en": "to Thee" } },
        { "id": "w019", "form": "grátias", "lemma": "gratia", "morph": { "pos": "noun", "case": "acc", "number": "pl", "gender": "f", "decl": 1 }, "gloss": { "pl": "dzięki", "en": "thanks" } },
        { "id": "w020", "form": "agens", "post": ",", "lemma": "ago", "morph": { "pos": "verb", "case": "nom", "number": "sg", "gender": "m", "tense": "pres", "mood": "part", "voice": "act", "conj": 3 }, "head": "w021", "gloss": { "pl": "składając", "en": "giving" } }
      ]
    },
    {
      "id": "s07",
      "type": "rubric",
      "text": "Sinistra tenens Calicem, dextera signat super eum.",
      "narrative": {
        "pl": "Trzymając kielich w lewej ręce, kapłan prawą czyni nad nim znak krzyża.",
        "en": "Holding the chalice in his left hand, the priest makes the sign of the cross over it with his right."
      }
    },
    {
      "id": "s08",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "błogosławił i podał swoim uczniom, mówiąc:",
        "en": "He said the blessing and gave the chalice to His disciples, saying:"
      },
      "words": [
        { "id": "w021", "form": "benedíxit", "post": ",", "lemma": "benedico", "morph": { "pos": "verb", "person": 3, "number": "sg", "tense": "perf", "mood": "ind", "voice": "act", "conj": 3 }, "gloss": { "pl": "pobłogosławił", "en": "He blessed" } },
        { "id": "w022", "form": "dedítque", "lemma": "do", "morph": { "pos": "verb", "person": 3, "number": "sg", "tense": "perf", "mood": "ind", "voice": "act", "conj": 1 }, "gloss": { "pl": "i dał", "en": "and He gave" }, "function": { "pl": "W opowiadaniu nad kielichem nie ma „fregit”, które występuje przy chlebie.", "en": "The narrative over the chalice has no “fregit”, which occurs with the bread." } },
        { "id": "w023", "form": "discípulis", "lemma": "discipulus", "morph": { "pos": "noun", "case": "dat", "number": "pl", "gender": "m", "decl": 2 }, "gloss": { "pl": "uczniom", "en": "to the disciples" } },
        { "id": "w024", "form": "suis", "post": ",", "lemma": "suus", "morph": { "pos": "adj", "case": "dat", "number": "pl", "gender": "m" }, "head": "w023", "gloss": { "pl": "swoim", "en": "His" } },
        { "id": "w025", "form": "dicens", "post": ":", "lemma": "dico", "morph": { "pos": "verb", "case": "nom", "number": "sg", "gender": "m", "tense": "pres", "mood": "part", "voice": "act", "conj": 3 }, "head": "w021", "gloss": { "pl": "mówiąc", "en": "saying" } }
      ]
    },
    {
      "id": "s09",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "Bierzcie i pijcie z niego wszyscy:",
        "en": "Take this, all of you, and drink from it:"
      },
      "words": [
        { "id": "w026", "form": "Accípite", "post": ",", "lemma": "accipio", "morph": { "pos": "verb", "person": 2, "number": "pl", "tense": "pres", "mood": "imp", "voice": "act", "conj": 3 }, "gloss": { "pl": "bierzcie", "en": "take" } },
        { "id": "w027", "form": "et", "lemma": "et", "morph": { "pos": "conj" }, "gloss": { "pl": "i", "en": "and" } },
        { "id": "w028", "form": "bíbite", "lemma": "bibo", "morph": { "pos": "verb", "person": 2, "number": "pl", "tense": "pres", "mood": "imp", "voice": "act", "conj": 3 }, "gloss": { "pl": "pijcie", "en": "drink" } },
        { "id": "w029", "form": "ex", "lemma": "ex", "morph": { "pos": "prep", "governs": "abl" }, "head": "w030", "gloss": { "pl": "z", "en": "of" } },
        { "id": "w030", "form": "eo", "lemma": "is", "morph": { "pos": "pron", "case": "abl", "number": "sg", "gender": "m" }, "gloss": { "pl": "niego", "en": "it" }, "function": { "pl": "Zaimek odnosi się do kielicha: „ex eo”, „z niego”. Przy chlebie występuje „ex hoc”, „z tego”.", "en": "The pronoun refers to the chalice: “ex eo”, “from it”. With the bread the formula has “ex hoc”, “of this”." } },
        { "id": "w031", "form": "omnes", "post": ".", "lemma": "omnis", "morph": { "pos": "adj", "case": "nom", "number": "pl", "gender": "m" }, "substantive": true, "gloss": { "pl": "wszyscy", "en": "all of you" } }
      ]
    },
    {
      "id": "s10",
      "type": "rubric",
      "text": "Profert verba consecrationis super Calicem, attente, continuate, et secrete, tenens illum parum elevatum.",
      "narrative": {
        "pl": "Kapłan wymawia słowa konsekracji nad kielichem uważnie, jednym ciągiem i po cichu, trzymając go nieco uniesiony.",
        "en": "The priest speaks the words of consecration over the chalice attentively, without break and silently, holding it slightly raised."
      }
    },
    {
      "id": "s11",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "To jest bowiem kielich Krwi mojej nowego i wiecznego przymierza: tajemnica wiary: która za was i za wielu będzie wylana na odpuszczenie grzechów.",
        "en": "For this is the chalice of My Blood, the Blood of the new and eternal covenant: the mystery of faith: which will be poured out for you and for many for the forgiveness of sins."
      },
      "words": [
        { "id": "w032", "form": "Hic", "lemma": "hic", "morph": { "pos": "pron", "case": "nom", "number": "sg", "gender": "m" }, "gloss": { "pl": "to", "en": "this" } },
        { "id": "w033", "form": "est", "lemma": "sum", "morph": { "pos": "verb", "person": 3, "number": "sg", "tense": "pres", "mood": "ind", "voice": "act" }, "gloss": { "pl": "jest", "en": "is" } },
        { "id": "w034", "form": "enim", "lemma": "enim", "morph": { "pos": "conj" }, "gloss": { "pl": "bowiem", "en": "for" } },
        { "id": "w035", "form": "Calix", "lemma": "calix", "morph": { "pos": "noun", "case": "nom", "number": "sg", "gender": "m", "decl": 3 }, "gloss": { "pl": "kielich", "en": "the chalice" } },
        { "id": "w036", "form": "Sánguinis", "lemma": "sanguis", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m", "decl": 3 }, "gloss": { "pl": "krwi", "en": "of the blood" } },
        { "id": "w037", "form": "mei", "post": ",", "lemma": "meus", "morph": { "pos": "adj", "case": "gen", "number": "sg", "gender": "m" }, "head": "w036", "gloss": { "pl": "mojej", "en": "My" } },
        { "id": "w038", "form": "novi", "lemma": "novus", "morph": { "pos": "adj", "case": "gen", "number": "sg", "gender": "n" }, "head": "w041", "gloss": { "pl": "nowego", "en": "of the new" }, "function": { "pl": "Dopełniacz zależny od „testaménti” (w041), nie od „Sánguinis” (w036).", "en": "A genitive agreeing with “testaménti” (w041), not with “Sánguinis” (w036)." } },
        { "id": "w039", "form": "et", "lemma": "et", "morph": { "pos": "conj" }, "gloss": { "pl": "i", "en": "and" } },
        { "id": "w040", "form": "ætérni", "lemma": "aeternus", "morph": { "pos": "adj", "case": "gen", "number": "sg", "gender": "n" }, "head": "w041", "gloss": { "pl": "wiecznego", "en": "eternal" }, "function": { "pl": "Tego określenia nie ma w opisach ustanowienia. „Krew przymierza wiecznego” występuje w Hbr 13, 20.", "en": "This qualification does not occur in the institution narratives. “The blood of the eternal covenant” occurs in Hebrews 13:20." }, "function_citations": { "pl": [{ "title": "Biblia Sacra Vulgata", "locator": "Hebrews 13:20" }], "en": [{ "title": "Biblia Sacra Vulgata", "locator": "Hebrews 13:20" }] } },
        { "id": "w041", "form": "testaménti", "post": ":", "lemma": "testamentum", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "n", "decl": 2 }, "gloss": { "pl": "przymierza", "en": "covenant" }, "function": { "pl": "Dopełniacz zależny od „Sánguinis” (w036), określony przez „novi” (w038) i „ætérni” (w040).", "en": "A genitive depending on “Sánguinis” (w036) and modified by “novi” (w038) and “ætérni” (w040)." } },
        { "id": "w042", "form": "mystérium", "lemma": "mysterium", "morph": { "pos": "noun", "case": "nom", "number": "sg", "gender": "n", "decl": 2 }, "gloss": { "pl": "tajemnica", "en": "the mystery" }, "function": { "pl": "Samodzielne dopowiedzenie w mianowniku do słów o kielichu Krwi: obecność Krwi Chrystusa w sakramencie jest tajemnicą przyjmowaną wiarą.", "en": "An independent nominative apposition to the words about the chalice of the Blood: Christ's Blood is present in the sacrament as a mystery held by faith." }, "function_citations": { "pl": [{ "title": "Thomas Aquinas, Summa theologiae", "locator": "III, q. 78, a. 3, ad 5–6", "url": "https://www.corpusthomisticum.org/sth4078.html" }, { "title": "Paulus VI, Mysterium fidei", "locator": "introduction", "url": "https://www.vatican.va/content/paul-vi/la/encyclicals/documents/hf_p-vi_enc_03091965_mysterium.html" }], "en": [{ "title": "Thomas Aquinas, Summa theologiae", "locator": "III, q. 78, a. 3, ad 5–6", "url": "https://www.corpusthomisticum.org/sth4078.html" }, { "title": "Paulus VI, Mysterium fidei", "locator": "introduction", "url": "https://www.vatican.va/content/paul-vi/la/encyclicals/documents/hf_p-vi_enc_03091965_mysterium.html" }] } },
        { "id": "w043", "form": "fídei", "post": ":", "lemma": "fides", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "f", "decl": 5 }, "gloss": { "pl": "wiary", "en": "of faith" } },
        { "id": "w044", "form": "qui", "lemma": "qui", "morph": { "pos": "pron", "case": "nom", "number": "sg", "gender": "m" }, "gloss": { "pl": "który", "en": "which" }, "function": { "pl": "„Calix” (w035) i „Sánguinis” (w036) są rodzaju męskiego, więc forma zaimka nie rozstrzyga poprzednika. Polski przekład odnosi go do Krwi.", "en": "“Calix” (w035) and “Sánguinis” (w036) are both masculine, so the pronoun's form does not resolve its antecedent. English likewise leaves it open." } },
        { "id": "w045", "form": "pro", "lemma": "pro", "morph": { "pos": "prep", "governs": "abl" }, "head": "w046", "gloss": { "pl": "za", "en": "for" } },
        { "id": "w046", "form": "vobis", "lemma": "vos", "morph": { "pos": "pron", "case": "abl", "number": "pl" }, "gloss": { "pl": "was", "en": "you" } },
        { "id": "w047", "form": "et", "lemma": "et", "morph": { "pos": "conj" }, "gloss": { "pl": "i", "en": "and" } },
