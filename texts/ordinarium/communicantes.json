        { "id": "w022", "form": "eiúsdem", "lemma": "idem", "morph": { "pos": "pron", "case": "gen", "number": "sg", "gender": "f" }, "gloss": { "pl": "tejże", "en": "the same" } },
        { "id": "w023", "form": "Vírginis", "lemma": "virgo", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "f", "decl": 3 }, "gloss": { "pl": "Dziewicy", "en": "Virgin" } },
        { "id": "w024", "form": "Sponsi", "post": ",", "lemma": "sponsus", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m", "decl": 2 }, "gloss": { "pl": "Oblubieńca", "en": "Spouse" }, "function": { "pl": "Dopełniacz w dopowiedzeniu do „Ioseph” (w021): przy nieodmiennym imieniu przypadek widać w beáti i w Sponsi.", "en": "A genitive in apposition to “Ioseph” (w021): with the name indeclinable, the case shows in beáti and in Sponsi." } }
      ]
    },
    {
      "id": "s03",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
