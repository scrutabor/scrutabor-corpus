        { "id": "w012", "form": "Dei", "lemma": "deus", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m", "decl": 2 }, "gloss": { "pl": "Boga", "en": "of God" } },
        { "id": "w013", "form": "et", "lemma": "et", "morph": { "pos": "conj" }, "gloss": { "pl": "i", "en": "and" } },
        { "id": "w014", "form": "Dómini", "lemma": "dominus", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m", "decl": 2 }, "gloss": { "pl": "Pana", "en": "Lord" } },
        { "id": "w015", "form": "nostri", "lemma": "noster", "morph": { "pos": "adj", "case": "gen", "number": "sg", "gender": "m" }, "head": "w014", "gloss": { "pl": "naszego", "en": "our" } },
        { "id": "w016", "form": "Iesu", "lemma": "Iesus", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m" }, "gloss": { "pl": "Jezusa", "en": "Jesus" } },
        { "id": "w017", "form": "Christi", "post": ":", "lemma": "Christus", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m", "decl": 2 }, "gloss": { "pl": "Chrystusa", "en": "Christ" } }
      ]
    },
    {
      "id": "s02",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "a także świętego Józefa, Oblubieńca tejże Dziewicy,",
        "en": "and blessed Joseph, Spouse of the same Virgin,"
      },
      "words": [
        { "id": "w018", "form": "sed", "lemma": "sed", "morph": { "pos": "conj" }, "gloss": { "pl": "a", "en": "and" } },
        { "id": "w019", "form": "et", "lemma": "et", "morph": { "pos": "conj" }, "gloss": { "pl": "także", "en": "also" }, "function": { "pl": "Razem z „sed” (w018) słowo et dołącza Józefa do wyliczenia: a także.", "en": "Together with “sed” (w018), et adds Joseph to the list: but also." } },
        { "id": "w020", "form": "beáti", "lemma": "beatus", "morph": { "pos": "adj", "case": "gen", "number": "sg", "gender": "m" }, "head": "w021", "gloss": { "pl": "błogosławionego", "en": "blessed" } },
