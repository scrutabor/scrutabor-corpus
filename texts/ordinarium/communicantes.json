        { "id": "w027", "form": "Apostolórum", "lemma": "apostolus", "morph": { "pos": "noun", "case": "gen", "number": "pl", "gender": "m", "decl": 2 }, "gloss": { "pl": "apostołów", "en": "apostles" } },
