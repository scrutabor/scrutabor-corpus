        { "id": "w034", "form": "Andréæ", "post": ",", "lemma": "Andreas", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m", "decl": 1 }, "gloss": { "pl": "Andrzeja", "en": "Andrew" } },
        { "id": "w035", "form": "Iacóbi", "post": ",", "lemma": "Iacobus", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m", "decl": 2 }, "gloss": { "pl": "Jakuba", "en": "James" }, "function": { "pl": "Pierwszy z dwóch Jakubów — brat Jana, syn Zebedeusza.", "en": "The first of the two Jameses — the brother of John, son of Zebedee." }, "function_citations": { "pl": [{ "title": "Biblia Sacra Vulgata", "locator": "Matthew 4:21" }, { "title": "Biblia Sacra Vulgata", "locator": "Mark 1:19" }], "en": [{ "title": "Biblia Sacra Vulgata", "locator": "Matthew 4:21" }, { "title": "Biblia Sacra Vulgata", "locator": "Mark 1:19" }] } },
        { "id": "w036", "form": "Ioánnis", "post": ",", "lemma": "Ioannes", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "m", "decl": 3 }, "gloss": { "pl": "Jana", "en": "John" } },
