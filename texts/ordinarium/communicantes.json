  "about": {
    "pl": "Modlitwa wspomina w jedności z całym Kościołem Najświętszą Maryję Pannę, św. Józefa, Apostołów i męczenników. Po wymienieniu świętych prosi Boga, aby przez ich zasługi i modlitwy otaczał wiernych swoją opieką.",
    "en": "In communion with the whole Church, the prayer honors the memory of the Blessed Virgin Mary, Saint Joseph, the Apostles, and the martyrs. After naming the saints, it asks God to surround the faithful with His protection through their merits and prayers."
  },
  "segments": [
    {
      "id": "s01",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "Zjednoczeni z całym Kościołem, ze czcią wspominamy najpierw pełną chwały Maryję, zawsze Dziewicę, Matkę Boga i naszego Pana Jezusa Chrystusa:",
        "en": "In communion with those whose memory we venerate, especially the glorious ever-Virgin Mary, Mother of our God and Lord, Jesus Christ:"
      },
      "words": [
        { "id": "w001", "form": "Communicántes", "post": ",", "lemma": "communico", "morph": { "pos": "verb", "case": "nom", "number": "pl", "gender": "m", "tense": "pres", "mood": "part", "voice": "act", "conj": 1 }, "substantive": true, "gloss": { "pl": "zjednoczeni", "en": "in communion with" }, "function": { "pl": "Imiesłów w mianowniku liczby mnogiej. Podmiot pozostaje niewyrażony.", "en": "A nominative plural participle. Its subject is left unexpressed." } },
        { "id": "w002", "form": "et", "lemma": "et", "morph": { "pos": "conj" }, "gloss": { "pl": "i", "en": "and" } },
        { "id": "w003", "form": "memóriam", "lemma": "memoria", "morph": { "pos": "noun", "case": "acc", "number": "sg", "gender": "f", "decl": 1 }, "gloss": { "pl": "pamięć", "en": "the memory" } },
        { "id": "w004", "form": "venerántes", "post": ",", "lemma": "veneror", "morph": { "pos": "verb", "case": "nom", "number": "pl", "gender": "m", "tense": "pres", "mood": "part", "voice": "dep", "conj": 1 }, "substantive": true, "gloss": { "pl": "czcząc", "en": "venerating" }, "function": { "pl": "Imiesłów deponentny, od którego zależy następujący dalej łańcuch dopełniaczy.", "en": "Deponent participle governing the chain of genitives that follows." } },
        { "id": "w005", "form": "in", "lemma": "in", "morph": { "pos": "prep", "governs": "abl" }, "head": "w006", "gloss": { "pl": "przede", "en": "first" } },
        { "id": "w006", "form": "primis", "lemma": "primus", "morph": { "pos": "adj", "case": "abl", "number": "pl" }, "substantive": true, "gloss": { "pl": "wszystkim", "en": "of all" } },
        { "id": "w007", "form": "gloriósæ", "lemma": "gloriosus", "morph": { "pos": "adj", "case": "gen", "number": "sg", "gender": "f" }, "head": "w009", "gloss": { "pl": "chwalebnej", "en": "glorious" } },
        { "id": "w008", "form": "semper", "lemma": "semper", "morph": { "pos": "adv" }, "gloss": { "pl": "zawsze", "en": "ever" } },
        { "id": "w009", "form": "Vírginis", "lemma": "virgo", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "f", "decl": 3 }, "gloss": { "pl": "Dziewicy", "en": "Virgin" }, "function": { "pl": "Razem z „semper” (w008) słowo Vírginis tworzy tytuł zawsze Dziewicy.", "en": "Together with “semper” (w008), Vírginis forms the title ever-Virgin." } },
        { "id": "w010", "form": "Maríæ", "post": ",", "lemma": "Maria", "morph": { "pos": "noun", "case": "gen", "number": "sg", "gender": "f", "decl": 1 }, "gloss": { "pl": "Maryi", "en": "Mary" } },
