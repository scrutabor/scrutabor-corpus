    {
      "id": "s02",
      "type": "rubric",
      "text": "Iungit manus, orat aliquantulum pro iis defunctis, pro quibus orare intendit, deinde extensis manibus prosequitur:",
      "narrative": {
        "pl": "Kapłan składa ręce i modli się chwilę w milczeniu za tych zmarłych, których chce wspomnieć. Potem rozkłada ręce i mówi dalej.",
        "en": "The priest joins his hands and prays a while in silence for those dead he means to remember, then spreads his hands and goes on."
      }
    },
    {
      "id": "s03",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "Błagamy Cię, Panie, abyś im i wszystkim spoczywającym w Chrystusie dał miejsce ochłody, światłości i pokoju.",
        "en": "We implore You, O Lord, to grant them and all who rest in Christ a place of refreshment, light, and peace."
      },
