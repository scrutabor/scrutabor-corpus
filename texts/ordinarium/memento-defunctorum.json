    {
      "id": "s01",
      "type": "verse",
      "speaker": "sacerdos",
      "voice": "secreto",
      "translation": {
        "pl": "Pamiętaj także, Panie, o Twoich sługach i służebnicach, którzy ze znakiem wiary odeszli przed nami i śpią snem pokoju.",
        "en": "Remember also, O Lord, Your servants, men and women, who went before us bearing the sign of faith and now sleep the sleep of peace."
      },
