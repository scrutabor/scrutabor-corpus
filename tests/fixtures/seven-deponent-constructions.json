    "proprium.dominica-xxi-post-pentecosten-communio": {
      "pl": {
        "about": "Communio formularza „21. Niedziela po Zesłaniu Ducha Świętego” w Mszale Rzymskim z 1962 roku.",
        "segment_fields": {
          "s01": {
            "translation": "W Twoim zbawieniu moja dusza i Twojemu słowu zaufałem: kiedy wykonasz sąd nad tymi, którzy mnie prześladują? Nieprawi mnie prześladowali; wspomóż mnie, Panie, Boże mój."
          }
        },
        "alignments": {
