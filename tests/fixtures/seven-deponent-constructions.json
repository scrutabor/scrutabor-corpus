      },
      "en": {
        "about": "The communio of the formulary “21st Sunday after Pentecost” in the 1962 Roman Missal.",
        "segment_fields": {
          "s01": {
            "translation": "My soul is in Your salvation, and in Your word I have hoped; when will You execute judgment on those who persecute me? The wicked have persecuted me; help me, O Lord my God."
          }
        },
