      "segments_before": {
        "s01": "Soul of Christ, sanctify me.",
        "s02": "Body of Christ, save me.",
        "s03": "Blood of Christ, inebriate me.",
        "s04": "Water from the side of Christ, wash me.",
        "s05": "Passion of Christ, strengthen me.",
        "s06": "O good Jesus, hear me.",
        "s07": "Within your wounds hide me.",
        "s08": "Do not permit me to be separated from you.",
        "s09": "Defend me from the evil enemy.",
        "s10": "At the hour of my death, call me.",
        "s11": "And bid me come to you,",
        "s12": "that I may praise you with your saints",
        "s13": "for ever and ever. Amen."
      },
      "segments_after": {
        "s01": "Soul of Christ, sanctify me.",
        "s02": "Body of Christ, save me.",
        "s03": "Blood of Christ, inebriate me.",
        "s04": "Water from the side of Christ, wash me.",
        "s05": "Passion of Christ, strengthen me.",
        "s06": "O good Jesus, hear me.",
        "s07": "Within Your wounds hide me.",
        "s08": "Do not permit me to be separated from You.",
        "s09": "Defend me from the evil enemy.",
        "s10": "At the hour of my death, call me.",
        "s11": "And bid me come to You,",
        "s12": "that I may praise You with Your saints",
        "s13": "for ever and ever. Amen."
      },
      "about": "The Anima Christi is a Christ-centered devotional prayer built from brief invocations. It asks Christ’s soul, body, blood, the water from his side, and his Passion for sanctification, salvation, inebriation, cleansing, and strength, and asks Jesus to hear, hide the speaker within his wounds, defend, call at the hour of death, and receive the speaker into everlasting praise with the saints.",
