  "explanations": {
    "pl": {
      "w011": "„Sancta sanctórum” to „Miejsce Najświętsze”. Oba słowa mają tu rodzaj nijaki. Nie oznaczają świętych osób.",
      "w014": "Po „ut” czasownik „mereámur” łączy się z „introíre”: „abyśmy byli godni wejść”. Rozdziela on słowa „puris” i „méntibus”, które razem znaczą „z czystymi umysłami”.",
      "w038": "„Dignéris” łączy się z poprzedzającym je „indulgére”. Po „ut” całość wyraża pełną szacunku prośbę: „abyś raczył odpuścić”."
    },
    "en": {
      "w011": "“Sancta sanctórum” means “the Holy of Holies.” Both words are neuter here and refer to a holy place, not to saints.",
      "w014": "After “ut,” “mereámur” takes the infinitive “introíre”: “that we may be worthy to enter.” It stands between “puris” and “méntibus,” which belong together: “with pure minds.”",
      "w038": "After “ut,” “dignéris” with the preceding infinitive “indulgére” expresses a deferential request: “that You may be pleased to forgive.”"
    }
  },
  "generic_notes": {
    "pl": {
      "senses": [
        "raczyć",
        "uznawać za godne"
      ],
      "note": "Czasownik deponens od dignus — godny. W prośbach z bezokolicznikiem może znaczyć „raczyć coś uczynić”."
    },
    "en": {
      "senses": [
        "to deign",
        "to think worthy"
      ],
      "note": "A deponent verb derived from dignus — worthy. In a deferential request, it can take an infinitive with the sense “be pleased to do something.”",
      "derivatives": [
        "deign"
      ]
    }
  },
  "preserved_layers": {
    "pl": {
      "s01": {
        "narrative": "Kapłan rozkłada i składa ręce, po czym mówi na głos jedno słowo."
      },
      "s02": {
        "translation": "Módlmy się.",
        "translation_citations": [
          {
            "title": "Pamiątka Missyi dla ludu katolickiego (1903)",
            "locator": "printed pp. 45–46",
            "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego"
          }
        ]
      },
      "s03": {
        "narrative": "Kapłan wstępuje po stopniach do ołtarza i dalszy ciąg mówi po cichu."
      },
      "s04": {
        "translation": "Panie, prosimy Cię, zabierz od nas nasze nieprawości, abyśmy z czystymi sercami byli godni wejść do Miejsca Najświętszego.",
        "translation_citations": [
          {
            "title": "Pamiątka Missyi dla ludu katolickiego (1903)",
            "locator": "printed pp. 45–46",
            "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego"
          }
        ]
      },
      "s05": {
        "translation": "Przez Chrystusa, Pana naszego. Amen.",
        "translation_citations": [
          {
            "title": "Pamiątka Missyi dla ludu katolickiego (1903)",
            "locator": "printed pp. 45–46",
            "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego"
          }
        ]
      },
      "s06": {
        "narrative": "Ze złożonymi rękami opartymi o ołtarz kapłan pochyla się nad nim i zaczyna drugą modlitwę."
      },
      "s07": {
        "translation": "Prosimy Cię, Panie, przez zasługi Twoich świętych,",
        "translation_citations": [
          {
            "title": "Pamiątka Missyi dla ludu katolickiego (1903)",
            "locator": "printed pp. 45–46",
            "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego"
          }
        ]
      },
      "s08": {
        "narrative": "Kapłan całuje środek ołtarza."
      },
      "s09": {
        "translation": "których relikwie tu się znajdują, i wszystkich świętych, abyś raczył przebaczyć wszystkie grzechy moje. Amen.",
        "translation_citations": [
          {
            "title": "Pamiątka Missyi dla ludu katolickiego (1903)",
            "locator": "printed pp. 45–46",
            "url": "https://sbc.org.pl/dlibra/publication/337480/edition/318796/pamiatka-missyi-dla-ludu-katolickiego"
          }
        ]
      }
    },
    "en": {
      "s01": {
        "narrative": "The priest extends and joins his hands, then says one word aloud."
      },
      "s02": {
        "translation": "Let us pray.",
        "translation_citations": [
          {
            "title": "The Missal for the Use of the Laity (1853)",
            "locator": "printed p. 6",
            "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
          },
          {
            "title": "The Missal for the Laity (1846)",
            "locator": "printed pp. 39–40",
            "url": "https://archive.org/details/TheMissalForTheLaity"
          },
          {
            "title": "The Family Prayer-book (1839)",
            "locator": "printed pp. 63–64",
            "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf"
          }
        ]
      },
      "s03": {
        "narrative": "The priest ascends the steps to the altar and continues silently."
      },
      "s04": {
        "translation": "Lord, we ask You to take away our iniquities, so that with pure minds we may be worthy to enter the Holy of Holies.",
        "translation_citations": [
          {
            "title": "The Missal for the Use of the Laity (1853)",
            "locator": "printed p. 6",
            "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
          },
          {
            "title": "The Missal for the Laity (1846)",
            "locator": "printed pp. 39–40",
            "url": "https://archive.org/details/TheMissalForTheLaity"
          },
          {
            "title": "The Family Prayer-book (1839)",
            "locator": "printed pp. 63–64",
            "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf"
          }
        ]
      },
      "s05": {
        "translation": "Through Christ our Lord. Amen.",
        "translation_citations": [
          {
            "title": "The Missal for the Use of the Laity (1853)",
            "locator": "printed p. 6",
            "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
          },
          {
            "title": "The Missal for the Laity (1846)",
            "locator": "printed pp. 39–40",
            "url": "https://archive.org/details/TheMissalForTheLaity"
          },
          {
            "title": "The Family Prayer-book (1839)",
            "locator": "printed pp. 63–64",
            "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf"
          }
        ]
      },
      "s06": {
        "narrative": "With joined hands resting on the altar the priest bows over it and begins the second prayer."
      },
      "s07": {
        "translation": "We ask You, Lord, by the merits of Your saints,",
        "translation_citations": [
          {
            "title": "The Missal for the Use of the Laity (1853)",
            "locator": "printed p. 6",
            "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
          },
          {
            "title": "The Missal for the Laity (1846)",
            "locator": "printed pp. 39–40",
            "url": "https://archive.org/details/TheMissalForTheLaity"
          },
          {
            "title": "The Family Prayer-book (1839)",
            "locator": "printed pp. 63–64",
            "url": "https://commons.wikimedia.org/wiki/File:The_family_prayer-book,_containing_all_the_public_and_private_devotions_in_use_amongst_English_Catholics._(IA_TheFamilyPrayerBookContaining).pdf"
          }
        ]
      },
      "s08": {
        "narrative": "The priest kisses the middle of the altar."
      },
      "s09": {
        "translation": "whose relics are here, and by the merits of all the saints, that You may be pleased to forgive all my sins. Amen.",
        "translation_citations": [
