  "apparatus": {
    "text": "ordinarium.aufer-a-nobis",
    "note": "Adjudicated punctuation variants among the three transcribed witnesses. Their spoken words agree; the selected punctuation and individual differences are recorded below.",
    "summary": {
      "entries": 4,
      "classes": [
        "punctuation"
      ]
    },
    "adjudicated": [
      {
        "at": "w001",
        "ours": "Orémus.",
        "witnesses": {
          "do": "Orémus,",
          "handmissal-eo": "Orémus."
        },
        "class": "punctuation",
        "ruling": "The selected full stop presents Orémus as a separate invitation, following handmissal-eo. DO prints a comma before an inline parenthetical rubric. Here the rubric occupies its own segment."
      },
      {
        "at": "w001",
        "ours": "Orémus.",
        "witnesses": {
          "mr": "Orémus,"
        },
        "class": "punctuation",
        "ruling": "The page sets Orémus inside the rubric that runs on, with a comma. The edition prints it as its own line, with a full stop."
      },
      {
        "at": "w018",
        "ours": "Christum",
        "witnesses": {
          "do": "Christum,",
          "handmissal-eo": "Christum"
        },
        "class": "punctuation",
        "ruling": "No comma after Christum, following MR and handmissal-eo. Dóminum nostrum stands in apposition to Christum. DO inserts a comma at this point."
      },
      {
        "at": "w032",
        "ours": "sunt,",
        "witnesses": {
          "handmissal-eo": "sunt"
        },
        "class": "punctuation",
        "ruling": "The comma after sunt follows MR and DO and closes the relative clause quorum relíquiæ hic sunt. Mérita governs both Sanctórum tuórum and ómnium Sanctórum. Handmissal-eo omits this comma."
      }
    ]
  },
