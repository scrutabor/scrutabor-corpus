        {
          "pointer": "/segments/s01/translation",
          "before": {
            "exists": true,
            "value": "In those days, I saw the holy city, the new Jerusalem, descending from heaven, from God, prepared as a bride adorned for her husband. And I heard a great voice from the throne, saying: Behold the tabernacle of God with men, and He will dwell with them. And they themselves will be His people, and God Himself with them will be their God; and God will wipe away every tear from their eyes, and death will be no longer, nor mourning, nor crying, nor grief will be any longer, because the first things have passed away. And He who sat upon the throne said: Behold, I make all things new."
          },
          "after": {
            "exists": true,
            "value": "In those days, I saw the holy city, the new Jerusalem, descending from heaven, from God, prepared as a bride adorned for her husband. And I heard a loud voice from the throne, saying: Behold the tabernacle of God with people, and He will dwell with them. And they themselves will be His people, and God Himself will be with them as their God; and God will wipe away every tear from their eyes, and death will be no more, nor will there be mourning, crying or pain any longer, because the former things have passed away. And He who was seated on the throne said: Behold, I make all things new."
          }
        },
