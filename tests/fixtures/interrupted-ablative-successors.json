    {
      "path": "languages/en/texts/proprium/sacratissimi-cordis-iesu-collecta.json",
      "pointer": "/segments/s01/translation",
      "before": {
        "exists": true,
        "value": "O God, who mercifully deignest to bestow upon us the infinite treasures of love in the Heart of Thy Son, wounded by our sins: grant, we beseech Thee, that, offering Him the devout homage of our piety, we may also fulfill the duty of worthy reparation. Through the same Lord Jesus Christ, Thy Son, who liveth and reigneth with Thee in the unity of the Holy Ghost, God, world without end."
      },
      "after": {
        "exists": true,
        "value": "O God, who are mercifully pleased to bestow on us the infinite treasures of love in Your Son’s Heart, wounded by our sins, grant, we pray, that, as we offer Him our devoted worship, we may also fulfill the duty of worthy reparation. Through the same Jesus Christ, our Lord, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God, forever and ever."
      }
    },
