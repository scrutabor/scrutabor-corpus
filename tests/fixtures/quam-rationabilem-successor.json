  "prose": {
    "s01": "O God, we ask You graciously to make this offering in all respects",
    "s03": "blessed, approved, ratified, spiritual, and acceptable,",
    "s05": "so that for us it may become the Body and Blood of Your dearly beloved Son,",
    "s07": "our Lord Jesus Christ."
  },
  "narratives": {
    "s02": "The priest makes three signs of the cross over the offerings.",
    "s04": "The priest makes one sign of the cross over the Host alone, at the word Corpus, and one over the chalice alone, at Sanguis.",
    "s06": "The priest joins his hands."
  },
