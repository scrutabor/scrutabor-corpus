    "introitus.pl": {
      "schema_version": "0.21.0",
      "language": "pl",
      "text": "proprium.commemoratio-omnium-fidelium-defunctorum-missa-i-introitus",
      "about": "Introitus formularza „Wspomnienie Wszystkich Wiernych Zmarłych — Msza I” w Mszale Rzymskim z 1962 roku.",
      "segments": {
        "s01": {
          "translation": "Wieczny odpoczynek racz im dać, Panie, a światłość wiekuista niechaj im świeci. Tobie, Boże, przystoi hymn na Syjonie i Tobie zostanie wypełnione ślubowanie w Jeruzalem; wysłuchaj mojej modlitwy, do Ciebie przyjdzie wszelkie ciało. Wieczny odpoczynek racz im dać, Panie, a światłość wiekuista niechaj im świeci."
        }
      },
