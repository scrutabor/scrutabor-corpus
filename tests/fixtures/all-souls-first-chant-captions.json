  "layers": {
    "communio.pl": {
      "schema_version": "0.21.0",
      "language": "pl",
      "text": "proprium.commemoratio-omnium-fidelium-defunctorum-missa-i-communio",
      "about": "Communio formularza „Wspomnienie Wszystkich Wiernych Zmarłych — Msza I” w Mszale Rzymskim z 1962 roku.",
      "segments": {
        "s01": {
          "translation": "Światłość wiekuista niechaj im świeci, o Panie: Wśród świętych Twoich na wieki, bo jesteś pełen dobroci. Wieczny odpoczynek racz im dać, Panie, a światłość wiekuista niechaj im świeci. Wśród świętych Twoich na wieki, bo jesteś pełen dobroci."
        }
      },
