    "introitus.en": {
      "schema_version": "0.21.0",
      "language": "en",
      "text": "proprium.commemoratio-omnium-fidelium-defunctorum-missa-i-introitus",
      "about": "The introitus of the formulary “Commemoration of All the Faithful Departed — Mass I” in the 1962 Roman Missal.",
      "segments": {
        "s01": {
          "translation": "Grant them eternal rest, O Lord, and let perpetual light shine upon them. A hymn is fitting for You, O God, in Zion, and to You a vow will be rendered in Jerusalem. Hear my prayer: all flesh will come to You. Grant them eternal rest, O Lord, and let perpetual light shine upon them.",
