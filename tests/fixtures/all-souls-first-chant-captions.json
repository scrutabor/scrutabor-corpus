    "communio.en": {
      "schema_version": "0.21.0",
      "language": "en",
      "text": "proprium.commemoratio-omnium-fidelium-defunctorum-missa-i-communio",
      "about": "The communio of the formulary “Commemoration of All the Faithful Departed — Mass I” in the 1962 Roman Missal.",
      "segments": {
        "s01": {
          "translation": "May light eternal shine upon them, O Lord, with Your saints forever, for You are merciful. Grant them eternal rest, O Lord; and let perpetual light shine upon them: with Your saints forever, for You are merciful.",
