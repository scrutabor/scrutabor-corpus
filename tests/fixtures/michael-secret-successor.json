    {
      "path": "languages/pl/texts/proprium/dedicatio-sancti-michaelis-archangeli-secreta.json",
      "pointer": "/words/w013/explanation",
      "before": {
        "exists": true,
        "value": "Słowa „angélico … interveniénte suffrágio” to ablativus absolutus. Polszczyzna oddaje go wyrażeniem przyimkowym: „za anielskim orędownictwem, wstawiającym się za nami”. Słowa „pro nobis” (za nami) stoją wewnątrz tej konstrukcji. Określa ona obie prośby: „przyjął” i „sprawił”."
      },
      "after": {
        "exists": true,
        "value": "Słowa „angélico … interveniénte suffrágio” tworzą ablativus absolutus: anielskie orędownictwo działa na naszą rzecz. Wyrażenie „pro nobis” (za nami) należy do tej konstrukcji. Określa ona obie prośby: „przyjął” i „sprawił”."
      }
    },
