    {
      "path": "languages/en/texts/proprium/dedicatio-sancti-michaelis-archangeli-secreta.json",
      "pointer": "/segments/s01/translation",
      "before": {
        "exists": true,
        "value": "We offer You sacrifices of praise, O Lord, humbly praying You to accept them graciously and to grant that they may be helpful for our salvation through the intercession of the Angels who intercede for us. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,"
      },
      "after": {
        "exists": true,
        "value": "We offer You sacrifices of praise, O Lord, humbly asking that, through angelic intercession on our behalf, You graciously accept them and grant that they may serve our salvation. Through our Lord Jesus Christ, Your Son, who lives and reigns with You in the unity of the Holy Spirit, God,"
      }
    },
