    {
      "path": "languages/pl/texts/proprium/dedicatio-sancti-michaelis-archangeli-secreta.json",
      "pointer": "/segments/s01/translation",
      "before": {
        "exists": true,
        "value": "Składamy Ci, Panie, ofiary chwały, pokornie błagając, abyś je za anielskim orędownictwem, wstawiającym się za nami, i przejednany przyjął, i sprawił, by wyszły nam na zbawienie. Przez Pana naszego Jezusa Chrystusa, Syna Twojego, który z Tobą żyje i króluje w jedności Ducha Świętego, Bóg,"
      },
      "after": {
        "exists": true,
        "value": "Składamy Ci, Panie, ofiary chwały, pokornie błagając, abyś dzięki anielskiemu orędownictwu, które nas wspiera, przyjął je przejednany i sprawił, by posłużyły naszemu zbawieniu. Przez Pana naszego Jezusa Chrystusa, Syna Twojego, który z Tobą żyje i króluje w jedności Ducha Świętego, Bóg,"
      }
