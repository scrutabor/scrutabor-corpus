        },
        "words": {
          "w001": {},
          "w002": {
            "explanation": "Biernik wskazuje tu na kwiaty wydawane przez roślinę: „wydawajcie kwiaty”. Forma jest również zgodna z wołaczem, ale odczytanie jej jako dopełnienia lepiej oddaje ten obraz."
          },
          "w003": {
            "gloss": "jak"
          },
          "w004": {
