          },
          "w009": {},
          "w010": {},
          "w011": {
            "explanation": "Gratia oznacza tu wdzięk i piękno. Cała fraza przedstawia roślinę wypuszczającą piękne liście."
          },
          "w012": {
            "explanation": "Pieśń jest wyrazem chwały oddawanej Bogu. Stąd wspólny przekład „wznoście pieśń chwały”, nie zachęta do chwalenia samej pieśni."
          },
          "w013": {},
