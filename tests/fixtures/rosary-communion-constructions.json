        "words": {
          "w001": {},
          "w002": {
            "explanation": "Flores names what is produced: blossoms. As an internal object of florete, the phrase means “put forth blossoms”. The form could also be vocative, but the object reading better fits this image."
          },
          "w003": {
            "gloss": "like"
          },
