          "w009": {},
          "w010": {},
          "w011": {
            "explanation": "Gratia here denotes beauty or charm. The whole phrase depicts the plant putting forth lovely leaves."
          },
          "w012": {
            "explanation": "The song expresses praise offered to God. The phrase is therefore rendered “sing a song of praise”, not an invitation to praise the song itself."
          },
          "w013": {},
          "w014": {
            "gloss": "and"
          },
          "w015": {
            "gloss": "bless"
          },
          "w016": {
