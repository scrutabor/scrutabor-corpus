  "texts": {
    "orationes.magnificat": {
      "core_sha256": "c13007c5e37f9d6bf84ce194076e826aba71a296c969a6758dacb0a4706bb80e",
      "pl_sha256": "be752ff85e509cda3bc46cef9cb20baadd9754eb2f851f2eb2588e8720f5e689",
      "about": "The Magníficat is Mary’s canticle from the Gospel according to Saint Luke (Luke 1:46–55), sung at Roman Vespers. This edition preserves the traditional Latin text and its ten numbered biblical verses, followed separately by the Glory Be doxology.",
      "segment_fields": {
        "s01": {
          "translation": "My soul magnifies the Lord.",
          "translation_citations": [
            {
              "title": "The Missal for the Use of the Laity (1853)",
              "locator": "Canticle of B.V.M., printed p. 346",
              "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
            }
          ]
        },
        "s02": {
          "translation": "And my spirit has rejoiced in God my Savior.",
          "translation_citations": [
            {
              "title": "The Missal for the Use of the Laity (1853)",
              "locator": "Canticle of B.V.M., printed p. 346",
              "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
            }
          ]
        },
        "s03": {
          "translation": "For He has regarded the lowliness of His handmaid: behold, from now on all generations will call me blessed.",
          "translation_citations": [
            {
              "title": "The Missal for the Use of the Laity (1853)",
              "locator": "Canticle of B.V.M., printed p. 346",
              "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
            }
          ]
        },
        "s04": {
          "translation": "For He who is mighty has done great things for me, and holy is His name.",
          "translation_citations": [
            {
              "title": "The Missal for the Use of the Laity (1853)",
              "locator": "Canticle of B.V.M., printed p. 346",
              "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
            }
          ]
        },
        "s05": {
          "translation": "And His mercy is from generation to generation for those who fear Him.",
          "translation_citations": [
            {
              "title": "The Missal for the Use of the Laity (1853)",
              "locator": "Canticle of B.V.M., printed p. 346",
              "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
            }
          ]
        },
        "s06": {
          "translation": "He has shown might with His arm; He has scattered the proud in the conceit of their heart.",
          "translation_citations": [
            {
              "title": "The Missal for the Use of the Laity (1853)",
              "locator": "Canticle of B.V.M., printed p. 346",
              "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
            }
          ]
        },
        "s07": {
          "translation": "He has put down the mighty from their seat, and has exalted the humble.",
          "translation_citations": [
            {
              "title": "The Missal for the Use of the Laity (1853)",
              "locator": "Canticle of B.V.M., printed p. 346",
              "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
            }
          ]
        },
        "s08": {
          "translation": "He has filled the hungry with good things and sent the rich away empty.",
          "translation_citations": [
            {
              "title": "The Missal for the Use of the Laity (1853)",
              "locator": "Canticle of B.V.M., printed p. 346",
              "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
            }
          ]
        },
        "s09": {
          "translation": "He has received Israel His servant, being mindful of His mercy.",
          "translation_citations": [
            {
              "title": "The Missal for the Use of the Laity (1853)",
              "locator": "Canticle of B.V.M., printed p. 346",
              "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
            }
          ]
        },
        "s10": {
          "translation": "As He spoke to our fathers, to Abraham and to his seed forever.",
          "translation_citations": [
            {
              "title": "The Missal for the Use of the Laity (1853)",
              "locator": "Canticle of B.V.M., printed p. 346",
              "url": "https://archive.org/details/missal_for_use_of_laity_1853-f_c_husenbeth"
            }
          ]
        },
        "s11": {
          "translation": "Glory be to the Father, and to the Son, and to the Holy Spirit.",
          "translation_citations": [
            {
              "title": "Key of Heaven (1901)",
              "locator": "printed p. 55",
              "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu"
            }
          ]
        },
        "s12": {
          "translation": "As it was in the beginning, is now, and ever shall be, world without end. Amen.",
          "translation_citations": [
            {
              "title": "Key of Heaven (1901)",
              "locator": "printed p. 55",
              "url": "https://commons.wikimedia.org/wiki/File:KeyOfHeaven.djvu"
            }
          ]
        }
      },
      "old_alignments": {
        "s03": [
          {
            "words": [
              "w018",
              "w019"
            ],
            "anchor": "w018",
            "gloss": "for behold"
          }
        ],
        "s11": [
          {
            "words": [
              "w095",
              "w096"
            ],
            "anchor": "w095",
            "gloss": "to the Holy Spirit"
          }
        ]
      },
      "predicate_notes": {
        "w080": "With “locútus” it forms the single predicate “has spoken”."
      }
    },
    "ordinarium.lavabo": {
      "core_sha256": "d63bb0787353a95cf3c30bb863f0005191d79ffefb548a22a1c44c243be8fbf0",
      "pl_sha256": "28f6966aec65fe704c3c91c829bf2fc0799f0cb68ec668e8d4746076b87b5e0b",
      "about": "Psalm 25:6–12 in the Vulgate numbering (Psalm 26 in Hebrew), said during the washing of hands. At Masses for the Dead, and at Masses of the season from Passion Sunday through Maundy Thursday, the Glória Patri is omitted. The psalm itself remains.",
      "segment_fields": {
        "s01": {
          "narrative": "The priest washes his fingertips, the thumb and forefinger, while saying the psalm."
        },
        "s02": {
          "translation": "I will wash my hands among the innocent and go around Your altar, O Lord,",
          "translation_citations": [
            {
              "title": "The Missal for the Laity (1846)",
              "locator": "printed pp. 50–51",
              "url": "https://archive.org/details/TheMissalForTheLaity"
            }
          ]
        },
        "s03": {
          "translation": "that I may hear the voice of praise and recount all Your wonders.",
          "translation_citations": [
            {
              "title": "The Missal for the Laity (1846)",
              "locator": "printed pp. 50–51",
              "url": "https://archive.org/details/TheMissalForTheLaity"
            }
          ]
        },
        "s04": {
          "translation": "O Lord, I have loved the beauty of Your house and the place where Your glory dwells.",
          "translation_citations": [
            {
              "title": "The Missal for the Laity (1846)",
              "locator": "printed pp. 50–51",
              "url": "https://archive.org/details/TheMissalForTheLaity"
            }
          ]
        },
        "s05": {
          "translation": "O God, do not destroy my soul with the wicked, nor my life with bloodthirsty men,",
          "translation_citations": [
            {
              "title": "The Missal for the Laity (1846)",
              "locator": "printed pp. 50–51",
              "url": "https://archive.org/details/TheMissalForTheLaity"
            }
          ]
        },
        "s06": {
          "translation": "in whose hands are iniquities; their right hand is filled with gifts.",
          "translation_citations": [
            {
              "title": "The Missal for the Laity (1846)",
              "locator": "parallel Ordinary and Advent propers, examined edition",
              "url": "https://archive.org/details/TheMissalForTheLaity"
            }
          ]
        },
        "s07": {
          "translation": "But I have walked in my innocence; redeem me and have mercy on me.",
          "translation_citations": [
            {
              "title": "The Missal for the Laity (1846)",
              "locator": "printed pp. 50–51",
              "url": "https://archive.org/details/TheMissalForTheLaity"
            }
          ]
        },
        "s08": {
          "translation": "My foot has stood on level ground; in the assemblies I will bless You, O Lord.",
          "translation_citations": [
            {
              "title": "The Missal for the Laity (1846)",
              "locator": "printed pp. 50–51",
              "url": "https://archive.org/details/TheMissalForTheLaity"
            }
          ]
        },
        "s09": {
          "translation": "Glory be to the Father, and to the Son, and to the Holy Spirit.",
          "translation_citations": [
            {
              "title": "The Missal for the Laity (1846)",
              "locator": "printed p. 37",
              "url": "https://archive.org/details/TheMissalForTheLaity"
            }
          ]
        },
        "s10": {
          "translation": "As it was in the beginning, is now, and ever shall be, world without end. Amen.",
          "translation_citations": [
            {
              "title": "The Missal for the Laity (1846)",
              "locator": "printed p. 37",
              "url": "https://archive.org/details/TheMissalForTheLaity"
            }
          ]
        }
      },
      "old_alignments": {
